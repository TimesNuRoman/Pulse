---
// SPDX-License-Identifier: Apache-2.0
// R143: 404 page — on-brand dark Tokyo Night.
// 3 suggested next steps: home / FAQ / changelog.
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Not found — Pulse"
  description="404. The page being looked for moved or never existed."
  ctaVisible={false}
  footerLicense=""
  footerVersion=""
>
  <main class="notfound">
    <div class="container">
      <header class="notfound__head reveal">
        <span class="eyebrow">404</span>
        <h1>Not in someone else's cloud.</h1>
        <p class="lede">404. The page being looked for moved or never existed.</p>
      </header>

      <nav class="notfound__next reveal" aria-label="Suggested next steps">
        <a class="notfound__card" href="/">
          <span class="notfound__card-label">Go home</span>
          <span class="notfound__card-hint">The Pulse landing page</span>
        </a>
        <a class="notfound__card" href="/faq/">
          <span class="notfound__card-label">Read the FAQ</span>
          <span class="notfound__card-hint">Common questions about Pulse</span>
        </a>
        <a class="notfound__card" href="/changelog/">
          <span class="notfound__card-label">Check the changelog</span>
          <span class="notfound__card-hint">Every Pulse release, oldest to newest</span>
        </a>
      </nav>
    </div>
  </main>
  <Footer license="" version="" />
</Base>

<style>
  .notfound { padding-block: clamp(80px, 14vw, 160px); }
  .notfound__head {
    text-align: left;
    margin-bottom: 3rem;
    max-width: 30ch;
  }
  .notfound__head .lede { margin-top: 0.6rem; }

  .notfound__next {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    max-width: 64ch;
  }
  @media (min-width: 700px) {
    .notfound__next { grid-template-columns: 1fr 1fr 1fr; }
  }

  .notfound__card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.25rem 1.4rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--fg);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease),
                transform var(--dur) var(--ease),
                box-shadow var(--dur) var(--ease);
    min-height: 88px;
  }
  .notfound__card:hover {
    border-color: var(--purple);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
    color: var(--fg);
  }
  .notfound__card:focus-visible {
    outline: 2px solid var(--purple);
    outline-offset: 2px;
  }
  .notfound__card-label {
    font-weight: 600;
    color: var(--fg);
    font-size: 1.05rem;
  }
  .notfound__card-hint {
    color: var(--fg-dim);
    font-size: 0.92rem;
    line-height: 1.4;
  }
</style>
