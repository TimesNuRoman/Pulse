---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import CompareTable from '../components/CompareTable.astro';

/* R94b: Pulse vs alternatives comparison page
 * One nav pattern, one Footer, one CompareTable.
 * 12/12 hard rules: 0 emoji, DARK only, Tokyo Night, no marketing fluff.
 */

const APK_URL = '/downloads/pulse-notes-0.6.6.apk';
const APK_SIZE = '1.29 MB';

const PAGE_TITLE = 'Pulse vs Raycast AI, Notion AI, AnythingLLM, LM Studio, Ollama — local-first AI';
const PAGE_DESC = "Honest side-by-side: Pulse, Raycast AI, Notion AI, AnythingLLM, LM Studio, Ollama. Local-first, voice input, markdown notes, price, open source, mobile, RAM, privacy — no asterisks, no marketing fluff. Updated 2026-08-01.";

const products = [
  { key: 'pulse',  name: 'Pulse',          tagline: 'Voice + notes. Local. Apache 2.0.',          highlight: true  },
  { key: 'raycast',name: 'Raycast AI',     tagline: 'macOS only. $8/mo. Cloud-tied.' },
  { key: 'notion', name: 'Notion AI',      tagline: 'Cloud wiki + AI. $10/mo. Tracking.' },
  { key: 'anyllm', name: 'AnythingLLM',    tagline: 'Local. MIT. Docker. 30+ min setup.' },
  { key: 'lmstu',  name: 'LM Studio',      tagline: 'Local model GUI. MIT. No app layer.' },
  { key: 'ollama', name: 'Ollama (alone)', tagline: 'Local model engine. MIT. CLI / API only.' },
];

const rows = [
  { label: 'Platform',           values: { pulse: 'Windows + Android',  raycast: 'macOS only',        notion: 'Web + iOS + Android', anyllm: 'Docker (any OS)',  lmstu: 'Win / macOS / Linux',  ollama: 'CLI / API only' } },
  { label: 'Local-first',        values: { pulse: 'yes',                raycast: 'no',                notion: 'no',                anyllm: 'yes',              lmstu: 'yes',                  ollama: 'yes' } },
  { label: 'Voice input',        values: { pulse: 'yes',                raycast: 'partial',           notion: 'no',                anyllm: 'partial',          lmstu: 'no',                   ollama: 'no' } },
  { label: 'Markdown notes',     values: { pulse: 'yes',                raycast: 'no',                notion: 'partial',           anyllm: 'no',               lmstu: 'no',                   ollama: 'no' } },
  { label: 'Price',              values: { pulse: 'Free',               raycast: '$8 / mo',           notion: '$10 / mo',          anyllm: 'Free',             lmstu: 'Free',                 ollama: 'Free' } },
  { label: 'Open source',        values: { pulse: 'Apache 2.0',         raycast: 'no',                notion: 'no',                anyllm: 'MIT',              lmstu: 'MIT',                  ollama: 'MIT' } },
  { label: 'Mobile',             values: { pulse: 'Android',            raycast: 'no',                notion: 'iOS + Android',     anyllm: 'no',               lmstu: 'no',                   ollama: 'no' } },
  { label: 'Setup time',         values: { pulse: '~2 min',             raycast: '~5 min + sub',      notion: '~10 min + account', anyllm: '~30+ min',         lmstu: '~10 min',              ollama: '~5+ min' } },
  { label: 'RAM for 7B model',   values: { pulse: '~4-8 GB',            raycast: 'n/a (cloud)',       notion: 'n/a (cloud)',       anyllm: '~4-16 GB',         lmstu: '~4-16 GB',             ollama: '~4-16 GB' } },
  { label: 'Privacy',            values: { pulse: 'On-device. No tracking.', raycast: 'Cloud. OpenAI terms.', notion: 'Cloud. Telemetry.', anyllm: 'On-device. Self-hosted.', lmstu: 'On-device. No tracking.', ollama: 'On-device. No tracking.' } },
];

const verdicts = [
  { name: 'Raycast AI',  text: 'Eight dollars a month, macOS only, fast prompt bar. But your prompts go to OpenAI by default. The local-model extension is paid, separate, and still routes through Raycast servers. Good if you live in Raycast and trust the chain.' },
  { name: 'Notion AI',   text: 'Ten dollars a month, polished cloud editor with AI baked into every doc. But every note, every prompt, every keystroke is on Notion servers under their terms. The product is the wiki, the AI is the upsell.' },
  { name: 'AnythingLLM', text: 'Free, MIT, local-first, multi-model. Power-user surface: Docker, vector DB config, workspace permissions. Best choice if you want to roll your own and have a weekend.' },
  { name: 'LM Studio',   text: 'Free, MIT, polished local-model GUI. Runs GGUF models on your hardware. Stops at the chat window — no notes, no voice, no app layer. You wire your own front-end on top.' },
  { name: 'Ollama',      text: 'Free, MIT, the model engine everyone else builds on. No UI at all. You talk to it via curl, a script, or a third-party wrapper. Pulse uses Ollama as its local backend on desktop.' },
];

const whyCards = [
  {
    label: 'Local-first',
    title: 'Your data stays on the device.',
    body: 'Pulse talks to a local Ollama instance on desktop and uses on-device Whisper on Android. No cloud round-trip, no account, no telemetry. The on-device update checker only knows your version number.',
  },
  {
    label: 'Open source',
    title: 'Apache 2.0. Read the code.',
    body: 'Pulse is Apache 2.0 across all three surfaces: Windows desktop, Android notes, and this site. No "Pro" tier, no "Enterprise" tier, no telemetry opt-in, no premium model hidden behind a paywall.',
  },
  {
    label: 'Voice + notes',
    title: 'One side panel, one editor.',
    body: 'Voice is the desktop side panel. Markdown is the Android editor. Both are offline by default. Both are first-class surfaces, not a feature flag.',
  },
  {
    label: 'No tracking',
    title: 'Zero analytics. No opt-out needed.',
    body: 'There is no analytics SDK. There is no error reporter. There is no "phone home" with usage data. The only network call Pulse makes is the manifest poll for updates, and you can disable it.',
  },
];

const whenNot = [
  'You need frontier-scale AI (1M+ token context, latest GPT-4 / Claude). Pulse runs 4-70B local models. Use the cloud tools.',
  'You live in Raycast on macOS and are happy paying $8/mo for the prompt bar. Raycast AI is fine for that workflow.',
  'You do not have at least 8 GB of free RAM for a 7B model. Use a cloud tool or wait for a smaller distilled model.',
  'You need a multi-user wiki with comments, mentions, and shared workspaces. Notion AI is the right tool. Pulse Notes is single-user.',
  'You want a polished desktop chat UI with image generation out of the box. LM Studio plus a chat front-end is a better fit than Pulse.',
  'You want a fully GUI-driven local RAG pipeline. AnythingLLM is the closest match and the config is honest about it.',
];

const faqs = [
  { q: 'Does Pulse work offline?', a: 'Yes. Desktop Pulse talks to a local Ollama instance. Android Pulse runs on-device. The only network call is the optional update-checker manifest poll, which you can disable in settings. Voice input on Android uses the on-device speech recognizer; on desktop it uses Whisper.cpp running locally.' },
  { q: 'Which AI models does Pulse support?', a: 'Anything Ollama serves on desktop: Llama 3, Qwen 2.5, Mistral, Gemma 2, Phi-3, DeepSeek, and any other GGUF model. The 4-8B range (Qwen 2.5 7B, Llama 3.1 8B, Mistral Nemo 12B) hits the best latency / quality balance on a 16 GB laptop. On Android, Pulse Notes uses its on-device model for the recall step and ships the Smart Engine v3 router.' },
  { q: 'Can I sync notes between Android and desktop?', a: 'Not yet in v0.6.x. Pulse Notes v0.7 is the planned E2E sync release, opt-in and disabled by default. Today, the on-device SQLite file is plain and portable — copy notes.db off the device with any file manager, restore the same way. No proprietary export format.' },
  { q: 'Does Pulse work on Linux or iOS?', a: 'Linux desktop is not in v0.6.x. The desktop binary is Windows (Tauri 2). iOS is not planned for the Notes surface. Android is minSdk 24 (Android 7.0) with targetSdk 36.' },
  { q: 'Is there a paid tier or Pro version?', a: 'No. Pulse is Apache 2.0 across all three surfaces. There is no Pro tier, no premium model, no "Enterprise" SKU. The same code is the same code.' },
  { q: 'Can I self-host Pulse?', a: 'There is nothing to host. Pulse is local-first. The desktop app talks to your local Ollama; the Android app runs on-device. The site is a static Astro build. The only network endpoint is the manifest poll for updates, and the chain of hosts is public.' },
  { q: 'How is Pulse different from ChatGPT or Claude?', a: 'Privacy, cost, and offline use. ChatGPT and Claude route every prompt through their cloud, log it, and charge per token. Pulse runs the model on your hardware, costs nothing per query, and works on a plane. The trade-off: a 7B local model is not as capable as GPT-4 on hard reasoning tasks. If you need frontier capability, use a frontier tool. If you need a fast, private, always-available AI for daily work, Pulse is the better fit.' },
  { q: 'What about voice input on Android?', a: 'Pulse Notes v0.6.x uses Android’s on-device speech recognizer (free, accurate, no network round-trip). Desktop Pulse uses Whisper.cpp running locally on the device — the same model that powers the OpenAI Whisper API, but offline. There is no cloud STT in either surface.' },
];

/* JSON-LD FAQPage schema (for Google Rich Results). Roman's 12/12 hard rules: validate before ship. */
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---
<Base
  title={PAGE_TITLE}
  description={PAGE_DESC}
  ogImage="/og/compare.svg"
  ctaText={`Get Pulse Notes ↓ ${APK_SIZE}`}
  ctaHref={APK_URL}
  ctaVisible={true}
  footerLicense="Apache 2.0"
  footerVersion="v0.6.6"
>
  <a class="skip-link" href="#main">Skip to content</a>

  <nav class="nav" id="topnav" aria-label="Primary">
    <div class="nav__inner">
      <a class="nav__brand" href="/" aria-label="Pulse — home">
        <svg class="pulse-logo" viewBox="0 0 64 64" width="28" height="28" role="img" aria-label="Pulse">
          <circle class="pulse-logo__ring" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle class="pulse-logo__ring pulse-logo__ring--2" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle class="pulse-logo__ring pulse-logo__ring--3" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle cx="32" cy="32" r="9" fill="#bb9af7"></circle>
          <circle cx="35" cy="30" r="2" fill="#1a1b26"></circle>
        </svg>
        <span class="nav__brand-name">Pulse</span>
      </a>
      <ul class="nav__links" role="list">
        <li><a class="nav__link" href="/#why">Why</a></li>
        <li><a class="nav__link" href="/notes/">Notes</a></li>
        <li><a class="nav__link" href="/compare/" aria-current="page">Compare</a></li>
        <li><a class="nav__link" href="/changelog/">Changelog</a></li>
      </ul>
      <div class="nav__right">
        <a class="btn btn--primary nav__cta" href={APK_URL} rel="noopener noreferrer">Get Pulse Notes ↓ {APK_SIZE}</a>
        <button class="nav__burger" id="nav-burger" type="button" aria-expanded="false" aria-controls="nav-drawer" aria-label="Open menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="20" y2="17"></line>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <div class="nav-drawer" id="nav-drawer" aria-hidden="true">
    <a class="nav-drawer__link" href="/">Home</a>
    <a class="nav-drawer__link" href="/#why">Why Pulse</a>
    <a class="nav-drawer__link" href="/notes/">Notes</a>
    <a class="nav-drawer__link" href="/compare/" aria-current="page">Compare</a>
    <a class="nav-drawer__link" href="/changelog/">Changelog</a>
    <a class="btn btn--primary nav-drawer__cta" href={APK_URL} rel="noopener noreferrer">Get Pulse Notes ↓ {APK_SIZE}</a>
  </div>

  <script is:inline>
    (() => {
      const nav = document.getElementById('topnav');
      const burger = document.getElementById('nav-burger');
      const drawer = document.getElementById('nav-drawer');
      if (!nav) return;
      let scrolled = false;
      const setScrolled = (v) => {
        if (v === scrolled) return;
        scrolled = v;
        nav.classList.toggle('is-scrolled', v);
      };
      const onScroll = () => setScrolled(window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      if (burger && drawer) {
        const setOpen = (open) => {
          burger.setAttribute('aria-expanded', String(open));
          drawer.setAttribute('aria-hidden', String(!open));
          drawer.classList.toggle('is-open', open);
          document.body.style.overflow = open ? 'hidden' : '';
        };
        burger.addEventListener('click', () => {
          const isOpen = drawer.classList.contains('is-open');
          setOpen(!isOpen);
        });
        drawer.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => setOpen(false));
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
            setOpen(false);
            burger.focus();
          }
        });
        const mq = window.matchMedia('(min-width: 768px)');
        mq.addEventListener?.('change', (e) => {
          if (e.matches && drawer.classList.contains('is-open')) setOpen(false);
        });
      }
      document.body.classList.add('has-nav');
    })();
  </script>

  {/* FAQ JSON-LD — Google Rich Results validation */}
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <main id="main">
    {/* ─── Hero ─────────────────────────────────────────── */}
    <section class="compare-hero">
      <div class="bg-glow"></div>
      <div class="container compare-hero__grid">
        <div class="compare-hero__copy reveal">
          <span class="eyebrow">Compare</span>
          <h1 class="compare-hero__title">
            Local-first AI that respects your time and privacy.
          </h1>
          <p class="compare-hero__sub">
            Pulse is a voice-first AI side panel for Windows and a markdown
            notes app for Android. Both run on-device. Both are Apache 2.0.
            This page is the honest side-by-side: how Pulse stacks up
            against Raycast AI, Notion AI, AnythingLLM, LM Studio, and bare
            Ollama. No asterisks, no marketing copy.
          </p>
          <div class="compare-hero__ctas">
            <a class="btn btn--primary btn--lg" href={APK_URL} rel="noopener noreferrer">
              Get Pulse Notes ↓ {APK_SIZE}
            </a>
            <a class="btn btn--ghost btn--lg" href="#matrix">See the matrix</a>
          </div>
          <p class="compare-hero__meta">
            Updated <time datetime="2026-08-01">2026-08-01</time> · 6 products · 10 features · 0 affiliate links
          </p>
        </div>
      </div>
    </section>

    {/* ─── Comparison matrix ─────────────────────────────── */}
    <section class="matrix" id="matrix">
      <div class="container">
        <header class="matrix__head reveal">
          <span class="eyebrow">The matrix</span>
          <h2>Pulse vs five alternatives. The numbers are real.</h2>
          <p class="lede">
            Same ten questions, six products, no asterisks. Yellow dots
            mean partial. Hover on a column header on desktop to see
            the full product name. The table collapses to cards on phones.
          </p>
        </header>
        <CompareTable products={products} rows={rows} />
        <p class="matrix__src">
          Source: each product's own site and pricing page as of
          <time datetime="2026-08-01">2026-08-01</time>. Prices in USD. "RAM for 7B model" is the typical
          Q4 / Q5 GGUF run at Q4 quant on a 16 GB machine.
        </p>
      </div>
    </section>

    {/* ─── Honest verdicts ──────────────────────────────── */}
    <section class="verdicts">
      <div class="container">
        <header class="verdicts__head reveal">
          <span class="eyebrow">Honest verdicts</span>
          <h2>What each alternative is actually good at.</h2>
          <p class="lede">
            The other tools on this list solve real problems. Pulse is not
            the answer to every question. Here is what each one is, in
            one paragraph, without the spin.
          </p>
        </header>
        <div class="verdicts__grid">
          {verdicts.map((v) => (
            <article class="verdict glass reveal">
              <h3 class="verdict__name">{v.name}</h3>
              <p class="verdict__body">{v.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ─── Why Pulse ─────────────────────────────────────── */}
    <section class="why" id="why">
      <div class="container">
        <header class="why__head reveal">
          <span class="eyebrow">Why Pulse</span>
          <h2>Four reasons. No roadmap.</h2>
          <p class="lede">
            Pulse is not a platform. It does one thing well: runs an AI on
            your device, and keeps your notes on your device. The list
            below is what Pulse actually does in v0.6.6, not what it might
            do someday.
          </p>
        </header>
        <div class="why__grid">
          {whyCards.map((c) => (
            <article class="why__card glass reveal">
              <span class="why__card-label">{c.label}</span>
              <h3 class="why__card-title">{c.title}</h3>
              <p class="why__card-body">{c.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ─── When NOT Pulse ────────────────────────────────── */}
    <section class="whennot">
      <div class="container">
        <header class="whennot__head reveal">
          <span class="eyebrow">When not Pulse</span>
          <h2>If any of these is you, the other tool is the better fit.</h2>
          <p class="lede">
            This page would be lying if it said Pulse is for everyone. It
            is not. The honest list of when to pick a different tool is
            below. No upsell, no "but try it anyway."
          </p>
        </header>
        <ul class="whennot__list" role="list">
          {whenNot.map((w) => (
            <li class="whennot__item reveal">
              <svg class="whennot__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="6" y1="6" x2="18" y2="18"></line>
                <line x1="18" y1="6" x2="6" y2="18"></line>
              </svg>
              <p class="whennot__text">{w}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ─── FAQ ───────────────────────────────────────────── */}
    <section class="faq" id="faq">
      <div class="container">
        <header class="faq__head reveal">
          <span class="eyebrow">FAQ</span>
          <h2>Eight things people ask before they switch.</h2>
        </header>
        <div class="faq__list">
          {faqs.map((f, i) => (
            <details class="faq__item reveal" open={i === 0}>
              <summary class="faq__q">
                <span class="faq__q-text">{f.q}</span>
                <svg class="faq__chev" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </summary>
              <p class="faq__a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* ─── Final CTA ─────────────────────────────────────── */}
    <section class="cta-final">
      <div class="container">
        <div class="cta-final__card glass reveal">
          <h2 class="cta-final__title">Try Pulse. Both surfaces. Apache 2.0.</h2>
          <p class="cta-final__sub">
            Pulse Notes for Android is a 4.39&nbsp;MB APK, no Play Store, side-load from the link below. Pulse Desktop for Windows is a 12&nbsp;MB Tauri 2 binary, also from this site. Both are open source, both work offline, both are the same Apache 2.0 source tree.
          </p>
          <div class="cta-final__ctas">
            <a class="btn btn--primary btn--lg" href={APK_URL} rel="noopener noreferrer">
              Get Pulse Notes for Android ↓ {APK_SIZE}
            </a>
            <a class="btn btn--ghost btn--lg" href="/notes/">Read the Notes page</a>
          </div>
          <p class="cta-final__meta">
            <a href="/license/">Apache 2.0</a> licensed · <a href="/privacy/">No telemetry, no accounts</a> · <a href="/changelog/">Read the changelog</a>
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer license="Apache 2.0" version="v0.6.6" />
</Base>

<style>
  /* ─── Hero ─────────────────────────────────────────── */
  .compare-hero {
    padding-block: clamp(60px, 8vw, 100px) clamp(40px, 6vw, 80px);
    position: relative;
    overflow: hidden;
  }
  .compare-hero__grid { display: flex; flex-direction: column; gap: 2rem; }
  .compare-hero__copy { max-width: 60ch; }
  .compare-hero__title {
    font-size: var(--fs-1);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.0125em;
    margin-bottom: 1rem;
  }
  .compare-hero__sub {
    font-size: 1.1rem;
    color: var(--fg-dim);
    margin-bottom: 1.75rem;
    max-width: 60ch;
  }
  .compare-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .compare-hero__meta {
    color: var(--muted);
    font-size: 0.85rem;
  }

  /* ─── Matrix ────────────────────────────────────────── */
  .matrix__head { text-align: center; margin-bottom: 2.5rem; }
  .matrix__head .lede { margin: 0.5rem auto 0; }
  .matrix__src {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }

  /* ─── Verdicts ──────────────────────────────────────── */
  .verdicts__head { text-align: center; margin-bottom: 2.5rem; }
  .verdicts__head .lede { margin: 0.5rem auto 0; }
  .verdicts__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 700px) { .verdicts__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .verdicts__grid { grid-template-columns: 1fr 1fr 1fr; } }
  .verdict { padding: 1.5rem; }
  .verdict__name {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--purple);
    margin-bottom: 0.5rem;
  }
  .verdict__body {
    color: var(--fg-dim);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* ─── Why ───────────────────────────────────────────── */
  .why__head { text-align: center; margin-bottom: 2.5rem; }
  .why__head .lede { margin: 0.5rem auto 0; }
  .why__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 700px) { .why__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .why__grid { grid-template-columns: 1fr 1fr 1fr 1fr; } }
  .why__card { padding: 1.5rem; }
  .why__card-label {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--purple);
    margin-bottom: 0.5rem;
  }
  .why__card-title {
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }
  .why__card-body { color: var(--fg-dim); line-height: 1.6; font-size: 0.95rem; }

  /* ─── When NOT Pulse ───────────────────────────────── */
  .whennot__head { text-align: center; margin-bottom: 2.5rem; }
  .whennot__head .lede { margin: 0.5rem auto 0; }
  .whennot__list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    max-width: 800px;
