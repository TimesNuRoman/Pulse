---
// SPDX-License-Identifier: Apache-2.0
/**
 * R134 + R239: /changelog/ page тАФ release history, sourced from the
 * `releases` SSOT in `public/updates/{desktop,android}.json`.
 *
 * R239 replaced the inline 7-entry `releases` array (R134) with a
 * call to `getReleasesByChannel(...)` for both channels, sorted
 * newest-first by date. Major versions render as cards (border +
 * padding); minor versions render as compact bullet lists. Data is
 * read at build time (Astro / Vite's static JSON import) so the
 * page works offline.
 *
 * The cross-platform 'all' platform that R134 used is gone тАФ entries
 * now belong to exactly one channel. The 0.6.6 cross-platform entry
 * lives in the `releases.android` array (it's a notes-app release,
 * not a desktop build). 0.6.4 / 0.6.3 / 0.6.0 historical entries
 * are pending migration in a follow-up round; see the report OQ
 * section.
 *
 * Hard rules: no emoji, no "we / I / by Roman / Pulse team", no marketing
 * fluff, dark-only, present-tense only (no "soon" / "v0.7" promises).
 */
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { getReleasesByChannel, type ReleaseEntry } from '../data/releases';
import '../styles/notes.css';

// R239: merge both channels, sort newest-first. The .slice() before
// sort is defensive тАФ the source arrays from getReleasesByChannel
// are the SSOT's readonly views, and we don't want to mutate them.
const allReleases: readonly ReleaseEntry[] = [
  ...getReleasesByChannel('desktop'),
  ...getReleasesByChannel('android'),
].slice().sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));

const channelLabel: Record<ReleaseEntry['channel'], string> = {
  desktop: 'Windows',
  android: 'Android',
};

const latestVersion: string = allReleases[0]?.version ?? '0.6.0';

const intro =
  'Releases are tagged by date. Major features get a card, small fixes get a bullet. ' +
  'Dates are local (Asia/Bangkok). The full list of versions is sourced from /updates/desktop.json and /updates/android.json.';
---

<Base
  title="Pulse changelog тАФ release history"
  description="Pulse release notes. Windows, Android, and the local AI side panel."
  ogImage="/og-image.svg"
  ctaVisible={false}
  footerLicense=""
  footerVersion={`v${latestVersion}`}
  canonical="https://ownlocalml.com/changelog/"
>
  <a class="skip-link" href="#main">Skip to content</a>

  <nav class="nav" id="topnav" aria-label="Primary">
    <div class="nav__inner">
      <a class="nav__brand" href="/" aria-label="Pulse тАФ home">
        <svg class="pulse-logo" viewBox="0 0 64 64" width="28" height="28" role="img" aria-label="Pulse">
          <circle class="pulse-logo__ring" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle class="pulse-logo__ring pulse-logo__ring--2" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle class="pulse-logo__ring pulse-logo__ring--3" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle cx="32" cy="32" r="9" fill="#bb9af7"></circle>
          <circle cx="35" cy="30" r="2" fill="#1a1b26"></circle>
        </svg>
        <span class="nav__brand-name">Pulse</span>
      </a>
      <ul class="nav__links" role="list">
        <li><a class="nav__link" href="/#features">Features</a></li>
        <li><a class="nav__link" href="/notes/">Notes</a></li>
        <li><a class="nav__link" href="/#download">Download</a></li>
        <li><a class="nav__link" href="/compare/">Compare</a></li>
        <li><a class="nav__link is-cta" href="/changelog/" aria-current="page">Changelog</a></li>
      </ul>
      <div class="nav__right">
        <a class="btn btn--primary nav__cta" href="/#download">Start trial тЖУ 12.29 MB</a>
        <button class="nav__burger" id="nav-burger" type="button" aria-expanded="false" aria-controls="nav-drawer" aria-label="Open menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="20" y2="17"></line>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <div class="nav-drawer" id="nav-drawer" aria-hidden="true">
    <a class="nav-drawer__link" href="/#features">Features</a>
    <a class="nav-drawer__link" href="/notes/">Notes</a>
    <a class="nav-drawer__link" href="/#download">Download</a>
    <a class="nav-drawer__link" href="/compare/">Compare</a>
    <a class="nav-drawer__link" href="/changelog/" aria-current="page">Changelog</a>
    <a class="btn btn--primary nav-drawer__cta" href="/#download">Start trial тЖУ 12.29 MB</a>
  </div>

  <script is:inline>
    (() => {
      const nav = document.getElementById('topnav');
      const burger = document.getElementById('nav-burger');
      const drawer = document.getElementById('nav-drawer');
      if (!nav) return;

      let scrolled = false;
      const setScrolled = (v) => {
        if (v === scrolled) return;
        scrolled = v;
        nav.classList.toggle('is-scrolled', v);
      };
      const onScroll = () => setScrolled(window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      if (burger && drawer) {
        const setOpen = (open) => {
          burger.setAttribute('aria-expanded', String(open));
          drawer.setAttribute('aria-hidden', String(!open));
          drawer.classList.toggle('is-open', open);
          document.body.style.overflow = open ? 'hidden' : '';
        };
        burger.addEventListener('click', () => {
          const isOpen = drawer.classList.contains('is-open');
          setOpen(!isOpen);
        });
        drawer.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => setOpen(false));
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && drawer.classList.contains('is-open')) setOpen(false);
        });
        const mq = window.matchMedia('(min-width: 768px)');
        mq.addEventListener?.('change', (e) => {
          if (e.matches && drawer.classList.contains('is-open')) setOpen(false);
        });
      }
      document.body.classList.add('has-nav');
    })();
  </script>

  <main id="main" class="notes-main">
    <section class="notes-hero">
      <div class="bg-glow"></div>
      <div class="container notes-hero__grid">
        <div class="notes-hero__copy reveal">
          <div class="notes-hero__badges">
            <span class="notes-hero__eyebrow">Pulse ┬╖ Changelog</span>
            <span class="notes-hero__pill" aria-label="Latest version">
              <span class="notes-hero__pill-dot" aria-hidden="true"></span>
              Latest v{latestVersion}
            </span>
          </div>
          <h1 class="notes-hero__title">What changed.</h1>
          <p class="notes-hero__sub">{intro}</p>
        </div>
      </div>
    </section>

    <section class="changelog" id="changelog-list" aria-label="Release history">
      <div class="container">
        <ol class="changelog__list" role="list">
          {allReleases.map((r) => (
            <li
              class:list={[
                'changelog__item',
                'reveal',
                r.type === 'major' ? 'changelog__item--major' : 'changelog__item--minor',
              ]}
              id={`v${r.version}`}
            >
              <time class="changelog__date" datetime={r.date}>{r.date}</time>
              <div class="changelog__body">
                <h2 class="changelog__title">
                  <span class:list={['changelog__type', `changelog__type--${r.type}`]}>
                    {r.type}
                  </span>
                  {' '}v{r.version}
                  <span class="changelog__platform" aria-label={`Platform: ${channelLabel[r.channel]}`}>
                    ┬╖ {channelLabel[r.channel]}
                  </span>
                </h2>
                <p class="changelog__lede">{r.title}</p>
                <ul class="changelog__bullets" role="list">
                  {r.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </div>
            </li>
          ))}
        </ol>

        <p class="changelog__back">
          <a class="btn btn--ghost" href="/" rel="noopener">Back to home</a>
        </p>
      </div>
    </section>
  </main>

  <Footer license="" version={`v${latestVersion}`} />
</Base>

<style>
  .changelog__type {
    display: inline-block;
    padding: 0.1rem 0.5rem;
    margin-right: 0.4rem;
    border-radius: 4px;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    vertical-align: 0.12em;
    border: 1px solid;
  }
  .changelog__type--major { color: var(--purple); border-color: var(--purple); background: rgba(187, 154, 247, 0.08); }
  .changelog__type--minor { color: var(--blue);   border-color: var(--blue);   background: rgba(122, 162, 247, 0.08); }

  .changelog__platform {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .changelog__lede {
    color: var(--fg);
    font-size: 1.05rem;
    font-weight: 500;
    margin: 0.35rem 0 0.6rem;
    line-height: 1.4;
  }

  .changelog__bullets {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .changelog__bullets li {
    color: var(--fg-dim);
    font-size: 0.92rem;
    line-height: 1.55;
    padding-left: 1.1rem;
    position: relative;
  }
  .changelog__bullets li::before {
    content: "тАФ";
    position: absolute;
    left: 0;
    color: var(--muted);
  }

  /* Major releases render as a card (border + padding) per the R134 brief. */
  .changelog__item--major .changelog__body {
    border: 1px solid var(--border);
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg-soft) 100%);
    border-radius: var(--radius, 12px);
    padding: 1.25rem 1.5rem;
  }

  /* Minor releases stay compact тАФ no card chrome. */
  .changelog__item--minor .changelog__body {
    padding: 0.85rem 0 0.5rem;
  }

  .changelog__back {
    margin: 2.5rem 0 1rem;
    text-align: center;
  }
</style>

