---
// R257: /changelog page — release notes with sticky filter bar +
// subscribe form + featured post + month separators. Renders the
// content collection defined in `src/content/config.ts`.
//
// All data is file-based (`src/content/changelog/*.md`); the page
// is fully static and cacheable at the edge.
import Base from '../layouts/Base.astro';
import ChangelogPost from '../components/ChangelogPost.astro';
import FilterBar from '../components/FilterBar.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { getCollection } from 'astro:content';

const PAGE_TITLE = 'Pulse changelog — every release, big and small';
const PAGE_DESC  = 'Every Pulse release, big and small. Subscribe to get notified when we ship — about once a month.';

// Sort all entries newest-first.
const all = (await getCollection('changelog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Featured = first `featured: true` entry, otherwise the most recent.
const featuredIdx = all.findIndex((e) => e.data.featured);
const featured = featuredIdx >= 0 ? all.splice(featuredIdx, 1)[0] : all.shift();
const rest = all;

// Group rest by year-month (Aug 2026, Jul 2026, ...).
const groups: { key: string; label: string; entries: typeof rest }[] = [];
for (const e of rest) {
  const d = e.data.date;
  const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  const label = d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
  let g = groups[groups.length - 1];
  if (!g || g.key !== key) {
    g = { key, label, entries: [] };
    groups.push(g);
  }
  g.entries.push(e);
}

// Filter counts.
const counts: Record<string, number> = { all: 0, windows: 0, android: 0, web: 0, pro: 0 };
const allPosts = featured ? [featured, ...rest] : rest;
for (const e of allPosts) {
  counts.all++;
  for (const p of e.data.platforms) counts[p]++;
}
---
<Base
  title={PAGE_TITLE}
  description={PAGE_DESC}
  ogImage="/og-image.svg"
  ctaVisible={false}
  footerLicense=""
  footerVersion={`v${featured?.data.version ?? rest[0]?.data.version ?? '0.0.0'}`}
  canonical="https://ownlocalml.com/changelog/"
>
  <a class="skip-link" href="#feed">Skip to feed</a>

  <main class="page" id="main">
    <section class="hero">
      <span class="eyebrow">Changelog</span>
      <h1>What's new in Pulse</h1>
      <p class="lede">Every release, big and small. We post here when we ship — and only when we ship.</p>

      <SubscribeForm />
    </section>

    <FilterBar counts={counts} />

    <div class="feed" id="feed">
      {featured && (
        <ChangelogPost post={featured} featured body={featured.body} />
      )}

      {groups.map((g) => (
        <>
          <div class="month" data-month={g.key}>
            <span class="month__name">{g.label}</span>
            <span class="month__count">{g.entries.length} release{g.entries.length === 1 ? '' : 's'}</span>
          </div>
          {g.entries.map((e) => (
            <ChangelogPost post={e} body={e.body} />
          ))}
        </>
      ))}

      <div class="archive">
        <p class="archive__hint">Looking for older releases?</p>
        <a class="archive__btn" href="/changelog/archive/">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
          Browse full archive
        </a>
      </div>
    </div>
  </main>

  <script is:inline>
    (() => {
      const btns   = document.querySelectorAll('.filters__btn');
      const posts  = document.querySelectorAll('.post');
      const months = document.querySelectorAll('.month');

      function apply(filter) {
        // Toggle posts
        posts.forEach((p) => {
          const plats = (p.getAttribute('data-platforms') || '').split(/\s+/).filter(Boolean);
          const match = filter === 'all' || plats.includes(filter);
          p.classList.toggle('is-hidden', !match);
        });
        // Hide months with 0 visible posts
        months.forEach((m) => {
          // The posts that follow this month until the next month-or-end
          let visible = 0;
          let n = m.nextElementSibling;
          while (n && !n.classList.contains('month')) {
            if (n.classList.contains('post') && !n.classList.contains('is-hidden')) visible++;
            n = n.nextElementSibling;
          }
          m.classList.toggle('is-hidden', visible === 0);
        });
      }

      btns.forEach((btn) => {
        btn.addEventListener('click', () => {
          btns.forEach((b) => {
            b.classList.toggle('is-active', b === btn);
            b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
          });
          apply(btn.getAttribute('data-filter'));
        });
      });

      // Deep-link: /changelog#v3-1-0 — scroll the target into view
      const hash = location.hash;
      if (hash && hash.startsWith('#v')) {
        const el = document.getElementById(hash.slice(1));
        if (el) {
          setTimeout(() => el.scrollIntoView({ block: 'start' }), 50);
        }
      }

      // Toast on ?subscribe=ok
      if (location.search.includes('subscribe=ok')) {
        const succ = document.getElementById('subSuccess');
        if (succ) {
          succ.textContent = "✓ You're subscribed.";
          succ.classList.add('is-on');
          setTimeout(() => succ.classList.remove('is-on'), 6000);
        }
      }
    })();
  </script>

  <style is:global>
    /* R257: /changelog scoped styles. Per spec: square edges (radius 0),
     * Tokyo Night palette, dark only, sticky filter, no third-party. */
    .page {
      max-width: 760px;
      margin: 0 auto;
      padding: 0 16px;
    }
    .page .skip-link {
      position: absolute; left: -9999px; top: 0;
    }
    .page .skip-link:focus { left: 8px; top: 8px; z-index: 999; }

    /* Hero */
    .page .hero {
      padding: 56px 0 36px;
      border-bottom: 1px solid var(--border);
    }
    .page .hero .eyebrow {
      display: block;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--text-dim, #565f89);
      margin-bottom: 12px;
      font-weight: 600;
    }
    .page .hero h1 {
      font-size: 36px;
      font-weight: 700;
      letter-spacing: -0.025em;
      margin-bottom: 12px;
      line-height: 1.1;
      color: var(--fg, #c0caf5);
    }
    @media (min-width: 768px) {
      .page .hero h1 { font-size: 44px; }
    }
    .page .lede {
      color: var(--muted, #9aa5ce);
      font-size: 16px;
      margin-bottom: 28px;
      max-width: 56ch;
    }

    /* Subscribe */
    .page .subscribe {
      display: flex; align-items: center; gap: 8px;
      max-width: 460px;
    }
    .page .subscribe__input {
      flex: 1; padding: 11px 14px;
      background: #16171f;
      border: 1px solid var(--border, rgba(255,255,255,0.08));
      color: var(--fg, #c0caf5);
      font: inherit; font-size: 14px;
      outline: 0;
      border-radius: 0;
    }
    .page .subscribe__input:focus { border-color: var(--purple, #bb9af7); }
    .page .subscribe__input::placeholder { color: var(--comment, #565f89); }
    .page .subscribe__btn {
      padding: 0 18px; height: 42px;
      background: var(--purple, #bb9af7);
      color: #1a1b26;
      border: 0; font-size: 13px; font-weight: 600;
      cursor: pointer; flex-shrink: 0;
      border-radius: 0;
    }
    .page .subscribe__btn:hover { background: #c4adf9; }
    .page .subscribe__btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .page .subscribe__meta {
      display: flex; align-items: center; gap: 12px;
      margin-top: 10px; font-size: 12px; color: var(--comment, #565f89);
    }
    .page .subscribe__meta a {
      color: var(--muted, #9aa5ce);
      display: inline-flex; align-items: center; gap: 4px;
      text-decoration: none;
    }
    .page .subscribe__meta a:hover { color: var(--fg, #c0caf5); }
    .page .subscribe__success,
    .page .subscribe__error {
      display: none;
      padding: 10px 14px;
      max-width: 460px;
      margin-top: 12px;
      font-size: 13px;
      border-radius: 0;
    }
    .page .subscribe__success {
      background: rgba(158, 206, 106, 0.1);
      border: 1px solid rgba(158, 206, 106, 0.3);
      color: #9ece6a;
    }
    .page .subscribe__error {
      background: rgba(247, 118, 142, 0.1);
      border: 1px solid rgba(247, 118, 142, 0.3);
      color: #f7768e;
    }
    .page .subscribe__success.is-on,
    .page .subscribe__error.is-on { display: block; }
    .page .vh {
      position: absolute !important; width: 1px; height: 1px;
      padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0);
      white-space: nowrap; border: 0;
    }

    /* Filter bar (sticky) */
    .page .filters {
      position: sticky; top: 12px; z-index: 20;
      margin: 24px 0 0;
      padding: 8px;
      background: rgba(31, 35, 53, 0.85);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid var(--border, rgba(255,255,255,0.08));
      display: flex; align-items: center; gap: 4px;
      overflow-x: auto;
      scrollbar-width: none;
      border-radius: 0;
    }
    .page .filters::-webkit-scrollbar { display: none; }
    .page .filters__btn {
      padding: 8px 14px;
      background: transparent; color: var(--muted, #9aa5ce);
      border: 0; font-size: 13px; font-weight: 500;
      cursor: pointer; white-space: nowrap;
      transition: color 0.15s, background 0.15s;
      border-radius: 0;
    }
    .page .filters__btn:hover { color: var(--fg, #c0caf5); }
    .page .filters__btn.is-active {
      background: #24283b; color: var(--fg, #c0caf5);
    }
    .page .filters__count {
      margin-left: 4px; padding: 1px 6px;
      background: #24283b; color: var(--comment, #565f89);
      font-size: 11px; font-weight: 600;
      border-radius: 0;
    }
    .page .filters__btn.is-active .filters__count {
      background: #2a2f45; color: var(--muted, #9aa5ce);
    }

    /* Feed */
    .page .feed { padding: 32px 0 0; }

    /* Month separator */
    .page .month {
      display: flex; align-items: baseline; gap: 12px;
      margin: 32px 0 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border, rgba(255,255,255,0.08));
    }
    .page .month:first-child { margin-top: 0; }
    .page .month__name {
      font-size: 14px; font-weight: 600; color: var(--fg, #c0caf5);
      text-transform: uppercase; letter-spacing: 0.08em;
    }
    .page .month__count { font-size: 12px; color: var(--comment, #565f89); }

    /* Post */
    .page .post {
      padding: 20px 0;
      border-bottom: 1px solid var(--border, rgba(255,255,255,0.08));
    }
    .page .post:last-of-type { border-bottom: 0; }
    .page .post__meta {
      display: flex; align-items: center; gap: 10px;
      font-size: 12px; color: var(--comment, #565f89);
      margin-bottom: 6px;
    }
    .page .post__version {
      font-family: ui-monospace, SFMono-Regular, "JetBrains Mono", monospace;
      color: var(--purple, #bb9af7);
      font-weight: 600;
      padding: 1px 6px;
      background: rgba(187, 154, 247, 0.1);
      border: 1px solid rgba(187, 154, 247, 0.2);
      border-radius: 0;
    }
    .page .post__date { color: var(--muted, #9aa5ce); }
    .page .post__platforms {
      display: inline-flex; gap: 4px; margin-left: auto;
    }
    .page .post__platform {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 2px 6px;
      background: #1f2335; color: var(--comment, #565f89);
      font-size: 11px; font-weight: 500;
      border: 1px solid var(--border, rgba(255,255,255,0.08));
      border-radius: 0;
    }
    .page .post__title {
      font-size: 18px; font-weight: 600;
      letter-spacing: -0.01em; margin: 0 0 4px;
      color: var(--fg, #c0caf5);
    }
    .page .post__summary {
      color: var(--muted, #9aa5ce);
      font-size: 14px; margin: 0 0 12px;
    }

    /* Change groups */
    .page .changes {
      display: flex; flex-direction: column; gap: 10px;
    }
    .page .change-group {
      display: flex; gap: 12px; align-items: flex-start;
    }
    .page .change-group__label {
      flex-shrink: 0;
      display: inline-flex; align-items: center; gap: 4px;
      width: 86px; padding-top: 1px;
      font-size: 11px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .page .change-group__label--new      { color: #9ece6a; }
    .page .change-group__label--improved { color: #7aa2f7; }
    .page .change-group__label--fixed     { color: #e0af68; }
    .page .change-group__label--security  { color: #f7768e; }
    .page .change-group__items {
      flex: 1; display: flex; flex-direction: column; gap: 4px;
      margin: 0; padding: 0; list-style: none;
    }
    .page .change-item {
      display: flex; align-items: flex-start; gap: 8px;
      font-size: 14px; color: var(--fg, #c0caf5);
      line-height: 1.55;
    }
    .page .change-item::before {
      content: ""; width: 4px; height: 4px;
      background: var(--comment, #565f89);
      flex-shrink: 0; margin-top: 9px;
    }
    .page .change-item b { color: var(--fg, #c0caf5); font-weight: 600; }
    .page .change-item code {
      font-family: ui-monospace, SFMono-Regular, "JetBrains Mono", monospace;
      font-size: 0.9em;
      color: #7dcfff;
      background: #1f2335;
      padding: 0.1em 0.4em;
      border-radius: 0;
    }

    /* Featured */
    .page .post--featured {
      padding: 24px;
      margin: 0 0 24px;
      background: #1f2335;
      border: 1px solid var(--border, rgba(255,255,255,0.08));
    }
    .page .post--featured .post__title { font-size: 22px; }

    /* Filter visibility */
    .page .post.is-hidden { display: none; }
    .page .month.is-hidden { display: none; }

    /* Archive footer */
    .page .archive {
      margin-top: 48px; padding: 24px 0;
      text-align: center;
      border-top: 1px solid var(--border, rgba(255,255,255,0.08));
    }
    .page .archive__hint {
      font-size: 14px; color: var(--muted, #9aa5ce);
      margin: 0 0 12px;
    }
    .page .archive__btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 10px 18px;
      background: transparent; color: var(--muted, #9aa5ce);
      border: 1px solid var(--border, rgba(255,255,255,0.08));
      font-size: 13px; font-weight: 500;
      cursor: pointer; text-decoration: none;
      border-radius: 0;
    }
    .page .archive__btn:hover {
      color: var(--fg, #c0caf5);
      border-color: var(--comment, #565f89);
    }

    /* Mobile */
    @media (max-width: 480px) {
      .page .hero { padding: 40px 0 28px; }
      .page .hero h1 { font-size: 30px; }
      .page .post--featured { padding: 18px; }
      .page .post--featured .post__title { font-size: 18px; }
      .page .change-group { flex-direction: column; gap: 4px; }
      .page .change-group__label { width: auto; }
    }
  </style>
</Base>
