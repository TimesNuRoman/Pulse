  <!-- R128 SEO polish: one SoftwareApplication per platform so search
       engines can surface each installer / APK independently. -->
  <script type="application/ld+json" set:html={JSON.stringify(softwareAppsJsonLd)} />

  <!-- R247c: Tab switching + smart CTA that mirrors the active tab.
       WAI-ARIA tabs pattern. Click or arrow keys to switch panels.
       UA-based default tab (mobile → Android, macOS → macOS, Linux →
       Linux, else Windows). The hero CTA label / href / size swaps
       in place to follow the active tab — the smart download is no
       longer a separate "magic CTA" that diverges from the panel you
       just opened. -->
  <script is:inline define:vars={{ WIN_EXE_PATH: WIN_EXE, APK_PATH: APK_URL, WIN_SIZE: WIN_SIZE_EXE, APK_SIZE: APK_SIZE }}>
    (() => {
      var GITHUB = 'https://github.com/TimesNuRoman/pulse';

      // Per-platform CTA copy. Server-rendered default is Windows;
      // selectTab() rewrites the button on every switch.
      var VARIANTS = {
        windows: {
          filename: 'Download Pulse for Windows',
          size:     '\u00b7 ' + WIN_SIZE,
          href:     WIN_EXE_PATH,
          btnClass: 'btn--primary',
          download: true
        },
        android: {
          filename: 'Download Pulse for Android',
          size:     '\u00b7 ' + APK_SIZE,
          href:     APK_PATH,
          btnClass: 'btn--primary',
          download: true
        },
        macos: {
          filename: 'Build Pulse for macOS from source',
          size:     '',
          href:     '/install/macos/',
          btnClass: 'btn--primary',
          download: false
        },
        linux: {
          filename: 'Build Pulse for Linux from source',
          size:     '',
          href:     '/install/linux/',
          btnClass: 'btn--primary',
          download: false
        },
        ios: {
          filename: 'Download Android APK',
          size:     '\u00b7 ' + APK_SIZE,
          href:     APK_PATH,
          btnClass: 'btn--primary',
          download: true
        }
      };

      var cta   = document.querySelector('.dl-hero-compact__cta');
      var btnEl = cta && cta.querySelector('[data-smart-href]');
      var fnEl  = cta && cta.querySelector('[data-smart-filename]');
      var szEl  = cta && cta.querySelector('[data-smart-size]');

      var applyVariant = function (v) {
        if (!cta) return;
        var data = VARIANTS[v];
        if (!data) return;
        cta.setAttribute('data-smart-platform', v);
        if (btnEl) {
          btnEl.setAttribute('href', data.href);
          btnEl.classList.remove('btn--primary', 'btn--ghost');
          btnEl.classList.add(data.btnClass);
          if (data.download) btnEl.setAttribute('download', '');
          else btnEl.removeAttribute('download');
        }
        if (fnEl) fnEl.textContent = data.filename;
        if (szEl) szEl.textContent = data.size;
      };

      // ─── Tab switching ─────────────────────────────────────
      var tabs   = Array.from(document.querySelectorAll('[role="tab"][data-tab]'));
      var panels = Array.from(document.querySelectorAll('[role="tabpanel"][data-panel]'));
      if (tabs.length === 0 || panels.length === 0) return;

      var selectTab = function (tab) {
        if (!tab) return;
        tabs.forEach(function (t) {
          var selected = t === tab;
          t.setAttribute('aria-selected', String(selected));
          t.setAttribute('tabindex', selected ? '0' : '-1');
        });
        panels.forEach(function (p) {
          var show = p.getAttribute('data-panel') === tab.getAttribute('data-tab');
          if (show) p.removeAttribute('hidden');
          else p.setAttribute('hidden', '');
        });
        // Sync the hero CTA to the active tab. No separate UA
        // detection — the CTA is just a shortcut for the active
        // panel's primary action.
        applyVariant(tab.getAttribute('data-tab'));
      };

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          selectTab(tab);
          tab.focus();
        });
        tab.addEventListener('keydown', function (e) {
          var i = tabs.indexOf(tab);
          var next = -1;
          if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
          else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
          else if (e.key === 'Home') next = 0;
          else if (e.key === 'End') next = tabs.length - 1;
          if (next >= 0) {
            e.preventDefault();
            selectTab(tabs[next]);
            tabs[next].focus();
          }
        });
      });

      // UA-based default tab.
      var ua = (navigator.userAgent || '');
      var isAndroid = /android|mobile/i.test(ua);
      var isIOS     = /\b(iPhone|iPad|iPod)\b/i.test(ua);
      var isMac     = /\b(Mac OS X|Macintosh)\b/i.test(ua) && !isIOS;
      var isLinux   = /\bLinux|X11\b/i.test(ua) && !isAndroid;
      var defaultTab = 'windows';
      if (isAndroid) defaultTab = 'android';
      else if (isMac) defaultTab = 'macos';
      else if (isLinux) defaultTab = 'linux';
      var targetTab = tabs.find(function (t) { return t.getAttribute('data-tab') === defaultTab; }) || tabs[0];
      if (targetTab) selectTab(targetTab);
    })();
  </script>
</Base>

<style>
