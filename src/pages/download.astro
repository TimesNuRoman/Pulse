---
// SPDX-License-Identifier: Apache-2.0
// R250: /download/ hub. Square style. 5 platform tiles + meta row + past releases.
// Per-platform drill-downs live in /download/{windows,android,macos,linux,ios}.astro.
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { PLATFORMS, ICONS, type PlatformId } from '../lib/platforms';
import {
  WINDOWS_VERSION, WINDOWS_NSIS_SIZE,
  ANDROID_VERSION, ANDROID_APK_SIZE,
} from '../lib/versions';

const DESKTOP_VERSION = WINDOWS_VERSION;
const APK_SIZE = ANDROID_APK_SIZE;

const platformCopy: Record<PlatformId, { title: string; sub: string }> = {
  windows: { title: 'NSIS · MSI · portable',     sub: `${WINDOWS_NSIS_SIZE} · v${DESKTOP_VERSION}` },
  android: { title: 'Signed APK (v2 + v3)',     sub: `${APK_SIZE} · v${ANDROID_VERSION}` },
  macos:   { title: 'Build from source',         sub: '.app · .dmg · arm64 + x86_64' },
  linux:   { title: 'Build from source',         sub: '.deb · .AppImage · x86_64' },
  ios:     { title: 'App Store policy',          sub: 'Android APK is the tablet fallback' },
};

const pastReleases = [
  { name: 'Pulse v0.6.9', sub: 'Windows · Android · source', size: '12.30 MB' },
  { name: 'Pulse v0.6.7', sub: 'Windows · Android · source', size: '12.27 MB' },
  { name: 'Pulse v0.6.5', sub: 'Windows · Android · source', size: '11.94 MB' },
  { name: 'Pulse v0.6.4', sub: 'Windows · Android · source', size: '11.80 MB' },
];
---
<Base
  title="Download Pulse — for Windows, macOS, Linux, Android"
  description="Pulse runs on the device you already use. Signed installers for Windows and Android, source builds for macOS and Linux, no App Store for iOS — the Android APK is the tablet fallback."
  ctaText={`Start trial for Android ↓ ${APK_SIZE}`}
  ctaHref="/downloads/pulse-notes-0.6.9.apk"
  ctaVisible={true}
  footerLicense=""
  footerVersion={`v${ANDROID_VERSION} / v${DESKTOP_VERSION}`}
  canonical="https://ownlocalml.com/download/"
>
  <a class="skip-link" href="#main">Skip to content</a>
  <main id="main" class="notes-main">
    <!-- ─── Hero ────────────────────────────────────── -->
    <section class="dl-section dl-section--bg">
      <div class="dl-section__inner">
        <span class="eyebrow">Download</span>
        <h1>One app. <span class="hl">Five platforms.</span></h1>
        <p class="lede">Pulse runs on the device you already use. Signed installers for Windows and Android, source builds for macOS and Linux, no App Store for iOS — the Android APK is the tablet fallback.</p>
        <div class="dl-meta-row">
          <span class="dl-meta-chip"><b>v{DESKTOP_VERSION}</b> · latest</span>
          <span class="dl-meta-chip"><b>{WINDOWS_NSIS_SIZE}</b> · Windows</span>
          <span class="dl-meta-chip"><b>{APK_SIZE}</b> · Android</span>
          <span class="dl-meta-chip dl-meta-chip--ok">Apache 2.0</span>
        </div>
      </div>
    </section>

    <!-- ─── Choose your platform ────────────────────── -->
    <section class="dl-section dl-section--sur">
      <div class="dl-section__inner">
        <span class="eyebrow">Choose your platform</span>
        <h2>Pick where Pulse will live.</h2>
        <div class="dl-tiles">
          {PLATFORMS.map((p) => (
            <a class="dl-tile" href={p.href}>
              <div class="dl-tile__top">
                <span class="dl-tile__name">{p.label}</span>
                <span class="dl-tile__icon" aria-hidden="true">
                  <Fragment set:html={ICONS.platform[p.id]} />
                </span>
              </div>
              <span class:list={['dl-tile__status', `dl-tile__status--${p.status}`]}>
                {p.status === 'ready' ? 'Ready' : p.status === 'source' ? 'Source' : 'Not available'}
              </span>
              <div class="dl-tile__title">{platformCopy[p.id].title}</div>
              <div class="dl-tile__sub">{platformCopy[p.id].sub}</div>
              <span class="dl-tile__cta">
                {p.id === 'ios' ? 'Why no iOS' : `Get for ${p.label}`} →
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── Past releases ──────────────────────────── -->
    <section class="dl-section dl-section--sur2">
      <div class="dl-section__inner">
        <span class="eyebrow">All versions</span>
        <h2>Past releases, in case you need an older build.</h2>
        <ul class="dl-list" role="list">
          {pastReleases.map((r) => (
            <li>
              <span class="dl-list__name">{r.name}</span>
              <span class="dl-list__sub">{r.sub}</span>
              <span class="dl-list__spacer"></span>
              <span class="dl-list__size">{r.size}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <Footer license="" version={`v${ANDROID_VERSION} / v${DESKTOP_VERSION}`} />
</Base>
