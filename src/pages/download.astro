---
// SPDX-License-Identifier: Proprietary
// R253: /download/ — two-step flow (spec).
// Step 1: 5 platform cards (Windows / Android / macOS / Linux / iOS).
// Step 2: per-platform content (primary CTA + 1-2 secondary rows + SHA + setup link).
// macOS / Linux have no signed build → code block instead of primary CTA.
// iOS card disabled; iOS step cross-links to Android. Hash routing.
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import {
  ANDROID_VERSION,
  ANDROID_APK_URL,
  ANDROID_APK_SIZE,
  ANDROID_APK_SHA,
  WINDOWS_VERSION,
  WINDOWS_NSIS_URL,
  WINDOWS_MSI_URL,
  WINDOWS_NSIS_SIZE,
  WINDOWS_MSI_SIZE,
  WINDOWS_NSIS_SHA,
  WINDOWS_MSI_SHA,
} from '../lib/versions';

const APK_URL = ANDROID_APK_URL;
const APK_SIZE = ANDROID_APK_SIZE;
const APK_SHA = ANDROID_APK_SHA;
const WIN_VERSION = WINDOWS_VERSION;
const WIN_EXE = WINDOWS_NSIS_URL;
const WIN_MSI = WINDOWS_MSI_URL;
const WIN_SIZE_EXE = WINDOWS_NSIS_SIZE;
const WIN_SIZE_MSI = WINDOWS_MSI_SIZE;
const WIN_SHA_EXE = WINDOWS_NSIS_SHA;
const WIN_SHA_MSI = WINDOWS_MSI_SHA;

const GITHUB_URL = 'https://github.com/TimesNuRoman/Pulse';

const PAGE_TITLE = 'Download Pulse — for Windows, Android, macOS, Linux, or as source';
const PAGE_DESC =
  'Pick your platform and download Pulse. Windows (NSIS / MSI / portable), Android (universal APK), macOS and Linux (build from source). Local-first, no account, no telemetry.';

const softwareAppsJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Pulse for Windows',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Windows 10, Windows 11',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'A side panel for Windows. System tray, global hotkey, talks to a local model.',
    softwareVersion: WIN_VERSION,
    downloadUrl: `https://ownlocalml.com${WIN_EXE}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Pulse for Android',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Android 7.0+',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'A markdown note editor for Android with [[wikilink]] backlinks, voice input, and full-text search.',
    softwareVersion: ANDROID_VERSION,
    downloadUrl: `https://ownlocalml.com${APK_URL}`,
  },
];
---

<Base
  title={PAGE_TITLE}
  description={PAGE_DESC}
  ogImage="/og-download.png"
  ctaText={`Download APK ↓ ${APK_SIZE}`}
  ctaHref={APK_URL}
  ctaVisible={true}
  footerLicense=""
  footerVersion={`v${ANDROID_VERSION} / v${WIN_VERSION}`}
  canonical="https://ownlocalml.com/download/"
>
  <a class="skip-link" href="#main">Skip to content</a>

  <main id="main" class="dl">
    <!-- Step indicator (always visible on both steps) -->
    <div class="dl__steps container" role="status" aria-label="Download progress">
      <span class="dl__num is-active" id="step-num-1">1</span>
      <span class="dl__dot is-active" id="step-dot-1" aria-hidden="true"></span>
      <span class="dl__sep" aria-hidden="true"></span>
      <span class="dl__num" id="step-num-2">2</span>
      <span class="dl__dot" id="step-dot-2" aria-hidden="true"></span>
    </div>

    <!--
      R256: all .step sections live in a single grid cell.
      Inactive steps are visibility:hidden + opacity:0 + tiny Y offset;
      the active step fades in. The cell sizes to the tallest step,
      so toggling never shifts the page below the indicator.
    -->
    <div class="dl__stack">

    <!-- ═══ STEP 1 ═══ -->
    <section class="step is-active" id="step-1" data-step="1" aria-labelledby="dl-step1-title">
      <div class="container">
        <span class="eyebrow">Download</span>
        <h1 class="dl__h1" id="dl-step1-title">Pick your platform.</h1>
        <p class="dl__sub">One app, five platforms. Pulse runs on the device you already use.</p>

        <div class="dl__grid">
          <button class="plat" type="button" data-platform="windows">
            <span class="plat__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor"><path d="M3 5.5L10.5 4.5v7.5H3v-6.5zM11.5 4.4L21 3v9h-9.5V4.4zM3 13.5h7.5V21L3 19.5v-6zM11.5 13.5H21V21l-9.5-1.5v-6z"/></svg>
            </span>
            <div class="plat__body">
              <div class="plat__name">Windows</div>
              <div class="plat__meta">{WIN_SIZE_EXE} · v{WIN_VERSION}</div>
            </div>
            <span class="plat__arrow">Continue →</span>
          </button>

          <button class="plat" type="button" data-platform="android">
            <span class="plat__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor"><path d="M6 9c-1.1 0-2 .9-2 2v5c0 1.1.9 2 2 2v2c0 .55.45 1 1 1s1-.45 1-1v-2h8v2c0 .55.45 1 1 1s1-.45 1-1v-2c1.1 0 2-.9 2-2v-5c0-1.1-.9-2-2-2H6zM8 11.5c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zM16 11.5c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zM7 8L5.5 5.5C5.4 5.3 5.5 5 5.7 5c.2 0 .3.1.4.2L7.5 7.5C8.6 7.2 9.8 7 11 7h2c1.2 0 2.4.2 3.5.5l1.4-2.3c.1-.1.2-.2.4-.2.2 0 .3.3.2.5L17 8H7z"/></svg>
            </span>
            <div class="plat__body">
              <div class="plat__name">Android</div>
              <div class="plat__meta">{APK_SIZE} · v{ANDROID_VERSION}</div>
            </div>
            <span class="plat__arrow">Continue →</span>
          </button>

          <button class="plat" type="button" data-platform="macos">
            <span class="plat__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor"><path d="M14.5 10.6c0-2.1 1.7-3.1 1.8-3.2-1-1.5-2.5-1.7-3-1.7-1.3-.1-2.5.8-3.2.8-.7 0-1.7-.7-2.8-.7-1.4 0-2.7.8-3.5 2.1-1.5 2.6-.4 6.4 1 8.5.7 1 1.6 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7 1.3 0 1.7.7 2.8.7 1.2 0 1.9-1 2.6-2 .8-1.1 1.2-2.3 1.2-2.3-.1 0-2.4-1-2.4-3.6zM12.4 4.3c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.6.6-1 1.6-.9 2.6 1 0 2-.5 2.5-1.2z"/></svg>
            </span>
            <div class="plat__body">
              <div class="plat__name">macOS</div>
              <div class="plat__meta">Build from source</div>
            </div>
            <span class="plat__arrow">Continue →</span>
          </button>

          <button class="plat" type="button" data-platform="linux">
            <span class="plat__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor"><path d="M12 4c-1.7 0-3 1.4-3 3.2 0 .9.2 1.6.5 2.2-.5.8-1.4 1.7-2.2 2.7-1 1.3-1.8 2.8-1.8 4.2 0 .7.2 1.4.6 2 .4.5 1 .8 1.7.8.5 0 1-.1 1.4-.3.5-.2.9-.5 1.4-.5h2.8c.5 0 .9.3 1.4.5.4.2.9.3 1.4.3.7 0 1.3-.3 1.7-.8.4-.6.6-1.3.6-2 0-1.4-.8-2.9-1.8-4.2-.8-1-1.7-1.9-2.2-2.7.3-.6.5-1.3.5-2.2 0-1.8-1.3-3.2-3-3.2zM10.5 7.7a.7.7 0 110 1.4.7.7 0 010-1.4zm3 0a.7.7 0 110 1.4.7.7 0 010-1.4zM10 10.3a2 2 0 002 2 2 2 0 002-2h-4z"/></svg>
            </span>
            <div class="plat__body">
              <div class="plat__name">Linux</div>
              <div class="plat__meta">Build from source</div>
            </div>
            <span class="plat__arrow">Continue →</span>
          </button>

          <button class="plat plat--disabled" type="button" data-platform="ios" disabled aria-disabled="true">
            <span class="plat__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor"><path d="M14 2.5a2 2 0 00-2 2v.6c-2.4.4-4 2.4-4 4.9v4a2 2 0 01-1 1.7.8.8 0 00.4 1.5h11.2a.8.8 0 00.4-1.5 2 2 0 01-1-1.7v-4c0-2.5-1.6-4.5-4-4.9v-.6a2 2 0 00-2-2zm-1 1.5a.7.7 0 110 1.4.7.7 0 010-1.4zM8 14.5h10v1.3c0 .2 0 .4.1.6H7.9c.1-.2.1-.4.1-.6v-1.3z"/></svg>
            </span>
            <div class="plat__body">
              <div class="plat__name">iOS</div>
              <div class="plat__meta">Not available — see why</div>
            </div>
            <span class="plat__arrow">Read why →</span>
          </button>
        </div>
      </div>
    </section>

    <!-- ═══ STEP 2 — per-platform sections ═══ -->

    <!-- 2A. Windows -->
    <section class="step" id="step-2-windows" data-step="2" aria-labelledby="dl-win-title">
      <div class="container dl-step">
        <button class="dl-step__back" type="button" data-back aria-label="Back to platform picker">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          Choose another platform
        </button>
        <h1 class="dl-step__title" id="dl-win-title">Get Pulse for Windows</h1>
        <p class="dl-step__sub">Pick your installer. NSIS for personal, MSI for managed, portable for no install.</p>

        <a class="dl-btn" href={WIN_EXE} rel="noopener noreferrer" download>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
          Download NSIS installer
          <span class="dl-btn__filename">{WIN_SIZE_EXE}</span>
        </a>

        <div class="dl-secondary">
          <a class="dl-row" href={WIN_MSI} rel="noopener noreferrer" download>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <span class="dl-row__name">MSI installer <span class="dl-row__meta">per-machine · Program Files</span></span>
            <span class="dl-row__size">{WIN_SIZE_MSI}</span>
          </a>
          <a class="dl-row" href={WIN_EXE} rel="noopener noreferrer" download>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span class="dl-row__name">Portable .exe <span class="dl-row__meta">No install · no registry</span></span>
            <span class="dl-row__size">{WIN_SIZE_EXE}</span>
          </a>
        </div>

        <div class="dl-foot">
          <span><code>NSIS SHA-256</code> {WIN_SHA_EXE}</span>
          <a href="/install/windows/">Setup guide →</a>
        </div>
      </div>
    </section>

    <!-- 2B. Android -->
    <section class="step" id="step-2-android" data-step="2" aria-labelledby="dl-and-title">
      <div class="container dl-step">
        <button class="dl-step__back" type="button" data-back aria-label="Back to platform picker">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          Choose another platform
        </button>
        <h1 class="dl-step__title" id="dl-and-title">Get Pulse for Android</h1>
        <p class="dl-step__sub">Universal APK. Sideload on any Android 8.0+ device. No Play Store account required.</p>

        <a class="dl-btn" href={APK_URL} rel="noopener noreferrer" download>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
          Download APK
          <span class="dl-btn__filename">{APK_SIZE}</span>
        </a>

        <div class="dl-foot">
          <span><code>SHA-256</code> {APK_SHA}</span>
          <a href="/install/android/">Setup guide →</a>
        </div>
      </div>
    </section>

    <!-- 2C. macOS — no signed build, build-from-source -->
    <section class="step" id="step-2-macos" data-step="2" aria-labelledby="dl-mac-title">
      <div class="container dl-step">
        <button class="dl-step__back" type="button" data-back aria-label="Back to platform picker">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          Choose another platform
        </button>
        <h1 class="dl-step__title" id="dl-mac-title">Build Pulse for macOS from source</h1>
        <p class="dl-step__sub">No signed <code>.dmg</code> is published — Apple notarization requires a developer account. Build the unsigned <code>.app</code> and <code>.dmg</code> yourself from the same Tauri v2 source that ships on Windows.</p>

        <pre class="code-block" tabindex="0"><code><span class="c"># 1. install Rust + Node 22</span>
<span class="k">curl</span> --proto <span class="s">'=https'</span> --tlsv1.2 -sSf https://sh.rustup.rs | sh
<span class="k">brew install</span> node@22

<span class="c"># 2. clone &amp; install deps</span>
<span class="k">git clone</span> https://github.com/TimesNuRoman/Pulse.git
<span class="k">cd</span> pulse && <span class="k">pnpm install</span>

<span class="c"># 3. build the .app + .dmg</span>
<span class="k">pnpm</span> --filter @pulse/desktop tauri build --bundles app,dmg

<span class="c"># 4. install (Gatekeeper warns on first run; right-click → Open clears it)</span>
<span class="k">cp</span> -R src-tauri/target/release/bundle/macos/Pulse.app /Applications/</code></pre>

        <div class="dl-foot">
          <span>arm64 + x86_64 · macOS 11+</span>
          <a href={GITHUB_URL} rel="noopener noreferrer">View source on GitHub →</a>
        </div>
      </div>
    </section>

    <!-- 2D. Linux — build from source -->
    <section class="step" id="step-2-linux" data-step="2" aria-labelledby="dl-lin-title">
      <div class="container dl-step">
        <button class="dl-step__back" type="button" data-back aria-label="Back to platform picker">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          Choose another platform
        </button>
        <h1 class="dl-step__title" id="dl-lin-title">Build Pulse for Linux from source</h1>
        <p class="dl-step__sub">No prebuilt <code>.deb</code> or <code>.AppImage</code> is published yet. Build the Tauri v2 source against your distro. WebKit2GTK + GTK3 are required.</p>

        <pre class="code-block" tabindex="0"><code><span class="c"># 1. system deps (Debian / Ubuntu — Fedora uses dnf/yum)</span>
<span class="k">sudo apt install</span> -y libwebkit2gtk-4.1-dev build-essential curl wget file libxdo-dev libssl-dev libayatana-appindicator3-dev librsvg2-dev

<span class="c"># 2. install Rust + Node 22</span>
<span class="k">curl</span> --proto <span class="s">'=https'</span> --tlsv1.2 -sSf https://sh.rustup.rs | sh
<span class="k">sudo apt install</span> -y nodejs npm && <span class="k">sudo npm i -g pnpm</span>

<span class="c"># 3. clone &amp; build</span>
<span class="k">git clone</span> https://github.com/TimesNuRoman/Pulse.git
<span class="k">cd</span> pulse && <span class="k">pnpm install</span>
<span class="k">pnpm</span> --filter @pulse/desktop tauri build --bundles deb,appimage</code></pre>

        <div class="dl-foot">
          <span>x86_64 · Debian · Ubuntu · Fedora · Arch</span>
          <a href={GITHUB_URL} rel="noopener noreferrer">View source on GitHub →</a>
        </div>
      </div>
    </section>

    <!-- 2E. iOS — not available, cross-link to Android -->
    <section class="step" id="step-2-ios" data-step="2" aria-labelledby="dl-ios-title">
      <div class="container dl-step">
        <button class="dl-step__back" type="button" data-back aria-label="Back to platform picker">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          Choose another platform
        </button>
        <h1 class="dl-step__title" id="dl-ios-title">Pulse is not on iOS</h1>
        <p class="dl-step__sub">Two structural blockers: App Store policy (no sideloading unsigned builds on iPhone / iPad) and the 4 GB memory cap (Tauri v2 + WebView2 needs more than that on iOS). The Android APK works as a tablet fallback — same data model, same wikilink engine.</p>

        <button class="dl-btn" type="button" data-jump="android">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
          Get the Android APK
          <span class="dl-btn__filename">{APK_SIZE}</span>
        </button>

        <div class="dl-foot">
          <span>Android 8.0+ · sideload · no Play Store</span>
          <a href="/install/android/">Setup guide →</a>
        </div>
      </div>
    </section>

    </div><!-- /.dl__stack -->
  </main>

  <Footer license="" version={`v${ANDROID_VERSION} / v${WIN_VERSION}`} />

  <script type="application/ld+json" set:html={JSON.stringify(softwareAppsJsonLd)} />

  <!--
    R253/R256: Two-step state machine.
    - .plat[data-platform]  → switches to step 2 for that platform
    - [data-back]           → returns to step 1
    - [data-jump]           → cross-link (iOS → Android)
    - hash routing          → /download#windows opens step 2 windows
    - smooth scroll to top on every switch
    - R256: step visibility uses class toggle (is-active), not the
      `hidden` attribute, so opacity + transform transitions in CSS
      can fade between steps instead of an instant snap.
  -->
  <script is:inline>
    (() => {
      const step1   = document.getElementById('step-1');
      const step2s  = document.querySelectorAll('[data-step="2"]');
      const dot1    = document.getElementById('step-dot-1');
      const dot2    = document.getElementById('step-dot-2');
      const num1    = document.getElementById('step-num-1');
      const num2    = document.getElementById('step-num-2');

      const setStepIndicator = (step) => {
        const on2 = step === 2;
        dot1.classList.toggle('is-active', !on2);
        dot2.classList.toggle('is-active',  on2);
        num1.classList.toggle('is-active', !on2);
        num2.classList.toggle('is-active',  on2);
      };

      const showStep1 = () => {
        step1.classList.add('is-active');
        step2s.forEach((s) => s.classList.remove('is-active'));
        setStepIndicator(1);
        if (history.replaceState) history.replaceState(null, '', location.pathname);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      };

      const showStep2 = (platform) => {
        const target = document.getElementById('step-2-' + platform);
        if (!target) return;
        step1.classList.remove('is-active');
        step2s.forEach((s) => s.classList.toggle('is-active', s === target));
        setStepIndicator(2);
        if (history.replaceState) history.replaceState(null, '', '#' + platform);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      };

      document.querySelectorAll('.plat[data-platform]').forEach((b) => {
        b.addEventListener('click', () => {
          if (b.disabled || b.getAttribute('aria-disabled') === 'true') return;
          showStep2(b.dataset.platform);
        });
      });

      document.querySelectorAll('[data-back]').forEach((b) => {
        b.addEventListener('click', showStep1);
      });

      document.querySelectorAll('[data-jump]').forEach((b) => {
        b.addEventListener('click', () => showStep2(b.dataset.jump));
      });

      // Initial: respect /download#<platform>
      const initial = (location.hash || '').replace('#', '');
      if (initial && document.getElementById('step-2-' + initial)) {
        showStep2(initial);
      }
    })();
  </script>

  <style>
    /* ═══ Two-step flow (R253) ═══ */
    .dl { padding-top: clamp(112px, 14vw, 144px); }
    .dl .container { max-width: var(--max-w); }

    /* Step indicator */
    .dl__steps {
      display: flex;
      align-items: center;
      gap: 8px;
      padding-top: 0;
      padding-bottom: 32px;
      font-size: 12px;
      color: var(--text-dim);
    }
    .dl__dot, .dl__num {
      transition: color 200ms var(--ease), background 200ms var(--ease);
    }
    .dl__dot { width: 6px; height: 6px; background: var(--text-dim); }
    .dl__dot.is-active { background: var(--purple); }
    .dl__num { color: var(--text-muted); }
    .dl__num.is-active { color: var(--fg); font-weight: 600; }
    .dl__sep { flex: 1; height: 1px; background: var(--border); }

    /*
     * R256: Stack .step sections so the container collapses to the
     * active step's height. Inactive steps are taken out of the
     * flow (position:absolute) and faded out; the active step is
     * `position:relative` and gives the container its size. Toggling
     * `.is-active` fades between them — page below the indicator
     * doesn't shift, but the steps themselves don't pile on each
     * other.
     */
    .dl__stack {
      position: relative;
    }
    .dl__stack > .step {
      opacity: 0;
      visibility: hidden;
      transform: translateY(6px);
      pointer-events: none;
      position: absolute;
      inset: 0;
      transition:
        opacity 220ms var(--ease),
        transform 220ms var(--ease),
        visibility 0s linear 220ms;
    }
    .dl__stack > .step.is-active {
      opacity: 1;
      visibility: visible;
      transform: none;
      pointer-events: auto;
      position: relative;
      transition:
        opacity 220ms var(--ease),
        transform 220ms var(--ease),
        visibility 0s linear 0s;
    }

    /* Section head shared by both steps */
    .dl__h1 {
