---
// R258: /download/ — single page with hero + 5 platform tabs
// (Windows / Android / macOS / Linux / iOS). Each tab shows the
// download CTA + requirements + verification details. iOS is
// honestly "not available". All copy English, square edges,
// Tokyo Night palette.
//
// R256/R255 prior: this was a two-step hub (5 platform cards →
// per-platform block) with JavaScript show/hide. Replaced with
// radio-button tabs that work without JS.
import Base from '../layouts/Base.astro';
import DownloadTabs from '../components/DownloadTabs.astro';

const PAGE_TITLE = 'Download Pulse — for Windows, Android, macOS, Linux, or as source';
const PAGE_DESC  = 'One app, two surfaces. Pick your platform below — Windows and Android get signed installers, macOS and Linux are community beta, iOS is not available yet.';
---
<Base
  title={PAGE_TITLE}
  description={PAGE_DESC}
  ogImage="/og-download.png"
  ctaVisible={false}
  footerLicense=""
  footerVersion={`v0.6.9`}
  canonical="https://ownlocalml.com/download/"
>
  <a class="skip-link" href="#main">Skip to content</a>

  <main id="main" class="dl">
    <section class="dl__hero container">
      <span class="eyebrow">Download</span>
      <h1 class="dl__h1">Download Pulse</h1>
      <p class="dl__sub">One app, two surfaces. Pick your platform below.</p>
    </section>

    <section class="dl__tabs container" id="dl-tabs-wrap">
      <DownloadTabs />
    </section>
  </main>

  <style is:global>
    /* R258: /download/ page. max-width 720, square edges, tabs work
     * without JS (radio buttons + :checked selectors). */
    .dl { padding-top: clamp(96px, 12vw, 128px); padding-bottom: clamp(60px, 8vw, 96px); }

    /* Hero */
    .dl__hero {
      max-width: 720px;
      margin: 0 auto 32px;
      padding-inline: var(--gutter);
      text-align: left;
    }
    .dl__hero .eyebrow {
      display: inline-block;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--purple);
      margin-bottom: 0.75rem;
    }
    .dl__h1 {
      font-size: clamp(2rem, 5vw + 0.5rem, 3.25rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.1;
      color: var(--fg);
      margin: 0 0 12px;
    }
    .dl__sub {
      color: var(--fg-dim);
      font-size: var(--fs-body);
      line-height: 1.6;
      max-width: 60ch;
      margin: 0;
    }

    /* Tabs container */
    .dl__tabs {
      max-width: 720px;
      margin: 0 auto;
      padding-inline: var(--gutter);
    }

    /* Radio inputs (hidden, only labels visible) */
    .dl-tabs input[type="radio"].dl-tabs__radio {
      position: absolute;
      opacity: 0;
      pointer-events: none;
      width: 0; height: 0;
    }

    /* Tab bar */
    .dl-tabs__bar {
      display: flex;
      gap: 2px;
      border-bottom: 1px solid var(--border);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .dl-tabs__bar::-webkit-scrollbar { display: none; }
    .dl-tabs__label {
      padding: 10px 16px;
      background: transparent;
      color: var(--fg-dim);
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      white-space: nowrap;
      border: 0;
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      transition: color 0.15s, background 0.15s, border-color 0.15s;
    }
    .dl-tabs__label:hover { color: var(--fg); }

    /* Active tab styling per checked radio */
    #t-windows:checked ~ .dl-tabs__bar label[for="t-windows"],
    #t-android:checked ~ .dl-tabs__bar label[for="t-android"],
    #t-macos:checked   ~ .dl-tabs__bar label[for="t-macos"],
    #t-linux:checked   ~ .dl-tabs__bar label[for="t-linux"],
    #t-ios:checked     ~ .dl-tabs__bar label[for="t-ios"] {
      background: var(--surface-2);
      color: var(--fg);
      border-bottom-color: var(--purple);
    }

    /* Tab panels — all hidden by default */
    .dl-tabs__panel { display: none; padding-top: 28px; }
    #t-windows:checked ~ .dl-tabs__panels .dl-tabs__panel[data-for="windows"],
    #t-android:checked ~ .dl-tabs__panels .dl-tabs__panel[data-for="android"],
    #t-macos:checked   ~ .dl-tabs__panels .dl-tabs__panel[data-for="macos"],
    #t-linux:checked   ~ .dl-tabs__panels .dl-tabs__panel[data-for="linux"],
    #t-ios:checked     ~ .dl-tabs__panels .dl-tabs__panel[data-for="ios"] {
      display: block;
    }

    /* Per-panel content */
    .dl-panel__title {
      font-size: clamp(1.5rem, 3vw + 0.5rem, 2rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.15;
      color: var(--fg);
      margin: 0 0 8px;
    }
    .dl-panel__sub {
      color: var(--fg-dim);
      font-size: var(--fs-body);
      line-height: 1.6;
      max-width: 60ch;
      margin: 0 0 24px;
    }

    /* Primary CTA — full-width pill, square edges */
    .dl-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 0 20px;
      height: 52px;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      border: 0;
      border-radius: 0;
      transition: background 0.12s var(--ease);
      margin-bottom: 28px;
    }
    .dl-btn--primary {
      background: var(--purple);
      color: #1a1b26;
    }
    .dl-btn--primary:hover { background: #9d7cd8; }
    .dl-btn--primary:focus-visible { outline: 2px solid var(--purple); outline-offset: 2px; }
    .dl-btn--primary svg { width: 16px; height: 16px; }

    /* Ghost CTA (iOS "Get notified") */
    .dl-btn--ghost {
      background: transparent;
      color: var(--fg);
      border: 1px solid var(--border-strong);
    }
    .dl-btn--ghost:hover {
      background: var(--surface);
      border-color: var(--fg-dim);
      color: var(--fg);
    }

    /* Setup guide link */
    .dl-panel__guide {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--fg-muted);
      font-size: 13px;
      text-decoration: none;
      margin-top: 16px;
      transition: color 0.15s;
    }
    .dl-panel__guide:hover { color: var(--purple); }
    .dl-panel__guide svg { width: 13px; height: 13px; }

    /* Empty state (iOS) */
    .dl-panel__empty {
      padding: 32px 0 8px;
    }
    .dl-panel__empty-title {
      font-size: clamp(1.5rem, 3vw + 0.5rem, 2rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--fg);
      margin: 0 0 8px;
    }
    .dl-panel__empty-body {
      color: var(--fg-dim);
      font-size: var(--fs-body);
      line-height: 1.6;
      max-width: 60ch;
      margin: 0 0 24px;
    }

    /* Requirements */
    .reqs { margin: 28px 0 16px; }
    .reqs__label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--fg-muted);
      margin-bottom: 10px;
    }
    .reqs__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .reqs__row {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 14px;
      color: var(--fg);
      line-height: 1.5;
    }
    .reqs__icon {
      flex-shrink: 0;
      color: var(--green);
      width: 13px;
      height: 13px;
      margin-top: 4px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .reqs__text { flex: 1; }
    .reqs__caveat {
      font-size: 12px;
      color: var(--fg-dim);
      margin: 10px 0 0;
      line-height: 1.5;
    }

    /* Verification disclosure */
    .verify {
      margin-top: 24px;
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: 0;
    }
    .verify__summary {
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      cursor: pointer;
      font-size: 13px;
      color: var(--fg-muted);
      user-select: none;
    }
    .verify__summary::-webkit-details-marker { display: none; }
    .verify__summary:hover { color: var(--fg); }
    .verify[open] .verify__summary {
      border-bottom: 1px solid var(--border);
      color: var(--fg);
    }
    .verify[open] .verify__chev { transform: rotate(180deg); }
    .verify__chev {
      display: inline-block;
      transition: transform 0.2s var(--ease);
      font-size: 11px;
      color: var(--fg-dim);
    }
    .verify__body {
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .verify__row {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 10px;
      font-size: 13px;
    }
    .verify__label {
      flex-shrink: 0;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--fg-muted);
      min-width: 70px;
    }
    .verify__hash {
      font-family: ui-monospace, SFMono-Regular, "JetBrains Mono", monospace;
      font-size: 13px;
      color: var(--cyan);
      background: var(--bg);
      padding: 2px 8px;
      border: 1px solid var(--border);
      border-radius: 0;
    }
    .verify__file {
      font-family: ui-monospace, SFMono-Regular, "JetBrains Mono", monospace;
      font-size: 12px;
      color: var(--fg-dim);
    }
    .verify__verify {
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding-top: 6px;
      border-top: 1px solid var(--border);
    }
    .verify__cmd {
      margin: 0;
      font-family: ui-monospace, SFMono-Regular, "JetBrains Mono", monospace;
      font-size: 12px;
      line-height: 1.5;
      color: var(--fg-muted);
      background: var(--bg);
      padding: 8px 10px;
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      border-radius: 0;
    }
    .verify__cmd code {
      color: var(--cyan);
      font-family: inherit;
      background: transparent;
      padding: 0;
      word-break: break-all;
    }
    .verify__cmd-os {
      font-size: 11px;
      color: var(--fg-dim);
      margin-left: auto;
    }

    @media (max-width: 480px) {
      .dl { padding-top: 80px; }
      .dl__h1 { font-size: 1.875rem; }
      .dl-tabs__label { padding: 10px 12px; font-size: 13px; }
    }
  </style>
</Base>
