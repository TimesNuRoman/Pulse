---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import '../styles/notes.css';
import {
  ANDROID_VERSION,
  ANDROID_VERSION_CODE,
  ANDROID_APP_ID,
  ANDROID_MIN_SDK,
  ANDROID_TARGET_SDK,
  ANDROID_APK_URL,
  ANDROID_APK_SIZE,
  ANDROID_APK_SIZE_BYTES,
  ANDROID_APK_SHA,
  WINDOWS_VERSION,
  WINDOWS_NSIS_URL,
  WINDOWS_MSI_URL,
  WINDOWS_NSIS_SIZE,
  WINDOWS_MSI_SIZE,
  WINDOWS_NSIS_SHA,
  WINDOWS_MSI_SHA,
  WINDOWS_MIN_OS,
  WINDOWS_BUILD_TARGET,
  absoluteAndroidDownloadUrl,
} from '../lib/versions';

// R120 site simplify: download surface for the user-facing site.
// Keeps the platform details (NSIS / MSI, SHA-256, size, min OS) — those
// are required to verify a binary before running it. Strips round
// numbers and implementation jargon.
//
// R234: every version string + URL + size + SHA is now sourced from
// `src/lib/versions.ts` (the SSOT). The next version bump is a 1-line
// edit to public/updates/{desktop,android}.json, not a search-replace
// marathon across this file.
//
// R247c: Steam-pattern layout. Replaces the R184 "smart CTA in a big
// glass card + <details> wrapping the rest" pattern with a compact
// hero + visible tab strip + one tabpanel per platform. The 5
// platform cards (Windows, Android, macOS, Linux, iOS) are now
// always-visible tabs (click to switch) instead of a stack behind a
// "+/-" disclosure. Smart-CTA detection still swaps the primary
// download button's text/href based on the visitor's UA — but the
// surrounding hero is now a single-row layout (title left, CTA right).

// Local aliases — keep call-site diffs minimal (the names already in
// use below). All values come from the SSOT.
const APK_URL = ANDROID_APK_URL;
const APK_SIZE = ANDROID_APK_SIZE;
const APK_SIZE_BYTES = ANDROID_APK_SIZE_BYTES;
const APK_VERSION = ANDROID_VERSION;
const APK_VERSION_CODE = String(ANDROID_VERSION_CODE);
const APK_SHA = ANDROID_APK_SHA;
const APK_APP_ID = ANDROID_APP_ID;
const APK_MIN_SDK = String(ANDROID_MIN_SDK);
const APK_TARGET_SDK = String(ANDROID_TARGET_SDK);

const WIN_VERSION = WINDOWS_VERSION;
const WIN_EXE = WINDOWS_NSIS_URL;
const WIN_MSI = WINDOWS_MSI_URL;
const WIN_SIZE_EXE = WINDOWS_NSIS_SIZE;
const WIN_SIZE_MSI = WINDOWS_MSI_SIZE;
const WIN_SHA_EXE = WINDOWS_NSIS_SHA;
const WIN_SHA_MSI = WINDOWS_MSI_SHA;
const WIN_MIN_OS = WINDOWS_MIN_OS;
const WIN_BUILD_TARGET = WINDOWS_BUILD_TARGET;

// R195: GitHub repo URL for the "no build yet" CTA on macOS / Linux / iOS.
const GITHUB_URL = 'https://github.com/TimesNuRoman/pulse';

const PAGE_TITLE = 'Download Pulse — for Windows or Android';
const PAGE_DESC = 'Download Pulse for Windows (NSIS or MSI installer) or Pulse for Android (APK). Local-first, no account, no telemetry.';

// R128 SEO polish: JSON-LD for the two apps on this page.
// One SoftwareApplication per platform so search engines can surface
// each platform's installer + APK separately.
const softwareAppsJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Pulse for Windows',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Windows 10, Windows 11',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    description: 'A side panel for Windows. Sits in the system tray, opens with a global hotkey, talks to a local model.',
    softwareVersion: WIN_VERSION,
    license: 'https://www.apache.org/licenses/LICENSE-2.0',
    downloadUrl: `https://ownlocalml.com${WIN_EXE}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Pulse for Android',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Android 7.0+',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    description: 'A markdown note editor for Android with backlinks, tags, voice input, and full-text search.',
    softwareVersion: APK_VERSION,
    license: 'https://www.apache.org/licenses/LICENSE-2.0',
    downloadUrl: `https://ownlocalml.com${APK_URL}`,
  },
];
---

<Base
  title={PAGE_TITLE}
  description={PAGE_DESC}
  ogImage="/og-download.png"
  ctaText={`Start trial for Android ↓ ${APK_SIZE}`}
  ctaHref={APK_URL}
  ctaVisible={true}
  footerLicense=""
  footerVersion={`v${APK_VERSION} / v${WIN_VERSION}`}
  canonical="https://ownlocalml.com/download/"
>
  <a class="skip-link" href="#main">Skip to content</a>

  <nav class="nav" id="topnav" aria-label="Primary">
    <div class="nav__inner">
      <a class="nav__brand" href="/" aria-label="Pulse — home">
        <svg class="pulse-logo" viewBox="0 0 64 64" width="28" height="28" role="img" aria-label="Pulse">
          <circle class="pulse-logo__ring" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle class="pulse-logo__ring pulse-logo__ring--2" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle class="pulse-logo__ring pulse-logo__ring--3" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle cx="32" cy="32" r="9" fill="#bb9af7"></circle>
          <circle cx="35" cy="30" r="2" fill="#1a1b26"></circle>
        </svg>
        <span class="nav__brand-name">Pulse</span>
      </a>
      <ul class="nav__links" role="list">
        <li><a class="nav__link" href="/download/" aria-current="page">Download</a></li>
        <li><a class="nav__link" href="/pricing/">Pricing</a></li>
      </ul>
      <div class="nav__right">
        <a class="btn btn--primary nav__cta" href={APK_URL} rel="noopener noreferrer">Start trial ↓ {APK_SIZE}</a>
        <button class="nav__burger" id="nav-burger" type="button" aria-expanded="false" aria-controls="nav-drawer" aria-label="Open menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="20" y2="17"></line>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <div class="nav-drawer" id="nav-drawer" aria-hidden="true">
    <a class="nav-drawer__link" href="/">Home</a>
    <a class="nav-drawer__link" href="/download/" aria-current="page">Download</a>
    <a class="nav-drawer__link" href="/pricing/">Pricing</a>
    <a class="btn btn--primary nav-drawer__cta" href={APK_URL} rel="noopener noreferrer">Start trial ↓ {APK_SIZE}</a>
  </div>

  <script is:inline>
    (() => {
      const nav = document.getElementById('topnav');
      const burger = document.getElementById('nav-burger');
      const drawer = document.getElementById('nav-drawer');
      if (!nav) return;
      let scrolled = false;
      const setScrolled = (v) => { if (v === scrolled) return; scrolled = v; nav.classList.toggle('is-scrolled', v); };
      const onScroll = () => setScrolled(window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      if (burger && drawer) {
        const setOpen = (open) => {
          burger.setAttribute('aria-expanded', String(open));
          drawer.setAttribute('aria-hidden', String(!open));
          drawer.classList.toggle('is-open', open);
          document.body.style.overflow = open ? 'hidden' : '';
        };
        burger.addEventListener('click', () => {
          const isOpen = drawer.classList.contains('is-open');
          setOpen(!isOpen);
        });
        drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer.classList.contains('is-open')) { setOpen(false); burger.focus(); } });
        const mq = window.matchMedia('(min-width: 768px)');
        mq.addEventListener?.('change', (e) => { if (e.matches && drawer.classList.contains('is-open')) setOpen(false); });
      }
      document.body.classList.add('has-nav');
    })();
  </script>

  <main id="main" class="notes-main">
    <!-- ─── R247c: Compact hero ───────────────────────────
         Single-row layout: product name + version meta on the
         left, the smart primary CTA on the right. No glass card,
         no "One click" placeholder copy. The smart-CTA IIFE at
         the bottom of the file swaps this button's label / href
         in place based on the visitor's UA. -->
    <section class="dl-hero-compact">
      <div class="container dl-hero-compact__inner">
        <div class="dl-hero-compact__title">
          <h1 class="dl-hero-compact__h1">Download Pulse</h1>
          <p class="dl-hero-compact__meta">
            Windows v{WIN_VERSION} <span aria-hidden="true">·</span> Android v{APK_VERSION}
            <span aria-hidden="true">·</span> {WIN_SIZE_EXE} / {APK_SIZE}
          </p>
        </div>
        <div class="dl-hero-compact__cta" data-smart-state="ready" data-smart-platform="windows">
          <a class="btn dl-hero-compact__btn"
             data-smart-href
             data-smart-btn-class="btn--primary"
             href={WIN_EXE}
             rel="noopener noreferrer"
             download>
            <span data-smart-filename>Download Pulse for Windows</span>
            <span class="dl-hero-compact__size" data-smart-size>· {WIN_SIZE_EXE}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ─── R247c: Tab strip ──────────────────────────────
         5 platform pills, all visible above the fold. Click or
         arrow-key to switch. The active tab's content renders
         in the matching panel below. macOS / Linux / iOS tabs
         still show — they just open to "no build today" cards
         with the build-from-source / GitHub links. -->
    <section class="dl-tabs-wrap" aria-labelledby="dl-tabs-heading">
      <div class="container">
        <h2 id="dl-tabs-heading" class="dl-tabs-heading">Choose a platform</h2>
        <div class="dl-tabs" role="tablist" aria-label="Download platform">
          <button role="tab" type="button"
                  id="tab-windows" aria-selected="true" aria-controls="panel-windows" data-tab="windows"
                  class="dl-tab">
            <svg class="dl-tab__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M3 4.5l6.5-1v7H3v-6zm0 11l6.5 1V10H3v5.5zM10.5 3.4L17 2.4v8.1h-6.5V3.4zm0 13.2L17 17.6V9.5h-6.5v7.1z"/>
            </svg>
            <span class="dl-tab__label">Windows</span>
            <span class="dl-tab__badge">v{WIN_VERSION}</span>
          </button>
          <button role="tab" type="button"
                  id="tab-android" aria-selected="false" aria-controls="panel-android" data-tab="android" tabindex="-1"
                  class="dl-tab">
            <svg class="dl-tab__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M5 9.5a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0zm7 0a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0zM3.5 6h13v7.5a1.5 1.5 0 01-1.5 1.5h-1V17a1 1 0 11-2 0v-2h-4v2a1 1 0 11-2 0v-2H5A1.5 1.5 0 013.5 13.5V6zM4.7 4l-.7-.7a.5.5 0 11.7-.7l.8.7a5.5 5.5 0 014.5-.6L10.5 2a.5.5 0 11.4.9l-.4.7a5.5 5.5 0 014 1.4l.7-.7a.5.5 0 11.7.7l-.6.7A3 3 0 0116.5 8h-13A3 3 0 014.7 4z"/>
            </svg>
            <span class="dl-tab__label">Android</span>
            <span class="dl-tab__badge">v{APK_VERSION}</span>
          </button>
          <button role="tab" type="button"
                  id="tab-macos" aria-selected="false" aria-controls="panel-macos" data-tab="macos" tabindex="-1"
                  class="dl-tab">
            <svg class="dl-tab__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M14.5 10.6c0-2.1 1.7-3.1 1.8-3.2-1-1.5-2.5-1.7-3-1.7-1.3-.1-2.5.8-3.2.8-.7 0-1.7-.7-2.8-.7-1.4 0-2.7.8-3.5 2.1-1.5 2.6-.4 6.4 1 8.5.7 1 1.6 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7 1.3 0 1.7.7 2.8.7 1.2 0 1.9-1 2.6-2 .8-1.1 1.2-2.3 1.2-2.3-.1 0-2.4-1-2.4-3.6zM12.4 4.3c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.6.6-1 1.6-.9 2.6 1 0 2-.5 2.5-1.2z"/>
            </svg>
            <span class="dl-tab__label">macOS</span>
            <span class="dl-tab__badge">source</span>
          </button>
          <button role="tab" type="button"
                  id="tab-linux" aria-selected="false" aria-controls="panel-linux" data-tab="linux" tabindex="-1"
                  class="dl-tab">
            <svg class="dl-tab__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M10 2.5c-1.7 0-3 1.4-3 3.2 0 .9.2 1.6.5 2.2-.5.8-1.4 1.7-2.2 2.7-1 1.3-1.8 2.8-1.8 4.2 0 .7.2 1.4.6 2 .4.5 1 .8 1.7.8.5 0 1-.1 1.4-.3.5-.2.9-.5 1.4-.5h2.8c.5 0 .9.3 1.4.5.4.2.9.3 1.4.3.7 0 1.3-.3 1.7-.8.4-.6.6-1.3.6-2 0-1.4-.8-2.9-1.8-4.2-.8-1-1.7-1.9-2.2-2.7.3-.6.5-1.3.5-2.2 0-1.8-1.3-3.2-3-3.2zM8.5 6.2a.7.7 0 110 1.4.7.7 0 010-1.4zm3 0a.7.7 0 110 1.4.7.7 0 010-1.4zM8 8.8a2 2 0 002 2 2 2 0 002-2h-4z"/>
            </svg>
            <span class="dl-tab__label">Linux</span>
            <span class="dl-tab__badge">source</span>
          </button>
          <button role="tab" type="button"
                  id="tab-ios" aria-selected="false" aria-controls="panel-ios" data-tab="ios" tabindex="-1"
                  class="dl-tab">
            <svg class="dl-tab__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M11 2.5a2 2 0 00-2 2v.6c-2.4.4-4 2.4-4 4.9v4a2 2 0 01-1 1.7.8.8 0 00.4 1.5h11.2a.8.8 0 00.4-1.5 2 2 0 01-1-1.7v-4c0-2.5-1.6-4.5-4-4.9v-.6a2 2 0 00-2-2zm-1 1.5a.7.7 0 110 1.4.7.7 0 010-1.4zM5 14.5h10v1.3c0 .2 0 .4.1.6H4.9c.1-.2.1-.4.1-.6v-1.3z"/>
            </svg>
            <span class="dl-tab__label">iOS</span>
            <span class="dl-tab__badge">n/a</span>
          </button>
        </div>
      </div>
    </section>

    <!-- ─── R248g: "Choose your platform" grid ────────────
         5 cards, one per per-platform download page. -->
    <section class="dl-choose" aria-labelledby="dl-choose-title">
      <div class="container dl-choose__inner">
        <header class="dl-choose__head">
          <span class="eyebrow">Choose your platform</span>
          <h2 class="dl-choose__title" id="dl-choose-title">A download page for every platform.</h2>
          <p class="dl-choose__sub">Windows and Android ship as signed installers. macOS and Linux live as source builds. iOS is not on the App Store &mdash; the Android APK is the tablet fallback.</p>
        </header>
        <ul class="dl-choose__grid" role="list">
          <li>
            <a class="dl-choose__card glass" href="/download/windows/">
              <span class="dl-choose__card-platform">Windows</span>
              <span class="dl-choose__card-tag dl-choose__card-tag--ready">ready</span>
              <span class="dl-choose__card-title">NSIS · MSI · portable</span>
              <span class="dl-choose__card-meta">{WIN_SIZE_EXE} · v{WIN_VERSION}</span>
            </a>
          </li>
          <li>
            <a class="dl-choose__card glass" href="/download/android/">
              <span class="dl-choose__card-platform">Android</span>
              <span class="dl-choose__card-tag dl-choose__card-tag--ready">ready</span>
              <span class="dl-choose__card-title">Signed APK (v2 + v3)</span>
              <span class="dl-choose__card-meta">{APK_SIZE} · v{APK_VERSION}</span>
            </a>
          </li>
          <li>
            <a class="dl-choose__card glass" href="/download/macos/">
              <span class="dl-choose__card-platform">macOS</span>
              <span class="dl-choose__card-tag dl-choose__card-tag--source">source</span>
              <span class="dl-choose__card-title">Build from source</span>
              <span class="dl-choose__card-meta">.app · .dmg · arm64 + x86_64</span>
            </a>
          </li>
          <li>
            <a class="dl-choose__card glass" href="/download/linux/">
              <span class="dl-choose__card-platform">Linux</span>
              <span class="dl-choose__card-tag dl-choose__card-tag--source">source</span>
              <span class="dl-choose__card-title">Build from source</span>
              <span class="dl-choose__card-meta">.deb · .AppImage · x86_64</span>
            </a>
          </li>
          <li>
            <a class="dl-choose__card glass" href="/download/ios/">
              <span class="dl-choose__card-platform">iOS</span>
              <span class="dl-choose__card-tag dl-choose__card-tag--na">not available</span>
              <span class="dl-choose__card-title">App Store policy blocks it</span>
              <span class="dl-choose__card-meta">Android tablet fallback</span>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <!-- ─── R247c: Tab panels (legacy quick-switcher) ─────
         One panel per platform. Default = Windows. macOS / Linux
         / iOS panels stay honest: "no build today" + the build-
         from-source guide or the GitHub repo. Every tab is
         reachable without navigating away from /download/. -->
    <section class="dl-panels">
      <div class="container">

        <div role="tabpanel" id="panel-windows" aria-labelledby="tab-windows" data-panel="windows" class="dl-panel">
          <article class="dl-card glass reveal">
            <header class="dl-card__head">
              <span class="dl-card__platform">Pulse for Windows</span>
              <span class="notes-hero__pill" aria-label="Latest version">
                <span class="notes-hero__pill-dot" aria-hidden="true"></span>
                v{WIN_VERSION}
              </span>
            </header>
            <h3 class="dl-card__title">A side panel for your Windows desktop.</h3>
            <p class="dl-card__body">
              Pulse for Windows sits in the system tray and opens with a
              global hotkey. It talks to a local model that runs on your
              machine. Prompts, screenshots, and voice stay on the device.
              The installer ships as NSIS (per-user) or MSI (per-machine).
              The MSI is the one for IT departments; the NSIS is the one for
              individual installs.
            </p>
            <div class="dl-card__ctas">
              <a class="btn btn--primary btn--lg" href={WIN_EXE} rel="noopener noreferrer">
                Download NSIS ↓ {WIN_SIZE_EXE}
              </a>
              <a class="btn btn--ghost btn--lg" href={WIN_MSI} rel="noopener noreferrer">
                Download MSI ↓ {WIN_SIZE_MSI}
              </a>
            </div>
            <dl class="dl-card__meta">
              <div class="dl-card__meta-row">
                <dt>version</dt>
                <dd>v{WIN_VERSION}</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>build</dt>
                <dd>release · {WIN_BUILD_TARGET}</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>min OS</dt>
                <dd>{WIN_MIN_OS}</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>NSIS SHA-256</dt>
                <dd><code class="dl-card__sha">{WIN_SHA_EXE}</code></dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>MSI SHA-256</dt>
                <dd><code class="dl-card__sha">{WIN_SHA_MSI}</code></dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>license</dt>
                <dd>Proprietary</dd>
              </div>
            </dl>
            <p class="dl-card__more">
              Need the full version history? See the
              <a href="/changelog/">changelog</a>.
            </p>
          </article>
        </div>

        <div role="tabpanel" id="panel-android" aria-labelledby="tab-android" data-panel="android" class="dl-panel" hidden>
          <article class="dl-card glass reveal">
            <header class="dl-card__head">
              <span class="dl-card__platform">Pulse for Android</span>
              <span class="notes-hero__pill" aria-label="Latest version">
                <span class="notes-hero__pill-dot" aria-hidden="true"></span>
                v{APK_VERSION} · versionCode {APK_VERSION_CODE}
              </span>
            </header>
            <h3 class="dl-card__title">A markdown editor for your Android phone.</h3>
            <p class="dl-card__body">
              Pulse for Android is a note editor with
              <code>[[wikilink]]</code> backlinks, tag autocomplete, voice
              input, and full-text search. Notes live on the device — the
              app does not upload them. Backup rules keep the WebView cache
              off cloud-backup and device-transfer. Settings (profile, theme,
              about, actions) open from a gear button in the toolbar.
            </p>
            <div class="dl-card__ctas">
              <a class="btn btn--primary btn--lg" href={APK_URL} rel="noopener noreferrer">
                Download APK ↓ {APK_SIZE}
              </a>
              <a class="btn btn--ghost btn--lg" href="/changelog/">
                Full changelog
              </a>
            </div>
            <dl class="dl-card__meta">
              <div class="dl-card__meta-row">
                <dt>versionName</dt>
                <dd>v{APK_VERSION}</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>versionCode</dt>
                <dd>{APK_VERSION_CODE}</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>appId</dt>
                <dd><code>{APK_APP_ID}</code></dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>minSdk · targetSdk</dt>
                <dd>{APK_MIN_SDK} · {APK_TARGET_SDK}</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>SHA-256</dt>
                <dd><code class="dl-card__sha">{APK_SHA}</code></dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>size</dt>
                <dd>{APK_SIZE} ({APK_SIZE_BYTES.toLocaleString('en-US')} B)</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>signing</dt>
                <dd>Release keystore · v2 + v3</dd>
              </div>
            </dl>
            <p class="dl-card__more">
              <a href="/privacy/">Privacy &amp; data model</a>
            </p>
          </article>
        </div>

        <div role="tabpanel" id="panel-macos" aria-labelledby="tab-macos" data-panel="macos" class="dl-panel" hidden>
          <article class="dl-card glass reveal">
            <header class="dl-card__head">
              <span class="dl-card__platform">Pulse for macOS</span>
