---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import '../styles/notes.css';
import {
  ANDROID_VERSION,
  ANDROID_VERSION_CODE,
  ANDROID_APP_ID,
  ANDROID_MIN_SDK,
  ANDROID_TARGET_SDK,
  ANDROID_APK_URL,
  ANDROID_APK_SIZE,
  ANDROID_APK_SIZE_BYTES,
  ANDROID_APK_SHA,
  WINDOWS_VERSION,
  WINDOWS_NSIS_URL,
  WINDOWS_MSI_URL,
  WINDOWS_NSIS_SIZE,
  WINDOWS_MSI_SIZE,
  WINDOWS_NSIS_SHA,
  WINDOWS_MSI_SHA,
  WINDOWS_MIN_OS,
  WINDOWS_BUILD_TARGET,
  absoluteAndroidDownloadUrl,
} from '../lib/versions';

// R120 site simplify: download surface for the user-facing site.
// Keeps the platform details (NSIS / MSI, SHA-256, size, min OS) — those
// are required to verify a binary before running it. Strips round
// numbers and implementation jargon. UA-based JS reorder: mobile →
// Android first, desktop → Windows first.
//
// R184: smart download CTA — server-renders a Windows-flavoured CTA at
// the top, upgrades to the visitor's platform via the inline IIFE that
// mirrors `src/lib/platformDetect.ts`. The existing hero + platform
// cards move into a `<details id="other-platforms">` disclosure, opened
// by the "Pick a different platform" button. macOS / Linux / iOS all
// render an honest "no build yet" message with a fork-on-GitHub link.
//
// R234: every version string + URL + size + SHA is now sourced from
// `src/lib/versions.ts` (the SSOT). The next version bump is a 1-line
// edit to public/updates/{desktop,android}.json, not a search-replace
// marathon across this file.

// Local aliases — keep call-site diffs minimal (the names already in
// use below). All values come from the SSOT.
const APK_URL = ANDROID_APK_URL;
const APK_SIZE = ANDROID_APK_SIZE;
const APK_SIZE_BYTES = ANDROID_APK_SIZE_BYTES;
const APK_VERSION = ANDROID_VERSION;
const APK_VERSION_CODE = String(ANDROID_VERSION_CODE);
const APK_SHA = ANDROID_APK_SHA;
const APK_APP_ID = ANDROID_APP_ID;
const APK_MIN_SDK = String(ANDROID_MIN_SDK);
const APK_TARGET_SDK = String(ANDROID_TARGET_SDK);

const WIN_VERSION = WINDOWS_VERSION;
const WIN_EXE = WINDOWS_NSIS_URL;
const WIN_MSI = WINDOWS_MSI_URL;
const WIN_SIZE_EXE = WINDOWS_NSIS_SIZE;
const WIN_SIZE_MSI = WINDOWS_MSI_SIZE;
const WIN_SHA_EXE = WINDOWS_NSIS_SHA;
const WIN_SHA_MSI = WINDOWS_MSI_SHA;
const WIN_MIN_OS = WINDOWS_MIN_OS;
const WIN_BUILD_TARGET = WINDOWS_BUILD_TARGET;

// R184: GitHub repo URL for the "no build yet" CTA on macOS / Linux / iOS.
const GITHUB_URL = 'https://github.com/TimesNuRoman/pulse';

const PAGE_TITLE = 'Download Pulse — for Windows or Android';
const PAGE_DESC = 'Download Pulse for Windows (NSIS or MSI installer) or Pulse for Android (APK). 14-day trial included. Local-first, no account, no telemetry.';

// R128 SEO polish: JSON-LD for the two apps on this page.
// One SoftwareApplication per platform so search engines can surface
// each platform's installer + APK separately. Free / open-source.
const softwareAppsJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Pulse for Windows',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Windows 10, Windows 11',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    description: 'A side panel for Windows. Sits in the system tray, opens with a global hotkey, talks to a local model.',
    softwareVersion: WIN_VERSION,
    license: 'https://www.apache.org/licenses/LICENSE-2.0',
    downloadUrl: `https://ownlocalml.com${WIN_EXE}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Pulse for Android',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Android 7.0+',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    description: 'A markdown note editor for Android with backlinks, tags, voice input, and full-text search.',
    softwareVersion: APK_VERSION,
    license: 'https://www.apache.org/licenses/LICENSE-2.0',
    downloadUrl: `https://ownlocalml.com${APK_URL}`,
  },
];
---

<Base
  title={PAGE_TITLE}
  description={PAGE_DESC}
  ogImage="/og-download.png"
  ctaText={`Start trial for Android ↓ ${APK_SIZE}`}
  ctaHref={APK_URL}
  ctaVisible={true}
  footerLicense=""
  footerVersion={`v${APK_VERSION} / v${WIN_VERSION}`}
  canonical="https://ownlocalml.com/download/"
>
  <a class="skip-link" href="#main">Skip to content</a>

  <nav class="nav" id="topnav" aria-label="Primary">
    <div class="nav__inner">
      <a class="nav__brand" href="/" aria-label="Pulse — home">
        <svg class="pulse-logo" viewBox="0 0 64 64" width="28" height="28" role="img" aria-label="Pulse">
          <circle class="pulse-logo__ring" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle class="pulse-logo__ring pulse-logo__ring--2" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle class="pulse-logo__ring pulse-logo__ring--3" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle cx="32" cy="32" r="9" fill="#bb9af7"></circle>
          <circle cx="35" cy="30" r="2" fill="#1a1b26"></circle>
        </svg>
        <span class="nav__brand-name">Pulse</span>
      </a>
      <ul class="nav__links" role="list">
        <li><a class="nav__link" href="/download/" aria-current="page">Download</a></li>
        <li><a class="nav__link" href="/pricing/">Pricing</a></li>
      </ul>
      <div class="nav__right">
        <a class="btn btn--primary nav__cta" href={APK_URL} rel="noopener noreferrer">Start trial ↓ {APK_SIZE}</a>
        <button class="nav__burger" id="nav-burger" type="button" aria-expanded="false" aria-controls="nav-drawer" aria-label="Open menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="20" y2="17"></line>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <div class="nav-drawer" id="nav-drawer" aria-hidden="true">
    <a class="nav-drawer__link" href="/">Home</a>
    <a class="nav-drawer__link" href="/download/" aria-current="page">Download</a>
    <a class="nav-drawer__link" href="/pricing/">Pricing</a>
    <a class="btn btn--primary nav-drawer__cta" href={APK_URL} rel="noopener noreferrer">Start trial ↓ {APK_SIZE}</a>
  </div>

  <script is:inline>
    (() => {
      const nav = document.getElementById('topnav');
      const burger = document.getElementById('nav-burger');
      const drawer = document.getElementById('nav-drawer');
      if (!nav) return;
      let scrolled = false;
      const setScrolled = (v) => { if (v === scrolled) return; scrolled = v; nav.classList.toggle('is-scrolled', v); };
      const onScroll = () => setScrolled(window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      if (burger && drawer) {
        const setOpen = (open) => {
          burger.setAttribute('aria-expanded', String(open));
          drawer.setAttribute('aria-hidden', String(!open));
          drawer.classList.toggle('is-open', open);
          document.body.style.overflow = open ? 'hidden' : '';
        };
        burger.addEventListener('click', () => {
          const isOpen = drawer.classList.contains('is-open');
          setOpen(!isOpen);
        });
        drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer.classList.contains('is-open')) { setOpen(false); burger.focus(); } });
        const mq = window.matchMedia('(min-width: 768px)');
        mq.addEventListener?.('change', (e) => { if (e.matches && drawer.classList.contains('is-open')) setOpen(false); });
      }
      document.body.classList.add('has-nav');
    })();
  </script>

  <main id="main" class="notes-main">
    <!-- ─── R184: Smart download CTA ────────────────────
         Server-renders the Windows-flavoured CTA. The inline IIFE
         below detects the visitor's platform and swaps the CTA in
         place. The pure function is in src/lib/platformDetect.ts;
         this IIFE MUST mirror its logic. -->
    <section class="dl-smart" id="smart">
      <div class="bg-glow"></div>
      <div class="container dl-smart__inner glass">
        <div class="dl-smart__cta" data-smart-state="ready" data-smart-platform="windows">
          <span class="dl-smart__eyebrow">
            Detected: <span class="dl-smart__os" aria-live="polite" data-smart-os>Windows</span>
          </span>
          <h2 class="dl-smart__title" data-smart-title>One click. That's it.</h2>
          <p class="dl-smart__sub" data-smart-sub>
            Local-first, no account, 14-day trial included. We'll send you the right installer for <span data-smart-os-tail>Windows</span>.
          </p>
          <a class="btn dl-smart__btn"
             data-smart-href
             data-smart-btn-class="btn--primary"
             href={WIN_EXE}
             rel="noopener noreferrer"
             download>
            <span data-smart-filename>Download Pulse for Windows</span>
            <span class="dl-smart__size" data-smart-size>· {WIN_SIZE_EXE}</span>
          </a>
          <button class="dl-smart__pick"
                  data-smart-pick
                  type="button"
                  aria-expanded="false"
                  aria-controls="other-platforms">
            Pick a different platform <span aria-hidden="true">↓</span>
          </button>
        </div>
      </div>
    </section>

    <!-- ─── R184: "Other platforms" disclosure ────────────
         Wraps the R120 hero + platform cards. Default closed.
         The "Pick a different platform" button above opens this. -->
    <details id="other-platforms" class="dl-other">
      <summary class="dl-other__summary">
        <span class="dl-other__summary-label">Other platforms</span>
        <span class="dl-other__summary-sub">Windows, Android, or build from source</span>
        <span class="dl-other__summary-caret" aria-hidden="true">+</span>
      </summary>

      <!-- ─── Hero ──────────────────────────────────────── -->
      <section class="dl-hero">
        <div class="bg-glow"></div>
        <div class="container dl-hero__grid">
          <div class="dl-hero__copy reveal">
            <div class="dl-hero__badges">
              <span class="notes-hero__eyebrow">Pulse · download</span>
              <span class="notes-hero__pill" aria-label="Latest versions">
                <span class="notes-hero__pill-dot" aria-hidden="true"></span>
                Windows v{WIN_VERSION} · Android v{APK_VERSION}
              </span>
            </div>
            <h2 class="dl-hero__title">
              Other ways<br />to install. <span class="notes-hero__hl">Same Pulse.</span>
            </h2>
            <p class="dl-hero__sub">
              Pick an installer below or jump to the source on GitHub.
              Both builds are local-first. The Windows installer is NSIS
              (per-user) or MSI (per-machine); the Android build is a
              signed APK.
            </p>
            <ul class="dl-hero__platforms" role="list" aria-label="Jump to platform">
              <li><a class="btn btn--ghost btn--lg" href="#windows">Pulse for Windows ↓</a></li>
              <li><a class="btn btn--ghost btn--lg" href="#android">Pulse for Android ↓ {APK_SIZE}</a></li>
            </ul>
          </div>
        </div>
      </section>

      <!-- ─── Platform sections (UA-reordered) ─────────── -->
      <section class="dl-platforms" id="platforms" data-dl-reorder>
        <div class="container dl-platforms__grid">

          <article class="dl-card glass reveal" id="windows" data-dl-platform="windows">
            <header class="dl-card__head">
              <span class="dl-card__platform">Pulse for Windows</span>
              <span class="notes-hero__pill" aria-label="Latest version">
                <span class="notes-hero__pill-dot" aria-hidden="true"></span>
                v{WIN_VERSION}
              </span>
            </header>
            <h3 class="dl-card__title">A side panel for your Windows desktop.</h3>
            <p class="dl-card__body">
              Pulse for Windows sits in the system tray and opens with a
              global hotkey. It talks to a local model that runs on your
              machine. Prompts, screenshots, and voice stay on the device.
              The installer ships as NSIS (per-user) or MSI (per-machine).
              The MSI is the one for IT departments; the NSIS is the one for
              individual installs.
            </p>
            <div class="dl-card__ctas">
              <a class="btn btn--primary btn--lg" href={WIN_EXE} rel="noopener noreferrer">
                Download NSIS ↓ {WIN_SIZE_EXE}
              </a>
              <a class="btn btn--ghost btn--lg" href={WIN_MSI} rel="noopener noreferrer">
                Download MSI ↓ {WIN_SIZE_MSI}
              </a>
            </div>
            <dl class="dl-card__meta">
              <div class="dl-card__meta-row">
                <dt>version</dt>
                <dd>v{WIN_VERSION}</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>build</dt>
                <dd>release · {WIN_BUILD_TARGET}</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>min OS</dt>
                <dd>{WIN_MIN_OS}</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>NSIS SHA-256</dt>
                <dd><code class="dl-card__sha">{WIN_SHA_EXE}</code></dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>MSI SHA-256</dt>
                <dd><code class="dl-card__sha">{WIN_SHA_MSI}</code></dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>license</dt>
                <dd>Proprietary</dd>
              </div>
            </dl>
            <p class="dl-card__more">
              Need the full version history? See the
              <a href="/changelog/">changelog</a>.
            </p>
          </article>

          <article class="dl-card glass reveal" id="android" data-dl-platform="android">
            <header class="dl-card__head">
              <span class="dl-card__platform">Pulse for Android</span>
              <span class="notes-hero__pill" aria-label="Latest version">
                <span class="notes-hero__pill-dot" aria-hidden="true"></span>
                v{APK_VERSION} · versionCode {APK_VERSION_CODE}
              </span>
            </header>
            <h3 class="dl-card__title">A markdown editor for your Android phone.</h3>
            <p class="dl-card__body">
              Pulse for Android is a note editor with
              <code>[[wikilink]]</code> backlinks, tag autocomplete, voice
              input, and full-text search. Notes live on the device — the
              app does not upload them. Backup rules keep the WebView cache
              off cloud-backup and device-transfer. Settings (profile, theme,
              about, actions) open from a gear button in the toolbar.
            </p>
            <div class="dl-card__ctas">
              <a class="btn btn--primary btn--lg" href={APK_URL} rel="noopener noreferrer">
                Download APK ↓ {APK_SIZE}
              </a>
              <a class="btn btn--ghost btn--lg" href="/changelog/">
                Full changelog
              </a>
            </div>
            <dl class="dl-card__meta">
              <div class="dl-card__meta-row">
                <dt>versionName</dt>
                <dd>v{APK_VERSION}</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>versionCode</dt>
                <dd>{APK_VERSION_CODE}</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>appId</dt>
                <dd><code>{APK_APP_ID}</code></dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>minSdk · targetSdk</dt>
                <dd>{APK_MIN_SDK} · {APK_TARGET_SDK}</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>SHA-256</dt>
                <dd><code class="dl-card__sha">{APK_SHA}</code></dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>size</dt>
                <dd>{APK_SIZE} ({APK_SIZE_BYTES.toLocaleString('en-US')} B)</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>signing</dt>
                <dd>Release keystore · v2 + v3</dd>
              </div>
            </dl>
            <p class="dl-card__more">
              <a href="/privacy/">Privacy &amp; data model</a>
            </p>
          </article>

          <!-- ─── R195: macOS / Linux / iOS cards ───────────
               macOS and Linux: "no official build today" + link
               to the /install/{platform}/ build-from-source guide.
               iOS: no sideloading path on Apple hardware, link
               to the Android APK as a tablet fallback. -->
          <article class="dl-card glass reveal" id="macos" data-dl-platform="macos">
            <header class="dl-card__head">
              <span class="dl-card__platform">Pulse for macOS</span>
              <span class="notes-hero__pill" aria-label="Build from source">
                <span class="notes-hero__pill-dot" aria-hidden="true"></span>
                source build
              </span>
            </header>
            <h3 class="dl-card__title">Build Pulse for macOS from source.</h3>
            <p class="dl-card__body">
              There is no official macOS build today. The community has ported
              the source to Apple Silicon and Intel. The build produces an
              unsigned <code>.app</code> bundle and a <code>.dmg</code> that
              drags into <code>/Applications</code>. Gatekeeper warns on first
              run; the right-click &ldquo;Open&rdquo; menu clears it.
            </p>
            <div class="dl-card__ctas">
              <a class="btn btn--primary btn--lg" href="/install/macos/">
                Build from source on Mac ↓
              </a>
              <a class="btn btn--ghost btn--lg" href={GITHUB_URL} rel="noopener noreferrer">
                Read the source on GitHub
              </a>
            </div>
            <dl class="dl-card__meta">
              <div class="dl-card__meta-row">
                <dt>artifact</dt>
                <dd><code>.app</code> · <code>.dmg</code></dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>min OS</dt>
                <dd>macOS 11 (Big Sur)</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>arch</dt>
                <dd>arm64 · x86_64</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>signing</dt>
                <dd>Unsigned · Gatekeeper warns</dd>
              </div>
            </dl>
          </article>

          <article class="dl-card glass reveal" id="linux" data-dl-platform="linux">
            <header class="dl-card__head">
              <span class="dl-card__platform">Pulse for Linux</span>
              <span class="notes-hero__pill" aria-label="Build from source">
                <span class="notes-hero__pill-dot" aria-hidden="true"></span>
                source build
              </span>
            </header>
            <h3 class="dl-card__title">Build Pulse for Linux from source.</h3>
            <p class="dl-card__body">
              There is no official Linux build today. The community has ported
              the source to GTK3 and WebKit2GTK. The build produces an
              unsigned <code>.deb</code> for Debian-based distros and a
              portable <code>.AppImage</code> for everything else. Expect
              rough edges on Wayland.
            </p>
            <div class="dl-card__ctas">
              <a class="btn btn--primary btn--lg" href="/install/linux/">
                Build from source on Linux ↓
              </a>
              <a class="btn btn--ghost btn--lg" href={GITHUB_URL} rel="noopener noreferrer">
                Read the source on GitHub
              </a>
            </div>
            <dl class="dl-card__meta">
              <div class="dl-card__meta-row">
                <dt>artifact</dt>
                <dd><code>.deb</code> · <code>.AppImage</code></dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>distros</dt>
                <dd>Ubuntu · Debian · Fedora · Arch</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>arch</dt>
                <dd>x86_64</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>signing</dt>
                <dd>Unsigned · no apt or pacman repo</dd>
              </div>
            </dl>
          </article>

          <article class="dl-card glass reveal" id="ios" data-dl-platform="ios">
            <header class="dl-card__head">
              <span class="dl-card__platform">Pulse for iOS</span>
              <span class="notes-hero__pill" aria-label="Not available">
                <span class="notes-hero__pill-dot" aria-hidden="true"></span>
                not available
              </span>
            </header>
            <h3 class="dl-card__title">No iOS build today.</h3>
            <p class="dl-card__body">
              Pulse is not on the App Store. Apple&rsquo;s rules do not allow
              sideloading an unsigned build on iPhone or iPad. The Android
              APK can be sideloaded on a tablet if a markdown editor is
              the goal &mdash; it shares the same data model.
            </p>
            <div class="dl-card__ctas">
              <a class="btn btn--primary btn--lg" href={APK_URL} rel="noopener noreferrer">
                Download Android APK ↓ {APK_SIZE}
              </a>
              <a class="btn btn--ghost btn--lg" href={GITHUB_URL} rel="noopener noreferrer">
                Read the source on GitHub
              </a>
            </div>
            <dl class="dl-card__meta">
              <div class="dl-card__meta-row">
                <dt>artifact</dt>
                <dd>None</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>reason</dt>
                <dd>App Store policy</dd>
              </div>
              <div class="dl-card__meta-row">
                <dt>fallback</dt>
                <dd><a href={APK_URL}>Android APK</a> on tablet</dd>
              </div>
            </dl>
          </article>
        </div>
      </section>
    </details>

    <!-- ─── One product, two surfaces ── -->
    <section class="dl-unified">
      <div class="container dl-unified__inner reveal">
        <span class="eyebrow">One product · two surfaces</span>
        <h2>Same data model on Windows and Android.</h2>
        <p class="lede">
          Pulse for Windows and Pulse for Android share the same local-first
          data model. They differ in input: a tray icon and global hotkey
          on Windows, a bottom toolbar and share intent on Android. Notes
          and chats never leave the device they were written on.
        </p>
        <div class="dl-unified__grid">
          <a class="dl-unified__link glass" href="/pricing/">
            <span class="dl-unified__link-eyebrow">Pricing</span>
            <span class="dl-unified__link-title">14-day trial, then $20/mo</span>
            <span class="dl-unified__link-meta">No credit card to start</span>
          </a>
          <a class="dl-unified__link glass" href={GITHUB_URL} rel="noopener noreferrer">
            <span class="dl-unified__link-eyebrow">Source</span>
            <span class="dl-unified__link-title">Read the code on GitHub</span>
            <span class="dl-unified__link-meta">Audit the network calls · fork it</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer license="" version={`v${APK_VERSION} / v${WIN_VERSION}`} />

  <!-- R128 SEO polish: one SoftwareApplication per platform so search
       engines can surface each installer / APK independently. -->
  <script type="application/ld+json" set:html={JSON.stringify(softwareAppsJsonLd)} />

  <!-- UA-based reorder. mobile → Android first; desktop → Windows first.
       Uses CSS order: property with a UA class so screen-readers see a stable
       document order (Android article second) but the visual order swaps.
       No-JS fallback: Android first (matches the mobile-primary audience). -->
  <script is:inline>
    (() => {
      const root = document.querySelector('[data-dl-reorder]');
      if (!root) return;
      const grid = root.querySelector('.dl-platforms__grid');
      if (!grid) return;
      // isMobile = matches phone UA + narrow viewport
