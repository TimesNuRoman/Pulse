---
// R257: /changelog/confirm — confirms an email subscription.
// On the static landing, this is a thin page that POSTs the token
// to the API host (`/api/changelog/confirm`) and shows the result.
// The real DB lookup happens in pulse-web (out of scope for this
// repo). If no token, shows a generic "open the link from your
// email" message.
import Base from '../../layouts/Base.astro';
const API_URL = '/api/changelog/confirm';
---
<Base
  title="Confirm subscription — Pulse changelog"
  description="Confirm your subscription to Pulse release notes."
  ctaVisible={false}
  footerLicense=""
  canonical="https://ownlocalml.com/changelog/confirm/"
>
  <a class="skip-link" href="#main">Skip to content</a>

  <main class="page" id="main">
    <section class="hero">
      <span class="eyebrow">Changelog</span>
      <h1 id="confirmTitle">Confirming your subscription…</h1>
      <p class="lede" id="confirmLede">One moment.</p>
      <p class="confirm__actions" id="confirmActions" hidden>
        <a class="confirm__btn" href="/changelog/">Back to changelog</a>
      </p>
    </section>
  </main>

  <script is:inline define:vars={{ API_URL }}>
    (() => {
      const title = document.getElementById('confirmTitle');
      const lede  = document.getElementById('confirmLede');
      const acts  = document.getElementById('confirmActions');
      const token = new URLSearchParams(location.search).get('token');

      if (!token) {
        title.textContent = 'Open the link from your email';
        lede.textContent  = 'Paste the confirmation link from your inbox into your browser to subscribe.';
        acts.hidden = false;
        return;
      }

      // POST to API. Endpoint not yet implemented on this host —
      // 200 = success, anything else = invalid or already used.
      fetch(API_URL + '?token=' + encodeURIComponent(token), { method: 'POST' })
        .then((res) => {
          if (res.ok) {
            title.textContent = "✓ You're subscribed";
            lede.textContent  = 'You will get an email when the next release ships.';
            // Clean up the URL: drop ?token and add ?subscribe=ok
            history.replaceState(null, '', '/changelog/?subscribe=ok');
          } else {
            title.textContent = 'Link invalid or already used';
            lede.textContent  = 'Tokens expire after 24 hours, or the link has been used already. Try subscribing again.';
          }
        })
        .catch(() => {
          title.textContent = 'Link invalid or already used';
          lede.textContent  = "Couldn't reach the subscription service. Try again later.";
        })
        .finally(() => { acts.hidden = false; });
    })();
  </script>

  <style>
    .page {
      max-width: 760px;
      margin: 0 auto;
      padding: 0 16px;
    }
    .page .hero {
      padding: 80px 0 48px;
    }
    .page .eyebrow {
      display: block;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--comment, #565f89);
      margin-bottom: 12px;
      font-weight: 600;
    }
    .page h1 {
      font-size: 36px;
      font-weight: 700;
      letter-spacing: -0.025em;
      margin: 0 0 12px;
      line-height: 1.1;
      color: var(--fg, #c0caf5);
    }
    .page .lede {
      color: var(--muted, #9aa5ce);
      font-size: 16px;
      margin: 0 0 28px;
      max-width: 56ch;
    }
    .confirm__actions { margin: 0; }
    .confirm__btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 10px 18px;
      background: var(--purple, #bb9af7);
      color: #1a1b26;
      font-size: 13px; font-weight: 600;
      text-decoration: none;
      border-radius: 0;
    }
    .confirm__btn:hover { background: #c4adf9; }
  </style>
</Base>
