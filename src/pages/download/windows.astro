---
// SPDX-License-Identifier: Apache-2.0
// R250: /download/windows/ — per-platform page using DownloadLayout + DownloadCard.
import Base from '../../layouts/Base.astro';
import DownloadLayout from '../../components/DownloadLayout.astro';
import DownloadCard from '../../components/DownloadCard.astro';
import {
  WINDOWS_VERSION, WINDOWS_NSIS_URL, WINDOWS_MSI_URL,
  WINDOWS_NSIS_SIZE, WINDOWS_MSI_SIZE, WINDOWS_NSIS_SHA, WINDOWS_MSI_SHA,
  WINDOWS_MIN_OS, WINDOWS_BUILD_TARGET,
} from '../../lib/versions';

const VERSION = WINDOWS_VERSION;
const title = `Download Pulse for Windows — v${VERSION}`;
const description = 'Pulse lives in the system tray and opens with a global hotkey. Signed installer, no admin needed for the per-user build, MSI for managed deployments. Works on Windows 10 and 11.';
---
<Base title={title} description={description}>
  <DownloadLayout title={title} description={description} currentPlatform="windows" version={`v${VERSION}`}>
    <span slot="title">Get Pulse on <span class="hl">Windows.</span></span>
    <p slot="lede" class="lede">Pulse lives in the system tray and opens with a global hotkey. Signed installer, no admin needed for the per-user build, MSI for managed deployments. Works on Windows 10 and 11.</p>

    <section class="dl-section dl-section--sur" id="download-windows">
      <div class="dl-section__inner">
        <span class="eyebrow">v{VERSION} · latest</span>
        <h2>Pick your installer.</h2>

        <DownloadCard
          name="NSIS installer (per-user)"
          href={WINDOWS_NSIS_URL}
          filename={`Pulse_${VERSION}_x64-setup.exe`}
          size={WINDOWS_NSIS_SIZE}
          arch="x86_64"
          tag="Recommended"
          description="Installs to %LOCALAPPDATA%. No admin rights, no UAC prompt. Use this on a personal machine."
          checksum={WINDOWS_NSIS_SHA}
        />

        <DownloadCard
          name="MSI installer (per-machine)"
          href={WINDOWS_MSI_URL}
          filename={`Pulse_${VERSION}_x64_en-US.msi`}
          size={WINDOWS_MSI_SIZE}
          arch="x86_64"
          description="Installs to Program Files via Windows Installer. Needs admin. Use this for managed deployments, Group Policy, or shared lab machines."
          checksum={WINDOWS_MSI_SHA}
        />

        <DownloadCard
          name="Portable .exe"
          href={`/downloads/Pulse_${VERSION}_x64.exe`}
          filename={`Pulse_${VERSION}_x64.exe`}
          size="11.92 MB"
          arch="x86_64"
          description="Single .exe, no install, no registry entries. Drop in a folder, double-click, it runs. Good for USB sticks or sandboxed environments."
        />
      </div>
    </section>

    <section class="dl-section dl-section--sur2">
      <div class="dl-section__inner">
        <span class="eyebrow">System requirements</span>
        <h2>What you need to run Pulse.</h2>
        <div class="dl-reqs">
          <div class="dl-req"><span class="dl-req__name">OS</span><span class="dl-req__val">Windows 10 (1809+) · 11</span></div>
          <div class="dl-req"><span class="dl-req__name">Architecture</span><span class="dl-req__val">x86_64 · arm64 (preview)</span></div>
          <div class="dl-req"><span class="dl-req__name">RAM</span><span class="dl-req__val">4 GB minimum · 8 GB for 7B models</span></div>
          <div class="dl-req"><span class="dl-req__name">Disk</span><span class="dl-req__val">200 MB app · 4–8 GB per model</span></div>
          <div class="dl-req"><span class="dl-req__name">GPU</span><span class="dl-req__val">Optional · CUDA · Vulkan · DirectML</span></div>
          <div class="dl-req"><span class="dl-req__name">Runtime</span><span class="dl-req__val">None · self-contained binary</span></div>
          <div class="dl-req"><span class="dl-req__name">Build</span><span class="dl-req__val">release · {WINDOWS_BUILD_TARGET}</span></div>
          <div class="dl-req"><span class="dl-req__name">Min OS</span><span class="dl-req__val">{WINDOWS_MIN_OS}</span></div>
        </div>
      </div>
    </section>

    <section class="dl-section dl-section--sur">
      <div class="dl-section__inner">
        <span class="eyebrow">Install</span>
        <h2>Three steps. Under a minute.</h2>
        <ol class="dl-steps">
          <li class="dl-step"><div class="dl-step__body">
            <div class="dl-step__name">Download the .exe</div>
            <div class="dl-step__sub">Pick NSIS for a personal machine, MSI for managed deployment. The download is ~{WINDOWS_NSIS_SIZE}, no separate runtime needed.</div>
          </div></li>
          <li class="dl-step"><div class="dl-step__body">
            <div class="dl-step__name">Run the installer</div>
            <div class="dl-step__sub">Double-click the file. NSIS asks for no admin rights and writes to <code>%LOCALAPPDATA%\Pulse</code>. MSI requires admin and writes to <code>Program Files\Pulse</code>.</div>
          </div></li>
          <li class="dl-step"><div class="dl-step__body">
            <div class="dl-step__name">Open from the tray</div>
            <div class="dl-step__sub">Pulse appears as an icon in the system tray. Right-click for the menu, left-click to open the side panel. Press <code>Ctrl+Space</code> anywhere to toggle.</div>
          </div></li>
        </ol>
      </div>
    </section>
  </DownloadLayout>
</Base>
