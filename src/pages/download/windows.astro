---
// SPDX-License-Identifier: Apache-2.0
/**
 * R248g: per-platform download page for Windows.
 *
 * Pattern: per-platform download page (Roman, 2026-08-08) — centered
 * hero with abstract gradient backdrop, the product mockup below,
 * a 3-column meta grid (system requirements / build details /
 * verify your download), and an "Also available on" cross-link
 * strip at the bottom that points to the 4 sibling per-platform
 * pages.
 *
 * Replaces the marketing purpose of the old /install/windows/
 * page (R135). The /install/windows/ page is kept untouched —
 * it documents the 10-section build-from-source guide for users
 * who want to compile their own.
 *
 * All version / URL / size / SHA constants are sourced from
 * `src/lib/versions.ts` (the SSOT). The next Windows version
 * bump is a 1-line edit to public/updates/desktop.json, not a
 * search-replace across this file.
 *
 * Hard rules: no emoji, no "we / I / by Roman / Pulse team", no
 * marketing fluff, no future promises, dark-only (Tokyo Night),
 * Apache 2.0 SPDX, 48dp+ touch targets, prefers-reduced-motion
 * respected.
 */
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/notes.css';
import '../../styles/download-page.css';
import {
  WINDOWS_VERSION,
  WINDOWS_NSIS_URL,
  WINDOWS_MSI_URL,
  WINDOWS_PORTABLE_URL,
  WINDOWS_NSIS_SIZE,
  WINDOWS_MSI_SIZE,
  WINDOWS_PORTABLE_SIZE,
  WINDOWS_NSIS_SHA,
  WINDOWS_MSI_SHA,
  WINDOWS_PORTABLE_SHA,
  WINDOWS_NSIS_SHA256,
  WINDOWS_MSI_SHA256,
  WINDOWS_PORTABLE_SHA256,
  WINDOWS_MIN_OS,
  WINDOWS_BUILD_TARGET,
  ANDROID_APK_SIZE,
  SITE_BASE,
} from '../../lib/versions';

const VERSION = WINDOWS_VERSION;

// Per-page metadata
const PAGE_TITLE = `Download Pulse for Windows v${VERSION} — NSIS · MSI · portable`;
const PAGE_DESC = `Download Pulse v${VERSION} for Windows. NSIS installer (per-user), MSI installer (per-machine, IT admins), or portable .exe. SHA-256 verified. Local-first, no account, 14-day trial included.`;

// Absolute download URLs (pinned to ownlocalml.com per R130)
const NSIS_URL_ABS = `${SITE_BASE}${WINDOWS_NSIS_URL}`;
const MSI_URL_ABS  = `${SITE_BASE}${WINDOWS_MSI_URL}`;
const PORT_URL_ABS = `${SITE_BASE}${WINDOWS_PORTABLE_URL}`;

const NSIS_FILE = WINDOWS_NSIS_URL.split('/').pop() ?? '';
const MSI_FILE  = WINDOWS_MSI_URL.split('/').pop() ?? '';
const PORT_FILE = WINDOWS_PORTABLE_URL.split('/').pop() ?? '';

// R128 SEO polish: one SoftwareApplication JSON-LD block. The
// hub /download/ emits its own; this one describes just the
// Windows installer so search engines can surface it as a
// per-platform deep link.
const softwareAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Pulse for Windows',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Windows 10, Windows 11',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  description: 'A side panel for Windows. Sits in the system tray, opens with a global hotkey, talks to a local model.',
  softwareVersion: VERSION,
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  downloadUrl: NSIS_URL_ABS,
};
---
<Base
  title={PAGE_TITLE}
  description={PAGE_DESC}
  ogImage="/og-image.svg"
  ctaText={`Download for Windows ↓ ${WINDOWS_NSIS_SIZE}`}
  ctaHref={WINDOWS_NSIS_URL}
  ctaVisible={true}
  footerLicense=""
  footerVersion={`v${VERSION}`}
  canonical="https://ownlocalml.com/download/windows/"
>
  <a class="skip-link" href="#main">Skip to content</a>

  
  {/* R251: header is rendered by <Base/> via <RayHeader/> */}


  <main id="main" class="notes-main">
    <!-- ─── Hero ──────────────────────────────────────── -->
    <section class="dlpg-hero" aria-labelledby="dlpg-hero-title">
      <div class="dlpg-hero__bg" aria-hidden="true">
        <div class="dlpg-hero__bg-shape dlpg-hero__bg-shape--1"></div>
        <div class="dlpg-hero__bg-shape dlpg-hero__bg-shape--2"></div>
        <div class="dlpg-hero__bg-shape dlpg-hero__bg-shape--3"></div>
      </div>
      <div class="dlpg-hero__inner">
        <span class="dlpg-hero__eyebrow">
          <span class="dlpg-hero__eyebrow-dot" aria-hidden="true"></span>
          Pulse for Windows · v{VERSION}
        </span>
        <h1 class="dlpg-hero__title" id="dlpg-hero-title">
          Pulse for <span class="dlpg-hero__title-hl">Windows.</span>
        </h1>
        <p class="dlpg-hero__sub">
          A side panel for your desktop. Tray icon, global hotkey, talks to a
          local model. NSIS installer for individuals, MSI for IT admins.
        </p>
        <div class="dlpg-hero__ctas">
          <a class="btn btn--primary dlpg-hero__btn" href={WINDOWS_NSIS_URL} rel="noopener noreferrer" download>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
            </svg>
            Download for Windows
            <span class="dlpg-hero__size">{WINDOWS_NSIS_SIZE}</span>
          </a>
          <a class="btn btn--ghost dlpg-hero__btn" href={WINDOWS_MSI_URL} rel="noopener noreferrer" download>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download MSI
            <span class="dlpg-hero__size">{WINDOWS_MSI_SIZE}</span>
          </a>
        </div>
        <p class="dlpg-hero__meta">v{VERSION} · Windows 10+ · {WINDOWS_BUILD_TARGET}</p>
      </div>
    </section>

    <!-- ─── Mockup (Pulse chat panel) ───────────────────── -->
    <section class="dlpg-mock" aria-labelledby="dlpg-mock-title">
      <div class="dlpg-mock__inner">
        <div class="dlpg-mock__frame">
          <h2 class="visually-hidden" id="dlpg-mock-title">Pulse side panel preview</h2>
          <div class="dlpg-mock-chat" role="img" aria-label="Pulse chat panel showing a user prompt and an assistant response from a local model">
            <div class="dlpg-mock-chat__topbar">
              <div class="dlpg-mock-chat__left">
                <span class="dlpg-mock-chat__model">gemma3:4b</span>
              </div>
              <span class="dlpg-mock-chat__status">
                <span class="dlpg-mock-chat__dot" aria-hidden="true"></span>
                local · ready
              </span>
            </div>
            <div class="dlpg-mock-chat__messages">
              <div class="dlpg-mock-chat__msg dlpg-mock-chat__msg--user">
                <span class="dlpg-mock-chat__role dlpg-mock-chat__role--user">You</span>
                <p>Summarize the changelog for v{VERSION} in three bullets.</p>
              </div>
              <div class="dlpg-mock-chat__msg dlpg-mock-chat__msg--assistant">
                <span class="dlpg-mock-chat__role dlpg-mock-chat__role--assistant">Pulse</span>
                <p>Inline image paste into chat (PNG/JPEG, base64 round-trip). First-run onboarding with three opt-in slides. Multi-chat tabs with parallel conversations.</p>
              </div>
            </div>
            <div class="dlpg-mock-chat__composer">
              <span class="dlpg-mock-chat__mic" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                  <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                  <line x1="12" y1="19" x2="12" y2="23"></line>
                  <line x1="8" y1="23" x2="16" y2="23"></line>
                </svg>
              </span>
              <span class="dlpg-mock-chat__input">Ask anything…</span>
              <span class="dlpg-mock-chat__send" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
              </span>
            </div>
          </div>
          <p class="dlpg-mock__caption">
            Pulse for Windows. Tray icon, global hotkey, talks to a local model.
          </p>
        </div>
      </div>
    </section>

    <!-- ─── Meta grid (3 columns) ──────────────────────── -->
    <section class="dlpg-meta" aria-labelledby="dlpg-meta-title">
      <h2 class="visually-hidden" id="dlpg-meta-title">Build details</h2>
      <div class="dlpg-meta__grid">
        <article class="dlpg-meta__col" aria-labelledby="meta-win-req">
          <h3 id="meta-win-req">System requirements</h3>
          <ul>
            <li>{WINDOWS_MIN_OS}</li>
            <li>Windows 11 (any build)</li>
            <li>x86_64 architecture</li>
            <li>~200 MB free disk</li>
            <li>4 GB RAM minimum (8 GB recommended)</li>
            <li>Ollama runtime bundled (no separate install step)</li>
          </ul>
        </article>

        <article class="dlpg-meta__col" aria-labelledby="meta-win-build">
          <h3 id="meta-win-build">Build details</h3>
          <dl>
            <div>
              <dt>version</dt>
              <dd>v{VERSION}</dd>
            </div>
            <div>
              <dt>build target</dt>
              <dd><code>{WINDOWS_BUILD_TARGET}</code></dd>
            </div>
            <div>
              <dt>installer</dt>
              <dd>tauri-bundler</dd>
            </div>
            <div>
              <dt>NSIS</dt>
              <dd><code>{NSIS_FILE}</code></dd>
            </div>
            <div>
              <dt>MSI</dt>
              <dd><code>{MSI_FILE}</code></dd>
            </div>
            <div>
              <dt>portable</dt>
              <dd><code>{PORT_FILE}</code> · {WINDOWS_PORTABLE_SIZE}</dd>
            </div>
            <div>
              <dt>license</dt>
              <dd><a href="/license/">Proprietary</a></dd>
            </div>
          </dl>
        </article>

        <article class="dlpg-meta__col" aria-labelledby="meta-win-verify">
          <h3 id="meta-win-verify">Verify your download</h3>
          <dl>
            <div>
              <dt>NSIS SHA-256</dt>
              <dd><code>{WINDOWS_NSIS_SHA256.slice(0, 16)}…{WINDOWS_NSIS_SHA256.slice(-8)}</code></dd>
            </div>
            <div>
              <dt>MSI SHA-256</dt>
              <dd><code>{WINDOWS_MSI_SHA256.slice(0, 16)}…{WINDOWS_MSI_SHA256.slice(-8)}</code></dd>
            </div>
            <div>
              <dt>portable SHA-256</dt>
              <dd><code>{WINDOWS_PORTABLE_SHA256.slice(0, 16)}…{WINDOWS_PORTABLE_SHA256.slice(-8)}</code></dd>
            </div>
            <div>
              <dt>verify</dt>
              <dd><a href="/install/windows/#verify">full hashes + how-to</a></dd>
            </div>
            <div>
              <dt>notes</dt>
              <dd><a href="/changelog/#v{VERSION}">v{VERSION} release notes</a></dd>
            </div>
          </dl>
        </article>
      </div>
    </section>

    <!-- ─── Also available on (cross-link to siblings) ──── -->
    <nav class="dlpg-other" aria-labelledby="dlpg-other-title">
      <div class="dlpg-other__inner">
        <h2 id="dlpg-other-title">Also available on</h2>
        <p>Pulse ships installers for Windows and Android. The other platforms live on the install guides and on GitHub.</p>
        <ul class="dlpg-other__list" role="list">
          <li>
            <a class="dlpg-other__item" href="/download/windows/" aria-current="page">
              <span class="dlpg-other__item-name">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="7" height="7"></rect>
                  <rect x="14" y="3" width="7" height="7"></rect>
                  <rect x="3" y="14" width="7" height="7"></rect>
                  <rect x="14" y="14" width="7" height="7"></rect>
                </svg>
                Windows
              </span>
              <span class="dlpg-other__item-meta">{WINDOWS_NSIS_SIZE} · v{VERSION}</span>
            </a>
          </li>
          <li>
            <a class="dlpg-other__item" href="/download/android/">
              <span class="dlpg-other__item-name">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                  <line x1="12" y1="18" x2="12.01" y2="18"></line>
                </svg>
                Android
              </span>
              <span class="dlpg-other__item-meta">{ANDROID_APK_SIZE} · v{VERSION}</span>
            </a>
          </li>
          <li>
            <a class="dlpg-other__item" href="/download/macos/">
              <span class="dlpg-other__item-name">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                  <line x1="8" y1="21" x2="16" y2="21"></line>
                  <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
                macOS
              </span>
              <span class="dlpg-other__item-meta">source build</span>
            </a>
          </li>
          <li>
            <a class="dlpg-other__item" href="/download/linux/">
              <span class="dlpg-other__item-name">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                  <line x1="8" y1="21" x2="16" y2="21"></line>
                  <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
                Linux
              </span>
              <span class="dlpg-other__item-meta">source build</span>
            </a>
          </li>
          <li>
            <a class="dlpg-other__item" href="/download/ios/">
              <span class="dlpg-other__item-name">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                  <line x1="12" y1="18" x2="12.01" y2="18"></line>
                </svg>
                iOS
              </span>
              <span class="dlpg-other__item-meta">not available</span>
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </main>

  <Footer license="" version={`v${VERSION}`} />

  <script type="application/ld+json" set:html={JSON.stringify(softwareAppJsonLd)} />
</Base>
