---
// SPDX-License-Identifier: Apache-2.0
// R250: /download/android/ — APK + sideload steps.
import Base from '../../layouts/Base.astro';
import DownloadLayout from '../../components/DownloadLayout.astro';
import DownloadCard from '../../components/DownloadCard.astro';
import {
  ANDROID_VERSION, ANDROID_VERSION_CODE, ANDROID_APP_ID,
  ANDROID_MIN_SDK, ANDROID_TARGET_SDK,
  ANDROID_APK_URL, ANDROID_APK_SIZE, ANDROID_APK_SHA,
} from '../../lib/versions';

const VERSION = ANDROID_VERSION;
const title = `Download Pulse for Android — v${VERSION}`;
const description = 'Pulse for Android is a markdown note editor with backlinks, tags, voice input, and full-text search. Sideload the signed APK — no Play Store account required.';
---
<Base title={title} description={description}>
  <DownloadLayout title={title} description={description} currentPlatform="android" version={`v${VERSION}`}>
    <span slot="title">Get Pulse on <span class="hl">Android.</span></span>
    <p slot="lede" class="lede">Pulse for Android is a markdown note editor with backlinks, tags, voice input, and full-text search. Sideload the signed APK — no Play Store account required.</p>

    <section class="dl-section dl-section--sur" id="download-android">
      <div class="dl-section__inner">
        <span class="eyebrow">v{VERSION} · latest</span>
        <h2>One signed APK. No store required.</h2>

        <DownloadCard
          name="Signed APK"
          href={ANDROID_APK_URL}
          filename={`pulse-notes-${VERSION}.apk`}
          size={ANDROID_APK_SIZE}
          arch="arm64-v8a · armv7 · x86_64"
          tag="Recommended"
          description="Universal APK with native libraries for arm64, armv7, and x86_64. Signed with v2 + v3 release keystore. Backup rules keep WebView cache off cloud-backup and device-transfer."
          checksum={ANDROID_APK_SHA}
        />
      </div>
    </section>

    <section class="dl-section dl-section--sur2">
      <div class="dl-section__inner">
        <span class="eyebrow">System requirements</span>
        <h2>What you need to run Pulse.</h2>
        <div class="dl-reqs">
          <div class="dl-req"><span class="dl-req__name">OS</span><span class="dl-req__val">Android 7.0 (API 24) or newer</span></div>
          <div class="dl-req"><span class="dl-req__name">Architecture</span><span class="dl-req__val">arm64-v8a · armv7 · x86_64</span></div>
          <div class="dl-req"><span class="dl-req__name">RAM</span><span class="dl-req__val">2 GB minimum</span></div>
          <div class="dl-req"><span class="dl-req__name">Disk</span><span class="dl-req__val">15 MB app · grows with your notes</span></div>
          <div class="dl-req"><span class="dl-req__name">Signing</span><span class="dl-req__val">Release keystore · v2 + v3</span></div>
          <div class="dl-req"><span class="dl-req__name">App ID</span><span class="dl-req__val">{ANDROID_APP_ID}</span></div>
          <div class="dl-req"><span class="dl-req__name">Min SDK · target</span><span class="dl-req__val">{ANDROID_MIN_SDK} · {ANDROID_TARGET_SDK}</span></div>
          <div class="dl-req"><span class="dl-req__name">Version code</span><span class="dl-req__val">{ANDROID_VERSION_CODE}</span></div>
        </div>
      </div>
    </section>

    <section class="dl-section dl-section--sur">
      <div class="dl-section__inner">
        <span class="eyebrow">Install</span>
        <h2>Three steps. Sideload in under a minute.</h2>
        <ol class="dl-steps">
          <li class="dl-step"><div class="dl-step__body">
            <div class="dl-step__name">Allow installs from this source</div>
            <div class="dl-step__sub">Open the APK in your file manager or browser. Android asks you to allow your file manager to install unknown apps — toggle the permission and continue.</div>
          </div></li>
          <li class="dl-step"><div class="dl-step__body">
            <div class="dl-step__name">Tap "Install"</div>
            <div class="dl-step__sub">The installer verifies the APK signature (v2 + v3) against the release keystore, then unpacks ~{ANDROID_APK_SIZE} of native libraries and WebView assets to your device.</div>
          </div></li>
          <li class="dl-step"><div class="dl-step__body">
            <div class="dl-step__name">Open Pulse</div>
            <div class="dl-step__sub">Pulse appears in your launcher. The first launch starts a 14-day trial. Notes live in a local database on your device — nothing is uploaded.</div>
          </div></li>
        </ol>
      </div>
    </section>
  </DownloadLayout>
</Base>
