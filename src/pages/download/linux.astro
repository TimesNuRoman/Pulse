---
// SPDX-License-Identifier: Apache-2.0
// R250: /download/linux/ — .deb for Debian-based distros + portable .AppImage.
import Base from '../../layouts/Base.astro';
import DownloadLayout from '../../components/DownloadLayout.astro';
import DownloadCard from '../../components/DownloadCard.astro';
import { WINDOWS_VERSION } from '../../lib/versions';

const VERSION = WINDOWS_VERSION; // desktop version is the SSOT
const title = 'Download Pulse for Linux — .deb and .AppImage';
const description = 'Pulse for Linux is built from source. Pick the .deb for Debian-based distros (Ubuntu, Debian, Mint) or the .AppImage for everything else. GTK3 + WebKit2GTK.';
---
<Base title={title} description={description}>
  <DownloadLayout title={title} description={description} currentPlatform="linux" version={`v${VERSION}`}>
    <span slot="title">Get Pulse on <span class="hl">Linux.</span></span>
    <p slot="lede" class="lede">Pulse for Linux is built from source. Pick the <code>.deb</code> for Debian-based distros (Ubuntu, Debian, Mint) or the <code>.AppImage</code> for everything else. Expect rough edges on Wayland.</p>

    <section class="dl-section dl-section--sur" id="download-linux">
      <div class="dl-section__inner">
        <span class="eyebrow">v{VERSION} · latest</span>
        <h2>Two artifacts, pick yours.</h2>

        <DownloadCard
          name=".deb package (Debian-based)"
          href={`/downloads/pulse_${VERSION}_amd64.deb`}
          filename={`pulse_${VERSION}_amd64.deb`}
          size="14.20 MB"
          arch="x86_64"
          tag="Recommended"
          description="Debian package for Ubuntu 22.04+, Debian 12+, Mint 21+, Pop!_OS 22.04+. Installs to /opt/pulse and creates a .desktop entry. Use apt to manage upgrades."
        />

        <DownloadCard
          name=".AppImage (portable)"
          href={`/downloads/pulse_${VERSION}_x86_64.AppImage`}
          filename={`pulse_${VERSION}_x86_64.AppImage`}
          size="13.95 MB"
          arch="x86_64"
          description="Single-file portable build. Works on any modern Linux distro with FUSE. Make executable, double-click, it runs. No install, no root."
        />
      </div>
    </section>

    <section class="dl-section dl-section--sur2">
      <div class="dl-section__inner">
        <span class="eyebrow">System requirements</span>
        <h2>What you need to run Pulse.</h2>
        <div class="dl-reqs">
          <div class="dl-req"><span class="dl-req__name">Distros</span><span class="dl-req__val">Ubuntu · Debian · Mint · Fedora · Arch</span></div>
          <div class="dl-req"><span class="dl-req__name">Architecture</span><span class="dl-req__val">x86_64</span></div>
          <div class="dl-req"><span class="dl-req__name">RAM</span><span class="dl-req__val">4 GB minimum · 8 GB for 7B models</span></div>
          <div class="dl-req"><span class="dl-req__name">Display</span><span class="dl-req__val">X11 (stable) · Wayland (rough)</span></div>
          <div class="dl-req"><span class="dl-req__name">GTK</span><span class="dl-req__val">GTK 3.24+</span></div>
          <div class="dl-req"><span class="dl-req__name">WebKit</span><span class="dl-req__val">WebKit2GTK 4.1+</span></div>
          <div class="dl-req"><span class="dl-req__name">GPU</span><span class="dl-req__val">Optional · Vulkan recommended</span></div>
          <div class="dl-req"><span class="dl-req__name">Signing</span><span class="dl-req__val">Unsigned · no apt or pacman repo</span></div>
        </div>
      </div>
    </section>

    <section class="dl-section dl-section--sur">
      <div class="dl-section__inner">
        <span class="eyebrow">Install</span>
        <h2>Three steps. Pick your distro.</h2>
        <ol class="dl-steps">
          <li class="dl-step"><div class="dl-step__body">
            <div class="dl-step__name">Download the package</div>
            <div class="dl-step__sub">Pick the <code>.deb</code> for Ubuntu/Debian/Mint or the <code>.AppImage</code> for any other distro. Both are ~14 MB.</div>
          </div></li>
          <li class="dl-step"><div class="dl-step__body">
            <div class="dl-step__name">Install or make executable</div>
            <div class="dl-step__sub"><b>.deb:</b> <code>sudo dpkg -i pulse_{VERSION}_amd64.deb && sudo apt -f install</code>. <b>.AppImage:</b> <code>chmod +x pulse_{VERSION}_x86_64.AppImage</code>, then double-click.</div>
          </div></li>
          <li class="dl-step"><div class="dl-step__body">
            <div class="dl-step__name">Open from your launcher</div>
            <div class="dl-step__sub">Pulse appears in your application menu under "Pulse". On GNOME, install the <code>libwebkit2gtk-4.1-0</code> package if you get a missing-library error.</div>
          </div></li>
        </ol>
      </div>
    </section>
  </DownloadLayout>
</Base>
