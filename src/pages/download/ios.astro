---
// SPDX-License-Identifier: Apache-2.0
// R250: /download/ios/ — no App Store build, fallback to Android APK on tablet.
import Base from '../../layouts/Base.astro';
import DownloadLayout from '../../components/DownloadLayout.astro';
import { ANDROID_APK_URL, ANDROID_APK_SIZE, ANDROID_VERSION } from '../../lib/versions';

const title = 'Pulse for iOS — not available, and why';
const description = 'Pulse is not on the App Store. Apple does not allow sideloading an unsigned build on iPhone or iPad. The Android APK is the tablet fallback.';
---
<Base title={title} description={description}>
  <DownloadLayout title={title} description={description} currentPlatform="ios" version="n/a">
    <span slot="title">No iOS build <span class="hl">today.</span></span>
    <p slot="lede" class="lede">Pulse is not on the App Store. Apple's rules do not allow sideloading an unsigned build on iPhone or iPad. The Android APK can be sideloaded on a tablet if a markdown editor is the goal — it shares the same data model.</p>

    <section class="dl-section dl-section--sur" id="download-ios">
      <div class="dl-section__inner">
        <span class="eyebrow">Why no iOS</span>
        <h2>Two reasons, in plain language.</h2>
        <div class="dl-reason">
          <div class="dl-reason__name">App Store policy</div>
          <div class="dl-reason__body">Apple's App Store Review Guidelines prohibit "an app that is not a standalone experience" and require all installs to flow through the Store. There is no developer-tier escape hatch for open-source apps without a paid Apple Developer account.</div>
        </div>
        <div class="dl-reason">
          <div class="dl-reason__name">No sideloading on iPhone</div>
          <div class="dl-reason__body">iOS does not allow side-loaded apps on iPhone — only on Mac (with Apple Silicon). Even on a Mac, the iOS binary requires a paid signing certificate to install on an iPhone or iPad. There is no equivalent of Android's "install from unknown sources" toggle.</div>
        </div>
      </div>
    </section>

    <section class="dl-section dl-section--sur2">
      <div class="dl-section__inner">
        <span class="eyebrow">Use the Android APK on a tablet</span>
        <h2>If a markdown editor is what you need.</h2>
        <p class="lede" style="margin-bottom: 1rem;">The Android APK runs on most x86 / arm tablets with Android 7+. Sideload it the same way you would on a phone. The data model, file format, and shortcuts are identical to Pulse for Windows.</p>
        <div class="dl-fallback">
          <div class="dl-fallback__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M6 9c-1.1 0-2 .9-2 2v5c0 1.1.9 2 2 2v2c0 .55.45 1 1 1s1-.45 1-1v-2h8v2c0 .55.45 1 1 1s1-.45 1-1v-2c1.1 0 2-.9 2-2v-5c0-1.1-.9-2-2-2H6zM8 11.5c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zM16 11.5c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zM7 8l-1.5-2.5C5.4 5.3 5.5 5 5.7 5c.2 0 .3.1.4.2L7.5 7.5C8.6 7.2 9.8 7 11 7h2c1.2 0 2.4.2 3.5.5l1.4-2.3c.1-.1.2-.2.4-.2.2 0 .3.3.2.5L17 8H7z"/></svg>
          </div>
          <div>
            <div class="dl-fallback__name">Pulse for Android · v{ANDROID_VERSION}</div>
            <div class="dl-fallback__sub">Signed APK · {ANDROID_APK_SIZE} · arm64 + x86_64</div>
          </div>
          <a class="dl-fallback__cta" href={ANDROID_APK_URL} rel="noopener noreferrer" download>Download APK</a>
        </div>
      </div>
    </section>
  </DownloadLayout>
</Base>
