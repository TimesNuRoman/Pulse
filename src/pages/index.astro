---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { getLatestRelease } from '../data/releases';
import '../styles/notes.css';
import {
  ANDROID_APK_URL,
  ANDROID_APK_SIZE,
  WINDOWS_NSIS_URL,
  WINDOWS_MSI_URL,
  WINDOWS_NSIS_SIZE,
  WINDOWS_MSI_SIZE,
} from '../lib/versions';

// R120: site simplified for users. Strip roadmap / changelog /
// implementation detail. Two product names (Pulse for Windows,
// Pulse for Android), one download CTA, three plain bullets.
// R239: the desktop "latest" version is now sourced from the
// `releases` SSOT in public/updates/desktop.json (via
// getLatestRelease). The download URLs in the JSON's
// `latest_nsis_url` field remain the source of truth for the
// artifact paths; the R239 SSOT provides the version string for
// the visible "Latest vX.Y.Z" pill on the hero.
//
// Brand rule: no first-person ("we", "I"), no founder credit, no
// "team" personal voice — use "Pulse" or no subject.
//
// R234: every URL + size + version is sourced from
// `src/lib/versions.ts` (the SSOT). The next version bump is a
// 1-line edit to public/updates/*.json, not a search-replace.

const latestDesktop = getLatestRelease('desktop');
const latestDesktopVersion: string = latestDesktop.version;

const APK_URL = ANDROID_APK_URL;
const APK_SIZE = ANDROID_APK_SIZE;
const WIN_NSIS_URL = WINDOWS_NSIS_URL;
const WIN_MSI_URL = WINDOWS_MSI_URL;
const WIN_NSIS_SIZE = WINDOWS_NSIS_SIZE;
const WIN_MSI_SIZE = WINDOWS_MSI_SIZE;

const PAGE_TITLE = 'Pulse — AI side panel for Windows and Android, paid with a 14-day trial';
const PAGE_DESC = 'Pulse is a paid, local-first AI side panel for Windows and a notes app for Android. 14-day trial, then $20/month or $192/year. No account, no cloud, no telemetry.';

// R128 SEO polish: JSON-LD SoftwareApplication block for the home page.
// R141e: offers is no longer price:0 — it's the trial model. priceSpecification
// would be ideal but we keep the schema minimal and honest: price = "0" means
// the trial is free; the subscription lives on the Polar.sh product pages.
const softwareAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Pulse',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Windows, Android',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: '14-day trial, then $20/month or $192/year subscription',
  },
  description: 'Local-first AI side panel for Windows and notes app for Android. 14-day trial, then $20/month or $192/year.',
};
---

<Base
  title={PAGE_TITLE}
  description={PAGE_DESC}
  ogImage="/og-home.png"
  ctaText="Start 14-day trial ↓"
  ctaHref="/download/"
  ctaVisible={true}
  footerLicense=""
  footerVersion=""
  canonical="https://ownlocalml.com/"
>
  <a class="skip-link" href="#main">Skip to content</a>

  <nav class="nav" id="topnav" aria-label="Primary">
    <div class="nav__inner">
      <a class="nav__brand" href="/" aria-label="Pulse — home">
        <svg class="pulse-logo" viewBox="0 0 64 64" width="28" height="28" role="img" aria-label="Pulse">
          <circle class="pulse-logo__ring" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle class="pulse-logo__ring pulse-logo__ring--2" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle class="pulse-logo__ring pulse-logo__ring--3" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle cx="32" cy="32" r="9" fill="#bb9af7"></circle>
          <circle cx="35" cy="30" r="2" fill="#1a1b26"></circle>
        </svg>
        <span class="nav__brand-name">Pulse</span>
      </a>
      <ul class="nav__links" role="list">
        <li><a class="nav__link" href="/download/">Download</a></li>
        <li><a class="nav__link" href="/pricing/">Pricing</a></li>
        <li><a class="nav__link" href="/faq/">FAQ</a></li>
      </ul>
      <div class="nav__right">
        <a class="nav__login" href="/login/" aria-label="Activate an existing license">Log in</a>
        <a class="btn btn--primary nav__cta" href="/download/">Start trial ↓</a>
        <button class="nav__burger" id="nav-burger" type="button" aria-expanded="false" aria-controls="nav-drawer" aria-label="Open menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="20" y2="17"></line>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <div class="nav-drawer" id="nav-drawer" aria-hidden="true">
    <a class="nav-drawer__link" href="/">Home</a>
    <a class="nav-drawer__link" href="/download/">Download</a>
    <a class="nav-drawer__link" href="/pricing/">Pricing</a>
    <a class="nav-drawer__link" href="/faq/">FAQ</a>
    <a class="nav-drawer__link" href="/login/">Log in</a>
    <a class="btn btn--primary nav-drawer__cta" href="/download/">Start trial ↓</a>
  </div>

  <script is:inline>
    (() => {
      const nav = document.getElementById('topnav');
      const burger = document.getElementById('nav-burger');
      const drawer = document.getElementById('nav-drawer');
      if (!nav) return;

      let scrolled = false;
      const setScrolled = (v) => {
        if (v === scrolled) return;
        scrolled = v;
        nav.classList.toggle('is-scrolled', v);
      };
      const onScroll = () => setScrolled(window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      if (burger && drawer) {
        const setOpen = (open) => {
          burger.setAttribute('aria-expanded', String(open));
          drawer.setAttribute('aria-hidden', String(!open));
          drawer.classList.toggle('is-open', open);
          document.body.style.overflow = open ? 'hidden' : '';
        };
        burger.addEventListener('click', () => {
          const isOpen = drawer.classList.contains('is-open');
          setOpen(!isOpen);
        });
        drawer.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => setOpen(false));
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
            setOpen(false);
            burger.focus();
          }
        });
        const mq = window.matchMedia('(min-width: 768px)');
        mq.addEventListener?.('change', (e) => {
          if (e.matches && drawer.classList.contains('is-open')) setOpen(false);
        });
      }
      document.body.classList.add('has-nav');
    })();
  </script>

  <main id="main">
    <!-- ─── Hero ──────────────────────────────────────── -->
    <section class="home-hero">
      <div class="bg-glow"></div>
      <div class="container home-hero__grid">
        <div class="home-hero__copy reveal">
          <h1 class="home-hero__title">
            AI on your machine.<br /><span class="home-hero__hl">Not in someone else's cloud.</span>
          </h1>
          <p class="home-hero__sub">
            Pulse is a paid, local-first AI side panel for Windows and a
            notes app for Android. Notes, chat, and your model stay on the
            device. No account, no telemetry, no upload.
          </p>
          <div class="home-hero__ctas">
            <a class="btn btn--primary btn--lg" id="hero-download" href="/download/" rel="noopener noreferrer">Start 14-day trial ↓</a>
            <a class="btn btn--ghost btn--lg" href="#what">See what it does →</a>
          </div>
          <p class="home-hero__meta">Latest v{latestDesktopVersion} · 14-day trial · $20/mo or $192/yr · Windows + Android</p>
        </div>
      </div>
    </section>

    <!-- ─── What Pulse does ──────────────────────────── -->
    <section class="home-what" id="what">
      <div class="container">
        <header class="home-what__head reveal">
          <span class="eyebrow">What Pulse does</span>
          <h2>Three things. On your device.</h2>
        </header>
        <ul class="home-what__list" role="list">
          <li class="home-what__item reveal">
            <h3>Talk to your notes.</h3>
            <p>
              Write in plain markdown on Windows or Android. Ask Pulse to
              summarize, search, or link them.
            </p>
          </li>
          <li class="home-what__item reveal">
            <h3>Bring your own AI model.</h3>
            <p>
              Connect any local model that runs on your machine. Pulse does
              not lock you to a provider.
            </p>
          </li>
          <li class="home-what__item reveal">
            <h3>Everything stays on your device.</h3>
            <p>
              Your notes, your chats, and your model never leave the
              computer or phone you installed Pulse on.
            </p>
          </li>
        </ul>
      </div>
    </section>

    <!-- ─── Start trial: two cards ─────────────────────── -->
    <section class="home-get" id="get">
      <div class="container">
        <header class="home-get__head reveal">
          <span class="eyebrow">Start trial</span>
          <h2>Pick your device.</h2>
          <p class="lede">
            Both versions are the same Pulse. Different install, same data
            model, same on-device engine.
          </p>
        </header>
        <div class="home-get__grid">
          <article class="home-get__card glass reveal" data-pick="windows">
            <span class="home-get__platform">Pulse for Windows</span>
            <h3 class="home-get__title">A side panel for your desktop.</h3>
            <p class="home-get__body">
              Lives in the system tray, opens with a global hotkey, talks
              to a local model on your machine. NSIS installer (per-user)
              or MSI (per-machine). Runs on Windows 10 and 11.
            </p>
            <div class="home-get__ctas">
              <a class="btn btn--primary" href={WIN_NSIS_URL} rel="noopener noreferrer">Download for Windows ↓ {WIN_NSIS_SIZE}</a>
              <a class="btn btn--ghost" href="/download/#windows">All Windows downloads</a>
            </div>
          </article>
          <article class="home-get__card glass reveal" data-pick="android">
            <span class="home-get__platform">Pulse for Android</span>
            <h3 class="home-get__title">A markdown editor for your phone.</h3>
            <p class="home-get__body">
              Write notes with backlinks, tags, and voice input. Find
              anything with full-text search. Sideload the APK — no Play
              Store account required.
            </p>
            <div class="home-get__ctas">
              <a class="btn btn--primary" href={APK_URL} rel="noopener noreferrer">Download APK ↓ {APK_SIZE}</a>
              <a class="btn btn--ghost" href="/download/#android">Android details</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ─── Trial ──────────────────────────────────────── -->
    <section class="home-free" id="trial">
      <div class="container home-free__inner reveal">
        <span class="eyebrow">Trial</span>
        <h2>14 days, no credit card. After that, decide.</h2>
        <p>
          The trial unlocks the basics: notes, chat with a local model,
          full-text search, backlinks, code-aware chat, and 50 web-search
          queries per day. The trial clock starts at first launch. After
          14 days the app continues to work in read-only mode unless you
          upgrade to PRO.
        </p>
        <div class="home-free__row">
          <a class="btn btn--primary btn--lg" href="/download/">Start 14-day trial ↓</a>
          <a class="btn btn--ghost btn--lg" href="/pricing/">See pricing →</a>
        </div>
      </div>
    </section>
  </main>

  <Footer license="" version="" />

  <!-- R128 SEO polish: SoftwareApplication JSON-LD for search engines.
       Same data as the visible home page copy, no extra claims. -->
  <script type="application/ld+json" set:html={JSON.stringify(softwareAppJsonLd)} />

  <script is:inline define:vars={{ APK_URL: ANDROID_APK_URL }}>
    (() => {
      // R120 site simplify: hero CTA picks the right artifact by UA.
      // - Windows desktop → /download/ page (user picks NSIS or MSI).
      // - Mobile / Android → direct APK download.
      // - macOS / Linux / unknown → /download/ page.
      // R234: APK_URL is pre-rendered from `src/lib/versions.ts` (the
      // SSOT) via Astro's `define:vars` directive.
      const a = document.getElementById('hero-download');
      if (!a) return;
      const ua = (navigator.userAgent || '').toLowerCase();
      const isAndroid = /android|mobile|iphone|ipad|ipod/.test(ua);
      if (isAndroid) {
        a.setAttribute('href', APK_URL);
      }
      // else leave as /download/ — Windows + macOS + Linux go to the picker
    })();
  </script>
</Base>

<style>
  /* ─── Hero ──────────────────────────────────────────── */
  .home-hero {
    padding-top: clamp(112px, 14vw, 160px);
    padding-bottom: clamp(64px, 9vw, 96px);
    overflow: hidden;
  }
  .home-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .home-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 820px;
  }
  .home-hero__title {
    font-size: var(--fs-1);
    line-height: 1.05;
    font-weight: 700;
    color: var(--fg);
    letter-spacing: -0.02em;
  }
  .home-hero__hl {
    background: linear-gradient(120deg, var(--purple), var(--blue));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .home-hero__sub {
    color: var(--fg-dim);
    font-size: var(--fs-body);
    line-height: 1.65;
    max-width: 60ch;
  }
  .home-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }
  .home-hero__meta {
    color: var(--muted);
    font-size: 0.92rem;
    margin: 0.25rem 0 0;
  }

  /* ─── What Pulse does ────────────────────────────── */
  .home-what { padding: 4rem 0 4rem; }
  .home-what__head { text-align: center; max-width: 640px; margin: 0 auto 2.5rem; }
  .home-what__head h2 { font-size: var(--fs-2); }
  .home-what__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    max-width: 980px;
    margin-inline: auto;
  }
  @media (min-width: 820px) {
    .home-what__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .home-what__item {
    padding: 1.5rem 1.5rem var(--sp-4);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg-soft) 100%);
    border: 1px solid var(--border);
  }
  .home-what__item h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--fg);
    margin: 0 0 0.5rem;
  }
  .home-what__item p {
    color: var(--fg-dim);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  /* ─── Start trial cards ────────────────────────────── */
  .home-get { padding: var(--sp-5) 0 4rem; }
  .home-get__head { text-align: center; max-width: 640px; margin: 0 auto 2.5rem; }
  .home-get__head h2 { font-size: var(--fs-2); }
  .home-get__head .lede { margin: 0.5rem auto 0; }
  .home-get__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 920px) {
    .home-get__grid { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  }
  .home-get__card {
    padding: var(--sp-4) var(--sp-4) 2rem;
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .home-get__platform {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--purple);
  }
  .home-get__title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--fg);
    margin: 0;
    line-height: 1.3;
  }
  .home-get__body {
    color: var(--fg-dim);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }
  .home-get__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  /* ─── Free ────────────────────────────────────────── */
  .home-free { padding: 4rem 0 5rem; position: relative; }
  .home-free__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
  }
  .home-free h2 {
    font-size: var(--fs-2);
    font-weight: 700;
    color: var(--fg);
    line-height: 1.2;
    margin: 0;
  }
  .home-free p {
    color: var(--fg-dim);
    font-size: var(--fs-body);
    line-height: 1.65;
    max-width: 60ch;
  }
  .home-free__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  /* ─── Topnav: "Log in" link (sits to the left of the Start trial CTA) ─── */
  .nav__login {
    display: none;        /* mobile: shown via the drawer */
    align-items: center;
    color: var(--fg-dim);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.5rem 0.85rem;
    min-height: 36px;
    border-radius: 8px;
    text-decoration: none;
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .nav__login:hover {
    color: var(--fg);
    background: var(--surface);
  }
  @media (min-width: 768px) {
    .nav__login { display: inline-flex; }
  }
</style>

