---
// SPDX-License-Identifier: Apache-2.0
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import '../styles/notes.css';

// R120: site simplified for users. Strip roadmap / changelog /
// implementation detail. Two product names (Pulse for Windows,
// Pulse for Android), one download CTA, three plain bullets.
//
// R248d: home page only — replaced the inlined full-width nav
// with a centered floating frosted-glass capsule, and rebuilt
// the hero around 2 side-by-side platform download pills with
// an abstract radial-gradient backdrop. The same nav markup
// still ships in BaseLayout for the other pages (see R101),
// so this page renders standalone until the integrator reconciles.
//
// Brand rule: no first-person ("we", "I"), no founder credit, no
// "team" personal voice — use "Pulse" or no subject.
//
// R234: every URL + size + version is sourced from
// `src/lib/versions.ts` (the SSOT). The next version bump is a
// 1-line edit to public/updates/*.json, not a search-replace.

const PAGE_TITLE = 'Pulse — AI side panel for Windows and Android, paid with a 14-day trial';
const PAGE_DESC = 'Pulse is a paid, local-first AI side panel for Windows and a notes app for Android. 14-day trial, then $20/month or $192/year. No account, no cloud, no telemetry.';

// R128 SEO polish: JSON-LD SoftwareApplication block for the home page.
// R141e: offers is no longer price:0 — it's the trial model. priceSpecification
// would be ideal but we keep the schema minimal and honest: price = "0" means
// the trial is free; the subscription lives on the Polar.sh product pages.
const softwareAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Pulse',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Windows, Android',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: '14-day trial, then $20/month or $192/year subscription',
  },
  description: 'Local-first AI side panel for Windows and notes app for Android. 14-day trial, then $20/month or $192/year.',
};
---

<Base
  title={PAGE_TITLE}
  description={PAGE_DESC}
  ogImage="/og-home.png"
  ctaText="Start 14-day trial ↓"
  ctaHref="/download/"
  ctaVisible={true}
  footerLicense=""
  footerVersion=""
  canonical="https://ownlocalml.com/"
>
  <a class="skip-link" href="#main">Skip to content</a>

  {/*
    R251: header is rendered by <Base/> via <RayHeader/>.
    All the inline markup, drawer, and scroll-script used to live
    here; now the component owns it so every page gets the same
    floating frosted-glass capsule with active-link highlight.
  */}

  <main id="main">
    <!-- ─── Hero ──────────────────────────────────────── -->
    <section class="home-hero-ray" id="top">
      <div class="home-hero-ray__bg" aria-hidden="true">
        <div class="home-hero-ray__shape home-hero-ray__shape--1"></div>
        <div class="home-hero-ray__shape home-hero-ray__shape--2"></div>
        <div class="home-hero-ray__shape home-hero-ray__shape--3"></div>
      </div>
      <div class="container home-hero-ray__inner reveal">
        <h1 class="home-hero-ray__title">
          AI on your machine.<br /><span class="home-hero-ray__hl">Not in someone else's cloud.</span>
        </h1>
        <p class="home-hero-ray__sub">
          Pulse is a paid, local-first AI side panel for Windows and a
          notes app for Android. Notes, chat, and your model stay on the
          device. No account, no telemetry, no upload.
        </p>
        <div class="home-hero-ray__ctas">
          <a class="btn btn--primary btn--lg" id="hero-download" href="/download/">
            Download ↓
          </a>
        </div>
        <p class="home-hero-ray__meta">Local install · 14-day trial · No account required</p>
        <a class="home-hero-ray__more" href="/changelog/">
          <span class="home-hero-ray__more-pill">Recent changes</span>
          <span class="home-hero-ray__more-sep" aria-hidden="true">|</span>
          <span class="home-hero-ray__more-link">Read the changelog →</span>
        </a>
      </div>
    </section>

    <!-- ─── What Pulse does ──────────────────────────── -->
    <section class="home-what" id="what">
      <div class="container">
        <header class="home-what__head reveal">
          <span class="eyebrow">What Pulse does</span>
          <h2>Three things. On your device.</h2>
        </header>
        <ul class="home-what__list" role="list">
          <li class="home-what__item reveal">
            <h3>Talk to your notes.</h3>
            <p>
              Write in plain markdown on Windows or Android. Ask Pulse to
              summarize, search, or link them.
            </p>
          </li>
          <li class="home-what__item reveal">
            <h3>Bring your own AI model.</h3>
            <p>
              Connect any local model that runs on your machine. Pulse does
              not lock you to a provider.
            </p>
          </li>
          <li class="home-what__item reveal">
            <h3>Everything stays on your device.</h3>
            <p>
              Your notes, your chats, and your model never leave the
              computer or phone you installed Pulse on.
            </p>
          </li>
        </ul>
      </div>
    </section>

    <!-- ─── Showcase: Chat ─────────────────────────────── -->
    <!-- R248e: Interactive product showcase. Pseudo-UI panels that
         approximate real Pulse desktop surfaces (chat, routing,
         voice). All inline HTML/CSS, no JS for the static panels.
         The routing pills panel uses ~40 LoC of inline JS for tab
         switching (the only feature that's fundamentally
         interactive). Pseudo-UI is visually approximate, not a
         real screenshot — but uses Pulse colors, real copy, real
         component structure so it reads as "this is what Pulse
         looks like", not a marketing render. -->
    <section class="home-showcase" id="showcase-chat" aria-labelledby="showcase-chat-title">
      <div class="container home-showcase__grid">
        <div class="home-showcase__copy reveal">
          <span class="eyebrow">Chat</span>
          <h2 id="showcase-chat-title">Talk to a local model. From your tray.</h2>
          <p class="lede">
            Pulse opens with a global hotkey, lives in the system tray, and
            talks to any model you have running on the machine — gemma,
            llama, qwen, mistral. Chat history stays in a local file.
          </p>
          <a class="home-showcase__more" href="/download/">Get Pulse for Windows &nbsp;↓</a>
        </div>
        <div class="home-showcase__demo reveal">
          <div class="demo-chat" role="img" aria-label="Pulse chat panel: a local-model conversation with copy button and voice input">
            <div class="demo-chat__topbar">
              <span class="demo-chat__model">gemma3:4b</span>
              <span class="demo-chat__status">
                <span class="demo-chat__dot" aria-hidden="true"></span>
                connected
              </span>
            </div>
            <div class="demo-chat__messages">
              <div class="demo-chat__msg demo-chat__msg--user">
                Summarize the README.
              </div>
              <div class="demo-chat__msg demo-chat__msg--assistant">
                <p>
                  Pulse is a local-first AI side panel for Windows and a
                  notes app for Android. Notes, chat, and the model stay
                  on the device. No account, no telemetry, no upload.
                </p>
                <button class="demo-chat__copy" type="button" aria-label="Copy assistant message">Copy</button>
              </div>
            </div>
            <div class="demo-chat__composer">
              <span class="demo-chat__mic" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="2" width="6" height="12" rx="3"></rect>
                  <path d="M5 11a7 7 0 0 0 14 0"></path>
                  <line x1="12" y1="18" x2="12" y2="22"></line>
                </svg>
              </span>
              <span class="demo-chat__input">Ask anything…</span>
              <span class="demo-chat__send" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"></path>
                  <path d="M13 6l6 6-6 6"></path>
                </svg>
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Showcase: Routing modes (interactive) ──────── -->
    <section class="home-showcase home-showcase--reverse" id="showcase-routing" aria-labelledby="showcase-routing-title">
      <div class="container home-showcase__grid">
        <div class="home-showcase__copy reveal">
          <span class="eyebrow">Routing</span>
          <h2 id="showcase-routing-title">Six routing modes. One model swap.</h2>
          <p class="lede">
            Each prompt takes a different path: short answers, code edits,
            planning, vision, tests. The pill you pick routes the next
            round through a different model or prompt — without
            re-installing anything.
          </p>
          <a class="home-showcase__more" href="/faq/">How routing works &nbsp;→</a>
        </div>
        <div class="home-showcase__demo reveal">
          <div class="demo-routing" data-testid="demo-routing">
            <div class="demo-routing__pills" role="tablist" aria-label="Routing mode">
              <button type="button" role="tab" id="pill-auto" class="demo-routing__pill is-active" aria-selected="true" aria-controls="demo-routing-panel" data-pill="auto" aria-label="Auto-routing (no override)">Авто</button>
              <button type="button" role="tab" id="pill-ask" class="demo-routing__pill" aria-selected="false" aria-controls="demo-routing-panel" data-pill="ask" aria-label="Quick Answer — short reply">Ask</button>
              <button type="button" role="tab" id="pill-plan" class="demo-routing__pill" aria-selected="false" aria-controls="demo-routing-panel" data-pill="plan" aria-label="Reasoning — analysis and planning">План</button>
              <button type="button" role="tab" id="pill-code" class="demo-routing__pill" aria-selected="false" aria-controls="demo-routing-panel" data-pill="code" aria-label="CodeEdit — generation and refactor">Код</button>
              <button type="button" role="tab" id="pill-vision" class="demo-routing__pill" aria-selected="false" aria-controls="demo-routing-panel" data-pill="vision" aria-label="Vision — image and screenshot description">Препью</button>
              <button type="button" role="tab" id="pill-default" class="demo-routing__pill" aria-selected="false" aria-controls="demo-routing-panel" data-pill="default" aria-label="Default — general fallback">Тесты</button>
            </div>
            <div
              class="demo-routing__panel"
              id="demo-routing-panel"
              role="tabpanel"
              aria-labelledby="pill-auto"
              data-testid="demo-routing-panel"
            >
              <span class="demo-routing__tag" data-routing-tag>Auto</span>
              <p class="demo-routing__text" data-routing-text>
                Pulse reads the prompt and picks the best mode for the
                next round — short answer, planning, code, or vision.
                Override with a pill any time; Pulse remembers the
                choice for the rest of the conversation.
              </p>
            </div>
            <span class="demo-routing__hint" aria-hidden="true">Tap a pill →</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Showcase: Voice input ──────────────────────── -->
    <section class="home-showcase" id="showcase-voice" aria-labelledby="showcase-voice-title">
      <div class="container home-showcase__grid">
        <div class="home-showcase__copy reveal">
          <span class="eyebrow">Voice</span>
          <h2 id="showcase-voice-title">Hold to talk. Text lands in the input.</h2>
          <p class="lede">
            Hold the mic, speak, release. Pulse runs speech-to-text
            locally, the transcript lands in the composer, and you can
            edit before sending. No upload, no cloud STT.
          </p>
          <a class="home-showcase__more" href="/install/windows/">Setup voice on Windows &nbsp;→</a>
        </div>
        <div class="home-showcase__demo reveal">
          <div class="demo-voice" role="img" aria-label="Voice input panel: a large microphone button, an animated waveform, and three live transcript lines">
            <div class="demo-voice__row">
              <span class="demo-voice__chip">STT · Web Speech · Chrome 138</span>
              <span class="demo-voice__timer" aria-hidden="true">0:04</span>
            </div>
            <div class="demo-voice__center">
              <span class="demo-voice__btn" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="2" width="6" height="12" rx="3"></rect>
                  <path d="M5 11a7 7 0 0 0 14 0"></path>
                  <line x1="12" y1="18" x2="12" y2="22"></line>
                </svg>
              </span>
              <div class="voice-waveform" role="img" aria-label="Recording volume">
                <span class="voice-waveform__bar" style="--vw-scale:0.35; --vw-delay:0s"></span>
                <span class="voice-waveform__bar" style="--vw-scale:0.7;  --vw-delay:0.08s"></span>
                <span class="voice-waveform__bar" style="--vw-scale:0.95; --vw-delay:0.16s"></span>
                <span class="voice-waveform__bar" style="--vw-scale:0.55; --vw-delay:0.24s"></span>
                <span class="voice-waveform__bar" style="--vw-scale:0.8;  --vw-delay:0.32s"></span>
                <span class="voice-waveform__bar" style="--vw-scale:0.4;  --vw-delay:0.4s"></span>
                <span class="voice-waveform__bar" style="--vw-scale:0.65; --vw-delay:0.48s"></span>
              </div>
            </div>
            <ul class="demo-voice__transcript" role="list">
              <li class="demo-voice__line"><span class="demo-voice__ts">0:01</span> открой</li>
              <li class="demo-voice__line"><span class="demo-voice__ts">0:02</span> найди Pulse README</li>
              <li class="demo-voice__line demo-voice__line--live" aria-live="polite"><span class="demo-voice__ts">0:04</span> <span class="demo-voice__caret" aria-hidden="true"></span> пр</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Pick your device — one download CTA (R261) + platforms row (R273) ── -->
    <section class="home-get" id="get">
      <div class="container">
        <header class="home-get__head reveal">
          <h2>Pick your device.</h2>
        </header>
        <div class="home-get__cta reveal">
          <a class="btn btn--primary btn--lg home-get__btn" href="/download/">
            Download ↓
          </a>
        </div>
        <p class="home-get__platforms reveal" aria-label="Supported platforms">
          Windows · Android · build from source for macOS / Linux
        </p>
      </div>
    </section>

    <!-- ─── Trial ──────────────────────────────────────── -->
    <section class="home-free" id="trial">
      <div class="container home-free__inner reveal">
        <span class="eyebrow">Trial</span>
        <h2>14 days, no credit card. After that, decide.</h2>
        <p>
          The trial unlocks the basics: notes, chat with a local model,
          full-text search, backlinks, code-aware chat, and 50 web-search
          queries per day. The trial clock starts at first launch. After
          14 days the app continues to work in read-only mode unless you
          upgrade to PRO.
        </p>
        <div class="home-free__row">
          <a class="btn btn--primary btn--lg" href="/download/">Start 14-day trial ↓</a>
          <a class="btn btn--ghost btn--lg" href="/pricing/">See pricing →</a>
        </div>
      </div>
    </section>
  </main>

  <!-- R248e: Routing pill interactivity. Six tabs (Авто / Ask / План /
       Код / Препью / Тесты), each swaps the panel text + tag. Mirrors
       the real Pulse desktop ChatView ROUTING_PILLS array (r248). No
       framework, no deps, ~40 LoC. Keyboard nav: ←/→ moves focus
       between pills, Home/End jump to first/last, Enter/Space activates
       (default <button> behavior). aria-selected is the source of
       truth; .is-active is a visual mirror for the CSS. -->
  <script is:inline>
    (() => {
      // Routing mode data — labels and copy mirror the real
      // pulse-desktop-r248/web/src/components/ChatView.tsx ROUTING_PILLS
      // (without emoji, in Pulse style).
      const PILL_TEXTS = {
        auto: {
          tag: 'Auto',
          text: 'Pulse reads the prompt and picks the best mode for the next round — short answer, planning, code, or vision. Override with a pill any time; Pulse remembers the choice for the rest of the conversation.',
        },
        ask: {
          tag: 'QuickAnswer',
          text: 'Short, factual reply. Routes to a fast model with a tight context window. Use it for one-line lookups, definitions, and quick clarifications.',
        },
        plan: {
          tag: 'Reasoning',
          text: 'Multi-step planning and analysis. Routes to a larger model with a wider context. Use it for architecture decisions, refactor strategy, or any prompt that needs the model to think out loud.',
        },
        code: {
          tag: 'CodeEdit',
          text: 'Code generation and refactor. Routes through a code-aware prompt with parseable code blocks in the response. Use it for "rewrite this function", "add a test", "explain this diff".',
        },
        vision: {
          tag: 'Vision',
          text: 'Image and screenshot description. Attaches the current screenshot (or any image in the chat) as a multimodal block. Use it for "what is on this screenshot" or "summarize this UI".',
        },
        default: {
          tag: 'Default',
          text: 'General fallback when the other five modes do not match. Routes to a balanced model with the system prompt unchanged. Use it as the safe choice when in doubt.',
        },
      };

      const root = document.querySelector('[data-testid="demo-routing"]');
      if (!root) return;
      const pills = root.querySelectorAll('[data-pill]');
      const panel = root.querySelector('#demo-routing-panel');
      const tagEl = panel?.querySelector('[data-routing-tag]');
      const textEl = panel?.querySelector('[data-routing-text]');
      if (!pills.length || !panel || !tagEl || !textEl) return;

      function activate(pill) {
        const key = pill.getAttribute('data-pill');
        if (!key || !(key in PILL_TEXTS)) return;
        pills.forEach((p) => {
          const isActive = p === pill;
          p.setAttribute('aria-selected', isActive ? 'true' : 'false');
          p.classList.toggle('is-active', isActive);
          p.setAttribute('tabindex', isActive ? '0' : '-1');
        });
        const data = PILL_TEXTS[key];
        tagEl.textContent = data.tag;
        textEl.textContent = data.text;
        panel.setAttribute('aria-labelledby', pill.id);
      }

      pills.forEach((pill) => {
        pill.addEventListener('click', () => activate(pill));
        pill.addEventListener('keydown', (e) => {
          const list = Array.from(pills);
          const idx = list.indexOf(pill);
          if (idx < 0) return;
          let next = null;
          if (e.key === 'ArrowRight') next = list[(idx + 1) % list.length];
          else if (e.key === 'ArrowLeft') next = list[(idx - 1 + list.length) % list.length];
          else if (e.key === 'Home') next = list[0];
          else if (e.key === 'End') next = list[list.length - 1];
          if (next) {
            e.preventDefault();
            next.focus();
            activate(next);
          }
        });
      });
    })();
  </script>

  <Footer license="" version="" />

  <!-- R128 SEO polish: SoftwareApplication JSON-LD for search engines.
       Same data as the visible home page copy, no extra claims. -->
  <script type="application/ld+json" set:html={JSON.stringify(softwareAppJsonLd)} />
</Base>

<style is:global>
  /* ─── Floating capsule header (R248d) ─────────────────
     Centered, frosted glass, ~880px wide, with a thin border
     and a soft drop shadow. Scrolls opaque (background gets
     denser and the border sharpens on scroll). */

  .ray-header {
    position: fixed;
    top: clamp(12px, 1.6vw, 20px);
    left: 0; right: 0;
    z-index: 50;
    padding: 0 clamp(12px, 2vw, 20px);
    pointer-events: none;        /* let clicks fall through to the
                                    inner capsule, which captures them */
  }
  .ray-header__inner {
    pointer-events: auto;
    width: 100%;
    max-width: 880px;
    margin: 0 auto;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0 0.5rem 0 1.1rem;
    border-radius: 9999px;       /* pill / capsule */
    background: var(--topnav-bg);
    border: 1px solid var(--topnav-border);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.4),
      0 0 0 1px var(--glass) inset;
    transition:
      background var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .ray-header.is-scrolled .ray-header__inner {
    background: var(--topnav-bg-scrolled);
    border-color: var(--border-strong);
  }

  .ray-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg);
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    min-height: 44px;             /* a11y touch target */
    flex-shrink: 0;
  }
  .ray-header__brand:hover { color: var(--fg); }
  .ray-header__brand-name { font-weight: 700; letter-spacing: -0.005em; }
  .ray-header__brand svg { width: 28px; height: 28px; flex-shrink: 0; }

  .ray-header__links {
    display: none;
    align-items: center;
    gap: 1.5rem;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .ray-header__links { display: flex; }
  }
  .ray-header__link {
    color: var(--fg-dim);
    font-size: 0.92rem;
    font-weight: 500;
    padding: 0.5rem 0.25rem;
    border-radius: 6px;
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .ray-header__link:hover { color: var(--fg); }
  .ray-header__link[aria-current="page"] { color: var(--purple); }

  .ray-header__right {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  .ray-header__login {
    display: none;
    color: var(--fg-dim);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.5rem 0.7rem;
    text-decoration: none;
    border-radius: 6px;
    transition: color var(--dur) var(--ease);
  }
  @media (min-width: 768px) {
    .ray-header__login { display: inline-flex; }
  }
  .ray-header__login:hover { color: var(--fg); }

  .ray-header__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: var(--fg);
    color: #1a1b26;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 9999px;
    text-decoration: none;
    min-height: 36px;
    transition:
      transform var(--dur) var(--ease),
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .ray-header__cta:hover {
    background: #e8eaf6;
    color: #1a1b26;
    transform: translateY(-1px);
  }
  .ray-header__cta svg { width: 14px; height: 14px; }

  .ray-header__burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    color: var(--fg);
    border: 1px solid var(--border);
    background: transparent;
    transition: border-color var(--dur) var(--ease);
  }
  .ray-header__burger:hover { border-color: var(--fg-dim); }
  @media (min-width: 768px) { .ray-header__burger { display: none; } }
  .ray-header__burger svg { width: 18px; height: 18px; }

  /* Drawer (mobile only; same UX as the legacy .nav-drawer
     but bound to .ray-drawer so it pairs with the new header). */
  .ray-drawer {
    position: fixed;
    inset: calc(56px + clamp(12px, 1.6vw, 20px) + 8px) 0 0;
    z-index: 49;
    background: var(--topnav-bg-scrolled);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
