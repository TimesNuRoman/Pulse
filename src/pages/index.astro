---
// SPDX-License-Identifier: Apache-2.0
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { getLatestRelease } from '../data/releases';
import '../styles/notes.css';
import {
  ANDROID_APK_URL,
  ANDROID_APK_SIZE,
  WINDOWS_NSIS_URL,
  WINDOWS_MSI_URL,
  WINDOWS_NSIS_SIZE,
  WINDOWS_MSI_SIZE,
} from '../lib/versions';

// R120: site simplified for users. Strip roadmap / changelog /
// implementation detail. Two product names (Pulse for Windows,
// Pulse for Android), one download CTA, three plain bullets.
// R239: the desktop "latest" version is now sourced from the
// `releases` SSOT in public/updates/desktop.json (via
// getLatestRelease). The download URLs in the JSON's
// `latest_nsis_url` field remain the source of truth for the
// artifact paths; the R239 SSOT provides the version string for
// the visible "Latest vX.Y.Z" pill on the hero.
//
// R248d: home page only — replaced the inlined full-width nav
// with a centered floating frosted-glass capsule, and rebuilt
// the hero around 2 side-by-side platform download pills with
// an abstract radial-gradient backdrop. The same nav markup
// still ships in BaseLayout for the other pages (see R101),
// so this page renders standalone until the integrator reconciles.
//
// Brand rule: no first-person ("we", "I"), no founder credit, no
// "team" personal voice — use "Pulse" or no subject.
//
// R234: every URL + size + version is sourced from
// `src/lib/versions.ts` (the SSOT). The next version bump is a
// 1-line edit to public/updates/*.json, not a search-replace.

const latestDesktop = getLatestRelease('desktop');
const latestDesktopVersion: string = latestDesktop.version;

const APK_URL = ANDROID_APK_URL;
const APK_SIZE = ANDROID_APK_SIZE;
const WIN_NSIS_URL = WINDOWS_NSIS_URL;
const WIN_MSI_URL = WINDOWS_MSI_URL;
const WIN_NSIS_SIZE = WINDOWS_NSIS_SIZE;
const WIN_MSI_SIZE = WINDOWS_MSI_SIZE;

const PAGE_TITLE = 'Pulse — AI side panel for Windows and Android, paid with a 14-day trial';
const PAGE_DESC = 'Pulse is a paid, local-first AI side panel for Windows and a notes app for Android. 14-day trial, then $20/month or $192/year. No account, no cloud, no telemetry.';

// R128 SEO polish: JSON-LD SoftwareApplication block for the home page.
// R141e: offers is no longer price:0 — it's the trial model. priceSpecification
// would be ideal but we keep the schema minimal and honest: price = "0" means
// the trial is free; the subscription lives on the Polar.sh product pages.
const softwareAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Pulse',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Windows, Android',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: '14-day trial, then $20/month or $192/year subscription',
  },
  description: 'Local-first AI side panel for Windows and notes app for Android. 14-day trial, then $20/month or $192/year.',
};
---

<Base
  title={PAGE_TITLE}
  description={PAGE_DESC}
  ogImage="/og-home.png"
  ctaText="Start 14-day trial ↓"
  ctaHref="/download/"
  ctaVisible={true}
  footerLicense=""
  footerVersion=""
  canonical="https://ownlocalml.com/"
>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="ray-header" id="topnav" role="navigation" aria-label="Primary">
    <div class="ray-header__inner glass">
      <a class="ray-header__brand" href="/" aria-label="Pulse — home">
        <svg class="pulse-logo" viewBox="0 0 64 64" width="28" height="28" role="img" aria-label="Pulse">
          <circle class="pulse-logo__ring" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle class="pulse-logo__ring pulse-logo__ring--2" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle class="pulse-logo__ring pulse-logo__ring--3" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle cx="32" cy="32" r="9" fill="#bb9af7"></circle>
          <circle cx="35" cy="30" r="2" fill="#1a1b26"></circle>
        </svg>
        <span class="ray-header__brand-name">Pulse</span>
      </a>
      <nav class="ray-header__links" aria-label="Primary">
        <a class="ray-header__link" href="/download/">Download</a>
        <a class="ray-header__link" href="/pricing/">Pricing</a>
        <a class="ray-header__link" href="/faq/">FAQ</a>
      </nav>
      <div class="ray-header__right">
        <a class="ray-header__login" href="/pricing/">Log in</a>
        <a class="ray-header__cta" href="/download/">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14"></path>
            <path d="M19 12l-7 7-7-7"></path>
          </svg>
          Download
        </a>
        <button class="ray-header__burger" id="nav-burger" type="button" aria-expanded="false" aria-controls="nav-drawer" aria-label="Open menu">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="20" y2="17"></line>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <div class="ray-drawer" id="nav-drawer" aria-hidden="true">
    <a class="ray-drawer__link" href="/">Home</a>
    <a class="ray-drawer__link" href="/download/">Download</a>
    <a class="ray-drawer__link" href="/pricing/">Pricing</a>
    <a class="ray-drawer__link" href="/faq/">FAQ</a>
    <a class="btn btn--primary ray-drawer__cta" href="/download/">Start trial ↓</a>
  </div>

  <script is:inline>
    (() => {
      const nav = document.getElementById('topnav');
      const burger = document.getElementById('nav-burger');
      const drawer = document.getElementById('nav-drawer');
      if (!nav) return;

      let scrolled = false;
      const setScrolled = (v) => {
        if (v === scrolled) return;
        scrolled = v;
        nav.classList.toggle('is-scrolled', v);
      };
      const onScroll = () => setScrolled(window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      if (burger && drawer) {
        const setOpen = (open) => {
          burger.setAttribute('aria-expanded', String(open));
          drawer.setAttribute('aria-hidden', String(!open));
          drawer.classList.toggle('is-open', open);
          document.body.style.overflow = open ? 'hidden' : '';
        };
        burger.addEventListener('click', () => {
          const isOpen = drawer.classList.contains('is-open');
          setOpen(!isOpen);
        });
        drawer.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => setOpen(false));
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
            setOpen(false);
            burger.focus();
          }
        });
        const mq = window.matchMedia('(min-width: 768px)');
        mq.addEventListener?.('change', (e) => {
          if (e.matches && drawer.classList.contains('is-open')) setOpen(false);
        });
      }
      document.body.classList.add('has-nav');
    })();
  </script>

  <main id="main">
    <!-- ─── Hero ──────────────────────────────────────── -->
    <section class="home-hero-ray" id="top">
      <div class="home-hero-ray__bg" aria-hidden="true">
        <div class="home-hero-ray__shape home-hero-ray__shape--1"></div>
        <div class="home-hero-ray__shape home-hero-ray__shape--2"></div>
        <div class="home-hero-ray__shape home-hero-ray__shape--3"></div>
      </div>
      <div class="container home-hero-ray__inner reveal">
        <h1 class="home-hero-ray__title">
          AI on your machine.<br /><span class="home-hero-ray__hl">Not in someone else's cloud.</span>
        </h1>
        <p class="home-hero-ray__sub">
          Pulse is a paid, local-first AI side panel for Windows and a
          notes app for Android. Notes, chat, and your model stay on the
          device. No account, no telemetry, no upload.
        </p>
        <div class="home-hero-ray__ctas">
          <a class="home-hero-ray__btn home-hero-ray__btn--win" id="hero-download" href="/download/" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3 5.5L10.5 4.5v7.5H3v-6.5zM11.5 4.4L21 3v9h-9.5V4.4zM3 13.5h7.5V21L3 19.5v-6zM11.5 13.5H21V21l-9.5-1.5v-6z"></path>
            </svg>
            Download for Windows
            <span class="home-hero-ray__size">↓ {WIN_NSIS_SIZE}</span>
          </a>
          <a class="home-hero-ray__btn home-hero-ray__btn--android" href={APK_URL} rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6 9c-1.1 0-2 .9-2 2v5c0 1.1.9 2 2 2v2c0 .55.45 1 1 1s1-.45 1-1v-2h8v2c0 .55.45 1 1 1s1-.45 1-1v-2c1.1 0 2-.9 2-2v-5c0-1.1-.9-2-2-2H6zM8 11.5c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zM16 11.5c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zM7 8L5.5 5.5C5.4 5.3 5.5 5 5.7 5c.2 0 .3.1.4.2L7.5 7.5C8.6 7.2 9.8 7 11 7h2c1.2 0 2.4.2 3.5.5l1.4-2.3c.1-.1.2-.2.4-.2.2 0 .3.3.2.5L17 8H7z"></path>
            </svg>
            Download APK
            <span class="home-hero-ray__size">↓ {APK_SIZE}</span>
          </a>
        </div>
        <p class="home-hero-ray__meta">Install via winget · Try Pulse v{latestDesktopVersion}</p>
        <a class="home-hero-ray__more" href="/changelog/#v0.6.9">
          <span class="home-hero-ray__more-pill">Meet Pulse v3.1</span>
          <span class="home-hero-ray__more-sep" aria-hidden="true">|</span>
          <span class="home-hero-ray__more-link">Learn more →</span>
        </a>
      </div>
    </section>

    <!-- ─── What Pulse does ──────────────────────────── -->
    <section class="home-what" id="what">
      <div class="container">
        <header class="home-what__head reveal">
          <span class="eyebrow">What Pulse does</span>
          <h2>Three things. On your device.</h2>
        </header>
        <ul class="home-what__list" role="list">
          <li class="home-what__item reveal">
            <h3>Talk to your notes.</h3>
            <p>
              Write in plain markdown on Windows or Android. Ask Pulse to
              summarize, search, or link them.
            </p>
          </li>
          <li class="home-what__item reveal">
            <h3>Bring your own AI model.</h3>
            <p>
              Connect any local model that runs on your machine. Pulse does
              not lock you to a provider.
            </p>
          </li>
          <li class="home-what__item reveal">
            <h3>Everything stays on your device.</h3>
            <p>
              Your notes, your chats, and your model never leave the
              computer or phone you installed Pulse on.
            </p>
          </li>
        </ul>
      </div>
    </section>

    <!-- ─── Start trial: two cards ─────────────────────── -->
    <section class="home-get" id="get">
      <div class="container">
        <header class="home-get__head reveal">
          <span class="eyebrow">Start trial</span>
          <h2>Pick your device.</h2>
          <p class="lede">
            Both versions are the same Pulse. Different install, same data
            model, same on-device engine.
          </p>
        </header>
        <div class="home-get__grid">
          <article class="home-get__card glass reveal" data-pick="windows">
            <span class="home-get__platform">Pulse for Windows</span>
            <h3 class="home-get__title">A side panel for your desktop.</h3>
            <p class="home-get__body">
              Lives in the system tray, opens with a global hotkey, talks
              to a local model on your machine. NSIS installer (per-user)
              or MSI (per-machine). Runs on Windows 10 and 11.
            </p>
            <div class="home-get__ctas">
              <a class="btn btn--primary" href={WIN_NSIS_URL} rel="noopener noreferrer">Download for Windows ↓ {WIN_NSIS_SIZE}</a>
              <a class="btn btn--ghost" href="/download/#windows">All Windows downloads</a>
            </div>
          </article>
          <article class="home-get__card glass reveal" data-pick="android">
            <span class="home-get__platform">Pulse for Android</span>
            <h3 class="home-get__title">A markdown editor for your phone.</h3>
            <p class="home-get__body">
              Write notes with backlinks, tags, and voice input. Find
              anything with full-text search. Sideload the APK — no Play
              Store account required.
            </p>
            <div class="home-get__ctas">
              <a class="btn btn--primary" href={APK_URL} rel="noopener noreferrer">Download APK ↓ {APK_SIZE}</a>
              <a class="btn btn--ghost" href="/download/#android">Android details</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ─── Trial ──────────────────────────────────────── -->
    <section class="home-free" id="trial">
      <div class="container home-free__inner reveal">
        <span class="eyebrow">Trial</span>
        <h2>14 days, no credit card. After that, decide.</h2>
        <p>
          The trial unlocks the basics: notes, chat with a local model,
          full-text search, backlinks, code-aware chat, and 50 web-search
          queries per day. The trial clock starts at first launch. After
          14 days the app continues to work in read-only mode unless you
          upgrade to PRO.
        </p>
        <div class="home-free__row">
          <a class="btn btn--primary btn--lg" href="/download/">Start 14-day trial ↓</a>
          <a class="btn btn--ghost btn--lg" href="/pricing/">See pricing →</a>
        </div>
      </div>
    </section>
  </main>

  <Footer license="" version="" />

  <!-- R128 SEO polish: SoftwareApplication JSON-LD for search engines.
       Same data as the visible home page copy, no extra claims. -->
  <script type="application/ld+json" set:html={JSON.stringify(softwareAppJsonLd)} />

  <script is:inline define:vars={{ APK_URL: ANDROID_APK_URL }}>
    (() => {
      // R248d: hero has TWO pills now (Windows + APK). On Android
      // mobile the Windows pill collapses — the APK pill is already
      // direct. So on Android we just hide the Windows pill (it would
      // download an .exe that can't run on the phone) and let the APK
      // pill take the full row. Other platforms see both pills side
      // by side and can pick whichever fits.
      const win = document.getElementById('hero-download');
      if (!win) return;
      const ua = (navigator.userAgent || '').toLowerCase();
      const isAndroid = /android/.test(ua);
      if (isAndroid) {
        win.style.display = 'none';
      }
      // On iOS we also hide it — same reason. (The APK CTA stays.)
      if (/iphone|ipad|ipod/.test(ua)) {
        win.style.display = 'none';
      }
    })();
  </script>
</Base>

<style is:global>
  /* ─── Floating capsule header (R248d) ─────────────────
     Centered, frosted glass, ~880px wide, with a thin border
     and a soft drop shadow. Scrolls opaque (background gets
     denser and the border sharpens on scroll). */

  .ray-header {
    position: fixed;
    top: clamp(12px, 1.6vw, 20px);
    left: 0; right: 0;
    z-index: 50;
    padding: 0 clamp(12px, 2vw, 20px);
    pointer-events: none;        /* let clicks fall through to the
                                    inner capsule, which captures them */
  }
  .ray-header__inner {
    pointer-events: auto;
    width: 100%;
    max-width: 880px;
    margin: 0 auto;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0 0.5rem 0 1.1rem;
    border-radius: 9999px;       /* pill / capsule */
    background: rgba(26, 27, 38, 0.6);
    border: 1px solid var(--border);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.02) inset;
    transition:
      background var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .ray-header.is-scrolled .ray-header__inner {
    background: rgba(26, 27, 38, 0.85);
    border-color: var(--border-strong);
  }

  .ray-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg);
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    min-height: 44px;             /* a11y touch target */
    flex-shrink: 0;
  }
  .ray-header__brand:hover { color: var(--fg); }
  .ray-header__brand-name { font-weight: 700; letter-spacing: -0.005em; }
  .ray-header__brand svg { width: 28px; height: 28px; flex-shrink: 0; }

  .ray-header__links {
    display: none;
    align-items: center;
    gap: 1.5rem;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .ray-header__links { display: flex; }
  }
  .ray-header__link {
    color: var(--fg-dim);
    font-size: 0.92rem;
    font-weight: 500;
    padding: 0.5rem 0.25rem;
    border-radius: 6px;
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .ray-header__link:hover { color: var(--fg); }
  .ray-header__link[aria-current="page"] { color: var(--purple); }

  .ray-header__right {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  .ray-header__login {
    display: none;
    color: var(--fg-dim);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.5rem 0.7rem;
    text-decoration: none;
    border-radius: 6px;
    transition: color var(--dur) var(--ease);
  }
  @media (min-width: 768px) {
    .ray-header__login { display: inline-flex; }
  }
  .ray-header__login:hover { color: var(--fg); }

  .ray-header__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: var(--fg);
    color: #1a1b26;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 9999px;
    text-decoration: none;
    min-height: 36px;
    transition:
      transform var(--dur) var(--ease),
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .ray-header__cta:hover {
    background: #e8eaf6;
    color: #1a1b26;
    transform: translateY(-1px);
  }
  .ray-header__cta svg { width: 14px; height: 14px; }

  .ray-header__burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    color: var(--fg);
    border: 1px solid var(--border);
    background: transparent;
    transition: border-color var(--dur) var(--ease);
  }
  .ray-header__burger:hover { border-color: var(--fg-dim); }
  @media (min-width: 768px) { .ray-header__burger { display: none; } }
  .ray-header__burger svg { width: 18px; height: 18px; }

  /* Drawer (mobile only; same UX as the legacy .nav-drawer
     but bound to .ray-drawer so it pairs with the new header). */
  .ray-drawer {
    position: fixed;
    inset: calc(56px + clamp(12px, 1.6vw, 20px) + 8px) 0 0;
    z-index: 49;
    background: rgba(26, 27, 38, 0.96);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    display: flex;
    flex-direction: column;
    padding: 1.5rem var(--gutter) 2rem;
    gap: 0.5rem;
    transform: translateY(-110%);
    transition: transform var(--dur) var(--ease);
    visibility: hidden;
    overflow-y: auto;
  }
  .ray-drawer.is-open { transform: translateY(0); visibility: visible; }
  .ray-drawer__link {
    display: block;
    padding: 0.85rem 0.25rem;
    color: var(--fg);
    font-size: 1.1rem;
    font-weight: 500;
    border-bottom: 1px solid var(--border);
    letter-spacing: -0.005em;
    text-decoration: none;
  }
  .ray-drawer__link:hover { color: var(--purple); }
  .ray-drawer__cta {
    margin-top: 1rem;
    align-self: stretch;
    min-height: 52px;
    font-size: 1.05rem;
  }

  /* ─── Hero (R248d) ────────────────────────────────────
     Centered, with a soft abstract radial-gradient backdrop
     in Tokyo Night colors (purple / blue / cyan). Two
     side-by-side pill CTAs (Windows + APK), each with a
     platform icon and a dimmed file-size text. The
     "Meet Pulse v3.1" outline pill at the bottom links to
     the changelog anchor. */
  .home-hero-ray {
    position: relative;
    padding-top: clamp(120px, 16vw, 180px);
    padding-bottom: clamp(72px, 11vw, 128px);
    text-align: center;
    overflow: hidden;
  }
  .home-hero-ray__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .home-hero-ray__shape {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    will-change: transform;
  }
  .home-hero-ray__shape--1 {
    top: 18%;
    left: 50%;
    transform: translateX(-50%);
    width: 620px;
    height: 620px;
    background: radial-gradient(circle, rgba(187, 154, 247, 0.55) 0%, transparent 60%);
    opacity: 0.55;
  }
  .home-hero-ray__shape--2 {
    top: 40%;
    left: 12%;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(122, 162, 247, 0.45) 0%, transparent 65%);
    opacity: 0.4;
  }
  .home-hero-ray__shape--3 {
    top: 26%;
    right: 10%;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(125, 207, 255, 0.4) 0%, transparent 65%);
    opacity: 0.3;
  }
  @media (max-width: 639px) {
    .home-hero-ray__shape--1 { width: 460px; height: 460px; }
    .home-hero-ray__shape--2 { width: 280px; height: 280px; left: -40px; }
    .home-hero-ray__shape--3 { width: 320px; height: 320px; right: -40px; }
  }

  .home-hero-ray__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    max-width: 880px;
    margin: 0 auto;
  }
  .home-hero-ray__title {
    font-size: clamp(2.4rem, 5.6vw + 0.5rem, 4.5rem);
    line-height: 1.05;
    font-weight: 700;
    color: var(--fg);
    letter-spacing: -0.025em;
    margin: 0;
  }
  .home-hero-ray__hl {
