---
// R104: /notes/ → /download/#android
// Unification: Pulse Notes is now the Android section of /download/.
// Old link still works (meta refresh + JS redirect) but the canonical
// surface is /download/.
//
// We do NOT issue an HTTP 301 here (Astro static output makes that
// a config-file change at the host, not in the build). Meta refresh
// is the universal fallback; the JS redirect is the snappy one for
// modern browsers. Both go to /download/#android.
import Base from '../layouts/Base.astro';

const REDIRECT_TO = '/download/#android';
const REDIRECT_AFTER_MS = 0;  // immediate
---

<Base
  title="Redirecting — Pulse for Android"
  description="Pulse for Android is now the Android section of /download/. Redirecting."
  ctaVisible={false}
  footerLicense=""
  footerVersion=""
>
  <noscript>
    <meta http-equiv="refresh" content={`${REDIRECT_AFTER_MS}; url=${REDIRECT_TO}`} />
  </noscript>
  <script is:inline set:html={`window.location.replace(${JSON.stringify(REDIRECT_TO)});`} />

  <main class="legal">
    <div class="container">
      <header class="legal__head reveal">
        <span class="eyebrow">Redirecting</span>
        <h1>Pulse for Android is now at <a href={REDIRECT_TO}>/download/</a>.</h1>
        <p class="lede">
          The Android surface moved to a section of the unified download
          page. If your browser does not follow the redirect automatically,
          follow the link above.
        </p>
        <p style="margin-top: 1.5rem;">
          <a class="btn btn--primary" href={REDIRECT_TO}>Open /download/ ↓</a>
        </p>
      </header>
    </div>
  </main>
</Base>
