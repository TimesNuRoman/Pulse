---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import '../styles/notes.css';
---
<Base
  title="Notes that remember. · Pulse"
  description="Pulse Notes v0.5.2 — a local-first second brain. CodeMirror 6 markdown editor, split-pane preview, [[wikilink]] backlinks, tag autocomplete, M3 toolbar. No cloud, no telemetry."
  ogImage="/og/notes.svg"
>
  <a class="skip-link" href="#main">Skip to content</a>

  <nav class="nav" id="topnav" aria-label="Primary">
    <div class="nav__inner">
      <a class="nav__brand" href="/" aria-label="Pulse — home">
        <svg class="pulse-logo" viewBox="0 0 64 64" width="28" height="28" role="img" aria-label="Pulse">
          <circle class="pulse-logo__ring" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle class="pulse-logo__ring pulse-logo__ring--2" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle class="pulse-logo__ring pulse-logo__ring--3" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle cx="32" cy="32" r="9" fill="#bb9af7"></circle>
          <circle cx="35" cy="30" r="2" fill="#1a1b26"></circle>
        </svg>
        <span class="nav__brand-name">Pulse</span>
      </a>
      <ul class="nav__links" role="list">
        <li><a class="nav__link" href="/#features">Features</a></li>
        <li><a class="nav__link is-cta" href="/notes/" aria-current="page">Notes</a></li>
        <li><a class="nav__link" href="/#download">Download</a></li>
        <li><a class="nav__link" href="/changelog/">Changelog</a></li>
        <li><a class="nav__link" href="/changelog/">Blog</a></li>
      </ul>
      <div class="nav__right">
        <a class="btn btn--primary nav__cta" href="/#download">Get Pulse ↓ 12MB</a>
        <button class="nav__burger" id="nav-burger" type="button" aria-expanded="false" aria-controls="nav-drawer" aria-label="Open menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="20" y2="17"></line>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <div class="nav-drawer" id="nav-drawer" aria-hidden="true">
    <a class="nav-drawer__link" href="/#features">Features</a>
    <a class="nav-drawer__link" href="/notes/" aria-current="page">Notes</a>
    <a class="nav-drawer__link" href="/#download">Download</a>
    <a class="nav-drawer__link" href="/changelog/">Changelog</a>
    <a class="nav-drawer__link" href="/changelog/">Blog</a>
    <a class="btn btn--primary nav-drawer__cta" href="/#download">Get Pulse ↓ 12MB</a>
  </div>

  <script is:inline>
    (() => {
      const nav = document.getElementById('topnav');
      const burger = document.getElementById('nav-burger');
      const drawer = document.getElementById('nav-drawer');
      if (!nav) return;

      let scrolled = false;
      const setScrolled = (v) => {
        if (v === scrolled) return;
        scrolled = v;
        nav.classList.toggle('is-scrolled', v);
      };
      const onScroll = () => setScrolled(window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      if (burger && drawer) {
        const setOpen = (open) => {
          burger.setAttribute('aria-expanded', String(open));
          drawer.setAttribute('aria-hidden', String(!open));
          drawer.classList.toggle('is-open', open);
          document.body.style.overflow = open ? 'hidden' : '';
        };
        burger.addEventListener('click', () => {
          const isOpen = drawer.classList.contains('is-open');
          setOpen(!isOpen);
        });
        drawer.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => setOpen(false));
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
            setOpen(false);
            burger.focus();
          }
        });
        const mq = window.matchMedia('(min-width: 768px)');
        mq.addEventListener?.('change', (e) => {
          if (e.matches && drawer.classList.contains('is-open')) setOpen(false);
        });
      }
      document.body.classList.add('has-nav');
    })();
  </script>

  <main id="main" class="notes-main">
    <!-- ─── Hero ────────────────────────────────────────── -->
    <section class="notes-hero">
      <div class="bg-glow"></div>
      <div class="container notes-hero__grid">
        <div class="notes-hero__copy reveal">
          <div class="notes-hero__badges">
            <span class="notes-hero__eyebrow">Pulse Notes · killer feature</span>
            <span class="notes-hero__pill" aria-label="Latest version">
              <span class="notes-hero__pill-dot" aria-hidden="true"></span>
              Latest v0.5.2
            </span>
          </div>
          <h1 class="notes-hero__title">
            Notes that <span class="notes-hero__hl">remember.</span>
          </h1>
          <p class="notes-hero__sub">
            Pulse Notes v0.5.2 ships a real markdown editor: CodeMirror 6 with
            syntax highlighting, a drag-resize split-pane, <code>[[wikilink]]</code>
            backlinks, tag autocomplete, and a Material 3 toolbar. Local-first.
            SQLite + FTS5. The note you saved two days ago is the one Pulse
            surfaces when you ask.
          </p>
          <div class="notes-hero__ctas">
            <a class="btn btn--primary btn--lg" href="/#download">Get Pulse</a>
            <a class="btn btn--ghost btn--lg" href="#new-in-v5">What is new</a>
          </div>
          <ul class="notes-hero__trust" role="list" aria-label="Quick highlights">
            <li class="notes-hero__trust-item">Local-first</li>
            <li class="notes-hero__trust-sep" aria-hidden="true">·</li>
            <li class="notes-hero__trust-item">SQLite + FTS5</li>
            <li class="notes-hero__trust-sep" aria-hidden="true">·</li>
            <li class="notes-hero__trust-item">No cloud</li>
            <li class="notes-hero__trust-sep" aria-hidden="true">·</li>
            <li class="notes-hero__trust-item">No telemetry</li>
            <li class="notes-hero__trust-sep" aria-hidden="true">·</li>
            <li class="notes-hero__trust-item">Apache 2.0</li>
          </ul>
        </div>
        <div class="notes-hero__composite reveal" aria-hidden="true">
          <div class="notes-hero__halo"></div>
          <figure class="notes-hero__shot notes-hero__shot--editor">
            <img
              src="/mockups/notes-v5-editor.svg"
              alt="Pulse Notes editor with split-pane preview"
              width="720"
              height="480"
              loading="eager"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- ─── Killer demo: Capture. Wait. Recall. ────────── -->
    <section class="kd" id="killer-demo">
      <div class="container">
        <header class="kd__head reveal">
          <span class="eyebrow">The actual flow</span>
          <h2>Capture. Wait. Recall.</h2>
          <p class="lede">
            Three steps. No cloud round-trips, no email scans, no notification
            listeners. The same note you saved two days ago is the one Pulse
            surfaces when you ask.
          </p>
        </header>
        <ol class="kd__steps" role="list">
          <li class="kd__step reveal" id="kd-1">
            <div class="kd__step-num" aria-hidden="true">01</div>
            <div class="kd__step-body">
              <span class="kd__step-label">Capture</span>
              <h3 class="kd__step-title">You share a Telegram message about a hotel in Bangkok.</h3>
              <p class="kd__step-copy">
                Pulse catches the share intent on Android, opens the capture sheet,
                and pre-fills it with the original text. Tags like <code>#travel</code>
                and <code>#bangkok</code> are added automatically. You tap save, or
                you do nothing — Pulse saves it for you after 3 seconds.
              </p>
            </div>
          </li>
          <li class="kd__step reveal" id="kd-2">
            <div class="kd__step-num" aria-hidden="true">02</div>
            <div class="kd__step-body">
              <span class="kd__step-label">Wait</span>
              <h3 class="kd__step-title">Two days pass. You don't open Pulse once.</h3>
              <p class="kd__step-copy">
                There is nothing to do. The note sits in your local SQLite database,
                fully searchable, with no syncing, no background calls, no telemetry
                ping. The local model is idle, the OS is not being asked to keep
                anything warm.
              </p>
            </div>
          </li>
          <li class="kd__step reveal" id="kd-3">
            <div class="kd__step-num" aria-hidden="true">03</div>
            <div class="kd__step-body">
              <span class="kd__step-label">Recall</span>
              <h3 class="kd__step-title">You ask Pulse: "Planning Thailand in October. What was the Bangkok hotel?"</h3>
              <p class="kd__step-copy">
                The agent pulls the right note from the local index, shows the
                source, and answers. No cloud round-trip, no LLM training on your
                messages, no email scan, no notification listener. Just the note
                you saved, surfaced at the moment you needed it.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- ─── 4 core features ────────────────────────────── -->
    <section class="nf" id="features">
      <div class="container">
        <header class="nf__head reveal">
          <span class="eyebrow">What is in the box</span>
          <h2>Four things. No roadmap.</h2>
          <p class="lede">
            The features that ship in Pulse Notes v0.5.x. Anything not on this
            list is in the issue tracker, not in the marketing.
          </p>
        </header>
        <div class="nf__grid">
          <article class="nf__card glass reveal" id="capture">
            <span class="nf__card-label">Capture</span>
            <h3 class="nf__card-title">Share from anywhere. Pulse writes the note.</h3>
            <p class="nf__card-body">
              Forward a Telegram message, share from Slack, drop a screenshot.
              Pulse turns it into a note, auto-tags it, and links it back to the
              source. No "import" flow, no spreadsheet of bookmarks.
            </p>
          </article>
          <article class="nf__card glass reveal" id="search">
            <span class="nf__card-label">Search</span>
            <h3 class="nf__card-title">Find anything across notes, captures, chats.</h3>
            <p class="nf__card-body">
              FTS5 full-text search. One search box covers notes, captures, chat
              history, and skills. Results are instant because the index lives on
              your disk, in the same SQLite file as the data.
            </p>
          </article>
          <article class="nf__card glass reveal" id="link">
            <span class="nf__card-label">Link</span>
            <h3 class="nf__card-title">[[wiki-style]] backlinks, tags, relations.</h3>
            <p class="nf__card-body">
              Type <code>[[</code> to link one note to another. Tags are coloured
              by semantics — blue for topics, yellow for time, green for relations,
              purple for tools. It feels like Obsidian because the data model is
              the same; the difference is what runs locally.
            </p>
          </article>
          <article class="nf__card glass reveal" id="recall">
            <span class="nf__card-label">Recall</span>
            <h3 class="nf__card-title">Pulse surfaces relevant notes when you ask.</h3>
            <p class="nf__card-body">
              Ask "what was the Bangkok hotel?" and the right note appears, even
              if you wrote it three weeks ago. No cloud embeddings, no telemetry.
              The same local model that runs chat runs the recall.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ─── What's new in v0.5.x — 5 new features ──────── -->
    <section class="new-in-v5" id="new-in-v5">
      <div class="container">
        <header class="new-in-v5__head reveal">
          <span class="eyebrow">What shipped in v0.5.x</span>
          <h2>Five things the markdown editor bought us.</h2>
          <p class="lede">
            v0.5.1 replaced the plain textarea with CodeMirror 6, wired up
            markdown-it 14 + highlight.js 11 + @lezer/highlight, and split the
            editor and preview into a drag-resize pane. The new surface unlocked
            five capabilities that ship in the v0.5.2 build you can download
            today.
          </p>
        </header>

        <!-- 1. Markdown editor -->
        <article class="n5 reveal" id="v5-editor">
          <div class="n5__copy">
            <span class="n5__label">New · Editor</span>
            <h3 class="n5__title">A real markdown editor, not a textarea.</h3>
            <p class="n5__body">
              CodeMirror 6 with the markdown grammar and the Lezer syntax tree.
              Line numbers, code-block highlighting, smart indentation, and
              bracket-matching on. The editor lazy-loads with the
              <code>notes.markdown.v2</code> feature flag — default ON, ~82&nbsp;KB
              gzipped, no impact on the list view.
            </p>
            <ul class="n5__list">
              <li><strong>Lezer highlighting</strong> for headings, lists, links, code, emphasis.</li>
              <li><strong>Line numbers</strong> + current-line gutter, always on.</li>
              <li><strong>Smart indent</strong> on Enter inside lists and code blocks.</li>
              <li><strong>Keyboard-first</strong> — Tab/Shift-Tab indent, Ctrl+D duplicates line.</li>
            </ul>
          </div>
          <figure class="n5__figure">
            <img
              src="/mockups/notes-v5-editor.svg"
              alt="CodeMirror 6 markdown editor with split-pane preview"
              width="1200"
              height="800"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Editor (left) + rendered preview (right) — drag the divider to resize.</figcaption>
          </figure>
        </article>

        <!-- 2. Split-pane -->
        <article class="n5 n5--reverse reveal" id="v5-split-pane">
          <div class="n5__copy">
            <span class="n5__label">New · Split-pane</span>
            <h3 class="n5__title">Editor left, preview right. Drag the divider.</h3>
            <p class="n5__body">
              A horizontal divider that you can drag to any ratio from 20/80 to
              80/20. The pane widths persist per-note in the SQLite database,
              not in localStorage, so a note opened on the desktop and a
              different note opened on the laptop keep their own layouts.
            </p>
            <ul class="n5__list">
              <li><strong>Drag-resize</strong> with mouse, touch, or keyboard arrows when focused.</li>
              <li><strong>Per-note width</strong> stored in the notes table, not localStorage.</li>
              <li><strong>Collapse</strong> either side with a single click on the divider grip.</li>
              <li><strong>Preview updates</strong> debounced to 80&nbsp;ms — no input lag at 4K.</li>
            </ul>
          </div>
          <figure class="n5__figure">
            <img
              src="/mockups/notes-v5-editor.svg"
              alt="Drag-resize split-pane between markdown editor and rendered preview"
              width="1200"
              height="800"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Two panes, one divider. Resize ratio persists per note.</figcaption>
          </figure>
        </article>

        <!-- 3. Backlinks ([[wikilink]] autocomplete) -->
        <article class="n5 reveal" id="v5-backlinks">
          <div class="n5__copy">
            <span class="n5__label">New · Backlinks</span>
            <h3 class="n5__title"><code>[[wikilink]]</code> with autocomplete and cross-note navigation.</h3>
            <p class="n5__body">
              Type <code>[[</code> and a fuzzy-match dropdown opens over the
              cursor. Pick an existing note to insert a link, or type a new
              title and press Enter to create the target on save. Clicking a
              <code>[[link]]</code> in the preview navigates to that note.
              The backlink index is rebuilt on save — no background worker,
              no debounce trick, just a single SQL query.
            </p>
            <ul class="n5__list">
              <li><strong>Autocomplete</strong> on <code>[[</code> — fuzzy match against note titles.</li>
              <li><strong>Create-on-the-fly</strong> — type a new title, press Enter, the note exists.</li>
              <li><strong>Click to navigate</strong> in the rendered preview.</li>
              <li><strong>Backlinks panel</strong> at the bottom of every note shows what links in.</li>
            </ul>
          </div>
          <figure class="n5__figure">
            <img
              src="/mockups/notes-v5-backlinks.svg"
              alt="Note editor with [[wikilink]] autocomplete dropdown"
              width="1200"
              height="800"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Type <code>[[</code> and the dropdown opens over the cursor.</figcaption>
          </figure>
        </article>

        <!-- 4. Tag autocomplete -->
        <article class="n5 n5--reverse reveal" id="v5-tag-autocomplete">
          <div class="n5__copy">
            <span class="n5__label">New · Tag autocomplete</span>
            <h3 class="n5__title">Type <code>#</code> and existing tags surface.</h3>
            <p class="n5__body">
              The tag autocomplete in v0.5.2 is a real fuzzy match, not a
              static list. It runs against every tag currently in the database
              (case-insensitive prefix + subsequence match), ranked by usage
              frequency so the tags you actually use float to the top.
            </p>
            <ul class="n5__list">
              <li><strong>Fuzzy match</strong> — <code>#bkk</code> matches <code>#bangkok</code>.</li>
              <li><strong>Ranked by frequency</strong> — your top 10 tags always come first.</li>
              <li><strong>Inline create</strong> — type a new tag, press Space, it exists.</li>
              <li><strong>Keyboard nav</strong> — ↑/↓/Enter/Escape, no mouse required.</li>
            </ul>
          </div>
          <figure class="n5__figure">
            <img
              src="/mockups/notes-v5-backlinks.svg"
              alt="Note editor with #tag autocomplete dropdown"
              width="1200"
              height="800"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Tag fuzzy-match dropdown, ranked by how often you actually use each tag.</figcaption>
          </figure>
        </article>

        <!-- 5. M3 toolbar -->
        <article class="n5 reveal" id="v5-toolbar">
          <div class="n5__copy">
            <span class="n5__label">New · Toolbar</span>
            <h3 class="n5__title">Seven formatting actions on a Material 3 toolbar.</h3>
            <p class="n5__body">
              A floating action bar at the top of the editor with the seven
              actions that cover 90% of formatting needs. Each one is a
              keyboard shortcut, a button tap, and a menu item — pick your
              path. The toolbar uses Material 3 spacing tokens on Android and
              the macOS / Windows fluent pattern on desktop, so it feels native
              on every platform.
            </p>
            <ul class="n5__list">
              <li><strong>Bold</strong> — wraps selection in <code>**</code>. Shortcut: Ctrl/Cmd+B.</li>
              <li><strong>Italic</strong> — wraps selection in <code>*</code>. Shortcut: Ctrl/Cmd+I.</li>
              <li><strong>Code</strong> — wraps inline in backticks or 4-space-fences a block.</li>
              <li><strong>Link</strong> — <code>[text](url)</code>. Shortcut: Ctrl/Cmd+K.</li>
              <li><strong>List</strong> — toggles between ordered and unordered.</li>
              <li><strong>Heading</strong> — cycles H1 → H2 → H3 → paragraph.</li>
              <li><strong>Image</strong> — <code>![alt](path)</code> with a file picker.</li>
            </ul>
          </div>
          <figure class="n5__figure">
            <img
              src="/mockups/notes-v5-editor.svg"
              alt="M3 toolbar with seven formatting buttons above the editor"
              width="1200"
              height="800"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Seven actions, one toolbar. Shortcuts shown on hover.</figcaption>
          </figure>
        </article>
      </div>
    </section>

    <!-- ─── What changed — changelog entries ────────────── -->
    <section class="changelog" id="changelog">
      <div class="container">
        <header class="changelog__head reveal">
          <span class="eyebrow">What changed</span>
          <h2>Pulse Notes — release notes.</h2>
          <p class="lede">
            Five shipped entries between v0.4.0 and v0.5.2. Dates are local
            (Asia/Bangkok). Full audit lives in the
            <a href="/changelog/#v0.6.0">changelog</a>.
          </p>
        </header>
        <ol class="changelog__list" role="list">
          <li class="changelog__item reveal">
            <time class="changelog__date" datetime="2026-07-31">2026-07-31</time>
            <div class="changelog__body">
              <h3 class="changelog__title">v0.5.2 · split-pane persistence, M3 toolbar polish</h3>
              <p>
                Split-pane widths now persist per-note in the notes table.
                Toolbar added the image action and Ctrl/Cmd+K link shortcut.
                Tag autocomplete ranks by frequency, not alphabetical.
                294 unit tests, 0 regressions.
              </p>
            </div>
          </li>
          <li class="changelog__item reveal">
            <time class="changelog__date" datetime="2026-07-31">2026-07-31</time>
            <div class="changelog__body">
              <h3 class="changelog__title">v0.5.1 · CodeMirror 6 markdown editor ships</h3>
              <p>
                Replaced the plain textarea with CodeMirror 6, markdown-it 14,
                highlight.js 11, and @lezer/highlight. Five new components:
                MarkdownEditor (lazy), MarkdownPreview, NoteToolbar (M3),
                TagAutocomplete (M3), SplitPane. Two new lib files:
                <code>markdownIt.ts</code>, <code>notesBacklinks.ts</code>.
                <code>[[wikilink]]</code> backlinks and split-pane preview
                land. Feature flag <code>notes.markdown.v2</code> default ON.
              </p>
            </div>
          </li>
          <li class="changelog__item reveal">
            <time class="changelog__date" datetime="2026-07-31">2026-07-31</time>
            <div class="changelog__body">
              <h3 class="changelog__title">v0.5.0 · Tier 1 desktop Notes ships</h3>
              <p>
                SQLite + FTS5 schema landed, with 8 Tauri commands and 5 React
                components. Tray menu gains a "New note" action. 17 Rust tests,
                158 vitest tests, clean release build. Notes enters beta on
                Windows.
              </p>
            </div>
          </li>
          <li class="changelog__item reveal">
            <time class="changelog__date" datetime="2026-07-31">2026-07-31</time>
            <div class="changelog__body">
              <h3 class="changelog__title">v0.4.1 · Notes module scaffolded</h3>
              <p>
                The notes/ folder, the capture intent integration, and the
                first 12 vitest tests for the SQLite adapter. No user-facing
                UI yet — this is the foundation.
              </p>
            </div>
          </li>
          <li class="changelog__item reveal">
            <time class="changelog__date" datetime="2026-07-31">2026-07-31</time>
            <div class="changelog__body">
              <h3 class="changelog__title">v0.4.0 · Notes feature announced</h3>
              <p>
                Notes was the headline feature of the v0.4.0 launch. The brief
                promised a local-first second brain with capture, search,
                backlinks, and recall — all running through the local Ollama
                model. The 12MB installer shipped with the schema and a
                capture sheet, even though the editor was still a textarea.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- ─── Privacy ─────────────────────────────────────── -->
    <section class="np" id="privacy">
      <div class="container np__inner reveal">
        <div class="np__copy">
          <span class="eyebrow">Privacy · honest version</span>
          <h2>Your notes never leave your device.</h2>
          <p class="lede">
            Pulse stores everything in a local SQLite database on your disk.
            The full-text search index is the same database. The recall step
            is the same local model that runs chat. Nothing crosses the
            network boundary.
          </p>
          <ul class="np__list" role="list">
            <li>
              <strong>Tier 1 (free, forever):</strong> local only. No accounts,
              no signup, no cloud. You wipe the folder, you get a clean install.
            </li>
            <li>
              <strong>Tier 2 (Pro, $5/mo, planned for v0.6):</strong> opt-in
              end-to-end-encrypted sync across devices. Pro is the only path
              that uses the network. You can disable it and nothing changes.
            </li>
            <li>
              <strong>Free sync, today:</strong> the <code>notes.db</code> file
              is plain SQLite. Point any git client at <code>~/.pulse</code>
              and you have manual sync without paying anyone.
            </li>
          </ul>
          <p class="np__more">
            Full audit, source code, and the security model live on the
            <a href="/privacy/">Security &amp; privacy</a>.
          </p>
        </div>
        <aside class="np__card glass" aria-label="What Pulse does and does not do">
          <h3 class="np__card-title">What Pulse does.</h3>
          <ul class="np__card-list np__card-list--yes" role="list">
            <li>Stores notes in a local SQLite database</li>
            <li>Runs FTS5 search on the same database</li>
            <li>Calls the local Ollama over loopback HTTP</li>
            <li>Surfaces relevant notes from the local index</li>
          </ul>
          <h3 class="np__card-title">What Pulse does not do.</h3>
          <ul class="np__card-list np__card-list--no" role="list">
            <li>Send your notes anywhere by default</li>
            <li>Read SMS, notifications, or other apps</li>
            <li>Phone home with usage telemetry</li>
            <li>Train a model on your data, ever</li>
          </ul>
        </aside>
      </div>
    </section>

    <!-- ─── How it works ────────────────────────────────── -->
    <section class="hw" id="how-it-works">
      <div class="container">
        <header class="hw__head reveal">
          <span class="eyebrow">How it works</span>
          <h2>Three steps. About five minutes.</h2>
          <p class="lede">
            From the installer to your first saved note is roughly the time it
            takes to make coffee. No accounts, no credit card, no email
            confirmation loop.
          </p>
        </header>
        <ol class="hw__steps" role="list">
          <li class="hw__step reveal">
            <div class="hw__step-num">01</div>
            <h3 class="hw__step-title">Install Pulse.</h3>
            <p class="hw__step-body">
              12MB Windows installer. No admin rights for the app itself. Pull
              <code>gemma3:4b</code> through Ollama if you don't already have a
              model. The first 90 seconds are install + one model pull.
            </p>
            <a class="hw__step-cta" href="/changelog/#v0.6.0">Install guide →</a>
          </li>
          <li class="hw__step reveal">
            <div class="hw__step-num">02</div>
            <h3 class="hw__step-title">Open Notes.</h3>
            <p class="hw__step-body">
              From the system tray, hit the Notes button, or use the
              <code>Win+Shift+N</code> hotkey. The list lands on a single
              screen with five note cards, three tag chips, and a purple FAB
              at the bottom-right.
            </p>
          </li>
          <li class="hw__step reveal">
            <div class="hw__step-num">03</div>
            <h3 class="hw__step-title">Share anything. Pulse remembers.</h3>
            <p class="hw__step-body">
              Forward a message, drop a screenshot, dictate a thought. Pulse
              writes a note, indexes it, and links it back. Two days from now,
              when you ask, the right note is already there.
            </p>
            <a class="hw__step-cta" href="#killer-demo">See the demo →</a>
          </li>
        </ol>
      </div>
    </section>

