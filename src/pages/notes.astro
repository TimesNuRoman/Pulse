---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import '../styles/notes.css';

const APK_URL = 'https://uiwb7l19o4r7b.space.minimax.io/downloads/pulse-notes-0.6.5-debug.apk';
const APK_SIZE = '4.39 MB';
const APK_SHA = 'AD81D03C…1D7607';
const APK_VERSION = '0.6.5';
const APK_VERSION_CODE = '15';
const APK_MIN_SDK = '24';
const APK_TARGET_SDK = '36';
const APK_APP_ID = 'app.pulse.notes';
---

<Base
  title="Pulse Notes v0.6.5 — Greenfield markdown editor for Android"
  description="Pulse Notes v0.6.5 — R93 bridge release: manifest URL fallback chain grown to 7 hosts (R92 + R90 added at the head) on top of the v0.6.0 GREENFIELD Android markdown editor. Svelte 5 + CodeMirror 6 + split-pane + [[wikilink]] + tag autocomplete. Local-first, 4.39MB APK, 276/276 vitest, Smart Engine v3."
  ogImage="/og/notes-v60.svg"
  ctaText={`Get Pulse Notes ↓ ${APK_SIZE}`}
  ctaHref={APK_URL}
  ctaVisible={true}
  footerLicense="Apache 2.0"
  footerVersion="v0.6.5"
>
  <a class="skip-link" href="#main">Skip to content</a>

  <nav class="nav" id="topnav" aria-label="Primary">
    <div class="nav__inner">
      <a class="nav__brand" href="/" aria-label="Pulse — home">
        <svg class="pulse-logo" viewBox="0 0 64 64" width="28" height="28" role="img" aria-label="Pulse">
          <circle class="pulse-logo__ring" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle class="pulse-logo__ring pulse-logo__ring--2" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle class="pulse-logo__ring pulse-logo__ring--3" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
          <circle cx="32" cy="32" r="9" fill="#bb9af7"></circle>
          <circle cx="35" cy="30" r="2" fill="#1a1b26"></circle>
        </svg>
        <span class="nav__brand-name">Pulse</span>
      </a>
      <ul class="nav__links" role="list">
        <li><a class="nav__link" href="/#features">Features</a></li>
        <li><a class="nav__link is-cta" href="/notes/" aria-current="page">Notes</a></li>
        <li><a class="nav__link" href="#download">Download</a></li>
        <li><a class="nav__link" href="/compare/">Compare</a></li>
        <li><a class="nav__link" href="/changelog/">Changelog</a></li>
      </ul>
      <div class="nav__right">
        <a class="btn btn--primary nav__cta" href={APK_URL} rel="noopener noreferrer">Get Pulse Notes ↓ {APK_SIZE}</a>
        <button class="nav__burger" id="nav-burger" type="button" aria-expanded="false" aria-controls="nav-drawer" aria-label="Open menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="20" y2="17"></line>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <div class="nav-drawer" id="nav-drawer" aria-hidden="true">
    <a class="nav-drawer__link" href="/#features">Features</a>
    <a class="nav-drawer__link" href="/notes/" aria-current="page">Notes</a>
    <a class="nav-drawer__link" href="#download">Download</a>
    <a class="nav-drawer__link" href="/compare/">Compare</a>
    <a class="nav-drawer__link" href="/changelog/">Changelog</a>
    <a class="btn btn--primary nav-drawer__cta" href={APK_URL} rel="noopener noreferrer">Get Pulse Notes ↓ {APK_SIZE}</a>
  </div>

  <script is:inline>
    (() => {
      const nav = document.getElementById('topnav');
      const burger = document.getElementById('nav-burger');
      const drawer = document.getElementById('nav-drawer');
      if (!nav) return;

      let scrolled = false;
      const setScrolled = (v) => {
        if (v === scrolled) return;
        scrolled = v;
        nav.classList.toggle('is-scrolled', v);
      };
      const onScroll = () => setScrolled(window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      if (burger && drawer) {
        const setOpen = (open) => {
          burger.setAttribute('aria-expanded', String(open));
          drawer.setAttribute('aria-hidden', String(!open));
          drawer.classList.toggle('is-open', open);
          document.body.style.overflow = open ? 'hidden' : '';
        };
        burger.addEventListener('click', () => {
          const isOpen = drawer.classList.contains('is-open');
          setOpen(!isOpen);
        });
        drawer.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => setOpen(false));
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
            setOpen(false);
            burger.focus();
          }
        });
        const mq = window.matchMedia('(min-width: 768px)');
        mq.addEventListener?.('change', (e) => {
          if (e.matches && drawer.classList.contains('is-open')) setOpen(false);
        });
      }
      document.body.classList.add('has-nav');
    })();
  </script>

  <main id="main" class="notes-main">
    <!-- ─── Hero ────────────────────────────────────────── -->
    <section class="notes-hero">
      <div class="bg-glow"></div>
      <div class="container notes-hero__grid">
        <div class="notes-hero__copy reveal">
          <div class="notes-hero__badges">
            <span class="notes-hero__eyebrow">Pulse Notes · Android · Greenfield</span>
            <span class="notes-hero__pill" aria-label="Latest version">
              <span class="notes-hero__pill-dot" aria-hidden="true"></span>
              Latest v{APK_VERSION} · versionCode {APK_VERSION_CODE}
            </span>
          </div>
          <h1 class="notes-hero__title">
            A markdown editor,<br />built for Android, <span class="notes-hero__hl">from scratch.</span>
          </h1>
          <p class="notes-hero__sub">
            v0.6.5 is the current build (R93 bridge release: manifest URL fallback chain grown to 7 hosts — R92 + R90 added at the head — 276/276 vitest). v0.6.0 was the greenfield Android release: Svelte 5 + TypeScript strict + Vite, CodeMirror 6 with a drag-resize split-pane, <code>[[wikilink]]</code> backlinks, tag autocomplete, and a Material&nbsp;3 toolbar. 4.39&nbsp;MB APK, zero cloud, zero telemetry.
          </p>
          <div class="notes-hero__ctas">
            <a class="btn btn--primary btn--lg" href={APK_URL} rel="noopener noreferrer">Download APK ↓ {APK_SIZE}</a>
            <a class="btn btn--ghost btn--lg" href="#new-in-v6">What is new</a>
          </div>
          <ul class="notes-hero__trust" role="list" aria-label="Quick highlights">
            <li class="notes-hero__trust-item">Local-first</li>
            <li class="notes-hero__trust-sep" aria-hidden="true">·</li>
            <li class="notes-hero__trust-item">4.39 MB APK</li>
            <li class="notes-hero__trust-sep" aria-hidden="true">·</li>
            <li class="notes-hero__trust-item">Svelte 5 + TS strict</li>
            <li class="notes-hero__trust-sep" aria-hidden="true">·</li>
            <li class="notes-hero__trust-item">No cloud</li>
            <li class="notes-hero__trust-sep" aria-hidden="true">·</li>
            <li class="notes-hero__trust-item">Apache 2.0</li>
          </ul>
          <p class="notes-hero__sha">
            <span class="notes-hero__sha-label">SHA-256</span>
            <code class="notes-hero__sha-code">{APK_SHA}</code>
            <a class="notes-hero__sha-link" href="/changelog/#v0.6.5">verify →</a>
          </p>
        </div>
        <div class="notes-hero__composite reveal" aria-hidden="true">
          <div class="notes-hero__halo"></div>
          <figure class="notes-hero__shot notes-hero__shot--editor">
            <img
              src="/mockups/notes-v60-editor.svg"
              alt="Pulse Notes v0.6.0 Android editor with split-pane preview"
              width="720"
              height="520"
              loading="eager"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- ─── Why Android-first ───────────────────────────── -->
    <section class="waf" id="why-android">
      <div class="container">
        <header class="waf__head reveal">
          <span class="eyebrow">Why Android first</span>
          <h2>Capture happens on the phone. Pulse Notes too.</h2>
          <p class="lede">
            Telegram links, screenshots, voice notes — most of what you save in a day
            arrives on Android first. Pulse Notes v0.6.0 was written from scratch on
            Android instead of being ported from the desktop v0.5.x line. The desktop
            build picks up the same code path in a follow-up release; the Android
            surface ships today.
          </p>
        </header>
        <div class="waf__grid">
          <article class="waf__card glass reveal">
            <h3 class="waf__card-title">Greenfield, not a port.</h3>
            <p class="waf__card-body">
              Svelte 5 + TypeScript strict + Vite, with vitest + jsdom. 5 components
              and 2 library files, written clean against the Capacitor 8 + Android
              WebView target. No drag-along from the desktop stack.
            </p>
          </article>
          <article class="waf__card glass reveal">
            <h3 class="waf__card-title">Phone-first UX.</h3>
            <p class="waf__card-body">
              Split-pane degrades to a bottom-sheet toggle on small screens. The M3
              toolbar sits at the bottom edge where thumbs land. Share intents,
              notifications, and the clipboard are wired through native plugins
              instead of being faked in a web shim.
            </p>
          </article>
          <article class="waf__card glass reveal">
            <h3 class="waf__card-title">Smart Engine v3 from day one.</h3>
            <p class="waf__card-body">
              v0.6.0 ships with the v3 router and the v3 recall gate as the default
              surface. Pass-rate 88%, p50 latency −1370&nbsp;ms versus the v2
              baseline, threshold&nbsp;5. Notes benefits from the same A/B harness
              that gates desktop chat.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ─── 4 core features ────────────────────────────── -->
    <section class="nf" id="features">
      <div class="container">
        <header class="nf__head reveal">
          <span class="eyebrow">What is in the box</span>
          <h2>Four things. No roadmap.</h2>
          <p class="lede">
            The features that ship in Pulse Notes v0.6.0 on Android. Anything not on
            this list is in the issue tracker, not in the marketing.
          </p>
        </header>
        <div class="nf__grid">
          <article class="nf__card glass reveal" id="capture">
            <span class="nf__card-label">Capture</span>
            <h3 class="nf__card-title">Share to Pulse. The note is already written.</h3>
            <p class="nf__card-body">
              The share sheet on Android shows Pulse. Tap it from Telegram, Slack, a
              browser, or anywhere that exports text. Pulse writes the note, tags
              it from the source app, and parks it in the inbox for you to triage
              later.
            </p>
          </article>
          <article class="nf__card glass reveal" id="search">
            <span class="nf__card-label">Search</span>
            <h3 class="nf__card-title">FTS5 across notes, captures, and tags.</h3>
            <p class="nf__card-body">
              One search box hits every note, capture, and tag in the local SQLite
              index. Results land in milliseconds because the index is the same
              file as the data, on the device, with no network round-trip.
            </p>
          </article>
          <article class="nf__card glass reveal" id="link">
            <span class="nf__card-label">Link</span>
            <h3 class="nf__card-title"><code>[[wiki-style]]</code> backlinks, fuzzy autocomplete.</h3>
            <p class="nf__card-body">
              Type <code>[[</code> and a ranked dropdown opens. The note title you
              meant is almost always at the top. Tags work the same way with
              <code>#</code>, ranked by how often you actually use each one.
            </p>
          </article>
          <article class="nf__card glass reveal" id="recall">
            <span class="nf__card-label">Recall</span>
            <h3 class="nf__card-title">The right note appears when you ask.</h3>
            <p class="nf__card-body">
              Ask Pulse what the Bangkok hotel was, and the note surfaces with its
              source attached. No cloud embeddings, no telemetry, no per-app
              listeners — just the local index and the local model.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ─── What's new in v0.6.0 ────────────────────────── -->
    <section class="new-in-v6" id="new-in-v6">
      <div class="container">
        <header class="new-in-v6__head reveal">
          <span class="eyebrow">What shipped in v0.6.0</span>
          <h2>Five things the greenfield rewrite bought us.</h2>
          <p class="lede">
            v0.6.0 is the first Android release. Svelte 5 + TS strict + Vite
            replaced a long port path, wired up CodeMirror 6 with markdown-it 14 and
            highlight.js 11, and split the editor and preview into a drag-resize
            pane. The new surface unlocked five capabilities that ship in the build
            you can download today.
          </p>
        </header>

        <!-- 1. Greenfield architecture -->
        <article class="n6 reveal" id="v6-greenfield">
          <div class="n6__copy">
            <span class="n6__label">New · Architecture</span>
            <h3 class="n6__title">Written from scratch on Svelte 5 + TS strict.</h3>
            <p class="n6__body">
              5 components and 2 library files, with no drag-along from the v0.5.x
              desktop code. TypeScript runs in strict mode, vite handles HMR, vitest
              with jsdom drives the 150-test green line. The bundle is 849&nbsp;KB
              raw / 306&nbsp;KB gzipped, and the editor lazy-loads behind a feature
              flag so the list view stays light.
            </p>
            <ul class="n6__list">
              <li><strong>Svelte 5</strong> runes + TS strict + Vite + vitest + jsdom.</li>
              <li><strong>Lazy editor</strong> behind <code>notes.markdown.v2</code> — list view stays under 60&nbsp;KB.</li>
              <li><strong>5 components</strong> + 2 lib files (<code>markdownIt.ts</code>, <code>notesBacklinks.ts</code>).</li>
              <li><strong>150/150</strong> vitest across 9 files, 0 regressions.</li>
            </ul>
          </div>
          <figure class="n6__figure">
            <img
              src="/mockups/notes-v60-editor.svg"
              alt="Pulse Notes v0.6.0 Android editor with split-pane preview"
              width="720"
              height="520"
              loading="lazy"
              decoding="async"
            />
            <figcaption>CodeMirror 6 with split-pane, M3 toolbar at the bottom, share intent behind the floating action button.</figcaption>
          </figure>
        </article>

        <!-- 2. Split-pane -->
        <article class="n6 n6--reverse reveal" id="v6-split-pane">
          <div class="n6__copy">
            <span class="n6__label">New · Split-pane</span>
            <h3 class="n6__title">Editor left, preview right. On phone, a bottom-sheet toggle.</h3>
            <p class="n6__body">
              The split-pane is a horizontal divider you can drag from 20/80 to
              80/20. On phone, it collapses into a bottom-sheet toggle: the editor
              fills the screen, the preview slides up on demand. The pane state
              persists per-note, so a note you opened in 60/40 stays in 60/40.
            </p>
            <ul class="n6__list">
              <li><strong>Drag-resize</strong> on tablet, mouse and touch.</li>
              <li><strong>Bottom-sheet</strong> toggle on phone — 80&nbsp;ms debounce.</li>
              <li><strong>Per-note state</strong> in the local store, not localStorage.</li>
              <li><strong>Preview updates</strong> debounced — no input lag at any width.</li>
            </ul>
          </div>
          <figure class="n6__figure">
            <img
              src="/mockups/notes-v60-backlinks.svg"
              alt="Drag-resize split-pane between markdown editor and rendered preview"
              width="1200"
              height="800"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Two panes, one divider. Resize ratio persists per note. Backlinks panel at the bottom.</figcaption>
          </figure>
        </article>

        <!-- 3. Wikilinks + tags -->
        <article class="n6 reveal" id="v6-wikilinks">
          <div class="n6__copy">
            <span class="n6__label">New · Wikilinks + tags</span>
            <h3 class="n6__title"><code>[[wikilink]]</code> and <code>#tag</code>, both with fuzzy autocomplete.</h3>
            <p class="n6__body">
              Type <code>[[</code> and a ranked dropdown opens over the cursor. Pick
              an existing note to insert a link, or type a new title and press
              Enter to create the target on save. Clicking a <code>[[link]]</code>
              in the preview navigates to that note. Tags work the same way with
              <code>#</code>, ranked by usage frequency so the tags you actually
              use float to the top.
            </p>
            <ul class="n6__list">
              <li><strong>Fuzzy match</strong> on <code>[[</code> and <code>#</code>.</li>
              <li><strong>Ranked by frequency</strong> — your top 10 tags always come first.</li>
              <li><strong>Create-on-the-fly</strong> — type a new title, press Enter.</li>
              <li><strong>Backlinks panel</strong> at the bottom of every note shows what links in.</li>
            </ul>
          </div>
          <figure class="n6__figure">
            <img
              src="/mockups/notes-v60-backlinks.svg"
              alt="Note editor with [[wikilink]] autocomplete and tag suggestions"
              width="1200"
              height="800"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Type <code>[[</code> and the dropdown opens. Tags float to the top by frequency.</figcaption>
          </figure>
        </article>

        <!-- 4. M3 toolbar + 9 plugins -->
        <article class="n6 n6--reverse reveal" id="v6-toolbar">
          <div class="n6__copy">
            <span class="n6__label">New · Toolbar + native plugins</span>
            <h3 class="n6__title">M3 toolbar and 9 Capacitor plugins wired in.</h3>
            <p class="n6__body">
              The bottom toolbar carries the seven formatting actions that cover
              most editing needs: bold, italic, code, link, list, heading, image.
              Below them sit 9 Capacitor plugins: share, clipboard, haptics,
              status bar, splash, keyboard, app, files, and a local model bridge.
              The web bundle in the APK is the same one that runs in a desktop
              browser; native paths attach through Capacitor at runtime.
            </p>
            <ul class="n6__list">
              <li><strong>7 actions</strong> on the M3 toolbar, all keyboard-mapped.</li>
              <li><strong>9 Capacitor plugins</strong> (+share, +clipboard, +haptics, +status-bar, +splash-screen, +keyboard, +app, +files, +local-model).</li>
              <li><strong>Share intent</strong> pre-fills the capture sheet.</li>
              <li><strong>Web fallback</strong> for browser preview — same bundle, no fork.</li>
            </ul>
          </div>
          <figure class="n6__figure">
            <img
              src="/mockups/notes-v60-editor.svg"
              alt="Pulse Notes v0.6.0 Android editor with M3 bottom toolbar"
              width="720"
              height="520"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Seven actions, one toolbar. Native share intent when the user taps the floating action button.</figcaption>
          </figure>
        </article>

        <!-- 5. Performance / footprint -->
        <article class="n6 reveal" id="v6-perf">
          <div class="n6__copy">
            <span class="n6__label">New · Footprint</span>
            <h3 class="n6__title">4.34 MB APK, 306 KB gzipped bundle.</h3>
            <p class="n6__body">
              The full greenfield build is 4.34&nbsp;MB, with the JS bundle at
              849&nbsp;KB raw / 306&nbsp;KB gzipped. The CodeMirror editor is
              lazy-loaded behind a feature flag — the list view pulls in under
              60&nbsp;KB on first paint. Capacitor 8 with minSdk 24 and targetSdk
              36 covers the Android install base down to Android 7.
            </p>
            <ul class="n6__list">
              <li><strong>4.34 MB</strong> APK, versionCode 11, appId <code>app.pulse.notes</code>.</li>
              <li><strong>minSdk 24</strong> (Android 7.0) · <strong>targetSdk 36</strong>.</li>
              <li><strong>First paint</strong> under 60&nbsp;KB before CodeMirror loads.</li>
              <li><strong>150/150 vitest</strong> green at HEAD, no flake.</li>
            </ul>
          </div>
          <figure class="n6__figure">
            <div class="n6__metrics glass">
              <div class="n6__metric">
                <span class="n6__metric-num">4.34<span class="n6__metric-unit">MB</span></span>
                <span class="n6__metric-label">APK size</span>
              </div>
              <div class="n6__metric">
                <span class="n6__metric-num">306<span class="n6__metric-unit">KB gz</span></span>
                <span class="n6__metric-label">JS bundle</span>
              </div>
              <div class="n6__metric">
                <span class="n6__metric-num">150<span class="n6__metric-unit">/150</span></span>
                <span class="n6__metric-label">vitest</span>
              </div>
              <div class="n6__metric">
                <span class="n6__metric-num">9</span>
                <span class="n6__metric-label">Capacitor plugins</span>
              </div>
            </div>
            <figcaption>What 5 components + 2 libs + 1 greenfield rewrite measure against the install base.</figcaption>
          </figure>
        </article>
      </div>
    </section>

    <!-- ─── Smart Engine v3 callout (cross-feature) ─────── -->
    <section class="se3" id="smart-engine-v3">
      <div class="container se3__inner reveal">
        <div class="se3__copy">
          <span class="eyebrow">Cross-feature · Smart Engine v3</span>
          <h2>Notes get even smarter with Smart Engine v3.</h2>
          <p class="lede">
            The same A/B harness that gates the chat router on desktop also gates
            the recall step in Notes on Android. v3 prefers the right model for the
            query 32 percentage points more often than the v2 baseline — and
            answers land in roughly a seventh of the time. v0.6.0 ships with v3
            as the default, threshold&nbsp;5. The harness logs every call to
            <code>data/smart-engine-v3-ab-*.jsonl</code> for inspection.
          </p>
          <div class="se3__stats" role="list" aria-label="Smart Engine v3 results">
            <div class="se3__stat" role="listitem">
              <span class="se3__stat-num">+32<span class="se3__stat-unit">pp</span></span>
              <span class="se3__stat-label">pass-rate vs v2 baseline (88% absolute)</span>
            </div>
            <div class="se3__stat" role="listitem">
              <span class="se3__stat-num">−1370<span class="se3__stat-unit">ms</span></span>
              <span class="se3__stat-label">p50 latency vs v2 baseline</span>
            </div>
            <div class="se3__stat" role="listitem">
              <span class="se3__stat-num">5</span>
              <span class="se3__stat-label">PassThreshold, default ON for Notes</span>
            </div>
          </div>
          <a class="se3__cta" href="/changelog/#smart-engine-v3">
            Read the Smart Engine v3 report →
          </a>
        </div>
      </div>
    </section>

    <!-- ─── Changelog snapshot ──────────────────────────── -->
    <section class="changelog" id="changelog">
      <div class="container">
        <header class="changelog__head reveal">
          <span class="eyebrow">What changed</span>
          <h2>Pulse Notes — release notes.</h2>
          <p class="lede">
            Nine shipped entries between v0.5.0 and v0.6.5. Dates are local
            (Asia/Bangkok). Full audit lives in the
            <a href="/changelog/#v0.6.5">changelog</a>.
          </p>
        </header>
        <ol class="changelog__list" role="list">
          <li class="changelog__item reveal" id="v065-snapshot">
            <time class="changelog__date" datetime="2026-08-01">2026-08-01</time>
            <div class="changelog__body">
              <h3 class="changelog__title">v0.6.5 · Manifest chain grown to 7 (R93 bridge release)</h3>
              <p>
                <code>DEFAULT_MANIFEST_URLS</code> grows from 5 to 7 entries
                (R92 + R90 added at the head). v0.6.5+ devices can
                auto-update forward even if the older hosts go down.
                v0.6.3 / v0.6.4 users need to side-load v0.6.5 once.
