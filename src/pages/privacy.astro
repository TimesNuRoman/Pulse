// R143: Privacy — full rewrite under R141 brand policy.
// SPDX header is the only reference to the license name in this file.
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Privacy — Pulse"
  description="Pulse is local-first. Notes, chat, and model output stay on the device. License validation is the only outbound request Pulse makes on its own. No telemetry, no analytics, no crash reporting."
  ctaVisible={false}
  footerLicense=""
  footerVersion=""
>
  <main class="legal">
    <div class="container">
      <header class="legal__head reveal">
        <span class="eyebrow">Legal</span>
        <h1>Privacy.</h1>
        <p class="lede">Pulse runs on the device. Notes, chat, screenshots, voice, and model output never leave it. License validation is the only outbound network request Pulse makes on its own.</p>
      </header>

      <article class="legal__body">
        <h2 class="legal__h2">What stays on the device.</h2>
        <p>
          Notes, chat history, and license keys are stored in a local SQLite
          database on the device. Local AI models, when downloaded on demand,
          live in the Pulse data directory. Screenshots, voice recordings,
          and any file dropped into a note are written to disk locally.
          No copy is uploaded.
        </p>
        <p>
          The Pulse desktop app talks to Ollama running on the same machine
          (typically <code>http://127.0.0.1:11434</code>). Prompts and
          completions are exchanged only between the local Pulse process
          and the local Ollama process. Nothing in that exchange reaches a
          Pulse server, a third party, or any analytics endpoint.
        </p>
        <p>
          No telemetry SDK is included in the Pulse binary. No analytics are
          collected. No crash reports are sent. Update checks are surfaced
          in-app and can be disabled in Settings; the launch-time check
          carries only the current version string.
        </p>

        <h2 class="legal__h2">What leaves the device.</h2>
        <p>
          License keys are validated against a Pulse server. The request
          contains the key and a device identifier; no note content, prompt,
          or model output is included. The response tells the app whether
          the key is active and when it expires.
        </p>
        <p>
          For PRO subscriptions, billing is handled by NOWPayments under their
          <a href="https://nowpayments.io/policy" target="_blank" rel="noopener noreferrer">privacy policy</a>.
          No card data, no billing address, and no email ever reach the
          Pulse server. NOWPayments transmits only the subscription status
          back to Pulse.
        </p>
        <p>
          The download and update infrastructure is hosted on Cloudflare
          R2 under their
          <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener noreferrer">privacy policy</a>.
          Source releases and issue tracking are hosted by GitHub under their
          <a href="https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement" target="_blank" rel="noopener noreferrer">privacy policy</a>.
        </p>

        <h2 class="legal__h2">Third parties involved.</h2>
        <ul>
          <li><strong>NOWPayments</strong> — billing and merchant of record for PRO subscriptions. No card data passes through Pulse.</li>
          <li><strong>Cloudflare</strong> — hosts the public website, the R2 download bucket, and the license validation endpoint.</li>
          <li><strong>GitHub</strong> — hosts the source repositories, release artifacts, and the issue tracker.</li>
        </ul>

        <h2 class="legal__h2">User rights.</h2>
        <p>
          All user data lives on the device and can be removed at any time:
        </p>
        <ul>
          <li><strong>Export</strong> — the Pulse data directory contains notes as plain Markdown and chat history as JSON. Files can be copied out without any tool.</li>
          <li><strong>Delete</strong> — uninstalling Pulse and removing the Pulse data directory erases all notes, chat history, license keys, and downloaded models. The license remains valid and can be re-validated on a new device.</li>
          <li><strong>Opt out of updates</strong> — update checks can be disabled in Settings. The app continues to work without checking for new versions.</li>
        </ul>

        <h2 class="legal__h2">Contact and data requests.</h2>
        <p>
          Questions, complaints, or a GDPR or CCPA request can be filed as an
          issue on the
          <a href="https://github.com/TimesNuRoman/Pulse" rel="noopener noreferrer">public GitHub repository</a>.
          Response time is honest — usually a few days. No support email
          is published; the
          <a href="/faq/">FAQ</a> covers common questions.
        </p>
      </article>

      <p class="legal__back reveal"><a href="/">← Back to Pulse</a></p>
    </div>
  </main>
  <Footer license="" version="" />
</Base>

<style>
  .legal { padding-block: clamp(60px, 10vw, 120px); }
  .legal__head { text-align: left; margin-bottom: 2.5rem; }
  .legal__head .lede { margin-top: 0.6rem; }
  .legal__body {
    max-width: 65ch;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--fg-dim);
    font-size: 1.02rem;
  }
  .legal__body p code {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1px 6px;
    border-radius: 4px;
    color: var(--cyan);
  }
  .legal__h2 {
    margin-top: 1.5rem;
    font-size: 1.15rem;
    color: var(--fg);
    letter-spacing: -0.01em;
  }
  .legal__body ul {
    list-style: disc;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .legal__back {
    margin-top: 3rem;
    font-size: 0.95rem;
  }
</style>
