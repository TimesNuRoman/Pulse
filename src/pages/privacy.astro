---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Privacy — Pulse"
  description="Pulse is local-first. We do not run a server. We do not see your prompts, screenshots, or voice. Here is exactly what stays on your machine."
  ctaVisible={false}
  footerLicense=""
  footerVersion=""
>
  <main class="legal">
    <div class="container">
      <header class="legal__head reveal">
        <span class="eyebrow">Legal</span>
        <h1>Privacy.</h1>
        <p class="lede">Short version: Pulse runs on your machine. Your prompts, your screenshots, and your voice never leave it.</p>
      </header>

      <article class="legal__body">
        <p>
          Pulse is a 12MB Tauri v2 desktop app. It talks to Ollama running locally on your computer
          (typically <code>http://127.0.0.1:11434</code>). Pulse does not include a telemetry SDK,
          does not phone home, and does not run a backend that could see your input. The only
          network requests the app makes are the ones you trigger yourself — fetching a model,
          hitting a web page, or contacting an API you pointed Pulse at.
        </p>

        <p>
          GitHub releases and the source repository are hosted by GitHub under their
          <a href="https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement" target="_blank" rel="noopener noreferrer">privacy policy</a>.
          Billing for PRO subscriptions is handled by Polar.sh under their
          <a href="https://polar.sh/legal/privacy" target="_blank" rel="noopener noreferrer">privacy policy</a>.
          No billing details ever reach the Pulse team.
        </p>

        <p>
          Questions, complaints, or a GDPR/CCPA request? Open an issue on the
          <a href="https://github.com/TimesNuRoman/pulse" rel="noopener noreferrer">public GitHub repository</a>.
          Response time is honest — usually a few days.
        </p>
      </article>

      <p class="legal__back reveal"><a href="/">← Back to Pulse</a></p>
    </div>
  </main>
  <Footer license="" version="" />
</Base>

<style>
  .legal { padding-block: clamp(60px, 10vw, 120px); }
  .legal__head { text-align: left; margin-bottom: 2.5rem; }
  .legal__head .lede { margin-top: 0.6rem; }
  .legal__body {
    max-width: 65ch;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--fg-dim);
    font-size: 1.02rem;
  }
  .legal__body p code {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1px 6px;
    border-radius: 4px;
    color: var(--cyan);
  }
  .legal__back {
    margin-top: 3rem;
    font-size: 0.95rem;
  }
</style>
