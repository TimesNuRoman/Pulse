/**
 * R201: /blog/privacy-in-local-ai/ — first blog post.
 *
 * 5 sections, ~1600 words, 1 Pulse mention (R129 strict count).
 * JSON-LD: BlogPosting + HowTo (5 HowToStep for "How to verify your
 * local AI setup").
 *
 * Hard rules (R141 brand + R143 + R129):
 *   - 0 new npm deps
 *   - Anonymous brand: no personal name, no team attribution, no first-person
 *   - No "free, forever" / "$0"
 *   - No emoji
 *   - No marketing fluff, no future promises
 *   - Apache 2.0 SPDX only on line 1
 *   - Tokyo Night dark only (handled by global.css)
 *   - 56dp min-height on interactive elements
 *   - 1 brand mention in section 5 (R129 strict, ≤ 1)
 *
 * Astro parser gotcha (R192/R198 lesson): literal `${` inside JSX text
 * breaks the build with an esbuild "Expected '}' but found ':'" error.
 * Fix: use HTML entities `&#36;&#123;` for `${` in code samples. We
 * also avoid raw `${` placeholders by using `<VAR>` style.
 *
 * Page count: 16 -> 17 (+1 page; +1 sitemap entry).
 */

import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/notes.css';

const PAGE_TITLE = 'Privacy in local AI: what stays on your device';
const PAGE_DESC =
  'A practical guide to data sovereignty when running AI models on your own hardware. ' +
  'What stays local, what leaves the device, and how to verify the boundary yourself.';
const PUB_DATE = '2026-08-03';
const READING_TIME = '7 min read';
const CANONICAL = 'https://ownlocalml.com/blog/privacy-in-local-ai/';

// R129 strict: ≤ 1 "Pulse" mention per blog post. The single mention
// lives in section 5 ("How to verify your setup"), neutral and factual.
// Counter (used by verification grep): any string containing "Pulse"
// anywhere in the rendered post body. Keep this honest.
const TAGS = ['privacy', 'local-ai', 'data-sovereignty', 'guide'];

// Section anchors (for in-page TOC + HowTo steps).
const SECTIONS = [
  { id: 'why-local-ai-why-now', num: 1, label: 'Why local AI, why now' },
  { id: 'what-stays-local', num: 2, label: 'What stays local with Ollama' },
  { id: 'what-leaves-the-device', num: 3, label: 'What goes to the cloud (and when)' },
  { id: 'threat-model', num: 4, label: 'Threat model: what local AI protects against' },
  { id: 'how-to-verify', num: 5, label: 'How to verify your setup' },
];

// HowTo JSON-LD — 5 steps, mirrors the section structure for SEO.
const howToSteps = [
  {
    '@type': 'HowToStep',
    position: 1,
    name: 'List active connections on the Ollama port',
    text:
      'Run `netstat -an | grep :11434` (Linux / macOS) or ' +
      '`Get-NetTCPConnection -LocalPort 11434` (PowerShell) to confirm ' +
      'Ollama only listens on localhost. Connections to public IPs mean ' +
      'something is misconfigured.',
  },
  {
    '@type': 'HowToStep',
    position: 2,
    name: 'Inspect raw HTTP traffic with a packet capture',
    text:
      'Open Wireshark on the loopback interface, capture for sixty ' +
      'seconds, then apply a display filter for non-local traffic. ' +
      'No request body should match the size and shape of a prompt.',
  },
  {
    '@type': 'HowToStep',
    position: 3,
    name: 'Enable verbose logging on the Ollama server',
    text:
      'Stop the running server and restart it with `OLLAMA_DEBUG=1 ollama serve`. ' +
      'The log shows every inbound request and outbound connection. ' +
      'Cross-reference each outbound host against the documented list.',
  },
  {
    '@type': 'HowToStep',
    position: 4,
    name: 'Confirm telemetry is off',
    text:
      'Read the env file or service unit that starts Ollama. The variable ' +
      '`OLLAMA_TELEMETRY` should be set to `false` or absent. ' +
      'If unset, Ollama disables telemetry by default since v0.3.x.',
  },
  {
    '@type': 'HowToStep',
    position: 5,
    name: 'Verify the client does not exfiltrate',
    text:
      'In the client app, disable any cloud fallback in settings. ' +
      'Then repeat the packet capture with a long conversation. ' +
      'No bytes should leave the device during inference.',
  },
];

// BlogPosting JSON-LD.
const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: PAGE_TITLE,
  description: PAGE_DESC,
  datePublished: PUB_DATE,
  dateModified: PUB_DATE,
  author: { '@type': 'Organization', name: 'Pulse' },
  publisher: {
    '@type': 'Organization',
    name: 'Pulse',
    url: 'https://ownlocalml.com/',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': CANONICAL,
  },
  url: CANONICAL,
  keywords: TAGS.join(', '),
  inLanguage: 'en',
};

// HowTo JSON-LD (one per page; aggregated for the "How to verify" section).
const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to verify your local AI setup',
  description:
    'Five concrete checks to confirm that an Ollama-based local AI setup ' +
    'keeps prompts, responses, and conversation history on the device.',
  totalTime: 'PT10M',
  step: howToSteps,
};
