<!-- SPDX-License-Identifier: Apache-2.0
     R253: /login/ redesign. Two-tab pattern: Account (email+password) + License key.
     Reference: pulse-web-ref/login.html
     TopBar comes from <Base/> via <TopNav/> — not modified here. -->
---
import Base from '../layouts/Base.astro';
---
<Base
  title="Log in — Pulse"
  description="Log in to Pulse with your email and password, or activate an existing license key. 14-day trial starts at first launch."
  ogImage="/og-login.png"
  ctaVisible={false}
  footerLicense="Apache 2.0"
  canonical="https://ownlocalml.com/login/"
>
  <a class="skip-link" href="#main">Skip to content</a>

  <main id="main" class="auth-page">
    <div class="auth-page__bg" aria-hidden="true"></div>

    <div class="auth-card">
      <header class="auth-card__head">
        <h1 class="auth-card__title">Welcome to Pulse</h1>
        <p class="auth-card__sub">The local way to think with your machine.</p>
      </header>

      <div class="auth-tabs" role="tablist" aria-label="Sign in method">
        <button class="auth-tab is-active" role="tab" id="tab-account" aria-selected="true" aria-controls="panel-account" data-tab="account" type="button">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          <span>Account</span>
        </button>
        <button class="auth-tab" role="tab" id="tab-license" aria-selected="false" aria-controls="panel-license" data-tab="license" type="button" tabindex="-1">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <span>License key</span>
        </button>
      </div>

      <div class="auth-panel" id="panel-account" role="tabpanel" aria-labelledby="tab-account">
        <div class="auth-alert" data-error hidden></div>

        <form class="auth-form" id="form-account" novalidate>
          <div class="auth-field">
            <label for="email">Email</label>
            <input class="auth-input" id="email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required />
          </div>
          <div class="auth-field">
            <label for="password">Password</label>
            <input class="auth-input" id="password" name="password" type="password" placeholder="••••••••" autocomplete="current-password" required />
          </div>
          <div class="auth-row">
            <label class="auth-check">
              <input type="checkbox" name="remember" />
              <span>Keep me signed in</span>
            </label>
            <a href="/forgot">Forgot password?</a>
          </div>
          <button class="auth-btn" type="submit">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
              <polyline points="10 17 15 12 10 7"/>
              <line x1="15" y1="12" x2="3" y2="12"/>
            </svg>
            Log in
          </button>
        </form>

        <div class="auth-divider"><span>or</span></div>
        <a class="auth-btn auth-btn--ghost" href="/signup">Create a new account</a>
      </div>

      <div class="auth-panel" id="panel-license" role="tabpanel" aria-labelledby="tab-license" hidden>
        <form class="auth-form" id="form-license" novalidate>
          <div class="auth-field">
            <label for="key">License key</label>
            <input
              class="auth-input auth-input--mono"
              id="key"
              name="license"
              type="text"
              placeholder="PULSE-XXXX-XXXX-XXXX-XXXX-XXXX"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              pattern="PULSE-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}"
              aria-describedby="license-help"
              required
            />
            <p id="license-help" class="auth-format-hint">Format: <code>PULSE-XXXX-XXXX-XXXX-XXXX-XXXX</code></p>
          </div>
          <button class="auth-btn" type="submit">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 5v14M19 12l-7 7-7-7"/>
            </svg>
            Activate license
          </button>
        </form>

        <div class="auth-divider"><span>or</span></div>
        <a class="auth-btn auth-btn--ghost" href="/pricing/">Buy a new license</a>
      </div>

      <p class="auth-card__legal">By logging in, you agree to the <a href="/license/">Terms</a> and <a href="/privacy/">Privacy</a>.</p>
    </div>
  </main>

  <footer class="auth-footer">
    <a href="/">Pulse</a> · <a href="/privacy/">Privacy</a> · <a href="/license/">Terms</a>
  </footer>

  <script is:inline>
    (() => {
      // R253: tab switching with roving tabindex + keyboard (←/→)
      const tabs = document.querySelectorAll('.auth-tab');
      const panels = {
        account: document.getElementById('panel-account'),
        license: document.getElementById('panel-license'),
      };
      const selectTab = (key) => {
        tabs.forEach((t) => {
          const active = t.getAttribute('data-tab') === key;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
          t.setAttribute('tabindex', active ? '0' : '-1');
        });
        Object.entries(panels).forEach(([k, el]) => { el.hidden = (k !== key); });
      };
      tabs.forEach((t) => {
        t.addEventListener('click', () => { selectTab(t.getAttribute('data-tab')); t.focus(); });
        t.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft' && e.key !== 'Home' && e.key !== 'End') return;
          e.preventDefault();
          const all = Array.from(tabs);
          const i = all.indexOf(t);
          let next = i;
          if (e.key === 'ArrowRight') next = (i + 1) % all.length;
          else if (e.key === 'ArrowLeft') next = (i - 1 + all.length) % all.length;
          else if (e.key === 'Home') next = 0;
          else if (e.key === 'End') next = all.length - 1;
          selectTab(all[next].getAttribute('data-tab'));
          all[next].focus();
        });
      });

      // Account form: real API call would go here. We stub the success/401
      // paths so the UI is exercised end-to-end without a backend.
      const alertEl = document.querySelector('[data-error]');
      const showError = (msg) => {
        alertEl.textContent = msg;
        alertEl.hidden = false;
        alertEl.focus?.();
      };
      const clearError = () => { alertEl.textContent = ''; alertEl.hidden = true; };

      const accountForm = document.getElementById('form-account');
      accountForm.addEventListener('submit', (e) => {
        e.preventDefault();
        clearError();
        const email = accountForm.email.value.trim();
        const password = accountForm.password.value;
        if (!email || !password) {
          showError('Enter your email and password.');
          return;
        }
        // TODO: replace with real POST /api/auth/login when backend lands.
        // Demo: treat any email containing "fail" as 401, anything else as ok.
        if (/fail/i.test(email)) {
          showError('Incorrect email or password.');
        } else {
          window.location.href = '/app/chat';
        }
      });

      // License form: keep the existing flow — store pending key in
      // localStorage and forward to /download/?activate=… so the desktop
      // client picks it up on next launch.
      const licenseForm = document.getElementById('form-license');
      licenseForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const value = licenseForm.license.value.trim();
        if (!value) return;
        try { localStorage.setItem('pulse_pending_license', value); } catch {}
        window.location.href = '/download/?activate=' + encodeURIComponent(value);
      });
    })();
  </script>

  <style is:global>
    /* R253: log in page — square, two-tab (Account / License key). */
    .auth-page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: clamp(80px, 12vw, 120px) var(--gutter) clamp(40px, 6vw, 60px);
      background: var(--bg);
      position: relative;
    }
    .auth-page__bg {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background:
        radial-gradient(ellipse 80% 50% at 50% -10%, rgba(187, 154, 247, 0.12), transparent),
        radial-gradient(ellipse 60% 50% at 100% 100%, rgba(122, 162, 247, 0.08), transparent),
        var(--bg);
    }
    .auth-card {
      position: relative; z-index: 1;
      width: 100%;
      max-width: 480px;
    }
    .auth-card__head { text-align: center; margin-bottom: 1.5rem; }
    .auth-card__title {
      font-size: clamp(1.85rem, 4vw, 2.5rem);
      font-weight: 700;
      letter-spacing: -0.025em;
      line-height: 1.1;
      margin: 0 0 0.5rem;
      color: var(--fg);
    }
    .auth-card__sub {
      color: var(--fg-dim);
      font-size: 0.94rem;
      line-height: 1.5;
      margin: 0;
    }
    .auth-card__legal {
      text-align: center;
      font-size: 0.72rem;
      color: var(--muted);
      margin: 1.25rem 0 0;
    }
    .auth-card__legal a { color: var(--fg-dim); text-decoration: none; border-bottom: 1px dotted var(--border); }
    .auth-card__legal a:hover { color: var(--purple); border-bottom-color: var(--purple); }

    /* Tab strip (square, 2 cells) */
    .auth-tabs {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1px;
      padding: 0;
      background: var(--border);
      border: 1px solid var(--border);
      margin-bottom: 1.25rem;
    }
    .auth-tab {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      padding: 0.65rem 0.875rem;
      background: var(--bg);
      color: var(--fg-dim);
      font-size: 0.82rem; font-weight: 500;
      border: 0; cursor: pointer;
      min-height: 44px;
      transition: color 200ms ease, background 200ms ease;
    }
    .auth-tab:hover { color: var(--fg); }
    .auth-tab.is-active { background: var(--surface-2); color: var(--fg); }
    .auth-tab:focus-visible { outline: 2px solid var(--purple); outline-offset: -2px; }
    .auth-tab svg { flex-shrink: 0; }

    .auth-panel { padding: 0.5rem 0; }
    .auth-panel[hidden] { display: none; }

    .auth-form { display: flex; flex-direction: column; }
    .auth-field { margin-bottom: 1rem; display: flex; flex-direction: column; }
    .auth-field label {
      display: block;
      font-size: 0.7rem; font-weight: 600;
      color: var(--muted);
      text-transform: uppercase; letter-spacing: 0.1em;
      margin-bottom: 0.5rem;
    }
    .auth-input {
      width: 100%;
      padding: 0.875rem 1rem;
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--fg);
      font: inherit;
      font-size: 0.88rem;
      outline: 0;
      transition: border-color 150ms ease;
      min-height: 48px;
    }
    .auth-input:focus { border-color: var(--purple); }
    .auth-input::placeholder { color: var(--muted); }
    .auth-input:invalid:not(:placeholder-shown) { border-color: var(--red); }
    .auth-input--mono {
      font-family: ui-monospace, "JetBrains Mono", monospace;
      letter-spacing: 0.04em;
      text-align: center;
    }
    .auth-format-hint { font-size: 0.75rem; color: var(--muted); margin: 0.5rem 0 0; }
    .auth-format-hint code {
      font-family: ui-monospace, monospace; font-size: 0.78rem;
      color: var(--cyan);
      background: var(--bg);
      padding: 1px 5px;
    }

    .auth-row {
      display: flex; align-items: center; justify-content: space-between;
      gap: 0.75rem;
      margin: 0.25rem 0 1.25rem;
      font-size: 0.82rem;
    }
    .auth-row a { color: var(--fg-dim); text-decoration: none; }
    .auth-row a:hover { color: var(--fg); }
    .auth-check { display: flex; align-items: center; gap: 6px; color: var(--fg-dim); cursor: pointer; user-select: none; }
    .auth-check input { accent-color: var(--purple); width: 14px; height: 14px; margin: 0; }

    .auth-btn {
      width: 100%;
      padding: 0 1rem;
      height: 48px;
      background: var(--purple);
      color: #1a1b26;
      border: 0;
      font-size: 0.88rem; font-weight: 600;
      cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      text-decoration: none;
      transition: background 200ms ease;
    }
    .auth-btn:hover { background: #c4adf9; }
    .auth-btn:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
    .auth-btn svg { width: 14px; height: 14px; }
    .auth-btn--ghost {
      background: transparent;
      color: var(--fg-dim);
      border: 1px solid var(--border);
    }
    .auth-btn--ghost:hover { color: var(--fg); border-color: var(--fg-dim); background: var(--surface); }

    .auth-divider {
      display: flex; align-items: center; gap: 0.75rem;
      margin: 1.25rem 0;
      font-size: 0.72rem;
      color: var(--muted);
      text-transform: uppercase; letter-spacing: 0.1em;
    }
    .auth-divider::before, .auth-divider::after { content: ""; flex: 1; height: 1px; background: var(--border); }
    .auth-divider span { flex-shrink: 0; }

    .auth-alert {
      padding: 0.65rem 0.875rem;
      background: rgba(247, 118, 142, 0.1);
      border: 1px solid rgba(247, 118, 142, 0.3);
      color: var(--red);
      font-size: 0.82rem;
      margin-bottom: 1rem;
    }
    .auth-alert[hidden] { display: none; }
    .auth-alert:focus { outline: 2px solid var(--red); outline-offset: 2px; }

    .auth-footer {
      padding: 1.25rem 1rem;
      text-align: center;
      font-size: 0.75rem;
      color: var(--muted);
    }
    .auth-footer a { color: var(--fg-dim); text-decoration: none; }
    .auth-footer a:hover { color: var(--fg); }
  </style>
</Base>
