---
// SPDX-License-Identifier: Proprietary
// R284 Luna: 5-tier freemium ladder per gtm/63 + gtm/72.
// Free: 100K GPT-4o mini + 200 premium chat + unlimited local Ollama. $0.
// Pro:  5M soft cap, $0.04/1K overage, GPT-4o + Haiku + Flash + Ollama. $20/mo or $192/yr.
// Pro+: 50M tokens, Sonnet 4.5 included, E2E multi-device sync, priority support. $99/mo or $948/yr.
// Business: 5 Pro+ seats pooled, admin console, audit log, Slack/Teams. $499/mo or $4,788/yr.
// Enterprise: 10+ seats, on-prem, SSO, custom SLA. Starts $1,000/mo, sales-led.
// 14-day Pro trial for new signups.
// Anonymous "Pulse team". Closed source. Crypto-only via NOWPayments.
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';

const PAGE_TITLE = 'Pricing — Pulse from $0 to $1,000+/mo. Pick the rung that matches your value.';
const PAGE_DESC = 'Pulse Free with 100K GPT-4o mini tokens, no card. Pro $20/mo with 5M token cap. Pro+ $99/mo with 50M tokens and Sonnet 4.5. Business $499/mo for 5-seat teams with admin and audit. Enterprise $1,000+/mo for on-prem and SSO. Anonymous team, local-first, crypto-only.';

// 5 tier cards. Anonymous voice. Crypto-only CTAs. All Pro+/Business have value
// prop banners per gtm/72 §7 Move 5 ("saves X hours/week" math).
const tiers = [
  {
    id: 'free',
    name: 'Free',
    price: '$0',
    period: 'forever',
    tag: 'No credit card',
    desc: 'The full Pulse side panel on your device, with cloud model access via GPT-4o mini. Local Ollama routing has no token cap, ever. No card, no account, no expiry. New signups also get a 14-day Pro trial of every paid feature.',
    cta: 'Download free',
    href: '/download/',
    primary: false,
    features: [
      '100,000 GPT-4o mini tokens per month',
      '200 premium chat messages (Claude Haiku, Gemini Flash, Sonar)',
      'Unlimited local Ollama — no token cap, ever',
      'All Pulse features: notes, chat, search, web-search, voice input, code mode',
      '14-day Pro trial for new signups — the whole product with no limit',
      'No credit card. No account. No expiry.',
    ],
    valueBanner: null,
  },
  {
    id: 'pro',
    name: 'Pro',
    price: '$20',
    period: '/month, or $192/year (save 20%)',
    tag: '14-day Pro trial',
    desc: 'Unlimited tokens on every cloud model we route, with a soft cap that almost nobody hits. Sonnet 4.5 as a paid add-on at $5 per million tokens. Cloud Whisper voice input, multi-device E2E-encrypted sync, priority rate limits, 30-day refund.',
    cta: 'Buy Pro',
    href: '#nowpayments-checkout',
    primary: false,
    badge: null,
    features: [
      'All Free features, always',
      '5,000,000 token soft cap per month',
      '$0.04 per 1,000 tokens overage',
      'Default models: GPT-4o, Claude Haiku 4.5, Gemini Flash, local Ollama',
      'Sonnet 4.5 add-on at $5 per million tokens (separate from soft cap)',
      'Priority rate limits, multi-device E2E-encrypted sync, cloud backup',
      '30-day refund, no questions asked',
    ],
    valueBanner: null,
  },
  {
    id: 'pro-plus',
    name: 'Pro+',
    price: '$99',
    period: '/month, or $948/year (save 20%)',
    tag: 'Most popular',
    desc: 'Ten times the token cap. Sonnet 4.5 included. Unlimited multi-device sync. Priority support with a 24-hour response and a dedicated Slack channel. Voice notes, email-reply copilot, spreadsheet helper, plugin SDK, all included at launch.',
    cta: 'Buy Pro+',
    href: '#nowpayments-checkout',
    primary: true,
    badge: 'For power users',
    features: [
      'All Pro features, always',
      '50,000,000 tokens per month (10x Pro)',
      'Sonnet 4.5 included in the cap (no separate meter)',
      'Unlimited multi-device E2E-encrypted sync',
      'Priority support: 24h response, dedicated Slack channel',
      'Unlimited voice notes (Whisper, v0.7)',
      'Email-reply copilot, spreadsheet helper, plugin SDK (v0.7)',
      '500 web-search queries per day',
    ],
    valueBanner: {
      headline: 'Average Pro+ user saves 11 hours/week.',
      math: 'At $30/hr loaded cost, that is $1,430/mo value. Pro+ is $99 = 7% of value captured. Your CFO will approve.',
    },
  },
  {
    id: 'business',
    name: 'Business',
    price: '$499',
    period: '/month, or $4,788/year (save 20%)',
    tag: '5 seats included',
    desc: 'Five seats of Pro+ bundled, plus admin and audit. 250 million tokens pooled across the team. Admin console for user management and role-based access, audit log for compliance, shared workspaces, Slack and Microsoft Teams integration, SSO with Google Workspace and Microsoft Entra ID. Priority support with 4-hour response.',
    cta: 'Buy Business',
    href: '#nowpayments-checkout',
    primary: false,
    badge: null,
    features: [
      '5 Pro+ seats (additional seats +$80/mo each)',
      '250,000,000 tokens pooled per month',
      'Admin console: user management, role-based access',
      'Audit log: who accessed what, when, for how long (compliance-ready)',
      'Shared workspaces: team notes, team chat history',
      'Slack and Microsoft Teams integration',
      'Priority support: 4h response, dedicated Slack channel',
      'SSO: Google Workspace, Microsoft Entra ID',
    ],
    valueBanner: {
      headline: 'A 5-seat Business team saves 50 hours/week combined.',
      math: 'At $50/hr loaded cost, that is $2,500/mo value. Business is $499 = 20% of value captured. The audit log alone pays for the seat cost.',
    },
  },
  {
    id: 'enterprise',
    name: 'Enterprise',
    price: 'Custom',
    period: 'starts at $1,000/mo · 10+ seats',
    tag: 'Sales-led',
    desc: 'For teams of ten or more. On-prem deployment option so Pulse runs on your infrastructure. SSO with Okta, Auth0, custom SAML. 99.9% uptime SLA with one-hour response, custom integration with the team on-call for setup, compliance roadmap for HIPAA, GDPR, SOC 2 Type II. Private Slack channel plus 1-on-1 video support.',
    cta: 'Contact us',
    href: 'mailto:pulse-team@ownlocalml.com',
    primary: false,
    badge: null,
    features: [
      '10+ seats included, custom contract',
      'On-prem option (Pulse runs on your infrastructure)',
      'SSO: Okta, Auth0, custom SAML',
      'SLA: 99.9% uptime, 1h response',
      'Custom integration: Luna on-call for setup',
      'Compliance roadmap: HIPAA, GDPR, SOC 2 Type II',
      'Dedicated support: private Slack + 1-on-1 video',
    ],
    valueBanner: null,
  },
];

// Comparison table for the 5 tiers. One row per dimension.
const comparisonRows = [
  { label: 'Price',                            vals: { free: '$0/mo', 'pro': '$20/mo or $192/yr', 'pro-plus': '$99/mo or $948/yr', business: '$499/mo or $4,788/yr', enterprise: 'Custom · $1,000+/mo' } },
  { label: 'Best for',                         vals: { free: 'Curious user, hobbyist', 'pro': 'Casual power user, daily driver', 'pro-plus': 'Power user, professional, "ChatGPT Plus is not enough"', business: 'Small team 3-10 seats, compliance needs', enterprise: 'Large org, on-prem, custom SLA' } },
  { label: 'GPT-4o mini tokens (cloud)',       vals: { free: '100,000 / mo', 'pro': 'Unlimited (5M cap)', 'pro-plus': 'Unlimited (50M cap)', business: 'Unlimited (250M pooled)', enterprise: 'Custom' } },
  { label: 'Premium chat (Claude Haiku, etc.)', vals: { free: '200 / mo', 'pro': 'Unlimited (5M cap)', 'pro-plus': 'Unlimited (50M cap)', business: 'Unlimited (250M pooled)', enterprise: 'Custom' } },
  { label: 'Sonnet 4.5 (premium reasoning)',   vals: { free: '—', 'pro': 'Add-on at $5/M tokens', 'pro-plus': 'Included in cap', business: 'Included in pool', enterprise: 'Custom' } },
  { label: 'Local Ollama',                     vals: { free: 'Unlimited', 'pro': 'Unlimited', 'pro-plus': 'Unlimited', business: 'Unlimited', enterprise: 'Unlimited' } },
  { label: 'Multi-device E2E-encrypted sync',  vals: { free: '1 device', 'pro': '1 device', 'pro-plus': 'Unlimited devices', business: 'Unlimited (5 seats)', enterprise: 'Unlimited (10+ seats)' } },
  { label: 'Voice notes (Whisper, v0.7)',      vals: { free: '—', 'pro': '100 / mo', 'pro-plus': 'Unlimited', business: 'Unlimited (5 seats)', enterprise: 'Unlimited' } },
  { label: 'Web-search quota',                 vals: { free: '50 / day', 'pro': '50 / day', 'pro-plus': '500 / day', business: '500 / day per seat', enterprise: 'Custom' } },
  { label: 'Email-reply copilot (v0.7)',       vals: { free: '—', 'pro': '—', 'pro-plus': 'yes', business: 'yes (5 seats)', enterprise: 'yes' } },
  { label: 'Spreadsheet helper (v0.7)',        vals: { free: '—', 'pro': '—', 'pro-plus': 'yes', business: 'yes (5 seats)', enterprise: 'yes' } },
  { label: 'Plugin SDK (v0.7)',                vals: { free: '—', 'pro': '—', 'pro-plus': 'yes', business: 'yes (5 seats)', enterprise: 'yes' } },
  { label: 'Admin console',                    vals: { free: '—', 'pro': '—', 'pro-plus': '—', business: 'yes (user mgmt, RBAC)', enterprise: 'yes + custom roles' } },
  { label: 'Audit log',                        vals: { free: '—', 'pro': '—', 'pro-plus': '—', business: 'yes (who/what/when, compliance-ready)', enterprise: 'yes + custom retention' } },
  { label: 'SSO',                              vals: { free: '—', 'pro': '—', 'pro-plus': '—', business: 'Google Workspace, MS Entra ID', enterprise: 'Okta, Auth0, custom SAML' } },
  { label: 'Slack / MS Teams integration',     vals: { free: '—', 'pro': '—', 'pro-plus': '—', business: 'yes', enterprise: 'yes + custom webhooks' } },
  { label: 'On-prem deployment',               vals: { free: '—', 'pro': '—', 'pro-plus': '—', business: '—', enterprise: 'yes' } },
  { label: 'SLA',                              vals: { free: 'Best effort', 'pro': 'Best effort', 'pro-plus': 'Best effort', business: '99.5%', enterprise: '99.9% · 1h response' } },
  { label: 'Support',                          vals: { free: 'Community', 'pro': 'Email, 48h', 'pro-plus': '24h response + dedicated Slack', business: '4h response + dedicated Slack', enterprise: 'Private Slack + 1-on-1 video' } },
  { label: 'Payment',                          vals: { free: 'Free (no payment)', 'pro': 'NOWPayments: XMR, BTC, USDT-TRC20, 200+', 'pro-plus': 'NOWPayments: XMR, BTC, USDT-TRC20, 200+', business: 'NOWPayments: XMR, BTC, USDT-TRC20, 200+', enterprise: 'NOWPayments + custom invoice' } },
  { label: 'Refund window',                    vals: { free: '—', 'pro': '30 days', 'pro-plus': '30 days', business: '30 days', enterprise: 'Per contract' } },
];

// 14 FAQs. Numbers and copy match gtm/71 Task 2 exactly.
const faqs = [
  {
    q: "What's the difference between Free and Pro?",
    a: 'Free: 100,000 GPT-4o mini tokens per month + 200 premium chat messages + unlimited local Ollama. Pro: unlimited premium models with a 5 million token soft cap and $0.04 per 1,000 tokens overage. Pro is $20/month or $192/year.',
  },
  {
    q: 'What happens after the 14-day Pro trial?',
    a: 'Your account automatically downgrades to Free. You keep all your notes, settings, and local Ollama config. The GPT-4o mini and premium chat caps reset to Free levels (100K + 200/month). You can re-upgrade to Pro at any time.',
  },
  {
    q: 'Can I use Pulse without internet?',
    a: 'Yes. Pulse routes to your local Ollama instance for any model you have installed. The 100K GPT-4o mini and 200 premium chat caps only apply when you use the cloud models. Local Ollama is unlimited on both Free and Pro.',
  },
  {
    q: 'Is my data private?',
    a: 'Yes. Notes and chat history are stored locally on your device. Cloud model requests (GPT-4o, Claude, Gemini) go directly from your device to the model provider — Pulse does not proxy them. The license Worker at pulse-sync stores only your subscription status and Pro cap usage, not your chat content.',
  },
  {
    q: 'What cryptocurrencies do you accept?',
    a: 'Monero (preferred), Bitcoin, USDT-TRC20, and 200+ others via NOWPayments. We do not accept Visa, Mastercard, PayPal, or any card payment. The full reasoning is at <a href="/blog/monero-manifesto">/blog/monero-manifesto</a>.',
  },
  {
    q: 'Do you have a free trial of Pro?',
    a: 'Yes — every new signup gets a 14-day Pro trial automatically. No card required. After 14 days, downgrade to Free or stay on Pro at $20/month or $192/year.',
  },
  {
    q: 'Do you have a lifetime deal?',
    a: 'No. We are a recurring-revenue business. The annual plan is 20% off the monthly price.',
  },
  {
    q: 'Can I get a refund?',
    a: 'Yes. 30-day refund on the Pro subscription, no questions asked. Email us.',
  },
  {
    q: 'How do I install Ollama for the unlimited local fallback?',
    a: 'Pulse detects Ollama on <code>localhost:11434</code> automatically. If Ollama is not installed, Pulse shows a one-click install link to ollama.com. We recommend Qwen2.5-Coder 7B as the default model for 8 GB RAM machines.',
  },
  {
    q: "What's the difference between Pro, Pro+, and Business?",
    a: 'Pro is $20/mo for casual use: 5M tokens, GPT-4o + Haiku + Flash + Ollama. Pro+ is $99/mo for power users: 50M tokens (10x Pro), Sonnet 4.5 included, unlimited multi-device sync, priority support. Business is $499/mo for 5-seat teams: pooled 250M tokens, admin console, audit log, Slack/Teams integration. See the comparison table below for the full breakdown.',
  },
  {
    q: 'Is Pulse worth $99/mo for individual use?',
    a: 'Yes, if you bill by the hour, draft a lot, or run daily AI workflows. The average Pro+ user saves 11 hours/week. At $30/hr loaded cost, that is $1,430/mo value. Pro+ is $99 = 7% of value captured. Use the ROI calculator at <a href="/pricing/roi">/pricing/roi</a> to estimate your own payback period.',
  },
  {
    q: 'How does the team tier (Business) work?',
    a: 'Business is 5 seats of Pro+ bundled ($99 x 5 = $495), plus a $4/mo admin/SSO/integration layer = $499/mo total. You get admin console for user management, audit log for compliance, and Slack/Teams integration. Additional seats beyond 5 are $80/mo each. Same NOWPayments crypto flow as Pro and Pro+.',
  },
  {
    q: 'Do you offer Enterprise plans with custom features?',
    a: 'Yes. Enterprise starts at $1,000/mo for 10+ seats and includes on-prem deployment option, custom SSO (Okta, Auth0, SAML), 99.9% SLA with 1h response, custom integration, and dedicated support. Email <a href="mailto:pulse-team@ownlocalml.com">pulse-team@ownlocalml.com</a> for a 30-min discovery call.',
  },
  {
    q: 'How do I pay $99+/mo with crypto?',
    a: 'NOWPayments handles any amount, including custom Enterprise contracts. At checkout, you pick the cryptocurrency (Monero, Bitcoin, USDT-TRC20, 200+ others) and the subscription tier. For Business or Enterprise on custom terms, we send a NOWPayments invoice link and the wire happens directly to our wallet. No bank, no card, no chargeback risk.',
  },
];

// JSON-LD Offer schema (4 entries; Enterprise excluded — custom-priced, sales-led).
const offerJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Pulse',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Windows, Android',
  offers: [
    {
      '@type': 'Offer',
      name: 'Free',
      price: '0',
      priceCurrency: 'USD',
      description: 'Free with 100,000 GPT-4o mini tokens per month, 200 premium chat messages, unlimited local Ollama. No card, no account.',
    },
    {
      '@type': 'Offer',
      name: 'Pro',
      price: '20',
      priceCurrency: 'USD',
      description: 'Pro tier with unlimited premium models, 5 million token soft cap per month, $0.04 per 1,000 tokens overage. $20/month or $192/year.',
    },
    {
      '@type': 'Offer',
      name: 'Pro+',
      price: '99',
      priceCurrency: 'USD',
      description: 'Pro+ tier for power users: 50 million tokens per month, Sonnet 4.5 included, unlimited multi-device sync, priority support. $99/month or $948/year.',
    },
    {
      '@type': 'Offer',
      name: 'Business',
      price: '499',
      priceCurrency: 'USD',
      description: 'Business tier: 5 Pro+ seats pooled, 250 million tokens, admin console, audit log, Slack/Teams integration. $499/month or $4,788/year.',
    },
  ],
};

// FAQPage JSON-LD from the same source of truth as the visible list.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a.replace(/<[^>]+>/g, ''),
    },
  })),
};
---

<Base
  title={PAGE_TITLE}
  description={PAGE_DESC}
  ogImage="/og-pricing.png"
  ctaText="Start free ↓"
  ctaHref="/download/"
  ctaVisible={true}
  footerLicense=""
  footerVersion=""
>
  <a class="skip-link" href="#main">Skip to content</a>

  <main id="main">
    <!-- ─── Hero ─────────────────────────────────────── -->
    <section class="pr-hero">
      <div class="bg-glow"></div>
      <div class="container pr-hero__grid">
        <div class="pr-hero__copy reveal">
          <span class="eyebrow">Pricing</span>
          <h1 class="pr-hero__title">From $0 to $1,000+/mo. Pick the rung that matches your value.</h1>
          <p class="pr-hero__sub">
            Free gives the full Pulse side panel with 100,000 GPT-4o mini tokens a month, 200 premium chat messages, and unlimited local Ollama routing — no card, no account, no expiry. Pro unlocks every cloud model with a 5M token soft cap. Pro+ is for power users billing by the hour. Business is for small teams. Enterprise is sales-led.
          </p>
          <p class="pr-hero__trust">
            Anonymous team · Local-first · No telemetry · 14-day Pro trial for new signups
          </p>
          <div class="pr-hero__ctas">
            <a class="btn btn--primary btn--lg" href="#tiers">See the plans ↓</a>
            <a class="btn btn--ghost btn--lg" href="/blog/monero-manifesto">Why crypto-only →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Visual ladder ABOVE the 5 cards ──────────── -->
    <section class="pr-ladder pr-ladder--top">
      <div class="container">
        <div class="pr-ladder__inner reveal">
          <p class="pr-ladder__lede">
            <span class="pr-ladder__hl">From $0 to $1,000+/mo.</span> Pick the rung that matches your value. Each tier is priced as a fraction of the time it saves — not as a feature bundle.
          </p>
        </div>
      </div>
    </section>

    <!-- ─── Tier cards (5) ───────────────────────────── -->
    <section class="pr-tiers" id="tiers">
      <div class="container">
        <ul class="pr-tiers__grid" role="list">
          {tiers.map((t) => (
            <li class={`pr-tier reveal ${t.primary ? 'pr-tier--featured' : ''}`} id={t.id}>
              {t.badge && <span class="pr-tier__badge">{t.badge}</span>}
              <header class="pr-tier__head">
                <h3 class="pr-tier__name">{t.name}</h3>
                <span class="pr-tier__tag">{t.tag}</span>
              </header>
              <div class="pr-tier__price">
                <span class="pr-tier__amount">{t.price}</span>
                <span class="pr-tier__period">{t.period}</span>
              </div>
              <p class="pr-tier__desc">{t.desc}</p>
              <a
                class={`btn ${t.primary ? 'btn--primary' : 'btn--ghost'} pr-tier__cta`}
                href={t.href}
                rel={t.href.startsWith('http') || t.href.startsWith('mailto:') ? 'noopener noreferrer' : undefined}
              >
                {t.cta} →
              </a>
              {t.valueBanner && (
                <div class="pr-tier__value" role="note" aria-label="Customer value math">
                  <p class="pr-tier__value-headline">{t.valueBanner.headline}</p>
                  <p class="pr-tier__value-math">{t.valueBanner.math}</p>
                </div>
              )}
              <ul class="pr-tier__list" role="list">
                {t.features.map((f) => (
                  <li>
                    <span class="pr-tier__check" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </span>
                    {f}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ─── Visual ladder BELOW the 5 cards ──────────── -->
    <section class="pr-ladder pr-ladder--bottom">
      <div class="container">
        <div class="pr-ladder__inner reveal">
          <p class="pr-ladder__lede">
            <span class="pr-ladder__hl">Each tier is priced as a fraction of the time you save.</span> Math: 10 hours/week at $30/hr = $300/mo value. Pro+ is $99 = 33% of value captured.
          </p>
        </div>
      </div>
    </section>

    <!-- ─── Comparison table (5 columns) ────────────── -->
    <section class="pr-compare" id="compare">
      <div class="container">
        <header class="pr-compare__head reveal">
          <span class="eyebrow">Feature comparison</span>
          <h2>All five tiers, line by line.</h2>
        </header>

        <div class="pr-compare__table-wrap reveal" role="region" aria-label="Pulse Free vs Pro vs Pro+ vs Business vs Enterprise feature comparison">
          <table class="pr-compare__table">
            <caption class="visually-hidden">Pulse Free, Pro, Pro+, Business, and Enterprise feature comparison</caption>
            <thead>
              <tr>
                <th scope="col">Feature</th>
                <th scope="col" class="col-free">Free</th>
                <th scope="col" class="col-pro">Pro</th>
                <th scope="col" class="col-proplus">Pro+</th>
                <th scope="col" class="col-business">Business</th>
                <th scope="col" class="col-enterprise">Enterprise</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  <td class="col-free">{r.vals.free}</td>
                  <td class="col-pro">{r.vals['pro']}</td>
                  <td class="col-proplus">{r.vals['pro-plus']}</td>
                  <td class="col-business">{r.vals.business}</td>
                  <td class="col-enterprise">{r.vals.enterprise}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ─── FAQ ──────────────────────────────────────── -->
    <section class="pr-faq" id="faq">
      <div class="container">
        <header class="pr-faq__head reveal">
          <span class="eyebrow">FAQ</span>
          <h2>14 common questions.</h2>
        </header>
        <div class="pr-faq__list">
          {faqs.map((f, i) => (
            <details class="faq__item reveal" open={i === 0}>
              <summary class="faq__q">
                <span class="faq__q-text">{f.q}</span>
                <svg class="faq__chev" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </summary>
              <div class="faq__a" set:html={f.a} />
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── Final CTA ────────────────────────────────── -->
    <section class="pr-cta">
      <div class="container pr-cta__inner reveal">
        <h2>Start free. Upgrade only if you bill by the hour.</h2>
        <div class="pr-cta__row">
          <a class="btn btn--primary btn--lg" href="/download/">Start free ↓</a>
          <a class="btn btn--ghost btn--lg" href="/blog/monero-manifesto">Why crypto-only →</a>
        </div>
      </div>
    </section>
  </main>

  <Footer license="" version="" />
</Base>

<!-- Offer schema (4 entries; Enterprise excluded as custom-priced). -->
<script type="application/ld+json" set:html={JSON.stringify(offerJsonLd)} is:inline />

<!-- FAQPage structured data. -->
<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />

<style>
  /* ─── Hero ──────────────────────────────────────── */
  .pr-hero {
    padding-top: clamp(112px, 14vw, 160px);
    padding-bottom: clamp(40px, 6vw, 72px);
    overflow: hidden;
