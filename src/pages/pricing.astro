---
// SPDX-License-Identifier: Proprietary
// R279 Luna: multi-tier freemium launch model.
// Free: GPT-4o mini routed, 100K tokens/mo, no card, anonymous, forever.
// Pro: $20/mo or $192/yr, unlimited, all models (GPT-4o, Claude, Gemini, local Ollama).
// 14-day Pro trial for new signups, then $20/mo or downgrade to Free.
// Team tier deferred to D30+ decision.
// Anonymous: no founder, no Lesside, no Roman, no pulse.tld. "Pulse team" or no subject.
// Closed source: no "open source" / "Apache 2.0" in marketing copy.
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';

const PAGE_TITLE = 'Pricing — Pulse Free with GPT-4o mini, or $20/mo Pro with unlimited everything';
const PAGE_DESC = 'Pulse Free uses GPT-4o mini with a 100K token monthly cap, no credit card. Pulse Pro is $20/month or $192/year with unlimited access to all models including GPT-4o, Claude, and local Ollama. Local-first, no telemetry, no account required.';

const tiers = [
  {
    name: 'Free',
    price: '$0',
    period: 'forever',
    tag: 'No credit card',
    description: 'The full Pulse side panel, on your device, with cloud model access via GPT-4o mini. 100,000 tokens per month, generous for daily notes and short Q&A. Bring your own Ollama model and the cap disappears on local paths.',
    cta: 'Start free',
    href: '/download/',
    primary: false,
    features: [
      '100,000 GPT-4o mini tokens per month',
      'Local Ollama routing — no token cap on local paths',
      '12 MB Tauri 2 installer, no Electron, no cloud upload',
      'Local notes with backlinks and tags',
      'Six routing modes (Auto, QuickAnswer, Reasoning, CodeEdit, Vision, Default)',
      'Cross-device sync over your local Wi-Fi',
      'Anonymous: no account, no email, no telemetry',
    ],
  },
  {
    name: 'Pro',
    price: '$20',
    period: 'per month, or $192/yr',
    tag: '14-day Pro trial',
    description: 'Unlimited tokens on every cloud model we route: GPT-4o, Claude Sonnet and Haiku, Gemini Flash, plus all of your local Ollama models. The 14-day Pro trial is the whole product with no limit — after 14 days, downgrade to Free or stay on Pro.',
    cta: 'Start 14-day Pro trial',
    href: '/download/',
    primary: true,
    badge: 'Most popular',
    features: [
      'Everything in Free',
      'Unlimited tokens on every cloud model',
      'GPT-4o, Claude Sonnet, Claude Haiku, Gemini Flash',
      'Cloud Whisper voice input (no local 1.5 GB model)',
      'Multi-model hot-swap without restarting the app',
      'Web search — unlimited queries per day',
      'Priority support, 48-hour email response',
      'Cancel any time, 30-day money-back guarantee',
    ],
  },
];

const comparisonRows = [
  { label: 'Pulse for Windows + Android',                     free: 'yes',     pro: 'yes' },
  { label: 'Local Ollama routing (unlimited on local paths)', free: 'yes',     pro: 'yes' },
  { label: 'Local notes with backlinks and tags',             free: 'yes',     pro: 'yes' },
  { label: 'Six routing modes (Auto, QuickAnswer, etc.)',     free: 'yes',     pro: 'yes' },
  { label: 'Cross-device sync over your local Wi-Fi',         free: 'yes',     pro: 'yes' },
  { label: 'No telemetry, no account required',               free: 'yes',     pro: 'yes' },
  { label: 'Cloud model access (GPT-4o mini)',                 free: '100K tokens / mo', pro: 'Unlimited' },
  { label: 'GPT-4o, Claude Sonnet, Claude Haiku, Gemini',     free: 'no',      pro: 'yes' },
  { label: 'Cloud Whisper voice input',                       free: 'no',      pro: 'yes' },
  { label: 'Multi-model hot-swap',                            free: 'no',      pro: 'yes' },
  { label: 'Web search',                                      free: '20 / day', pro: 'Unlimited' },
  { label: 'Priority support',                                free: 'Community', pro: 'Email, 48h' },
];

const trustSignals = [
  {
    title: 'Anonymous team',
    body: 'No founder photos, no team bio page with names, no personal credits. The team behind Pulse stays anonymous because the work is the credit.',
  },
  {
    title: 'Local-first',
    body: 'Notes live in a local database on your device. Chats are processed by a local model. The only network call Pulse makes is the optional update-checker manifest poll, and you can disable it in settings.',
  },
  {
    title: 'No telemetry, no tracking',
    body: 'No analytics SDK, no error reporter, no "phone home" endpoint. The Pro license check sends only an opaque key to the license server, and that key is not tied to any content.',
  },
  {
    title: 'Hosted on your device',
    body: 'Free and Pro both run the same on-device engine. Notes, chats, voice transcriptions, and routing mode caches stay on the device that runs Pulse. Pro adds remote model access but never uploads your content.',
  },
];

const faqs = [
  {
    q: "What's the difference between Free and Pro?",
    a: 'Free uses GPT-4o mini for cloud model access with a 100,000 token monthly cap, no credit card. Pro gives unlimited tokens on every cloud model we route (GPT-4o, Claude Sonnet and Haiku, Gemini Flash) plus cloud Whisper voice input, multi-model hot-swap, and unlimited web search. Both tiers include the full local Ollama routing path with no token cap on local models. New signups get a 14-day Pro trial — the whole product with no limit — and after 14 days can downgrade to Free or stay on Pro.',
  },
  {
    q: 'Is the Free tier really free forever?',
    a: 'Yes. The 100K tokens per month on GPT-4o mini is the rate limit on the cloud model path. Local Ollama routing has no token cap on Free — run any model you have on your machine and Pulse routes the prompts there. The Free tier does not expire, does not require a credit card, and does not ask for an email.',
  },
  {
    q: 'What happens after the 14-day Pro trial?',
    a: 'After 14 days the Pro features pause: cloud Whisper, multi-model hot-swap, unlimited web search, and access to GPT-4o / Claude / Gemini all stop. Free tier features keep working exactly as before. You can subscribe to Pro any time from the in-app account screen — the license key arrives by email and unlocks Pro for the billing period you picked.',
  },
  {
    q: 'How much does Pro cost?',
    a: 'Pro is $20 per month, or $192 per year (save $48 vs monthly). Billing is in crypto via NOWPayments (BTC, USDT-TRC20, XMR) because the team is based in Belarus and Stripe, Polar.sh, Paddle, Lemon Squeezy, and Gumroad do not pay out to Belarusian bank accounts. There is no lifetime deal and no student discount. The 14-day Pro trial is the only way to try Pro before paying.',
  },
  {
    q: 'How is the 100K GPT-4o mini cap counted?',
    a: 'Tokens in plus tokens out, across all cloud model prompts in a calendar month. A typical Q&A is around 500-1,500 tokens end-to-end, so 100K covers roughly 70-200 exchanges per month for everyday use. Local Ollama prompts do not count against the cap. The cap resets on the first of each month in your local timezone. You can see your running total in Settings → Usage.',
  },
  {
    q: 'How do I receive my Pro license key after I pay?',
    a: 'After the NOWPayments webhook confirms your transaction, a Cloudflare Email Service worker sends the 24-character license key to the email address you entered at checkout. The key is also written to your account at <code>ownlocalml.com/account/</code> and is recoverable any time from the receipt email. If the email does not arrive within 10 minutes, write to the support address on the receipt and we resend.',
  },
  {
    q: 'Do I need to sign up for an account to use Free?',
    a: 'No. Pulse does not require an account, email, phone number, or sign-in to use the Free tier. Download the installer, run it, open the app. Pro needs a license key, which is delivered by email after checkout, but the app itself does not log you in to use Free.',
  },
  {
    q: 'Is my data private?',
    a: 'Yes. Notes, chats, voice transcriptions, and routing mode caches never leave your device. The cloud model calls (GPT-4o mini on Free, GPT-4o / Claude / Gemini on Pro) are sent directly to the provider under your prompts. Pulse does not run an analytics SDK, an error reporter, or a "phone home" endpoint. You can verify the network calls in the app logs (Settings → Logs).',
  },
  {
    q: 'Can I use Pulse offline?',
    a: 'Yes for local models. If Pulse talks to an Ollama model on your machine and the model is already pulled, the full prompt-response cycle works offline: hotkey opens the panel, prompt goes to Ollama over <code>localhost</code>, response streams back. Internet is only required for cloud model calls (GPT-4o mini, GPT-4o, Claude, Gemini), the optional update check, and any Smart Engine tool that hits the network (HN, RSS).',
  },
  {
    q: 'Do you offer refunds?',
    a: 'Yes — 30-day money-back on any Pro purchase, no questions asked. Email the support address from your receipt and the refund goes through the same NOWPayments channel you paid with. After 30 days, Pro is still cancelable at any time but is not refunded for the unused billing period.',
  },
  {
    q: 'Why is payment crypto-only?',
    a: 'The Pulse team is based in Brest, Belarus, and Stripe, Polar.sh, Paddle, Lemon Squeezy, and Gumroad do not pay out to Belarusian bank accounts. NOWPayments handles BTC, USDT-TRC20, and XMR at 0.5% per transaction and pays out in the same currencies. The only fiat-shaped piece is the Cloudflare Email Service worker that sends the license key after the NOWPayments webhook fires. If you need an invoice in USD or EUR, write to the support email and we can do a manual stablecoin transfer.',
  },
  {
    q: 'How do I install Pulse?',
    a: 'Go to <a href="/download/">/download/</a> and pick your platform. Pulse for Windows is a 12 MB side-panel installer (NSIS or MSI). Pulse for Android is a 1.32 MB APK. Both are signed binaries with SHA-256 checksums published on the download page. No account, no email, no activation server roundtrip.',
  },
  {
    q: 'Do you offer student or education discounts?',
    a: 'Not at launch. The Free tier is the de-facto discount — 100K GPT-4o mini tokens per month is enough for daily coursework without paying.',
  },
];

// FAQPage JSON-LD for the structured-data block.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a.replace(/<[^>]+>/g, ''),
    },
  })),
};
---

<Base
  title={PAGE_TITLE}
  description={PAGE_DESC}
  ogImage="/og-pricing.png"
  ctaText="Start free ↓"
  ctaHref="/download/"
  ctaVisible={true}
  footerLicense=""
  footerVersion=""
>
  <a class="skip-link" href="#main">Skip to content</a>

  <main id="main">
    <!-- ─── Hero ─────────────────────────────────────── -->
    <section class="pr-hero">
      <div class="bg-glow"></div>
      <div class="container pr-hero__grid">
        <div class="pr-hero__copy reveal">
          <span class="eyebrow">Pricing</span>
          <h1 class="pr-hero__title">Start free with GPT-4o mini. Upgrade to Pro for unlimited everything.</h1>
          <p class="pr-hero__sub">
            Free gives the full Pulse side panel with 100,000 GPT-4o mini tokens a month and unlimited local Ollama routing — no card, no account, no expiry. Pro unlocks every cloud model, unlimited tokens, cloud Whisper voice input, and priority support.
          </p>
          <p class="pr-hero__trust">
            Anonymous team · Local-first · No telemetry · 14-day Pro trial for new signups
          </p>
          <div class="pr-hero__ctas">
            <a class="btn btn--primary btn--lg" href="#tiers">See the plans ↓</a>
            <a class="btn btn--ghost btn--lg" href="/faq/">Read the FAQ →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Tier cards ───────────────────────────────── -->
    <section class="pr-tiers" id="tiers">
      <div class="container">
        <header class="pr-tiers__head reveal">
          <span class="eyebrow">Plans</span>
          <h2>Two plans. One codebase. No upsells.</h2>
        </header>
        <ul class="pr-tiers__grid" role="list">
          {tiers.map((t) => (
            <li class={`pr-tier reveal ${t.primary ? 'pr-tier--featured' : ''}`}>
              {t.badge && <span class="pr-tier__badge">{t.badge}</span>}
              <header class="pr-tier__head">
                <h3 class="pr-tier__name">{t.name}</h3>
                <span class="pr-tier__tag">{t.tag}</span>
              </header>
              <div class="pr-tier__price">
                <span class="pr-tier__amount">{t.price}</span>
                <span class="pr-tier__period">{t.period}</span>
              </div>
              <p class="pr-tier__desc">{t.description}</p>
              <a
                class={`btn ${t.primary ? 'btn--primary' : 'btn--ghost'} pr-tier__cta`}
                href={t.href}
                rel={t.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                {t.cta} →
              </a>
              <ul class="pr-tier__list" role="list">
                {t.features.map((f) => (
                  <li>
                    <span class="pr-tier__check" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </span>
                    {f}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ─── Comparison table ─────────────────────────── -->
    <section class="pr-compare" id="compare">
      <div class="container">
        <header class="pr-compare__head reveal">
          <span class="eyebrow">Feature comparison</span>
          <h2>Free vs Pro, line by line.</h2>
        </header>

        <!-- Desktop / tablet (>=768px) — table -->
        <div class="pr-compare__table-wrap reveal" role="region" aria-label="Free vs Pro feature comparison">
          <table class="pr-compare__table">
            <caption class="visually-hidden">Pulse Free vs Pro feature comparison</caption>
            <thead>
              <tr>
                <th scope="col">Feature</th>
                <th scope="col" class="col-free">Free</th>
                <th scope="col" class="col-pro">Pro</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  <td class={r.free === 'yes' ? 'mark mark--yes' : r.free === 'no' ? 'mark mark--no' : ''}>
                    {r.free === 'yes' ? (
                      <span class="pr-compare__mark" data-val="yes" aria-hidden="true"><span class="visually-hidden">Included</span></span>
                    ) : r.free === 'no' ? (
                      <span class="pr-compare__mark" data-val="no" aria-hidden="true"><span class="visually-hidden">Not included</span></span>
                    ) : r.free}
                  </td>
                  <td class={r.pro === 'yes' ? 'col-pro mark mark--yes' : r.pro === 'no' ? 'col-pro mark mark--no' : 'col-pro'}>
                    {r.pro === 'yes' ? (
                      <span class="pr-compare__mark" data-val="yes" aria-hidden="true"><span class="visually-hidden">Included</span></span>
                    ) : r.pro === 'no' ? (
                      <span class="pr-compare__mark" data-val="no" aria-hidden="true"><span class="visually-hidden">Not included</span></span>
                    ) : r.pro}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Mobile (<768px) — stacked cards -->
        <div class="pr-compare__cards">
          {['free', 'pro'].map((which) => (
            <article class={`pr-compare__card reveal ${which === 'pro' ? 'is-highlight' : ''}`}>
              <header class="pr-compare__card-head">
                <h3 class="pr-compare__card-name">{which === 'free' ? 'Free' : 'Pro'}</h3>
                <p class="pr-compare__card-tagline">{which === 'free' ? '$0, 100K GPT-4o mini tokens / mo' : 'From $20/mo or $192/yr, unlimited'}</p>
              </header>
              <dl class="pr-compare__card-list">
                {comparisonRows.map((r) => {
                  const v = which === 'free' ? r.free : r.pro;
                  const text = v === 'yes' ? 'Included' : v === 'no' ? 'Not included' : v;
                  return (
                    <>
                      <dt>{r.label}</dt>
                      <dd class={v === 'yes' ? 'mark mark--yes' : v === 'no' ? 'mark mark--no' : ''}>{text}</dd>
                    </>
                  );
                })}
              </dl>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── Trust signals ────────────────────────────── -->
    <section class="pr-trust" id="trust">
      <div class="container">
        <header class="pr-trust__head reveal">
          <span class="eyebrow">How Pulse is built</span>
          <h2>The fine print, in plain language.</h2>
        </header>
        <ul class="pr-trust__grid" role="list">
          {trustSignals.map((s) => (
            <li class="pr-trust__item reveal">
              <h3 class="pr-trust__title">{s.title}</h3>
              <p class="pr-trust__body">{s.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ─── FAQ ──────────────────────────────────────── -->
    <section class="pr-faq" id="faq">
      <div class="container">
        <header class="pr-faq__head reveal">
          <span class="eyebrow">FAQ</span>
          <h2>Common questions.</h2>
        </header>
        <div class="pr-faq__list">
          {faqs.map((f, i) => (
            <details class="faq__item reveal" open={i === 0}>
              <summary class="faq__q">
                <span class="faq__q-text">{f.q}</span>
                <svg class="faq__chev" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </summary>
              <div class="faq__a" set:html={f.a} />
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── Final CTA ────────────────────────────────── -->
    <section class="pr-cta">
      <div class="container pr-cta__inner reveal">
        <h2>Start free. Upgrade only if you actually need more than 100K tokens a month.</h2>
        <div class="pr-cta__row">
          <a class="btn btn--primary btn--lg" href="/download/">Start free ↓</a>
          <a class="btn btn--ghost btn--lg" href="/faq/">Read the FAQ →</a>
        </div>
      </div>
    </section>
  </main>

  <Footer license="" version="" />
</Base>

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />

<style>
  /* ─── Hero ──────────────────────────────────────── */
  .pr-hero {
    padding-top: clamp(112px, 14vw, 160px);
    padding-bottom: clamp(56px, 8vw, 96px);
    overflow: hidden;
  }
  .pr-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(40px, 5vw, 64px);
    align-items: center;
  }
  @media (min-width: 900px) {
    .pr-hero__grid { grid-template-columns: minmax(0, 1fr); }
  }
  .pr-hero__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; max-width: 64ch; }
  .pr-hero__title {
    font-size: var(--fs-1);
    line-height: 1.05;
    font-weight: 700;
    color: var(--fg);
    letter-spacing: -0.02em;
  }
  .pr-hero__sub {
    color: var(--fg-dim);
    font-size: var(--fs-body);
    line-height: 1.65;
  }
  .pr-hero__trust {
    color: var(--muted);
    font-size: 0.92rem;
    font-family: ui-monospace, "JetBrains Mono", monospace;
    letter-spacing: 0.02em;
  }
  .pr-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  /* ─── Tier cards ────────────────────────────────── */
  .pr-tiers { padding-block: clamp(48px, 7vw, 96px); }
  .pr-tiers__head { text-align: center; max-width: 640px; margin: 0 auto 2.5rem; }
  .pr-tiers__head h2 { font-size: var(--fs-2); }

  .pr-tiers__grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: stretch;
    max-width: 920px;
    margin: 0 auto;
  }
  @media (min-width: 720px) {
    .pr-tiers__grid { grid-template-columns: repeat(2, 1fr); }
  }

  .pr-tier {
    position: relative;
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg-soft) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.85rem 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color var(--dur) var(--ease),
                transform var(--dur) var(--ease),
                box-shadow var(--dur) var(--ease);
  }
  .pr-tier:hover {
    border-color: var(--fg-dim);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .pr-tier--featured {
    border-color: var(--purple);
    box-shadow: 0 0 0 1px rgba(187,154,247,0.25),
                0 12px 40px rgba(187,154,247,0.18);
  }
  .pr-tier--featured:hover {
    border-color: var(--purple);
    box-shadow: 0 0 0 1px rgba(187,154,247,0.45),
                0 16px 48px rgba(187,154,247,0.25);
  }

  .pr-tier__badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--purple);
    color: #1a1b26;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 9999px;
    white-space: nowrap;
  }

  .pr-tier__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
  }
  .pr-tier__name { font-size: 1.25rem; font-weight: 700; color: var(--fg); margin: 0; }
  .pr-tier__tag {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--purple);
    font-weight: 600;
  }

  .pr-tier__price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1rem;
  }
  .pr-tier__amount {
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1;
    color: var(--fg);
    letter-spacing: -0.02em;
  }
  .pr-tier__period {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .pr-tier__desc {
    color: var(--fg-dim);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
    min-height: 3em;
  }

  .pr-tier__cta {
    align-self: flex-start;
    margin-top: 0.25rem;
  }
  @media (max-width: 767px) {
    .pr-tier__cta { align-self: stretch; width: 100%; min-height: 52px; }
  }

  .pr-tier__list {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .pr-tier__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: var(--fg-dim);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .pr-tier__check { color: var(--green); flex-shrink: 0; display: inline-flex; margin-top: 0.1em; }

  /* ─── Comparison table ──────────────────────────── */
  .pr-compare { padding-block: clamp(48px, 7vw, 96px); background: var(--bg-soft); }
  .pr-compare__head { text-align: center; max-width: 640px; margin: 0 auto 2.5rem; }
  .pr-compare__head h2 { font-size: var(--fs-2); }

  .pr-compare__table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .pr-compare__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .pr-compare__table th,
  .pr-compare__table td {
    padding: 0.85rem 1rem;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }
  .pr-compare__table th[scope="row"] {
    text-align: left;
