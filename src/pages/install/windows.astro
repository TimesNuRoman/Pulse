---
// SPDX-License-Identifier: Apache-2.0
/**
 * R135: /install/windows/ — step-by-step install guide for Pulse Windows.
 *
 * 10 sections (H2):
 *   1. Choose an installer   (NSIS / MSI / portable, with SHA-256)
 *   2. Download              (direct + winget placeholder)
 *   3. Run the installer     (3 numbered steps)
 *   4. First launch          (tray + side panel + hotkey)
 *   5. Optional: Ollama      (GPU-aware model recommendation)
 *   6. Optional: voice input (Windows speech settings)
 *   7. Optional: winget      (Microsoft Store submission pending)
 *   8. Uninstall             (Settings app + original .msi / NSIS uninstaller)
 *   9. Troubleshooting       (SmartScreen, missing runtime, no AI response)
 *  10. Next                  (links to /download/, /faq/, /pricing/)
 *
 * Hard rules: no emoji, no "we / I / by author / Pulse team", no marketing
 * fluff, no future promises, dark-only, Apache 2.0. Section styles are
 * scoped to this page (no global CSS touched — R133/R134 scope respected).
 *
 * R234: VERSION, NSIS_URL/MSI_URL, NSIS_FILE/MSI_FILE, and the
 * SHA-256 fingerprints are sourced from `src/lib/versions.ts` (the
 * SSOT). The next version bump is a 1-line edit to
 * public/updates/*.json, not a search-replace.
 */
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/notes.css';
import {
  WINDOWS_VERSION,
  WINDOWS_NSIS_URL,
  WINDOWS_MSI_URL,
  WINDOWS_PORTABLE_URL,
  WINDOWS_NSIS_SHA,
  WINDOWS_MSI_SHA,
  WINDOWS_PORTABLE_SHA,
  WINDOWS_MIN_OS,
  SITE_BASE,
} from '../../lib/versions';

const VERSION = WINDOWS_VERSION;
const PAGE_TITLE = `Install Pulse for Windows v${VERSION} — step-by-step guide`;
const PAGE_DESC =
  'Install Pulse for Windows. Three installers, five minutes, works offline. ' +
  'SHA-256 hashes, system requirements, and a fix for SmartScreen.';

// SHA-256 fingerprints (R130 verified against actual files). The
// short form (first 8 ... last 4) is exposed by the SSOT as
// WINDOWS_NSIS_SHA / WINDOWS_MSI_SHA / WINDOWS_PORTABLE_SHA.
const NSIS_SHA = WINDOWS_NSIS_SHA;
const MSI_SHA = WINDOWS_MSI_SHA;
const PORT_SHA = WINDOWS_PORTABLE_SHA;

// Direct download URLs (R130 pinned to ownlocalml.com).
const NSIS_URL  = `${SITE_BASE}${WINDOWS_NSIS_URL}`;
const MSI_URL   = `${SITE_BASE}${WINDOWS_MSI_URL}`;
const PORT_URL  = `${SITE_BASE}${WINDOWS_PORTABLE_URL}`;
const NSIS_FILE = WINDOWS_NSIS_URL.split('/').pop() ?? '';
const MSI_FILE  = WINDOWS_MSI_URL.split('/').pop() ?? '';
const PORT_FILE = WINDOWS_PORTABLE_URL.split('/').pop() ?? '';

// System requirements.
const MIN_OS = WINDOWS_MIN_OS;
const ARCH = 'x86_64';
---

<Base
  title={PAGE_TITLE}
  description={PAGE_DESC}
  ogImage="/og-image.svg"
  canonical="https://ownlocalml.com/install/windows/"
  ctaVisible={false}
  footerLicense=""
  footerVersion={`v${VERSION}`}
>
  <a class="skip-link" href="#main">Skip to content</a>

  
  {/* R251: header is rendered by <Base/> via <RayHeader/> */}


  <main id="main" class="notes-main install">
    <!-- ─── Hero ────────────────────────────────────────── -->
    <section class="notes-hero install__hero">
      <div class="bg-glow"></div>
      <div class="container notes-hero__grid">
        <div class="notes-hero__copy reveal">
          <div class="notes-hero__badges">
            <span class="notes-hero__eyebrow">Pulse · Windows · install guide</span>
            <span class="notes-hero__pill" aria-label="Latest version">
              <span class="notes-hero__pill-dot" aria-hidden="true"></span>
              v{VERSION}
            </span>
          </div>
          <h1 class="notes-hero__title">Install Pulse for Windows</h1>
          <p class="notes-hero__sub">v{VERSION} · 5 minutes · works offline</p>
          <p class="install__intro">
            Three installers, one portable binary, and a SHA-256 on every file. Pulse runs from the system tray, opens with a global hotkey, and talks to a local model on the same machine. {MIN_OS} or newer, {ARCH} only.
          </p>
        </div>
      </div>
    </section>

    <!-- ─── 1. Choose an installer ──────────────────────── -->
    <section class="ig" id="installers" aria-label="Choose an installer">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Step 1</span>
          <h2>Choose an installer</h2>
          <p class="lede">All three packages install the same Pulse v{VERSION} binary. Pick the format that matches the deployment.</p>
        </header>

        <div class="ig__grid" role="list">
          <article class="ig__card glass reveal" role="listitem">
            <span class="ig__card-badge ig__card-badge--recommended">Recommended</span>
            <h3 class="ig__card-title">NSIS installer</h3>
            <p class="ig__card-format"><code>.exe</code> · 12.29 MB · single user</p>
            <p class="ig__card-body">
              Standard Windows setup wizard with per-user install, a Start-menu shortcut, and an entry in Add or Remove Programs. Best for personal machines.
            </p>
            <dl class="ig__card-meta">
              <dt>Filename</dt>
              <dd><code>{NSIS_FILE}</code></dd>
              <dt>SHA-256</dt>
              <dd><code>{NSIS_SHA}</code></dd>
            </dl>
            <a class="btn btn--primary ig__card-cta" href={NSIS_URL} rel="noopener noreferrer">Download NSIS ↓ 12.29 MB</a>
          </article>

          <article class="ig__card glass reveal" role="listitem">
            <span class="ig__card-badge">For IT</span>
            <h3 class="ig__card-title">MSI installer</h3>
            <p class="ig__card-format"><code>.msi</code> · 16.94 MB · machine-wide</p>
            <p class="ig__card-body">
              Windows Installer package suitable for Group Policy, SCCM, Intune, and other enterprise deployment pipelines. Installs to <code>Program Files</code>.
            </p>
            <dl class="ig__card-meta">
              <dt>Filename</dt>
              <dd><code>{MSI_FILE}</code></dd>
              <dt>SHA-256</dt>
              <dd><code>{MSI_SHA}</code></dd>
            </dl>
            <a class="btn btn--ghost ig__card-cta" href={MSI_URL} rel="noopener noreferrer">Download MSI ↓ 16.94 MB</a>
          </article>

          <article class="ig__card glass reveal" role="listitem">
            <span class="ig__card-badge">No install</span>
            <h3 class="ig__card-title">Portable</h3>
            <p class="ig__card-format"><code>.exe</code> · 9.99 MB · runs anywhere</p>
            <p class="ig__card-body">
              Standalone executable with no installer. Place it on a USB stick, a network share, or a folder on the desktop. Settings live next to the binary.
            </p>
            <dl class="ig__card-meta">
              <dt>Filename</dt>
              <dd><code>{PORT_FILE}</code></dd>
              <dt>SHA-256</dt>
              <dd><code>{PORT_SHA}</code></dd>
            </dl>
            <a class="btn btn--ghost ig__card-cta" href={PORT_URL} rel="noopener noreferrer">Download portable ↓ 9.99 MB</a>
          </article>
        </div>

        <p class="ig__note">
          All three hashes are verified at build time and pinned in <a href="https://ownlocalml.com/updates/desktop.json"><code>/updates/desktop.json</code></a>. <code>Get-FileHash -Algorithm SHA256 &lt;file&gt;</code> in PowerShell reproduces the value on a downloaded copy.
        </p>
      </div>
    </section>

    <!-- ─── 2. Download ─────────────────────────────────── -->
    <section class="ig" id="download" aria-label="Download">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Step 2</span>
          <h2>Download</h2>
          <p class="lede">Direct links to the R2-hosted installers. A Microsoft Store winget package is in review — see the optional step below.</p>
        </header>

        <ul class="ig__links reveal" role="list">
          <li>
            <a class="ig__link" href={NSIS_URL} rel="noopener noreferrer">
              <span class="ig__link-label">NSIS installer</span>
              <span class="ig__link-meta"><code>{NSIS_FILE}</code> · 12.29 MB</span>
            </a>
          </li>
          <li>
            <a class="ig__link" href={MSI_URL} rel="noopener noreferrer">
              <span class="ig__link-label">MSI installer</span>
              <span class="ig__link-meta"><code>{MSI_FILE}</code> · 16.94 MB</span>
            </a>
          </li>
          <li>
            <a class="ig__link" href={PORT_URL} rel="noopener noreferrer">
              <span class="ig__link-label">Portable</span>
              <span class="ig__link-meta"><code>{PORT_FILE}</code> · 9.99 MB</span>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <!-- ─── 3. Run the installer ────────────────────────── -->
    <section class="ig" id="run" aria-label="Run the installer">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Step 3</span>
          <h2>Run the installer</h2>
          <p class="lede">Three steps. No reboot. The NSIS installer is shown; MSI and portable follow the same pattern.</p>
        </header>

        <ol class="ig__steps reveal" role="list">
          <li class="ig__step">
            <span class="ig__step-num">1</span>
            <div class="ig__step-body">
              <h3 class="ig__step-title">Double-click the downloaded <code>{NSIS_FILE}</code>.</h3>
              <p class="ig__step-body-copy">
                A security dialog may ask whether to allow the app to make changes (User Account Control). Pulse is signed with a developer's Authenticode certificate until the WHQL review completes; the publisher field shows the signer name on click.
              </p>
            </div>
          </li>
          <li class="ig__step">
            <span class="ig__step-num">2</span>
            <div class="ig__step-body">
              <h3 class="ig__step-title">Accept the UAC prompt.</h3>
              <p class="ig__step-body-copy">
                Click <strong>Yes</strong> on the User Account Control dialog. The default install path is <code>C:\Users\&lt;you&gt;\AppData\Local\Programs\Pulse\</code> (Tauri default, per-user scope). Pick a different folder in the wizard to change it.
              </p>
            </div>
          </li>
          <li class="ig__step">
            <span class="ig__step-num">3</span>
            <div class="ig__step-body">
              <h3 class="ig__step-title">Click <strong>Install</strong>.</h3>
              <p class="ig__step-body-copy">
                The wizard copies the binary, registers the file association, and adds a Start-menu entry under <em>Pulse</em>. The whole flow takes under twenty seconds on a modern SSD. No reboot is required.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- ─── 4. First launch ─────────────────────────────── -->
    <section class="ig" id="first-launch" aria-label="First launch">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Step 4</span>
          <h2>First launch</h2>
          <p class="lede">Pulse lives in the system tray. The side panel slides in from the right edge of the screen on a global hotkey.</p>
        </header>

        <div class="ig__prose reveal">
          <p>
            After install, Pulse starts hidden. A small <em>Pulse · click to open</em> entry appears in the system tray (notification area, bottom-right of the taskbar). Click it once and the side panel slides in from the right edge of the screen — a narrow column about 420&nbsp;px wide, anchored to the top-right.
          </p>
          <p>
            The default global hotkey is <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>Space</kbd>. Press it from any application to summon or dismiss the panel. The hotkey is rebindable in <strong>Settings → Hotkey</strong>. The first launch surfaces a one-time setup wizard that detects the GPU and recommends a local model — see the next step.
          </p>
        </div>
      </div>
    </section>

    <!-- ─── 5. Optional: Ollama ─────────────────────────── -->
    <section class="ig" id="ollama" aria-label="Optional Ollama setup">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Step 5 · optional</span>
          <h2>Pick a local model</h2>
          <p class="lede">Pulse ships a setup wizard that detects the GPU and recommends a model. The choice is required reading before v0.6.0+ models run locally.</p>
        </header>

        <div class="ig__prose reveal">
          <p>
            On first launch, the wizard inspects the GPU and suggests one of three Ollama models:
          </p>
          <ul class="ig__list" role="list">
            <li><strong>NVIDIA GPU</strong> — <code>gemma3:4b</code> · ~3 GB VRAM · best quality on consumer NVIDIA.</li>
            <li><strong>AMD or Intel GPU</strong> — <code>qwen2.5:3b</code> · ~2 GB VRAM · falls back to CPU if Vulkan is missing.</li>
            <li><strong>CPU only</strong> — <code>qwen2.5:1.5b</code> · ~1 GB RAM · usable on any x86_64 machine, slower token throughput.</li>
          </ul>
          <p>
            Pulse ships a bundled Ollama runtime on Windows, so no separate install is required. To install Ollama by hand or swap the model catalog, see <a href="https://ollama.com" rel="noopener noreferrer">ollama.com</a>. The wizard reopens from <strong>Settings → AI → Model setup</strong> at any time.
          </p>
        </div>
      </div>
    </section>

    <!-- ─── 6. Optional: voice input ────────────────────── -->
    <section class="ig" id="voice" aria-label="Optional voice input">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Step 6 · optional</span>
          <h2>Enable voice input</h2>
          <p class="lede">Windows speech recognition needs a single toggle in Privacy settings. Without it, the mic button in the panel is disabled.</p>
        </header>

        <div class="ig__prose reveal">
          <p>
            Open <strong>Windows Settings → Privacy &amp; security → Speech</strong> and turn on <em>Speech recognition</em>. The Pulse mic button in the side panel listens for tap-to-dictate after the toggle is on. Voice input uses the OS SpeechRecognition API on Windows; no audio leaves the machine.
          </p>
          <p>
            Cloud STT (Whisper) is a PRO feature in development — it ships in a future Pulse release behind the PRO license.
          </p>
        </div>
      </div>
    </section>

    <!-- ─── 7. Optional: winget ─────────────────────────── -->
    <section class="ig" id="winget" aria-label="Optional winget install">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Step 7 · optional</span>
          <h2>Install via winget</h2>
          <p class="lede">A Microsoft Store submission is in review. The direct download above works today.</p>
        </header>

        <div class="ig__prose reveal">
          <p>
            The planned winget package is <code>Pulse.Pulse</code>. The submission is pending Microsoft approval — winget install will fail with <em>Package not found</em> until the listing is live. The direct download at the top of this page is the only working install path right now; check back later or follow the <a href="/changelog/">changelog</a> for the winget listing announcement.
          </p>
        </div>
      </div>
    </section>

    <!-- ─── 8. Uninstall ────────────────────────────────── -->
    <section class="ig" id="uninstall" aria-label="Uninstall">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Step 8</span>
          <h2>Uninstall</h2>
          <p class="lede">The standard Windows uninstall path works for all three installers.</p>
        </header>

        <div class="ig__prose reveal">
          <p>
            Open <strong>Settings → Apps → Installed apps</strong>, find Pulse in the list, and click <em>Uninstall</em>. The original <code>{NSIS_FILE}</code> and <code>{MSI_FILE}</code> installers also carry an uninstaller — re-run either one and pick <em>Uninstall</em> from the wizard. The portable binary has no installer: delete <code>{PORT_FILE}</code> from the folder where it lives to remove Pulse.
          </p>
        </div>
      </div>
    </section>

    <!-- ─── 9. Troubleshooting ──────────────────────────── -->
    <section class="ig" id="troubleshooting" aria-label="Troubleshooting">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Step 9</span>
          <h2>Troubleshooting</h2>
          <p class="lede">The three issues that come up most often, and the fix for each.</p>
        </header>

        <ul class="ig__bullets reveal" role="list">
          <li>
            <strong>Installer blocked by SmartScreen.</strong>
            SmartScreen shows <em>Windows protected your PC</em> on first run. Click <em>More info</em>, then <em>Run anyway</em>. Pulse uses a developer's code-signing certificate until Microsoft completes the WHQL review — the publisher field shows the signer name on the dialog.
          </li>
          <li>
            <strong>Pulse does not open after install.</strong>
            Open <strong>Windows Event Viewer → Application</strong> and look for the most recent error. If the log mentions <code>VCRUNTIME140.dll</code> missing, install the Visual C++ Redistributable from <a href="https://aka.ms/vs/17/release/vc_redist.x64.exe" rel="noopener noreferrer">aka.ms/vs/17/release/vc_redist.x64.exe</a> and reboot once.
          </li>
          <li>
            <strong>No AI response in the panel.</strong>
            Ollama is not running. Open Pulse → <strong>Settings → AI</strong> and click <em>Start Ollama</em>, or run <code>ollama serve</code> in PowerShell. The bundled Ollama runtime is on the system PATH after the NSIS or MSI install.
          </li>
        </ul>
      </div>
    </section>

    <!-- ─── 10. Next ────────────────────────────────────── -->
    <section class="ig ig--next" id="next" aria-label="Next steps">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Step 10</span>
          <h2>Next</h2>
          <p class="lede">Three follow-up links from the same dark Tokyo Night surface.</p>
        </header>

        <ul class="ig__next reveal" role="list">
          <li>
            <a class="ig__next-link" href="/#download">
              <span class="ig__next-label">Download</span>
              <span class="ig__next-meta">Three installers, one portable — all pinned to v{VERSION}.</span>
            </a>
          </li>
          <li>
            <a class="ig__next-link" href="/faq/">
              <span class="ig__next-label">FAQ</span>
              <span class="ig__next-meta">Common questions on hotkeys, models, and the manifest.</span>
            </a>
          </li>
          <li>
            <a class="ig__next-link" href="/pricing/">
              <span class="ig__next-label">Pricing</span>
              <span class="ig__next-meta">14-day trial, then $20/mo or $192/yr.</span>
            </a>
          </li>
        </ul>

        <p class="ig__back">
          <a class="btn btn--ghost" href="/">Back to home</a>
        </p>
      </div>
    </section>
  </main>

  <Footer license="" version={`v${VERSION}`} />
</Base>

<style>
  /* ── Install-guide section styles (scoped to this page) ─────── */
  .install__hero { padding-bottom: clamp(48px, 8vw, 96px); }
  .install__intro {
    font-size: 1.05rem;
    color: var(--fg-dim);
    max-width: 64ch;
    margin-top: 0.5rem;
    line-height: 1.6;
  }
  .install__intro code { color: var(--cyan); }

  .ig {
    background: radial-gradient(800px 400px at 80% 0%, rgba(187,154,247,0.05), transparent 65%),
                radial-gradient(700px 400px at 10% 100%, rgba(122,162,247,0.06), transparent 65%);
  }
  .ig__head {
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    max-width: 64ch;
  }
  .ig__head h2 { max-width: 22ch; margin: 0; }
  .ig__head .lede { margin: 0.5rem 0 0; }

  /* ── 1. Installer cards ─────────────────────────────────────── */
  .ig__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin: 0 0 1.5rem;
  }
  @media (min-width: 760px) { .ig__grid { grid-template-columns: repeat(3, 1fr); } }

  .ig__card {
    padding: 1.5rem 1.5rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    position: relative;
  }
  .ig__card-badge {
    display: inline-block;
    align-self: flex-start;
    padding: 0.18rem 0.55rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.02);
  }
  .ig__card-badge--recommended {
    color: var(--purple);
    border-color: rgba(187, 154, 247, 0.5);
    background: rgba(187, 154, 247, 0.08);
  }
  .ig__card-title {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    margin: 0;
    color: var(--fg);
  }
  .ig__card-format {
    margin: 0;
    color: var(--fg-dim);
    font-size: 0.9rem;
    font-family: ui-monospace, "JetBrains Mono", monospace;
  }
  .ig__card-format code { color: var(--cyan); }
  .ig__card-body {
    color: var(--fg-dim);
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0;
  }
  .ig__card-body code { color: var(--cyan); }

  .ig__card-meta {
    margin: 0;
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 0.3rem 0.75rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .ig__card-meta dt { font-weight: 600; letter-spacing: 0.04em; }
  .ig__card-meta dd { margin: 0; color: var(--fg-dim); }
  .ig__card-meta code {
    background: var(--surface-2);
    padding: 0.05em 0.35em;
    border-radius: 3px;
    border: 1px solid var(--border);
    color: var(--cyan);
    font-size: 0.86em;
    word-break: break-all;
  }
  .ig__card-cta { margin-top: 0.3rem; align-self: stretch; justify-content: center; }

  .ig__note {
    color: var(--muted);
    font-size: 0.88rem;
    margin: 0;
    max-width: 70ch;
  }
  .ig__note code {
    background: var(--surface-2);
    padding: 0.05em 0.35em;
    border-radius: 3px;
    border: 1px solid var(--border);
    color: var(--cyan);
    font-size: 0.92em;
  }

  /* ── 2. Download link list ──────────────────────────────────── */
  .ig__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-width: 720px;
  }
  .ig__link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg-soft) 100%);
    color: var(--fg);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .ig__link:hover { border-color: var(--purple); transform: translateY(-1px); color: var(--fg); }
  .ig__link-label { font-weight: 600; color: var(--fg); font-size: 1rem; }
  .ig__link-meta { color: var(--fg-dim); font-size: 0.88rem; font-family: ui-monospace, "JetBrains Mono", monospace; }
  .ig__link-meta code { color: var(--cyan); }

  /* ── 3. Numbered steps ──────────────────────────────────────── */
  .ig__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 820px;
    counter-reset: ig-step;
  }
  .ig__step {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1rem 1.25rem;
    align-items: start;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
