---
// SPDX-License-Identifier: Apache-2.0
/**
 * R177: /install/android/ — step-by-step install guide for Pulse Android.
 *
 * 9 sections (H2):
 *   1. What you'll need   (Android version + storage + unknown-sources + Wi-Fi)
 *   2. Download the APK   (GitHub releases link + signed-APK note)
 *   3. Allow unknown sources (Settings path for Android 8 / 12+)
 *   4. Open the APK file  (tap the file in the file manager / browser)
 *   5. Install            (Install → Open)
 *   6. Pick a model       (first-launch model picker, links to /install/windows/)
 *   7. Security note      (signing-key fingerprint callout)
 *   8. Common issues      (install blocked / signature conflict / crashes / model path)
 *   9. Next steps         (Windows / FAQ / Pricing)
 *
 * Hard rules: no emoji, no first-person copy, no marketing
 * fluff, no future promises, dark-only. Section styles are
 * scoped to this page (no global CSS touched — R133/R135 scope respected).
 *
 * R234: VERSION is sourced from `src/lib/versions.ts` (the SSOT).
 * The next version bump is a 1-line edit to public/updates/*.json.
 * The page's body copy that references "v0.6.6" describes the
 * historical / current side-load procedure and is left as-is
 * (the JSX renders v0.6.6 → v${VERSION} where the literal makes
 * sense; some body copy stays anchored to the v0.6.6 procedure
 * for SEO continuity — see the body for context).
 */
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/notes.css';
import { ANDROID_VERSION } from '../../lib/versions';

const VERSION = ANDROID_VERSION;
const PAGE_TITLE = `Install Pulse for Android v${VERSION} — step-by-step guide`;
const PAGE_DESC =
  'Install Pulse for Android. Sideload the signed APK in five steps, ' +
  'pick a local model, and start working offline. System requirements and ' +
  'a fix for "install blocked" warnings included.';

// Direct asset URLs (R166 verified against the actual files in
// public/install/android/). Kept as variables so the version bump is one line.
const GITHUB_RELEASES = 'https://github.com/TimesNuRoman/Pulse/releases';
const ICON_MOCKUP = '/install/android/icon-mockup.png';
const ICON_XXXHDPI = '/install/android/icon-xxxhdpi.png';
const SPLASH_PORTRAIT = '/install/android/splash-portrait.png';
const LAST_UPDATED = '2026-08-03';

// JSON-LD: one SoftwareApplication for the APK + one HowTo with five steps.
// Sits in a single <script type="application/ld+json"> block in the markup.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Pulse for Android',
    operatingSystem: 'ANDROID',
    applicationCategory: 'ProductivityApplication',
    applicationSubCategory: 'NotesApplication',
    fileFormat: 'application/vnd.android.package-archive',
    softwareVersion: VERSION,
    softwareRequirements: 'Android 8.0 (API 26) or later',
    downloadUrl: `${GITHUB_RELEASES}`.replace('/releases', '/releases/latest'),
    description:
      'A markdown note editor and AI side panel for Android. ' +
      'Backlinks, tags, voice input, and full-text search.',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: `Install Pulse for Android v${VERSION}`,
    totalTime: 'PT3M',
    estimatedCost: {
      '@type': 'MonetaryAmount',
      currency: 'USD',
      value: '0',
    },
    tool: [
      { '@type': 'HowToTool', name: 'An Android phone or tablet running Android 8.0 (API 26) or later' },
      { '@type': 'HowToTool', name: 'A web browser or file manager with "Install unknown apps" enabled' },
    ],
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Download the APK',
        text: 'Open the GitHub releases page and download the signed APK to the device.',
        url: `https://ownlocalml.com/install/android/#download`,
        estimatedTime: 'PT30S',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Allow unknown sources',
        text: 'Open Android Settings, navigate to Apps → Special access → Install unknown apps, and allow the browser or file manager used for the download.',
        url: `https://ownlocalml.com/install/android/#allow`,
        estimatedTime: 'PT45S',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Open the APK file',
        text: 'Tap the downloaded APK in the notification shade or in the Downloads folder. Android shows the package details screen.',
        url: `https://ownlocalml.com/install/android/#open`,
        estimatedTime: 'PT15S',
      },
      {
        '@type': 'HowToStep',
        position: 4,
        name: 'Install',
        text: 'Tap Install. The package installs in under ten seconds. Tap Open when ready.',
        url: `https://ownlocalml.com/install/android/#install`,
        estimatedTime: 'PT15S',
      },
      {
        '@type': 'HowToStep',
        position: 5,
        name: 'Pick a model',
        text: 'On first launch, Pulse prompts for the local model. gemma3:4b is a good default on phones with at least 3 GB of free RAM.',
        url: `https://ownlocalml.com/install/android/#model`,
        estimatedTime: 'PT30S',
      },
    ],
  },
];
---

<Base
  title={PAGE_TITLE}
  description={PAGE_DESC}
  ogImage="/og-image.svg"
  canonical="https://ownlocalml.com/install/android/"
  ctaVisible={false}
  footerLicense=""
  footerVersion={`v${VERSION}`}
>
  <a class="skip-link" href="#main">Skip to content</a>

  
  {/* R251: header is rendered by <Base/> via <RayHeader/> */}


  <main id="main" class="notes-main install">
    <!-- ─── Hero ────────────────────────────────────────── -->
    <section class="notes-hero install__hero">
      <div class="bg-glow"></div>
      <div class="container notes-hero__grid">
        <div class="notes-hero__copy reveal">
          <div class="notes-hero__badges">
            <span class="notes-hero__eyebrow">Pulse · Android · install guide</span>
            <span class="notes-hero__pill" aria-label="Latest version">
              <span class="notes-hero__pill-dot" aria-hidden="true"></span>
              v{VERSION}
            </span>
          </div>
          <h1 class="notes-hero__title">Install Pulse for Android</h1>
          <p class="notes-hero__sub">v{VERSION} · 2 minutes · sideload from GitHub</p>
          <p class="install__intro">
            A signed APK, five steps, and a one-time toggle in Android settings. The first launch surfaces a model picker and downloads the chosen Ollama weights to the device.
          </p>
        </div>
      </div>
    </section>

    <!-- ─── 1. What you'll need ─────────────────────────── -->
    <section class="ig" id="needs" aria-label="What you'll need">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Before you start</span>
          <h2>What you'll need</h2>
          <p class="lede">Four prerequisites. None of them require a developer account or a USB cable.</p>
        </header>

        <ul class="ig__checklist reveal" role="list">
          <li>
            <span class="ig__check" aria-hidden="true"></span>
            <div>
              <strong>Android 8.0 (API 26) or later.</strong>
              The package targets API 36 and sets the minimum to 26. Phones on Android 7.x or earlier cannot install it.
            </div>
          </li>
          <li>
            <span class="ig__check" aria-hidden="true"></span>
            <div>
              <strong>About 30 MB of free storage.</strong>
              The APK is 1.29 MB. Local model weights download separately and need 1&ndash;3 GB depending on the chosen model.
            </div>
          </li>
          <li>
            <span class="ig__check" aria-hidden="true"></span>
            <div>
              <strong>"Install unknown apps" enabled for the browser or file manager.</strong>
              Android 8 blocks sideloaded APKs by default. The toggle is per-app, not global.
            </div>
          </li>
          <li>
            <span class="ig__check" aria-hidden="true"></span>
            <div>
              <strong>Wi-Fi or mobile data for the initial model download.</strong>
              The APK is small. The first-run model pull is the larger transfer. After that, Pulse works offline.
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- ─── 2. Download the APK ─────────────────────────── -->
    <section class="ig" id="download" aria-label="Download the APK">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Step 1 of 5 · 30 seconds</span>
          <h2>Download the APK</h2>
          <p class="lede">The release page carries a single signed APK per version. The link works on the phone itself or on a desktop with a USB transfer later.</p>
        </header>

        <div class="ig__prose reveal">
          <p>
            Open <a href={GITHUB_RELEASES} rel="noopener noreferrer"><code>github.com/TimesNuRoman/Pulse/releases</code></a> on the phone and pick the latest Android asset. The APK file name is <code>pulse-notes-{VERSION}.apk</code>. A SHA-256 fingerprint sits next to the download on the release page; <code>adb shell sha256sum</code> on the file reproduces the value if the device is reachable over USB.
          </p>
        </div>

        <p class="ig__cta reveal">
          <a class="btn btn--primary ig__cta-btn" href={GITHUB_RELEASES} rel="noopener noreferrer">Open GitHub releases → v{VERSION}</a>
        </p>
      </div>
    </section>

    <!-- ─── 3. Allow unknown sources ────────────────────── -->
    <section class="ig" id="allow" aria-label="Allow unknown sources">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Step 2 of 5 · 45 seconds</span>
          <h2>Allow unknown sources</h2>
          <p class="lede">Android blocks sideloaded APKs by default. The toggle is per-app and lives in two different places depending on the Android version.</p>
        </header>

        <ol class="ig__steps reveal" role="list">
          <li class="ig__step">
            <span class="ig__step-num">2.1</span>
            <div class="ig__step-body">
              <h3 class="ig__step-title">Open <strong>Settings → Apps → Special access → Install unknown apps</strong>.</h3>
              <p class="ig__step-body-copy">
                On Android 12 and newer the path is <strong>Settings → Apps → Special apps → Install unknown apps</strong>. On Android 8 through 11 the path is <strong>Settings → Apps &amp; notifications → Advanced → Special access → Install unknown apps</strong>.
              </p>
            </div>
          </li>
          <li class="ig__step">
            <span class="ig__step-num">2.2</span>
            <div class="ig__step-body">
              <h3 class="ig__step-title">Pick the browser or file manager that opened the APK.</h3>
              <p class="ig__step-body-copy">
                Toggle <strong>Allow from this source</strong> on. Chrome, Files, and a USB-transferred file from a desktop each show up as separate entries.
              </p>
            </div>
          </li>
        </ol>

        <aside class="ig__callout reveal" role="note">
          <p>
            <strong>Android 8 only:</strong> the toggle is at <strong>Settings → Security &amp; location → Install unknown apps</strong>. The per-app model landed in Android 9. The end result is the same.
          </p>
        </aside>
      </div>
    </section>

    <!-- ─── 4. Open the APK file ────────────────────────── -->
    <section class="ig" id="open" aria-label="Open the APK file">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Step 3 of 5 · 15 seconds</span>
          <h2>Open the APK file</h2>
          <p class="lede">Android surfaces the package details screen with the app name, version, and the permissions the package will request.</p>
        </header>

        <div class="ig__prose reveal">
          <p>
            Tap the downloaded <code>pulse-notes-{VERSION}.apk</code> in the notification shade or in <strong>Files → Downloads</strong>. Android shows the package screen with the Pulse icon, the version number, and a list of requested permissions (storage, microphone for voice input, network for the model download). The screen asks for confirmation before the package is installed.
          </p>
        </div>
      </div>
    </section>

    <!-- ─── 5. Install ──────────────────────────────────── -->
    <section class="ig" id="install" aria-label="Install">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Step 4 of 5 · 15 seconds</span>
          <h2>Install</h2>
          <p class="lede">One tap. Under ten seconds on a modern phone. No reboot.</p>
        </header>

        <ol class="ig__steps reveal" role="list">
          <li class="ig__step">
            <span class="ig__step-num">4.1</span>
            <div class="ig__step-body">
              <h3 class="ig__step-title">Tap <strong>Install</strong> at the bottom of the package screen.</h3>
              <p class="ig__step-body-copy">
                A progress bar fills the lower edge of the screen. The install runs in under ten seconds on a modern SSD-class storage phone.
              </p>
            </div>
          </li>
          <li class="ig__step">
            <span class="ig__step-num">4.2</span>
            <div class="ig__step-body">
              <h3 class="ig__step-title">Tap <strong>Open</strong> when the bar reaches 100%.</h3>
              <p class="ig__step-body-copy">
                Pulse launches into a one-time setup wizard. The icon also lands on the home screen with the launcher name <em>Pulse</em>.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- ─── 6. Pick a model ─────────────────────────────── -->
    <section class="ig" id="model" aria-label="Pick a model">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Step 5 of 5 · 30 seconds + model download</span>
          <h2>Pick a model</h2>
          <p class="lede">On first launch, Pulse prompts for the local Ollama model. The choice is the largest transfer of the day and the only network call after install.</p>
        </header>

        <div class="ig__prose reveal">
          <p>
            Three model profiles appear in the first-launch wizard:
          </p>
          <ul class="ig__list" role="list">
            <li><strong>High-end phone (4+ GB free RAM).</strong> <code>gemma3:4b</code> · ~3 GB weights · the same default shipped on Windows.</li>
            <li><strong>Mid-range phone (2&ndash;4 GB free RAM).</strong> <code>qwen2.5:3b</code> · ~2 GB weights · faster first-token, lower quality.</li>
            <li><strong>Low-end phone (1&ndash;2 GB free RAM).</strong> <code>qwen2.5:1.5b</code> · ~1 GB weights · usable but slow on long contexts.</li>
          </ul>
          <p>
            The wizard reopens from <strong>Settings → AI → Model setup</strong> at any time. The Windows model picker shares the same Ollama endpoint pattern; see <a href="/install/windows/">the Windows install guide</a> for the desktop workflow.
          </p>
        </div>
      </div>
    </section>

    <!-- ─── 7. Screenshots ──────────────────────────────── -->
    <section class="ig" id="screens" aria-label="Screenshots">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Visual reference</span>
          <h2>What Pulse looks like on Android</h2>
          <p class="lede">Three captures from the v{VERSION} build: the launcher icon at the densities Android ships, the icon mockup on a home-screen background, and the launch splash.</p>
        </header>

        <ul class="ig__shots reveal" role="list">
          <li class="ig__shot">
            <a class="ig__shot-link" href={ICON_MOCKUP} rel="noopener">
              <img class="ig__shot-img" src={ICON_MOCKUP} alt="Pulse app icon shown across three Android launcher sizes on a Tokyo Night background" width="720" height="240" loading="lazy" />
            </a>
            <p class="ig__shot-cap">Pulse on the home screen — three launcher sizes from a single adaptive icon.</p>
          </li>
          <li class="ig__shot">
            <a class="ig__shot-link" href={SPLASH_PORTRAIT} rel="noopener">
              <img class="ig__shot-img" src={SPLASH_PORTRAIT} alt="Pulse launch splash screen in portrait orientation, dark background with the Pulse wordmark" width="540" height="960" loading="lazy" />
            </a>
            <p class="ig__shot-cap">Splash on launch — fades into the home screen after the first model is loaded.</p>
          </li>
          <li class="ig__shot">
            <a class="ig__shot-link" href={ICON_XXXHDPI} rel="noopener">
              <img class="ig__shot-img ig__shot-img--square" src={ICON_XXXHDPI} alt="Pulse app icon at xxxhdpi density, 192 by 192 pixels" width="192" height="192" loading="lazy" />
            </a>
            <p class="ig__shot-cap">Adaptive icon at xxxhdpi (192&times;192) — the highest density Android ships.</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- ─── 8. Security note ────────────────────────────── -->
    <section class="ig" id="security" aria-label="Security note">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Security</span>
          <h2>Verify the signature</h2>
          <p class="lede">The APK is signed with a release key. The fingerprint is on the release page; the device shows the same one after install.</p>
        </header>

        <aside class="ig__callout ig__callout--security reveal" role="note">
          <p>
            The APK is signed with a release key. The SHA-256 signing-key fingerprint is on the GitHub release page. If the device shows a different signature or warns about an unknown publisher, do not install. Uninstall the package and report the SHA mismatch on the GitHub issue tracker.
          </p>
        </aside>
      </div>
    </section>

    <!-- ─── 9. Common issues ────────────────────────────── -->
    <section class="ig" id="issues" aria-label="Common issues">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">Troubleshooting</span>
          <h2>Common issues</h2>
          <p class="lede">Four problems that come up most often during a sideload install, and the fix for each.</p>
        </header>

        <ul class="ig__bullets ig__bullets--issues reveal" role="list">
          <li>
            <strong>Install blocked.</strong>
            Android blocks the install because the browser or file manager is not in the <em>Install unknown apps</em> list. Open <strong>Settings → Apps → Special access → Install unknown apps</strong> and toggle on the app that opened the APK. The path differs by Android version: see Step 2 above.
          </li>
          <li>
            <strong>App not installed.</strong>
            Usually a signature conflict with a previous sideload of Pulse under a different signing key. Uninstall the old package from <strong>Settings → Apps → Pulse → Uninstall</strong> first, then install the new APK. The app data in <code>/data/data/app.pulse.notes/</code> is removed with the package.
          </li>
          <li>
            <strong>Opens then crashes.</strong>
            Usually no model loaded. Pulse prompts for a model on first launch; if the download was cancelled or the connection dropped, the app shows an error screen on next start. Reopen the wizard from <strong>Settings → AI → Model setup</strong> and pick a model again. See <a href="/install/windows/">the Windows install guide</a> for the model picker UX.
          </li>
          <li>
            <strong>Where is the model downloaded?</strong>
            Model weights live in Pulse's private app data at <code>/data/data/app.pulse.notes/files/ollama/</code>. The folder is not visible to other apps and is removed when the package is uninstalled. No system-wide Ollama install is required on Android.
          </li>
        </ul>
      </div>
    </section>

    <!-- ─── 10. Next steps ──────────────────────────────── -->
    <section class="ig ig--next" id="next" aria-label="Next steps">
      <div class="container">
        <header class="ig__head reveal">
          <span class="eyebrow">After install</span>
          <h2>Next</h2>
          <p class="lede">Three follow-up links from the same dark Tokyo Night surface.</p>
        </header>

        <ul class="ig__next reveal" role="list">
          <li>
            <a class="ig__next-link" href="/install/windows/">
              <span class="ig__next-label">Get Pulse for Windows</span>
              <span class="ig__next-meta">Three installers and a model picker, side by side with this one.</span>
            </a>
          </li>
          <li>
            <a class="ig__next-link" href="/faq/">
              <span class="ig__next-label">FAQ</span>
              <span class="ig__next-meta">Common questions on hotkeys, model weights, and the manifest.</span>
            </a>
          </li>
          <li>
            <a class="ig__next-link" href="/pricing/">
              <span class="ig__next-label">Pricing</span>
              <span class="ig__next-meta">14-day trial, then PRO tiers for the advanced AI stack.</span>
            </a>
          </li>
        </ul>

        <p class="ig__back">
          <a class="btn btn--ghost" href="/">Back to home</a>
        </p>

        <p class="ig__updated">
          Last updated <time datetime={LAST_UPDATED}>{LAST_UPDATED}</time> · <a href="/changelog.xml">release feed</a> for the full history.
        </p>
      </div>
    </section>
  </main>

  <!-- JSON-LD: one SoftwareApplication for the APK + one HowTo with five steps.
       Renders in a single <script> block; values are stringified server-side. -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Footer license="" version={`v${VERSION}`} />
</Base>

<style>
  /* ── Install-guide section styles (scoped to this page) ─────── */
  .install__hero { padding-bottom: clamp(48px, 8vw, 96px); }
  .install__intro {
    font-size: 1.05rem;
    color: var(--fg-dim);
    max-width: 64ch;
    margin-top: 0.5rem;
    line-height: 1.6;
  }
  .install__intro code { color: var(--cyan); }

  .ig {
    background: radial-gradient(800px 400px at 80% 0%, rgba(187,154,247,0.05), transparent 65%),
                radial-gradient(700px 400px at 10% 100%, rgba(122,162,247,0.06), transparent 65%);
  }
  .ig__head {
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    max-width: 64ch;
  }
  .ig__head h2 { max-width: 22ch; margin: 0; }
  .ig__head .lede { margin: 0.5rem 0 0; }

  /* ── 1. Checklist (What you'll need) ──────────────────────── */
  .ig__checklist {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.7rem;
    max-width: 760px;
  }
  @media (min-width: 760px) {
    .ig__checklist { grid-template-columns: 1fr 1fr; }
  }
  .ig__checklist li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 0.7rem 0.85rem;
    align-items: start;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg-soft) 100%);
    color: var(--fg-dim);
    font-size: 0.96rem;
    line-height: 1.55;
  }
  .ig__checklist li strong { color: var(--fg); font-weight: 600; display: block; margin-bottom: 0.2rem; }
  .ig__check {
    width: 20px;
    height: 20px;
    margin-top: 0.18rem;
    border-radius: 6px;
    background: rgba(158, 206, 106, 0.12);
    border: 1px solid rgba(158, 206, 106, 0.45);
    position: relative;
  }
  .ig__check::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 1px;
    width: 6px;
    height: 12px;
    border: solid var(--green);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  /* ── 2. Prose blocks (used in 3 / 4 / 6) ──────────────────── */
  .ig__prose {
    color: var(--fg-dim);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 70ch;
    margin: 0 0 1.5rem;
  }
  .ig__prose p { margin: 0 0 1rem; }
  .ig__prose strong { color: var(--fg); font-weight: 600; }
  .ig__prose code {
    background: var(--surface-2);
    padding: 0.05em 0.4em;
    border-radius: 3px;
    border: 1px solid var(--border);
    font-size: 0.9em;
    color: var(--cyan);
  }
  .ig__prose a { color: var(--blue); }
  .ig__prose a:hover { color: var(--purple); }

  .ig__list {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .ig__list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--fg-dim);
    font-size: 0.98rem;
    line-height: 1.55;
  }
  .ig__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 6px;
