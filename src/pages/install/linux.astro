/**
 * R195: /install/linux/ — build Pulse desktop from source on Linux.
 *
 * 6 main sections (H2):
 *   1. Prerequisites          Node, Rust, build tools
 *   2. Install Tauri deps     per-distro table (apt / dnf / pacman)
 *   3. Clone the repo         github.com/TimesNuRoman/pulse (URL is a real path,
 *                              not a brand reference)
 *   4. Install npm deps       npm install
 *   5. Run dev                tauri dev (3-5 min first build)
 *   6. Build production       tauri build → .deb and .AppImage
 * Plus: Troubleshooting, Known limitations, Get help, Next steps.
 *
 * Hard rules: no emoji, anonymous brand, no marketing fluff, no future
 * promises, dark-only, Apache 2.0, 56dp touch targets, focus-visible,
 * skip-link. JSON-LD `HowTo` with 5 HowToSteps + ISO 8601 durations.
 */

import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/notes.css';

const PAGE_TITLE = 'Install Pulse on Linux — build from source';
const PAGE_DESC =
  'Build Pulse for Linux from source. There is no official Linux build ' +
  'today — the community has ported the source to GTK3 / WebKit2GTK. ' +
  'Six steps from Node 20 to a .deb and an .AppImage on your machine.';

const GITHUB_REPO = 'https://github.com/TimesNuRoman/pulse';
const GITHUB_DESKTOP = GITHUB_REPO + '/tree/main/pulse-desktop';
const GITHUB_ISSUES = GITHUB_REPO + '/issues';

// JSON-LD `HowTo` (R195 SEO) — five top-level HowToSteps. Mirrors the
// Steps 1-6 in the page. The four helper sections (troubleshooting,
// limitations, help, next) are NOT HowToSteps — they're context.
const howToJsonLd = {
