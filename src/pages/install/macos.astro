/**
 * R195: /install/macos/ — build Pulse desktop from source on macOS.
 *
 * 6 main sections (H2):
 *   1. Prerequisites          Xcode CLT, Node, Rust, Homebrew, git
 *   2. Tauri dependencies     Cocoa is built-in — no extra system packages
 *   3. Clone the repo         github.com/TimesNuRoman/pulse (URL is a real path,
 *                              not a brand reference)
 *   4. Install npm deps       npm install
 *   5. Run dev                tauri dev (3-5 min first build)
 *   6. Build production       tauri build → .app and .dmg
 * Plus: Apple Silicon vs Intel, Troubleshooting, Known limitations, Get help, Next steps.
 *
 * Hard rules: no emoji, anonymous brand, no marketing fluff, no future
 * promises, dark-only, Apache 2.0, 56dp touch targets, focus-visible,
 * skip-link. JSON-LD `HowTo` with 5 HowToSteps + ISO 8601 durations.
 */

import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/notes.css';

const PAGE_TITLE = 'Install Pulse on macOS — build from source';
const PAGE_DESC =
  'Build Pulse for macOS from source. There is no official macOS build ' +
  'today — the community has ported the source to Apple Silicon and ' +
  'Intel. Six steps from Xcode Command Line Tools to a .dmg on your ' +
  'machine.';

const GITHUB_REPO = 'https://github.com/TimesNuRoman/pulse';
const GITHUB_DESKTOP = GITHUB_REPO + '/tree/main/pulse-desktop';
const GITHUB_ISSUES = GITHUB_REPO + '/issues';
const HOMEBREW_URL = 'https://brew.sh';
const RUSTUP_URL = 'https://rustup.rs';
const APPLE_DEVELOPER_URL = 'https://developer.apple.com/account';

// JSON-LD `HowTo` (R195 SEO) — six HowToSteps mirroring the page body.
const howToJsonLd = {
