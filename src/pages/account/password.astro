---
// R260: /account/password — change password.
// Auth via AccountLayout (client-side check). Form posts to
// /api/account/password (POST) and shows status inline.
import AccountLayout from '../../layouts/AccountLayout.astro';
---

<AccountLayout title="Password — Pulse" active="profile">
  <header class="acct-page__head">
    <span class="eyebrow">Password</span>
    <h1 class="acct-page__title">Change your password</h1>
    <p class="acct-page__sub">
      Your password is also the encryption key for sync. We can't recover it for you.
    </p>
  </header>

  <section class="acct-card" aria-labelledby="password-heading">
    <header class="acct-card__head">
      <h2 id="password-heading" class="acct-card__title">Update password</h2>
    </header>

    <form id="password-form" class="profile-form" novalidate>
      <label class="profile-field">
        <span class="profile-field__label">Current password</span>
        <input
          type="password"
          name="current_password"
          class="profile-field__input"
          required
          autocomplete="current-password"
          data-pw-current
        />
      </label>

      <label class="profile-field">
        <span class="profile-field__label">New password</span>
        <input
          type="password"
          name="new_password"
          class="profile-field__input"
          required
          minlength="8"
          maxlength="128"
          autocomplete="new-password"
          data-pw-new
        />
        <span class="profile-field__hint">At least 8 characters. Mix of letters, numbers, symbols.</span>
      </label>

      <label class="profile-field">
        <span class="profile-field__label">Confirm new password</span>
        <input
          type="password"
          name="confirm"
          class="profile-field__input"
          required
          autocomplete="new-password"
          data-pw-confirm
        />
      </label>

      <div class="profile-form__actions">
        <button type="submit" class="btn btn--primary" data-pw-save>Update password</button>
        <a href="/account/" class="btn btn--ghost">Forgot password?</a>
        <span class="profile-form__status" data-pw-status role="status" aria-live="polite"></span>
      </div>
    </form>
  </section>
</AccountLayout>

<style>
  .acct-page__head { margin-bottom: 32px; }
  .acct-page__title { font-size: 1.8rem; font-weight: 700; color: var(--fg); margin: 0.5rem 0 0.5rem; letter-spacing: -0.015em; }
  .acct-page__sub { color: var(--fg-dim); font-size: 0.95rem; margin: 0; }

  .acct-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 24px;
    margin-bottom: 24px;
  }
  .acct-card__head { margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--border); }
  .acct-card__title { font-size: 1.1rem; font-weight: 600; color: var(--fg); margin: 0; }

  .profile-form { display: flex; flex-direction: column; gap: 16px; }
  .profile-field { display: flex; flex-direction: column; gap: 6px; }
  .profile-field__label {
    font-size: 0.78rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
  }
  .profile-field__input {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    color: var(--fg);
    padding: 12px 14px;
    font-size: 0.95rem;
    min-height: 48px;
    font: inherit;
  }
  .profile-field__input:focus {
    outline: 2px solid var(--purple);
    outline-offset: 1px;
    border-color: var(--purple);
  }
  .profile-field__input.is-invalid { border-color: var(--red); }
  .profile-field__hint { color: var(--muted); font-size: 0.8rem; }

  .profile-form__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
    flex-wrap: wrap;
  }
  .profile-form__status {
    font-size: 0.88rem;
    color: var(--green);
    min-height: 1em;
  }
  .profile-form__status[data-state="error"] { color: var(--red); }
  .profile-form__status[data-state="info"] { color: var(--fg-dim); }
</style>

<script is:inline>
  (() => {
    const form = document.getElementById('password-form');
    if (!form) return;
    const currentInput = form.querySelector('[data-pw-current]');
    const newInput = form.querySelector('[data-pw-new]');
    const confirmInput = form.querySelector('[data-pw-confirm]');
    const saveBtn = form.querySelector('[data-pw-save]');
    const statusEl = form.querySelector('[data-pw-status]');
    if (!currentInput || !newInput || !confirmInput || !saveBtn || !statusEl) return;

    const setStatus = (msg, state) => {
      statusEl.textContent = msg;
      if (state) statusEl.setAttribute('data-state', state);
      else statusEl.removeAttribute('data-state');
    };

    const invalidate = (el) => {
      el.classList.add('is-invalid');
      el.focus();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setStatus('Saving…', 'info');
      saveBtn.disabled = true;

      const current = currentInput.value;
      const next = newInput.value;
      const confirm = confirmInput.value;

      [currentInput, newInput, confirmInput].forEach((el) => el.classList.remove('is-invalid'));

      if (next.length < 8) {
        setStatus('New password must be at least 8 characters.', 'error');
        saveBtn.disabled = false;
        invalidate(newInput);
        return;
      }
      if (next !== confirm) {
        setStatus('New passwords do not match.', 'error');
        saveBtn.disabled = false;
        invalidate(confirmInput);
        return;
      }
      if (next === current) {
        setStatus('New password must differ from current.', 'error');
        saveBtn.disabled = false;
        invalidate(newInput);
        return;
      }

      try {
        const res = await fetch('/api/account/password', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ current_password: current, new_password: next }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.status === 401 && data.error === 'wrong_password') {
          setStatus('Current password is incorrect.', 'error');
          invalidate(currentInput);
          return;
        }
        if (!res.ok) {
          setStatus('Could not update password. Try again.', 'error');
          return;
        }
        setStatus('Password updated. Other devices have been signed out.', null);
        form.reset();
        setTimeout(() => setStatus('', null), 5000);
      } catch (err) {
        setStatus('Network error. Try again.', 'error');
      } finally {
        saveBtn.disabled = false;
      }
    });

    [currentInput, newInput, confirmInput].forEach((el) => {
      el.addEventListener('input', () => el.classList.remove('is-invalid'));
    });
  })();
</script>
