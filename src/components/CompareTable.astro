---
// SPDX-License-Identifier: Apache-2.0
/**
 * R94b: CompareTable.astro
 * R124: widened to 9 products (Pulse Free, Pulse PRO, Raycast AI,
 *       Notion AI, GitHub Copilot, Claude Pro, AnythingLLM,
 *       LM Studio, Ollama) and 14 rows.
 *
 * Reusable comparison table + mobile card-stack.
 * Renders N columns (caller-controlled) and N rows.
 * Mobile (<768px): collapses to one card per product, dl/dt/dd list.
 *
 * Mark values:
 *   - 'yes'    -> purple check icon
 *   - 'no'     -> muted dash icon
 *   - 'partial'-> yellow dot
 *   - any other string -> rendered as plain text
 */
export interface Props {
  products: Array<{
    key: string;
    name: string;
    tagline: string;
    highlight?: boolean;
  }>;
  rows: Array<{
    label: string;
    values: Record<string, string>;
  }>;
}

const { products, rows } = Astro.props;

const getVal = (row: (typeof rows)[number], k: string): string => row.values[k] ?? '—';

const labelFor = (v: string): string =>
  v === 'yes' ? 'Yes' : v === 'no' ? 'No' : v === 'partial' ? 'Partial' : v;

const isMark = (v: string): boolean => v === 'yes' || v === 'no' || v === 'partial';
---
<div class="compare__table-wrap reveal" role="region" aria-label="Comparison table">
  <table class="compare__table">
    <caption class="visually-hidden">Pulse (trial and PRO) compared to Raycast AI, Notion AI, GitHub Copilot, Claude Pro, AnythingLLM, LM Studio, and Ollama</caption>
    <thead>
      <tr>
        <th scope="col">Feature</th>
        {products.map((p) => (
          <th scope="col" class={p.highlight ? 'col-pulse' : ''}>
            {p.name}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">{r.label}</th>
          {products.map((p) => {
            const v = getVal(r, p.key);
            return (
              <td class={p.highlight ? `col-pulse ${isMark(v) ? `mark mark--${v}` : ''}` : isMark(v) ? `mark mark--${v}` : ''}>
                {isMark(v) ? (
                  <span class="cell-mark" data-val={v} aria-hidden="true">
                    <span class="visually-hidden">{labelFor(v)}</span>
                  </span>
                ) : (
                  v
                )}
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<div class="compare__cards">
  {products.map((p) => (
    <article class={`compare__card reveal ${p.highlight ? 'is-highlight' : ''}`}>
      <header class="compare__card-head">
        <h3 class="compare__card-name">{p.name}</h3>
        <p class="compare__card-tagline">{p.tagline}</p>
      </header>
      <dl class="compare__card-list">
        {rows.map((r) => {
          const v = getVal(r, p.key);
          const mark = isMark(v);
          return (
            <>
              <dt>{r.label}</dt>
              <dd class={`${mark ? `mark mark--${v}` : ''}`}>
                {mark ? <span class="visually-hidden">{labelFor(v)} - </span> : null}
                {labelFor(v)}
              </dd>
            </>
          );
        })}
      </dl>
    </article>
  ))}
</div>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Mobile card-stack: hidden on desktop, shown on mobile */
  .compare__cards { display: none; }
  @media (max-width: 767px) {
    .compare__cards { display: flex; flex-direction: column; gap: 1rem; }
    .compare__table-wrap { display: none; }
  }

  .compare__card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }
  .compare__card.is-highlight {
    border-color: var(--purple);
    box-shadow: 0 0 0 1px rgba(187, 154, 247, 0.25), 0 0 32px rgba(187, 154, 247, 0.15);
  }
  .compare__card-head { margin-bottom: 1rem; }
  .compare__card-name { font-size: 1.15rem; font-weight: 500; margin-bottom: 0.2rem; }
  .compare__card.is-highlight .compare__card-name { color: var(--purple); }
  .compare__card-tagline { font-size: 0.85rem; color: var(--muted); }
  .compare__card-list {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.55rem 1rem;
    margin: 0;
  }
  .compare__card-list dt {
    color: var(--fg-dim);
    font-size: 0.88rem;
  }
  .compare__card-list dd {
    color: var(--fg);
    font-size: 0.88rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .compare__card-list dd.mark--yes     { color: var(--purple); font-weight: 600; }
  .compare__card-list dd.mark--no      { color: var(--comment); }
  .compare__card-list dd.mark--partial { color: var(--yellow); }

  /* Desktop / tablet (>=768px) — table */
  .compare__table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .compare__table {
    width: 100%;
    border-collapse: collapse;
    min-width: 1080px;
    font-size: 0.92rem;
  }
  .compare__table th,
  .compare__table td {
    text-align: left;
    padding: 0.8rem 0.9rem;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }
  .compare__table thead th {
    background: var(--bg-soft);
    font-weight: 600;
    color: var(--fg);
    font-size: 0.82rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    position: sticky;
    top: 0;
    z-index: 1;
  }
  .compare__table tbody th { font-weight: 500; color: var(--fg-dim); }
  .compare__table tbody tr:last-child th,
  .compare__table tbody tr:last-child td { border-bottom: 0; }
  .col-pulse { color: var(--purple); }
  .compare__table td.col-pulse { background: rgba(187, 154, 247, 0.06); }

  /* Cell marks — inline SVG icon (no emoji, R85 fix) */
  .cell-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
  }
  .cell-mark[data-val="yes"] {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23bb9af7' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'/></svg>");
  }
  .cell-mark[data-val="no"] {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23565f89' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><line x1='6' y1='6' x2='18' y2='18'/><line x1='18' y1='6' x2='6' y2='18'/></svg>");
  }
  .cell-mark[data-val="partial"] {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'><circle cx='12' cy='12' r='5' fill='%23e0af68'/></svg>");
  }
  .mark--yes     { color: var(--purple); }
  .mark--no      { color: var(--comment); }
  .mark--partial { color: var(--yellow); }

  /* Responsive: tighten column padding at 1024 breakpoint (the table is wide) */
  @media (max-width: 1023px) {
    .compare__table th, .compare__table td { padding: 0.7rem 0.6rem; font-size: 0.85rem; }
  }
  @media (max-width: 899px) {
    .compare__table { min-width: 960px; }
  }
</style>
