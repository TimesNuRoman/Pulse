---
// R120: minimal footer for the user-facing site.
// Only Download + Pricing + license/privacy/conduct + GitHub link.
// No /changelog/, /compare/, /notes/, /release-notes/, /install/ links here —
// those are power-user pages reachable directly, not from the marketing nav.
// `version = ''` hides the version pill entirely (used on /privacy + /code-of-conduct + /license).
// R234: default `version` is sourced from `src/lib/versions.ts` (the SSOT).
// Pages can still pass `version=""` to hide the pill, or pass a literal
// `version="v0.6.4"` to pin a historical release-notes page footer.
import { DESKTOP_VERSION } from '../lib/versions';

export interface Props {
  license?: string;
  version?: string;
}
const { license = '', version = `v${DESKTOP_VERSION}` } = Astro.props;
const showVersion = version.trim().length > 0;

const columns = [
  {
    title: 'Apps',
    // R255: compact "Apps" column replaces the old separate
    // "Download" + "Android" rows. All three links point to
    // /download/{windows,android,}/ subpages created in R250,
    // so no more 404s on /install/* (the old URL before R250).
    links: [
      { label: 'Download hub', href: '/download/' },
      { label: 'Windows', href: '/download/windows/' },
      { label: 'Android', href: '/download/android/' },
      { label: 'macOS / Linux / iOS', href: '/download/' },
    ],
  },
  {
    title: 'Product',
    links: [
      { label: 'Pricing', href: '/pricing/' },
      { label: 'Login', href: '/login/' },
      // R183: blog landing — first post lives at /blog/five-ollama-errors/.
      // `tall: true` enforces 56dp min-height on this single link
      // (HR11 a11y); the other 12 footer text links will get the
      // same treatment when R180 lands.
      { label: 'Blog', href: '/blog/', tall: true },
    ],
  },
  {
    title: 'Source',
    links: [
      { label: 'Latest builds', href: 'https://ownlocalml.com/downloads/' },
      { label: 'Changelog', href: '/changelog/' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: `${license} License`, href: '/license/' },
      { label: 'Privacy', href: '/privacy/' },
      { label: 'Trademark', href: '/trademark/' },
      { label: 'Security', href: '/security/' },
      { label: 'Code of Conduct', href: '/code-of-conduct/' },
    ],
  },
];
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <div class="footer__logo">
          <svg viewBox="0 0 64 64" width="32" height="32" aria-hidden="true">
            <circle cx="32" cy="32" r="30" fill="none" stroke="#bb9af7" stroke-width="2" />
            <path d="M8 32 Q16 18, 24 32 T40 32 T56 32" stroke="#bb9af7" stroke-width="3" stroke-linecap="round" fill="none" />
            <circle cx="48" cy="32" r="3" fill="#7aa2f7" />
          </svg>
          <span>Pulse</span>
        </div>
        <p class="footer__tagline">Local-first AI side panel for Windows and Android. 14-day trial, then $20/mo or $192/yr.</p>
      </div>

      {columns.map((col) => (
        <div class="footer__col">
          <h3 class="footer__col-title">{col.title}</h3>
          <ul role="list">
            {col.links.map((l) => (
              <li><a class={l.tall ? 'footer__col-link footer__col-link--tall' : ''} href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="footer__bottom">
      <span>Built in Brest</span>
      {license.trim().length > 0 && (
        <>
          <span>·</span>
          <span><a href="/license/">{license} licensed</a></span>
        </>
      )}
      {showVersion && (
        <>
          <span>·</span>
          <span>{version}</span>
        </>
      )}
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: var(--sp-3) var(--sp-2);
    background: var(--bg-soft);
  }
  @media (min-width: 700px) {
    .footer { padding-block: var(--sp-5) var(--sp-3); }
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 1rem;
  }
  /* R255: 4 columns on desktop (Apps + Product + Source + Legal)
     plus the brand block on the left = 5 tracks total. Tighter
     column gap than before so all four link columns fit at
     1024-1280 without overflow. */
  @media (min-width: 900px) {
    .footer__grid { grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr; gap: var(--sp-4) var(--sp-3); }
  }
  .footer__brand { display: flex; flex-direction: column; gap: 0.4rem; grid-column: 1 / -1; }
  @media (min-width: 700px) { .footer__brand { grid-column: auto; gap: 0.6rem; } }
  .footer__logo { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; }
  .footer__tagline { color: var(--fg-dim); font-size: 0.78rem; max-width: 56ch; }
  @media (min-width: 700px) { .footer__tagline { font-size: 0.92rem; } }

  .footer__col-title {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-bottom: 0.35rem;
  }
  @media (min-width: 700px) {
    .footer__col-title { font-size: 0.78rem; margin-bottom: 0.7rem; }
  }
  .footer__col ul { list-style: none; display: flex; flex-direction: column; gap: 0; }
  @media (min-width: 700px) { .footer__col ul { gap: 0.4rem; } }
  .footer__col a {
    color: var(--fg-dim);
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    min-height: 38px;
  }
  @media (min-width: 700px) {
    .footer__col a { font-size: 0.95rem; min-height: 56px; }
  }
  .footer__col a:hover { color: var(--purple); }

  /* R183: 56dp min-height on the new Blog link (HR11 a11y).
     Scoped to a single class so the other 12 footer text links
     keep their existing 1-line height until R180 lands a global
     56dp rule. */
  .footer__col-link--tall {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
  }
  @media (min-width: 700px) {
    .footer__col-link--tall { min-height: 56px; }
  }

  .footer__bottom {
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    color: var(--muted);
    font-size: 0.85rem;
    grid-column: 1 / -1;
  }
  @media (min-width: 700px) {
    .footer__bottom { margin-top: 2.5rem; padding-top: 1.5rem; }
  }
  .footer__bottom a {
    color: var(--fg-dim);
    text-decoration: none;
    border-bottom: 1px dotted var(--border);
  }
  .footer__bottom a:hover {
    color: var(--purple);
    border-bottom-color: var(--purple);
  }
</style>
