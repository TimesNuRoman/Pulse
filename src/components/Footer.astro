---
// R85: per-page footer license + version (B2 fix-blocker).
// R94a: default license is now 'Apache 2.0' (was 'MIT' — pre-R93 relic).
// `version = ''` hides the version pill entirely (used on /privacy + /code-of-conduct + /license).
export interface Props {
  license?: string;
  version?: string;
}
const { license = 'Apache 2.0', version = 'v0.3.0' } = Astro.props;
const showVersion = version.trim().length > 0;

// R104: unified footer. /notes/ is gone (→ /download/#android via meta
// refresh); /download/ is the canonical download surface; /pricing/ is
// new ("Free, forever").
const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Download', href: '/download/' },
      { label: 'Pricing', href: '/pricing/' },
      { label: 'Compare', href: '/compare/' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Changelog', href: '/changelog/' },
      { label: 'Releases', href: 'https://github.com/TimesNuRoman/pulse/releases' },
      { label: 'GitHub', href: 'https://github.com/TimesNuRoman/pulse' },
      { label: 'Discord', href: 'https://discord.gg/join-pulse' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: `${license} License`, href: '/license/' },
      { label: 'Privacy', href: '/privacy' },
      { label: 'Code of Conduct', href: '/code-of-conduct' },
    ],
  },
];
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <div class="footer__logo">
          <svg viewBox="0 0 64 64" width="32" height="32" aria-hidden="true">
            <circle cx="32" cy="32" r="30" fill="none" stroke="#bb9af7" stroke-width="2" />
            <path d="M8 32 Q16 18, 24 32 T40 32 T56 32" stroke="#bb9af7" stroke-width="3" stroke-linecap="round" fill="none" />
            <circle cx="48" cy="32" r="3" fill="#7aa2f7" />
          </svg>
          <span>Pulse</span>
        </div>
        <p class="footer__tagline">AI that doesn't get to leave the room.</p>

        <ul class="footer__socials" role="list" aria-label="Social links">
          <li>
            <a href="https://github.com/TimesNuRoman/pulse" rel="noopener noreferrer" target="_blank" aria-label="GitHub">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.57.1.78-.25.78-.55v-1.93c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.27-1.68-1.27-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.34.95.1-.74.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.77 1.06.77 2.13v3.16c0 .31.21.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>
              </svg>
            </a>
          </li>
          <li>
            <a href="https://discord.gg/join-pulse" rel="noopener noreferrer" target="_blank" aria-label="Discord">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.32 4.37A19.8 19.8 0 0 0 16.39 3.2a.07.07 0 0 0-.08.04 13.7 13.7 0 0 0-.62 1.27 18.3 18.3 0 0 0-5.38 0 12.6 12.6 0 0 0-.63-1.27.08.08 0 0 0-.08-.04A19.7 19.7 0 0 0 5.67 4.37a.07.07 0 0 0-.03.03A20.4 20.4 0 0 0 2.16 16.1a.08.08 0 0 0 .03.06 19.9 19.9 0 0 0 5.99 3.03.08.08 0 0 0 .08-.03 14.2 14.2 0 0 0 1.23-2 .08.08 0 0 0-.04-.1 13.1 13.1 0 0 1-1.87-.89.08.08 0 0 1 0-.13c.13-.1.25-.2.37-.3a.08.08 0 0 1 .08-.01 14.2 14.2 0 0 0 12.06 0 .08.08 0 0 1 .08.01c.12.1.24.2.37.3a.08.08 0 0 1 0 .13 12.3 12.3 0 0 1-1.87.89.08.08 0 0 0-.04.1 16 16 0 0 0 1.23 2 .08.08 0 0 0 .08.03 19.8 19.8 0 0 0 6-3.03.08.08 0 0 0 .03-.06 20.2 20.2 0 0 0-3.47-11.7.06.06 0 0 0-.03-.03ZM8.68 13.99c-1.18 0-2.15-1.08-2.15-2.4 0-1.33.96-2.41 2.15-2.41 1.2 0 2.17 1.09 2.15 2.4 0 1.33-.96 2.41-2.15 2.41Zm6.65 0c-1.18 0-2.15-1.08-2.15-2.4 0-1.33.96-2.41 2.15-2.41 1.2 0 2.17 1.09 2.15 2.4 0 1.33-.95 2.41-2.15 2.41Z"/>
              </svg>
            </a>
          </li>
          <li>
            <a href="https://x.com/join-pulse" rel="noopener noreferrer" target="_blank" aria-label="X (Twitter)">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2H21.5l-7.5 8.57L23 22h-6.84l-5.36-7.01L4.66 22H1.4l8.02-9.17L1 2h7l4.85 6.4L18.244 2Zm-2.4 18h1.91L7.27 4H5.24l10.6 16Z"/>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      {columns.map((col) => (
        <div class="footer__col">
          <h3 class="footer__col-title">{col.title}</h3>
          <ul role="list">
            {col.links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="footer__bottom">
      <span>Built by Roman in Brest</span>
      <span>·</span>
      {showVersion ? (
        <span><a href="/license/">{license} licensed</a> · {version}</span>
      ) : (
        <span><a href="/license/">{license} licensed</a></span>
      )}
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: 3rem 2rem;
    background: var(--bg-soft);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 700px) {
    .footer__grid { grid-template-columns: 2fr 1fr 1fr 1fr; }
  }
  .footer__brand { display: flex; flex-direction: column; gap: 0.6rem; }
  .footer__logo { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; }
  .footer__tagline { color: var(--fg-dim); font-size: 0.92rem; }

  .footer__socials {
    list-style: none; display: flex; gap: 0.6rem; margin-top: 0.5rem;
  }
  .footer__socials a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px;  /* P0-5: Apple HIG / WCAG */
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--fg-dim);
    transition: all var(--dur) var(--ease);
  }
  .footer__socials a:hover {
    color: var(--purple);
    border-color: var(--purple);
    transform: translateY(-1px);
  }

  .footer__col-title {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-bottom: 0.7rem;
  }
  .footer__col ul { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
  .footer__col a { color: var(--fg-dim); font-size: 0.95rem; }
  .footer__col a:hover { color: var(--purple); }

  .footer__bottom {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .footer__bottom a {
    color: var(--fg-dim);
    text-decoration: none;
    border-bottom: 1px dotted var(--border);
  }
  .footer__bottom a:hover {
    color: var(--purple);
    border-bottom-color: var(--purple);
  }
</style>
