---
// R120: minimal footer for the user-facing site.
// Only Download + Pricing + license/privacy/conduct + GitHub link.
// No /changelog/, /compare/, /notes/, /release-notes/, /install/ links here —
// those are power-user pages reachable directly, not from the marketing nav.
// `version = ''` hides the version pill entirely (used on /privacy + /code-of-conduct + /license).
export interface Props {
  license?: string;
  version?: string;
}
const { license = '', version = 'v0.3.0' } = Astro.props;
const showVersion = version.trim().length > 0;

const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Download', href: '/download/' },
      { label: 'Pricing', href: '/pricing/' },
      // R183: blog landing — first post lives at /blog/five-ollama-errors/.
      // `tall: true` enforces 56dp min-height on this single link
      // (HR11 a11y); the other 12 footer text links will get the
      // same treatment when R180 lands.
      { label: 'Blog', href: '/blog/', tall: true },
    ],
  },
  {
    title: 'Source',
    links: [
      { label: 'GitHub', href: 'https://github.com/TimesNuRoman/pulse' },
      { label: 'Releases', href: 'https://github.com/TimesNuRoman/pulse/releases' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: `${license} License`, href: '/license/' },
      { label: 'Privacy', href: '/privacy' },
      { label: 'Trademark', href: '/trademark/' },
      { label: 'Code of Conduct', href: '/code-of-conduct' },
    ],
  },
];
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <div class="footer__logo">
          <svg viewBox="0 0 64 64" width="32" height="32" aria-hidden="true">
            <circle cx="32" cy="32" r="30" fill="none" stroke="#bb9af7" stroke-width="2" />
            <path d="M8 32 Q16 18, 24 32 T40 32 T56 32" stroke="#bb9af7" stroke-width="3" stroke-linecap="round" fill="none" />
            <circle cx="48" cy="32" r="3" fill="#7aa2f7" />
          </svg>
          <span>Pulse</span>
        </div>
        <p class="footer__tagline">Local-first AI side panel for Windows and Android. 14-day trial, then $20/mo or $192/yr.</p>

        <ul class="footer__socials" role="list" aria-label="Social links">
          <li>
            <a href="https://github.com/TimesNuRoman/pulse" rel="noopener noreferrer" target="_blank" aria-label="GitHub">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.57.1.78-.25.78-.55v-1.93c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.27-1.68-1.27-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.34.95.1-.74.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.77 1.06.77 2.13v3.16c0 .31.21.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      {columns.map((col) => (
        <div class="footer__col">
          <h3 class="footer__col-title">{col.title}</h3>
          <ul role="list">
            {col.links.map((l) => (
              <li><a class={l.tall ? 'footer__col-link footer__col-link--tall' : ''} href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="footer__bottom">
      <span>Built in Brest</span>
      <span>·</span>
      {showVersion ? (
        <span><a href="/license/">{license} licensed</a> · {version}</span>
      ) : (
        <span><a href="/license/">{license} licensed</a></span>
      )}
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: 3rem 2rem;
    background: var(--bg-soft);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 700px) {
    .footer__grid { grid-template-columns: 2fr 1fr 1fr 1fr; }
  }
  .footer__brand { display: flex; flex-direction: column; gap: 0.6rem; }
  .footer__logo { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; }
  .footer__tagline { color: var(--fg-dim); font-size: 0.92rem; }

  .footer__socials {
    list-style: none; display: flex; gap: 0.6rem; margin-top: 0.5rem;
  }
  .footer__socials a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px;  /* P0-5: Apple HIG / WCAG */
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--fg-dim);
    transition: all var(--dur) var(--ease);
  }
  .footer__socials a:hover {
    color: var(--purple);
    border-color: var(--purple);
    transform: translateY(-1px);
  }

  .footer__col-title {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-bottom: 0.7rem;
  }
  .footer__col ul { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
  .footer__col a {
    color: var(--fg-dim);
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    min-height: 56px;  /* R189: 56dp touch target per brief rule #11 */
  }
  .footer__col a:hover { color: var(--purple); }

  /* R183: 56dp min-height on the new Blog link (HR11 a11y).
     Scoped to a single class so the other 12 footer text links
     keep their existing 1-line height until R180 lands a global
     56dp rule. */
  .footer__col-link--tall {
    display: inline-flex;
    align-items: center;
    min-height: 56px;
  }

  .footer__bottom {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .footer__bottom a {
    color: var(--fg-dim);
    text-decoration: none;
    border-bottom: 1px dotted var(--border);
  }
  .footer__bottom a:hover {
    color: var(--purple);
    border-bottom-color: var(--purple);
  }
</style>
