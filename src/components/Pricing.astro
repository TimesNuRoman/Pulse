---
// R284: deprecated component — superseded by /pricing/ page (src/pages/pricing.astro).
// Kept for any legacy /legacy/ URLs that may still reference it. P0 fix: dead
// checkout URLs replaced with /pricing/#pro in-page anchor. Pulse uses crypto via
// NOWPayments (gtm/90). DO NOT add new Polar/Stripe/Paddle URLs.
const tiers = [
  {
    name: 'Trial',
    tag: '14 days',
    price: '$0',
    sub: 'for 14 days, then $20/mo',
    cta: 'Start 14-day trial',
    href: '/download/',
    primary: false,
    features: [
      'Single-model local chat',
      'Local notes with backlinks and tags',
      'Code-aware chat (tree-sitter)',
      'Web search — 50 queries / day',
      'Pulse for Windows + Android',
      'No credit card required',
    ],
  },
  {
    name: 'PRO Monthly',
    tag: 'Pay monthly',
    price: '$20',
    sub: 'per month',
    cta: 'Start Monthly',
    href: '/pricing/#pro',
    primary: false,
    features: [
      'Everything in Trial',
      'Switch between multiple AI models',
      'Voice input (cloud Whisper)',
      'Web search — unlimited',
      'Cross-device sync',
      'Priority updates',
      'Email support, 48h response',
    ],
  },
  {
    name: 'PRO Annual',
    tag: 'Best value',
    price: '$192',
    sub: 'per year · save $48/yr',
    cta: 'Start Annual',
    href: '/pricing/#pro',
    primary: true,
    badge: 'Most popular',
    features: [
      'Everything in PRO Monthly',
      'Two months free vs monthly',
      'Same features, same license key',
      'One email receipt per year',
      'Cancel any time, no penalty',
    ],
  },
];
---
<section class="pricing" id="pricing">
  <div class="container">
    <header class="pricing__head reveal">
      <span class="eyebrow">Pricing</span>
      <h2>14-day trial. Then $20 a month, or $192 a year.</h2>
      <p class="lede">Try Pulse for 14 days with the trial — no credit card. Upgrade only if you need multi-model hot-swap, voice input, or sync.</p>
    </header>

    <ul class="pricing__grid" role="list">
      {tiers.map((t) => (
        <li class={`tier card reveal ${t.primary ? 'tier--primary' : ''}`}>
          {t.badge && <span class="tier__badge">{t.badge}</span>}
          <div class="tier__head">
            <span class="tier__name">{t.name}</span>
            <span class="tier__tag">{t.tag}</span>
          </div>
          <div class="tier__price">
            <span class="tier__amount">{t.price}</span>
            <span class="tier__sub">{t.sub}</span>
          </div>
          <a class={`btn ${t.primary ? 'btn--primary' : 'btn--ghost'} tier__cta`} href={t.href}>
            {t.cta} →
          </a>
          <ul class="tier__list" role="list">
            {t.features.map((f) => (
              <li>
                <span class="tier__check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                {f}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pricing__head { text-align: center; margin-bottom: 3rem; }
  .pricing__head .lede { margin: 0.5rem auto 0; }

  .pricing__grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 800px) { .pricing__grid { grid-template-columns: repeat(3, 1fr); } }

  .tier { padding: 1.75rem; display: flex; flex-direction: column; gap: 1rem; position: relative; }
  .tier--primary {
    border-color: var(--purple);
    box-shadow: 0 0 0 1px rgba(187,154,247,0.25), var(--shadow-md);
  }
  .tier__badge {
    position: absolute;
    top: -10px;
    right: 1.25rem;
    background: var(--purple);
    color: #1a1b26;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
  }

  .tier__head { display: flex; justify-content: space-between; align-items: baseline; }
  .tier__name { font-size: 1.1rem; font-weight: 700; }
  .tier__tag  { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--purple); }

  .tier__price { display: flex; align-items: baseline; gap: 0.5rem; }
  .tier__amount { font-size: 2.4rem; font-weight: 800; line-height: 1; }
  .tier__sub    { color: var(--muted); font-size: 0.9rem; }

  .tier__cta { align-self: flex-start; }
  @media (max-width: 767px) {
    .tier__cta { align-self: stretch; width: 100%; min-height: 52px; }
  }
  .tier__list { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.5rem; }
  .tier__list li { display: flex; align-items: center; gap: 0.6rem; color: var(--fg-dim); font-size: 0.95rem; }
  .tier__check { color: var(--green); flex-shrink: 0; display: inline-flex; }
</style>
