---
const pills = ['Rust backend', 'Svelte 5 UI', 'Ollama local', 'gemma3:4b vision'];

const codeSample = `// Tauri command — capture the active window & screenshot
#[tauri::command]
async fn snapshot_active_window(app: AppHandle) -> Result<WindowSnapshot, String> {
    let win = app.get_webview_window("main").ok_or("no main window")?;
    let title = win.title().unwrap_or_default();
    let pid   = win.process_id().unwrap_or_default();
    let img   = win.capture_image().map_err(|e| e.to_string())?;
    Ok(WindowSnapshot { title, pid, png: img.to_png_bytes() })
}`;
---
<section class="arch" id="arch">
  <div class="container">
    <header class="arch__head reveal">
      <span class="eyebrow">Under the hood</span>
      <h2>Tiny by design.</h2>
      <p class="lede">A Rust shell, a Svelte UI, and a local model. Nothing in the cloud, nothing to subscribe to.</p>
    </header>

    <div class="arch__grid">
      <div class="arch__diagram reveal">
        {/* P1-7: hand-crafted SVG replaces Mermaid CDN.
            Same Tokyo Night palette, same flow, zero JS, zero dependencies. */}
        <svg class="arch__svg" viewBox="0 0 520 320" role="img" aria-label="Pulse architecture: hotkey triggers Svelte UI which invokes Rust commands for window snapshot, voice capture, and Ollama; results flow back to the UI.">
          <defs>
            <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
              <path d="M 0 0 L 10 5 L 0 10 z" fill="#7aa2f7"/>
            </marker>
            <marker id="arrow-pulse" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
              <path d="M 0 0 L 10 5 L 0 10 z" fill="#bb9af7"/>
            </marker>
            <linearGradient id="node-bg" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#2a2f45"/>
              <stop offset="100%" stop-color="#24283b"/>
            </linearGradient>
          </defs>

          {/* Hotkey (start) */}
          <g class="arch-node arch-node--start">
            <rect x="20" y="120" width="120" height="60" rx="10" fill="url(#node-bg)" stroke="#bb9af7" stroke-width="1.5"/>
            <text x="80" y="146" text-anchor="middle" fill="#bb9af7" font-size="12" font-weight="600" font-family="ui-sans-serif, system-ui">Hotkey</text>
            <text x="80" y="165" text-anchor="middle" fill="#c0caf5" font-size="11" font-family="ui-monospace, monospace">Ctrl+Shift+Space</text>
          </g>

          {/* Svelte 5 UI */}
          <g class="arch-node">
            <rect x="200" y="120" width="120" height="60" rx="10" fill="url(#node-bg)" stroke="#bb9af7" stroke-width="1.5"/>
            <text x="260" y="146" text-anchor="middle" fill="#bb9af7" font-size="12" font-weight="600" font-family="ui-sans-serif, system-ui">Svelte 5 UI</text>
            <text x="260" y="165" text-anchor="middle" fill="#c0caf5" font-size="11" font-family="ui-sans-serif, system-ui">side panel</text>
          </g>

          {/* Rust commands (center hub) */}
          <g class="arch-node arch-node--hub">
            <rect x="380" y="120" width="120" height="60" rx="10" fill="url(#node-bg)" stroke="#7aa2f7" stroke-width="1.5"/>
            <text x="440" y="146" text-anchor="middle" fill="#7aa2f7" font-size="12" font-weight="600" font-family="ui-sans-serif, system-ui">Rust commands</text>
            <text x="440" y="165" text-anchor="middle" fill="#c0caf5" font-size="11" font-family="ui-sans-serif, system-ui">Tauri v2</text>
          </g>

          {/* Top branch — Window snapshot */}
          <g class="arch-node">
            <rect x="380" y="20" width="120" height="60" rx="10" fill="url(#node-bg)" stroke="#2f334d" stroke-width="1"/>
            <text x="440" y="46" text-anchor="middle" fill="#c0caf5" font-size="12" font-weight="500" font-family="ui-sans-serif, system-ui">Window snapshot</text>
            <text x="440" y="65" text-anchor="middle" fill="#8aa1c7" font-size="10" font-family="ui-sans-serif, system-ui">+ active app</text>
          </g>

          {/* Middle branch — Voice capture */}
          <g class="arch-node">
            <rect x="380" y="120" width="120" height="60" rx="10" fill="url(#node-bg)" stroke="#2f334d" stroke-width="1"/>
            <text x="440" y="146" text-anchor="middle" fill="#c0caf5" font-size="12" font-weight="500" font-family="ui-sans-serif, system-ui">Voice capture</text>
            <text x="440" y="165" text-anchor="middle" fill="#8aa1c7" font-size="10" font-family="ui-sans-serif, system-ui">Web Speech API</text>
          </g>

          {/* Bottom branch — Ollama */}
          <g class="arch-node arch-node--model">
            <rect x="380" y="240" width="120" height="60" rx="10" fill="url(#node-bg)" stroke="#9ece6a" stroke-width="1.5"/>
            <text x="440" y="266" text-anchor="middle" fill="#9ece6a" font-size="12" font-weight="600" font-family="ui-sans-serif, system-ui">Ollama</text>
            <text x="440" y="285" text-anchor="middle" fill="#c0caf5" font-size="11" font-family="ui-monospace, monospace">gemma3:4b</text>
          </g>

          {/* Edges */}
          <line x1="140" y1="150" x2="200" y2="150" stroke="#7aa2f7" stroke-width="1.5" marker-end="url(#arrow)"/>
          <line x1="320" y1="150" x2="380" y2="150" stroke="#7aa2f7" stroke-width="1.5" marker-end="url(#arrow)"/>
          <line x1="440" y1="120" x2="440" y2="80"  stroke="#7aa2f7" stroke-width="1.5" marker-end="url(#arrow)"/>
          <line x1="440" y1="180" x2="440" y2="240" stroke="#7aa2f7" stroke-width="1.5" marker-end="url(#arrow)"/>
          <line x1="380" y1="270" x2="320" y2="165" stroke="#bb9af7" stroke-width="1.5" stroke-dasharray="4 3" marker-end="url(#arrow-pulse)"/>
        </svg>
        <p class="arch__diagram-cap">Pulse runs entirely on your machine. Ollama is the only "external" process — and it's local.</p>
      </div>

      <div class="arch__code reveal">
        <div class="arch__code-head">
          <span class="arch__code-name">snapshot_active_window.rs</span>
          <span class="arch__code-lang">Rust · Tauri v2</span>
        </div>
        <pre class="arch__code-body"><code>{codeSample}</code></pre>

        <ul class="arch__pills" role="list">
          {pills.map((p) => <li class="arch__pill">{p}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .arch__head { text-align: center; margin-bottom: 3rem; }
  .arch__head .lede { margin: 0.5rem auto 0; }

  .arch__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 900px) { .arch__grid { grid-template-columns: 1fr 1fr; } }

  .arch__diagram,
  .arch__code {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    min-width: 0;  /* prevent SVG from forcing grid item to overflow */
  }
  .arch__svg {
    display: block;
    width: 100%;
    height: auto;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.5rem;
  }
  .arch__diagram-cap {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .arch__code-head {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 0.75rem;
    font-size: 0.8rem;
  }
  .arch__code-name { color: var(--fg); font-weight: 500; font-family: ui-monospace, monospace; }
  .arch__code-lang { color: var(--muted); }
  .arch__code-body {
    background: #0f1018;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1rem;
    overflow-x: auto;
    color: var(--fg);
    line-height: 1.55;
  }
  .arch__code-body code { color: var(--cyan); }

  .arch__pills {
    list-style: none;
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .arch__pill {
    padding: 0.35rem 0.7rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.78rem;
    color: var(--fg-dim);
  }
  .arch__pill:hover { border-color: var(--purple); color: var(--fg); }
</style>
