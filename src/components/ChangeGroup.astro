---
// R257: a single change group (New / Improved / Fixed / Security).
// Colored label + icon + bullet list. `items` is an array of
// strings already split from the MD body (each starting with "- ").
import { inlineMd } from '../lib/inline-md';

interface Props {
  label: 'New' | 'Improved' | 'Fixed' | 'Security';
  items: string[];
}
const { label, items } = Astro.props;

const icons: Record<Props['label'], string> = {
  New:      '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15 8 22 9 17 14 18 21 12 18 6 21 7 14 2 9 9 8 12 2"/></svg>',
  Improved: '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>',
  Fixed:    '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L2 22h20L12 2z"/><line x1="12" y1="9" x2="12" y2="14"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>',
  Security: '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
};
const slug = label.toLowerCase();
---
<div class="change-group">
  <span class:list={['change-group__label', `change-group__label--${slug}`]}>
    <Fragment set:html={icons[label]} />
    {label}
  </span>
  <ul class="change-group__items" role="list">
    {items.map((it) => (
      <li class="change-item" set:html={inlineMd(it)} />
    ))}
  </ul>
</div>
