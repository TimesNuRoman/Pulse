---
// SPDX-License-Identifier: Apache-2.0
// R252: единая sticky-шапка на всех страницах. Spec — TopNav.astro.
// Floating glass pill → morphs to full-width bar on scroll > 80px.
// Renders the same on every page via <Base/>.

interface Props {
  /** Path текущей страницы, например "/pricing/" */
  currentPath?: string;
  /** Текст primary CTA */
  ctaText?: string;
  /** Ссылка primary CTA */
  ctaHref?: string;
  /** Показывать ли кнопку "Log in" (false на самой /login/) */
  showLogin?: boolean;
}

const {
  currentPath = '',
  ctaText = 'Download',
  ctaHref = '/download/',
  showLogin = true,
} = Astro.props;

const links: { href: string; label: string }[] = [
  { href: '/',           label: 'Home' },
  { href: '/pricing/',   label: 'Pricing' },
  { href: '/download/',  label: 'Download' },
  { href: '/faq/',       label: 'FAQ' },
  { href: '/changelog/', label: 'Changelog' },
  { href: '/privacy/',   label: 'Privacy' },
];

// Active match: exact for `/`, prefix for everything else.
// `startsWith` is intentional — `/download/` should also highlight
// `/download/android/`, `/install/windows/`, etc.
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="topnav" id="topnav" role="navigation" aria-label="Primary">
  <div class="topnav__inner">
    <a class="topnav__brand" href="/" aria-label="Pulse — home">
      <svg class="pulse-logo" viewBox="0 0 64 64" width="28" height="28" role="img" aria-label="Pulse">
        <circle class="pulse-logo__ring" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
        <circle class="pulse-logo__ring pulse-logo__ring--2" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
        <circle class="pulse-logo__ring pulse-logo__ring--3" cx="32" cy="32" r="14" fill="none" stroke="#bb9af7" stroke-width="1.5"></circle>
        <circle cx="32" cy="32" r="9" fill="#bb9af7"></circle>
        <circle cx="35" cy="30" r="2" fill="#1a1b26"></circle>
      </svg>
      <span class="topnav__brand-name">Pulse</span>
    </a>

    <nav class="topnav__links" aria-label="Primary">
      {links.map(({ href, label }) => (
        <a
          class="topnav__link"
          href={href}
          aria-current={isActive(href) ? 'page' : undefined}
        >{label}</a>
      ))}
    </nav>

    {showLogin && (
      <a
        class="topnav__login"
        href="/login/"
        aria-current={isActive('/login/') ? 'page' : undefined}
        aria-label="Activate an existing license"
      >Log in</a>
    )}

    <a class="topnav__cta" href={ctaHref}>
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 5v14"></path>
        <path d="M19 12l-7 7-7-7"></path>
      </svg>
      {ctaText}
    </a>

    <button class="topnav__burger" id="nav-burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-drawer">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
    </button>
  </div>
</header>

<div class="nav-drawer" id="nav-drawer" aria-hidden="true" role="menu">
  {links.map(({ href, label }) => (
    <a
      href={href}
      role="menuitem"
      aria-current={isActive(href) ? 'page' : undefined}
    >{label}</a>
  ))}
  {showLogin && (
    <a
      href="/login/"
      role="menuitem"
      aria-current={isActive('/login/') ? 'page' : undefined}
    >Log in</a>
  )}
</div>

<script>
  // R264: topnav state must survive Astro ViewTransitions soft-nav.
  // The previous IIFE bound scroll + burger handlers once on initial
  // load; after a soft swap the new <header> and <nav-drawer> nodes
  // either lose the .is-scrolled class or get new IDs with no
  // listeners. Fix: bind scroll once on window, and use a delegated
  // click + keydown handler on document that always resolves the
  // current #nav-burger / #nav-drawer / #topnav from the live DOM.
  let scrollBound = false;

  const initTopNav = () => {
    const nav = document.getElementById('topnav');
    const burger = document.getElementById('nav-burger');
    const drawer = document.getElementById('nav-drawer');
    document.body.classList.add('has-nav');

    if (nav) {
      // Sync .is-scrolled to the current scroll position immediately
      // so the header doesn't render flat after a soft-nav that landed
      // on a scrolled-down page.
      nav.classList.toggle('is-scrolled', window.scrollY > 80);
      document.body.classList.toggle('is-scrolled', window.scrollY > 80);
    }

    if (!scrollBound) {
      scrollBound = true;
      let scrolled = window.scrollY > 80;
      window.addEventListener('scroll', () => {
        const next = window.scrollY > 80;
        if (next === scrolled) return;
        scrolled = next;
        const n = document.getElementById('topnav');
        if (n) n.classList.toggle('is-scrolled', next);
        document.body.classList.toggle('is-scrolled', next);
      }, { passive: true });
    }

    const setOpen = (open) => {
      const b = document.getElementById('nav-burger');
      const d = document.getElementById('nav-drawer');
      if (!b || !d) return;
      b.setAttribute('aria-expanded', String(open));
      d.setAttribute('aria-hidden', String(!open));
      d.classList.toggle('is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    };

    if (burger) {
      burger.addEventListener('click', () => {
        const d = document.getElementById('nav-drawer');
        if (!d) return;
        setOpen(!d.classList.contains('is-open'));
      });
    }
    if (drawer) {
      drawer.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => setOpen(false));
      });
    }
  };

  // Delegated escape: works regardless of which burger/drawer is live.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const d = document.getElementById('nav-drawer');
    if (!d || !d.classList.contains('is-open')) return;
    const b = document.getElementById('nav-burger');
    d.classList.remove('is-open');
    d.setAttribute('aria-hidden', 'true');
    if (b) {
      b.setAttribute('aria-expanded', 'false');
      b.focus();
    }
    document.body.style.overflow = '';
  });

  initTopNav();
  document.addEventListener('astro:page-load', initTopNav);
</script>
