---
// R85: replaced emoji with inline SVG icons (no emoji in UI).
// Each icon is a 24x24 stroke-only path; accent color is inherited from
// the .accent-* class on the .feature card.
const features = [
  {
    icon: 'feather',
    title: '12MB installer',
    body: 'Built on Tauri v2 + Rust. Electron apps ship 100MB+ of Chromium. We don\'t.',
    accent: 'purple',
  },
  {
    icon: 'lock',
    title: 'Local-first',
    body: 'Talks to Ollama running on your machine. Your screenshots, your audio, your prompts — never leave.',
    accent: 'green',
  },
  {
    icon: 'eye',
    title: 'Vision',
    body: 'gemma3:4b understands screenshots of your screen, errors, and code. Just ask.',
    accent: 'blue',
  },
  {
    icon: 'mic',
    title: 'Voice',
    body: 'Push-to-talk, voice input via Web Speech API. STT runs in your browser, no cloud round-trip.',
    accent: 'cyan',
  },
  {
    icon: 'brain',
    title: 'Smart Engine',
    body: 'Sees the active app, window title, and process. Context-aware answers without you copy-pasting.',
    accent: 'yellow',
  },
  {
    icon: 'keyboard',
    title: 'Hotkey',
    body: 'Ctrl+Shift+Space summons the panel from anywhere. Type, speak, screenshot — done.',
    accent: 'red',
  },
];

// 24x24 viewBox stroke-only icons (Lucide-style). All icons inherit color.
const iconPath: Record<string, string> = {
  feather:
    '<path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/><line x1="16" y1="8" x2="2" y2="22"/><line x1="17.5" y1="15" x2="9" y2="15"/>',
  lock:
    '<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  eye:
    '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>',
  mic:
    '<rect x="9" y="2" width="6" height="13" rx="3"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/>',
  brain:
    '<path d="M9.5 2A2.5 2.5 0 0 0 7 4.5v.4a2.5 2.5 0 0 0-2 4.6 2.5 2.5 0 0 0 0 4 2.5 2.5 0 0 0 2 4.6v.4A2.5 2.5 0 0 0 9.5 22a2.5 2.5 0 0 0 2.5-2.5V4.5A2.5 2.5 0 0 0 9.5 2z"/><path d="M14.5 2A2.5 2.5 0 0 1 17 4.5v.4a2.5 2.5 0 0 1 2 4.6 2.5 2.5 0 0 1 0 4 2.5 2.5 0 0 1-2 4.6v.4A2.5 2.5 0 0 1 14.5 22a2.5 2.5 0 0 1-2.5-2.5V4.5A2.5 2.5 0 0 1 14.5 2z"/>',
  keyboard:
    '<rect x="2" y="6" width="20" height="12" rx="2"/><line x1="6" y1="10" x2="6" y2="10"/><line x1="10" y1="10" x2="10" y2="10"/><line x1="14" y1="10" x2="14" y2="10"/><line x1="18" y1="10" x2="18" y2="10"/><line x1="7" y1="14" x2="17" y2="14"/>',
};
---
<section class="features" id="features">
  <div class="container">
    <header class="features__head reveal">
      <span class="eyebrow">Built for the 100 people who care.</span>
      <h2>Small. Local. Actually useful.</h2>
      <p class="lede">Six things Pulse does that a 200MB Electron wrapper will never do.</p>
    </header>

    <ul class="features__grid">
      {features.map((f) => (
        <li class={`feature card reveal accent-${f.accent}`}>
          <div class="feature__icon" aria-hidden="true" set:html={`<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${iconPath[f.icon]}</svg>`} />
          <h3 class="feature__title">{f.title}</h3>
          <p class="feature__body">{f.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .features__head { text-align: center; margin-bottom: var(--sp-5); }
  .features__head .lede { margin: 0.5rem auto 0; }

  .features__grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-3);
  }
  @media (min-width: 640px) { .features__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .features__grid { grid-template-columns: repeat(3, 1fr); } }

  .feature { padding: 1.5rem; }
  .feature__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--sp-5);
    height: var(--sp-5);
    border-radius: 10px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--fg-dim);
    margin-bottom: 0.85rem;
  }
  .feature.accent-purple .feature__icon { color: var(--purple); border-color: var(--purple); }
  .feature.accent-green  .feature__icon { color: var(--green);  border-color: var(--green); }
  .feature.accent-blue   .feature__icon { color: var(--blue);   border-color: var(--blue); }
  .feature.accent-cyan   .feature__icon { color: var(--cyan);   border-color: var(--cyan); }
  .feature.accent-yellow .feature__icon { color: var(--yellow); border-color: var(--yellow); }
  .feature.accent-red    .feature__icon { color: var(--red);    border-color: var(--red); }
  .feature__title { margin-bottom: 0.4rem; }
  .feature__body { color: var(--fg-dim); font-size: 0.95rem; }
</style>
