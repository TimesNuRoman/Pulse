---
// R258: Account section shared layout — sidebar + topbar + page shell.
// Auth check is done CLIENT-SIDE (R258 plan revision): a tiny inline
// script calls /api/auth/me and either renders the page or redirects
// to /login/. This keeps the Astro build static (no SSR adapter needed).
// Server-side enforcement lives in the Worker API endpoints.

import Base from './Base.astro';

export interface Props {
  title: string;
  description?: string;
  active?: 'profile' | 'notes' | 'billing' | 'sync';
  hideTopnav?: boolean;
}

const { title, description, active = 'profile' } = Astro.props;
---

<Base
  title={title}
  description={description || 'Manage your Pulse account.'}
  ogImage="/og-account.png"
  ctaText=""
  ctaHref=""
  ctaVisible={false}
  footerLicense=""
  footerVersion=""
>
  <div class="acct" data-acct-root data-acct-active={active}>
    <aside class="acct__sidebar" aria-label="Account navigation">
      <nav class="acct__nav">
        <div class="acct__brand">
          <a href="/" class="acct__brand-link" aria-label="Pulse home">
            <svg viewBox="0 0 64 64" width="22" height="22" aria-hidden="true">
              <circle cx="32" cy="32" r="30" fill="none" stroke="#bb9af7" stroke-width="2" />
              <path d="M8 32 Q16 18, 24 32 T40 32 T56 32" stroke="#bb9af7" stroke-width="3" stroke-linecap="round" fill="none" />
              <circle cx="48" cy="32" r="3" fill="#7aa2f7" />
            </svg>
            <span class="acct__brand-name">Pulse</span>
          </a>
        </div>

        <div class="acct__group">
          <div class="acct__group-label">Account</div>
          <a
            href="/account/"
            class="acct__link"
            data-acct-link="profile"
            aria-current={active === 'profile' ? 'page' : undefined}
          >
            <span class="acct__link-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21a8 8 0 0 1 16 0" />
              </svg>
            </span>
            Profile
          </a>
          <a
            href="/account/notes/"
            class="acct__link"
            data-acct-link="notes"
            aria-current={active === 'notes' ? 'page' : undefined}
          >
            <span class="acct__link-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" />
                <line x1="8" y1="9" x2="16" y2="9" />
                <line x1="8" y1="13" x2="16" y2="13" />
                <line x1="8" y1="17" x2="12" y2="17" />
              </svg>
            </span>
            Notes
          </a>
          <a
            href="/account/billing/"
            class="acct__link"
            data-acct-link="billing"
            aria-current={active === 'billing' ? 'page' : undefined}
          >
            <span class="acct__link-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="20" height="14" rx="0" />
                <line x1="2" y1="10" x2="22" y2="10" />
              </svg>
            </span>
            Subscription
          </a>
          <a
            href="/account/sync/"
            class="acct__link"
            data-acct-link="sync"
            aria-current={active === 'sync' ? 'page' : undefined}
          >
            <span class="acct__link-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 0 1-9 9" />
                <path d="M3 12a9 9 0 0 1 9-9" />
                <path d="M21 12a9 9 0 0 0-9-9" />
                <path d="M3 12a9 9 0 0 0 9 9" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            </span>
            Sync
          </a>
        </div>

        <div class="acct__divider"></div>

        <div class="acct__group">
          <a href="/" class="acct__link acct__link--muted">
            <span class="acct__link-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
              </svg>
            </span>
            Open chat
          </a>
          <form method="post" action="/api/auth/logout" class="acct__logout">
            <button type="submit" class="acct__link acct__link--muted acct__link--btn" aria-label="Log out">
              <span class="acct__link-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                  <polyline points="16 17 21 12 16 7" />
                  <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
              </span>
              Log out
            </button>
          </form>
        </div>
      </nav>
    </aside>

    <main class="acct__main" id="main">
      <header class="acct__topbar" role="banner">
        <div class="acct__topbar-spacer"></div>
        <div class="acct__user" data-acct-user>
          <button type="button" class="acct__avatar-btn" data-acct-avatar aria-haspopup="menu" aria-expanded="false" aria-label="Account menu">
            <span class="acct__avatar" data-acct-avatar-letter aria-hidden="true">?</span>
            <span class="acct__user-name" data-acct-user-name>Account</span>
            <svg class="acct__caret" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
          <div class="acct__menu" data-acct-menu role="menu" hidden>
            <div class="acct__menu-email" data-acct-menu-email></div>
            <a href="/account/" class="acct__menu-item" role="menuitem">Profile</a>
            <a href="/account/billing/" class="acct__menu-item" role="menuitem">Subscription</a>
            <a href="/" class="acct__menu-item" role="menuitem">Open chat</a>
            <form method="post" action="/api/auth/logout">
              <button type="submit" class="acct__menu-item acct__menu-item--danger" role="menuitem">Log out</button>
            </form>
          </div>
        </div>
      </header>

      <div class="acct__content" data-acct-content>
        <slot />
      </div>
    </main>
  </div>
</Base>

<style>
  .acct {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: 100vh;
    background: var(--bg);
  }
  @media (max-width: 899px) {
    .acct { grid-template-columns: 1fr; }
  }

  .acct__sidebar {
    border-right: 1px solid var(--border);
    background: var(--bg-soft);
    padding: 20px 14px;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
  }
  @media (max-width: 899px) {
    .acct__sidebar {
      position: fixed;
      left: -260px;
      width: 240px;
      z-index: 30;
      transition: left 0.2s ease;
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.4);
    }
    .acct__sidebar.is-open { left: 0; }
  }

  .acct__brand { margin-bottom: 24px; }
  .acct__brand-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--fg);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 6px 10px;
    min-height: 36px;
  }
  .acct__brand-link:hover { color: var(--purple); }

  .acct__nav { display: flex; flex-direction: column; gap: 16px; }
  .acct__group { display: flex; flex-direction: column; gap: 2px; }
  .acct__group-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    padding: 8px 10px 4px;
  }
  .acct__divider { height: 1px; background: var(--border); margin: 4px 0; }

  .acct__link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px 8px 10px;
    min-height: 38px;
    color: var(--fg-dim);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    border-left: 2px solid transparent;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }
  .acct__link:hover { color: var(--fg); background: rgba(255, 255, 255, 0.04); }
  .acct__link.is-active {
    color: var(--purple);
    background: var(--surface-2);
    border-left-color: var(--purple);
  }
  .acct__link--muted { color: var(--muted); }
  .acct__link--muted:hover { color: var(--fg-dim); }
  .acct__link--btn {
    background: transparent;
    border: 0;
    width: 100%;
    text-align: left;
    cursor: pointer;
    font: inherit;
  }

  .acct__logout { margin: 0; }
  .acct__link-icon { display: inline-flex; align-items: center; color: inherit; }

  .acct__main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .acct__topbar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 56px;
    padding: 0 24px;
    background: rgba(31, 35, 53, 0.7);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .acct__topbar-spacer { flex: 1; }

  .acct__user { position: relative; }
  .acct__avatar-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px 4px 4px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--fg);
    cursor: pointer;
    min-height: 36px;
    font: inherit;
  }
  .acct__avatar-btn:hover { border-color: var(--fg-dim); }
  .acct__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: rgba(187, 154, 247, 0.18);
    color: var(--purple);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .acct__user-name {
    font-size: 0.88rem;
    color: var(--fg);
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .acct__caret { color: var(--muted); }
  @media (max-width: 480px) {
    .acct__user-name { display: none; }
    .acct__caret { display: none; }
  }

  .acct__menu {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    min-width: 220px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
    padding: 6px;
    z-index: 20;
  }
  .acct__menu[hidden] { display: none; }
  .acct__menu.is-open { display: block; }
  .acct__menu-email {
    padding: 8px 12px;
    font-size: 0.8rem;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
    margin-bottom: 4px;
  }
  .acct__menu-item {
    display: block;
    padding: 8px 12px;
    color: var(--fg);
    text-decoration: none;
    font-size: 0.9rem;
    background: transparent;
    border: 0;
    width: 100%;
    text-align: left;
    cursor: pointer;
    font: inherit;
  }
  .acct__menu-item:hover { background: var(--surface-2); color: var(--purple); }
  .acct__menu-item--danger { color: var(--red); }
  .acct__menu-item--danger:hover { background: rgba(247, 118, 142, 0.12); color: var(--red); }

  .acct__content {
    padding: 32px 24px 64px;
    max-width: 860px;
    width: 100%;
    margin: 0 auto;
  }
  @media (max-width: 640px) {
    .acct__content { padding: 24px 16px 48px; }
  }

  /* Mobile burger — only added by JS for viewports <900px. */
  .acct__burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--fg-dim);
    cursor: pointer;
  }
  .acct__burger:hover { color: var(--fg); border-color: var(--fg-dim); }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-acct-user]');
    if (!root) return;
    const btn = root.querySelector('[data-acct-avatar]');
    const menu = root.querySelector('[data-acct-menu]');
    if (!btn || !menu) return;

    const setOpen = (open) => {
      btn.setAttribute('aria-expanded', String(open));
      if (open) {
        menu.removeAttribute('hidden');
        menu.classList.add('is-open');
      } else {
        menu.setAttribute('hidden', '');
        menu.classList.remove('is-open');
      }
    };

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(menu.hasAttribute('hidden'));
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target)) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hasAttribute('hidden')) {
        setOpen(false);
        btn.focus();
      }
    });
  })();
</script>

<script is:inline>
  // R258: client-side auth check + active link + avatar population.
  // Calls /api/account/me (TBD in R259) — for now the layout is permissive:
  // if /api/account/me returns 401, we redirect to /login/ with the next param.
  (() => {
    const acct = document.querySelector('[data-acct-root]');
    if (!acct) return;
    const active = acct.getAttribute('data-acct-active') || 'profile';

    // Active link state — done server-side via aria-current, but we also
    // add a class for the CSS active state when the URL matches.
    const here = window.location.pathname;
    const links = acct.querySelectorAll('[data-acct-link]');
    links.forEach((a) => {
      const key = a.getAttribute('data-acct-link');
      const href = a.getAttribute('href') || '';
      if ((key === active && here.startsWith(href)) || (here === '/' && key === 'profile')) {
        a.classList.add('is-active');
      }
    });

    // Mobile menu toggle (sidebar drawer) — for viewports <900px, a
    // burger button is added in the topbar via JS (no SSR markup needed).
    if (window.matchMedia('(max-width: 899px)').matches) {
      const topbar = acct.querySelector('.acct__topbar');
      if (topbar && !topbar.querySelector('[data-acct-burger]')) {
        const burger = document.createElement('button');
        burger.type = 'button';
        burger.setAttribute('data-acct-burger', '');
        burger.setAttribute('aria-label', 'Open account menu');
        burger.className = 'acct__burger';
        burger.innerHTML = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>';
        topbar.insertBefore(burger, topbar.firstChild);
        const sidebar = acct.querySelector('.acct__sidebar');
        burger.addEventListener('click', () => {
          if (sidebar) sidebar.classList.toggle('is-open');
        });
      }
    }

    // Fetch /api/account/me to populate avatar + email + enforce auth.
    fetch('/api/account/me', { credentials: 'same-origin' })
      .then((r) => {
        if (r.status === 401) {
          const next = encodeURIComponent(window.location.pathname + window.location.search);
          window.location.replace('/login/?next=' + next);
          return null;
        }
        if (!r.ok) return null;
        return r.json();
      })
      .then((data) => {
        if (!data) return;
        const letter = ((data.name || data.email || '?').trim().charAt(0) || '?').toUpperCase();
        const nameEl = document.querySelector('[data-acct-user-name]');
        const letterEl = document.querySelector('[data-acct-avatar-letter]');
        const emailEl = document.querySelector('[data-acct-menu-email]');
        if (nameEl) nameEl.textContent = data.name || data.email;
        if (letterEl) letterEl.textContent = letter;
        if (emailEl) emailEl.textContent = data.email;
        document.documentElement.setAttribute('data-acct-user', data.id || '1');
      })
      .catch(() => {
        // Silent — login redirect above will handle the unauth case.
      });
  })();
</script>
