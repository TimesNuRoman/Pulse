---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  // R85: per-page sticky CTA (B1 fix-blocker)
  // When `ctaVisible` is false, the sticky CTA is not rendered at all.
  // `ctaText` may include the down-arrow character `↓` (U+2193) — not emoji.
  ctaText?: string;
  ctaHref?: string;
  ctaVisible?: boolean;
  // R85: per-page footer license + version (B2 fix-blocker)
  // `footerVersion = ''` hides the version pill entirely.
  footerLicense?: string;
  footerVersion?: string;
}

const {
  title = "Pulse — AI that doesn't get to leave the room",
  description = "Pulse is a 12MB Tauri v2 side panel that talks to local Ollama. Local. Private. No Electron, no cloud.",
  ogImage: ogImageProp,
  ctaText = 'Get Pulse ↓ 12 MB',
  ctaHref = '/#download',
  ctaVisible = true,
  // R94a: default footer license is 'Apache 2.0' (was 'MIT' — pre-R93 relic).
  footerLicense = 'Apache 2.0',
  footerVersion = 'v0.3.0',
} = Astro.props;

const ogImage = ogImageProp ?? '/og-image.svg';
// r102: fallback to the canonical R97-HOTFIX deploy host. Matches
// astro.config.mjs so og:url never ships the 'pulse.local' placeholder
// even if Astro.site is undefined (e.g. build with PULSE_SITE= overriding
// the config at runtime).
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://ebjklgbf0qvnp.space.minimax.io';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1a1b26" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- noscript fallback: show reveal content immediately -->
    <noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${description}`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body data-page-footer-license={footerLicense} data-page-footer-version={footerVersion}>
    <slot />

    {ctaVisible && (
      <!-- P0-1: Sticky mobile CTA (download) — appears after hero, hides at #download. R85: per-page text + href. -->
      <div class="sticky-cta" id="sticky-cta" hidden aria-label="Download Pulse">
        <a class="btn btn--primary" href={ctaHref} data-sticky-cta-link>
          {ctaText}
        </a>
        <button type="button" class="sticky-cta__close" id="sticky-cta-close" aria-label="Dismiss">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="6" y1="6" x2="18" y2="18"></line>
            <line x1="18" y1="6" x2="6" y2="18"></line>
          </svg>
        </button>
      </div>
    )}

    <!-- Scroll-reveal via IntersectionObserver -->
    <script is:inline>
      (() => {
        if (!('IntersectionObserver' in window)) {
          document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      })();
    </script>

    {ctaVisible && (
      <!-- P0-1: Sticky CTA logic — show after hero, hide at #download, dismissable -->
      <script is:inline>
        (() => {
          if (window.matchMedia('(min-width: 768px)').matches) return;  // desktop only

          const cta = document.getElementById('sticky-cta');
          const closeBtn = document.getElementById('sticky-cta-close');
          if (!cta || !closeBtn) return;

          const DISMISS_KEY = 'pulse_sticky_cta_dismissed';
          if (localStorage.getItem(DISMISS_KEY) === '1') {
            cta.hidden = true;
            return;
          }

          const hero = document.querySelector('.hero, .notes-hero, .legal');
          const download = document.getElementById('download');
          if (!hero || !download) return;

          let heroOut = false;     // user has scrolled past hero
          let atDownload = false;  // user is at #download

          const showCta = () => {
            if (heroOut && !atDownload) {
              cta.hidden = false;
              requestAnimationFrame(() => cta.classList.add('is-visible'));
            }
          };
          const hideCta = () => {
            cta.classList.remove('is-visible');
            // After transition, fully hide
            setTimeout(() => {
              if (!cta.classList.contains('is-visible')) cta.hidden = true;
            }, 350);
          };

          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.target === hero) heroOut = !e.isIntersecting;
                if (e.target === download) atDownload = e.isIntersecting;
              }
              if (heroOut && !atDownload) showCta();
              else hideCta();
            },
            { threshold: 0, rootMargin: '0px' }
          );
          io.observe(hero);
          io.observe(download);

          closeBtn.addEventListener('click', () => {
            localStorage.setItem(DISMISS_KEY, '1');
            hideCta();
          });

          // Smooth-scroll handled by html { scroll-behavior: smooth } in global.css;
          // we just need to refresh visibility when hash changes.
          cta.querySelector('[data-sticky-cta-link]')?.addEventListener('click', () => {
            // give smooth-scroll a moment, then force-hide
            setTimeout(hideCta, 50);
          });
        })();
      </script>
    )}
  </body>
</html>
