---
// R234: default `footerVersion` is sourced from `src/lib/versions.ts`
// (the SSOT). Pages can still pass `footerVersion=""` to hide the
// pill, or pass a literal `footerVersion="v0.6.4"` to pin a
// historical release-notes page footer.
import { DESKTOP_VERSION } from '../lib/versions';
import { ViewTransitions } from 'astro:transitions';
import TopNav from '../components/TopNav.astro';
import Background from '../components/Background.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  // R85: per-page sticky CTA (B1 fix-blocker)
  // When `ctaVisible` is false, the sticky CTA is not rendered at all.
  // `ctaText` may include the down-arrow character `↓` (U+2193) — not emoji.
  ctaText?: string;
  ctaHref?: string;
  ctaVisible?: boolean;
  // R85: per-page footer license + version (B2 fix-blocker)
  // `footerVersion = ''` hides the version pill entirely.
  footerLicense?: string;
  footerVersion?: string;
  // R128 SEO polish: per-page <link rel="canonical"> override.
  // When set, rendered as <link rel="canonical" href={canonical}> inside <head>.
  // When empty/absent, no canonical link is emitted.
  // (R135 also passed `canonical` from /install/windows/ — same prop, same dest.)
  canonical?: string;
  // R252: opt-out of the shared TopNav. 404.astro and notes.astro
  // (the Android redirect) pass `showNav={false}` — they're either a
  // terminal error state or a sub-app surface, not a marketing page.
  showNav?: boolean;
}

const {
  title = "Pulse — AI that doesn't get to leave the room",
  description = "Pulse is a 12MB Tauri v2 side panel that talks to local Ollama. Local. Private. No Electron, no cloud.",
  ogImage: ogImageProp,
  ctaText = 'Start trial ↓ 12 MB',
  ctaHref = '/#download',
  ctaVisible = true,
  // R141e: default footer license is '' (Roman: "Никакого опенсорс"). Pages can override
  // by passing `footerLicense="Apache 2.0"` if they need to surface the Apache label
  // (e.g. the /license/ page). Marketing pages stay neutral.
  footerLicense = '',
  footerVersion = `v${DESKTOP_VERSION}`,
  showNav = true,
} = Astro.props;

// R128 SEO polish: per-page canonical URL. Default '' → no canonical emitted.
const canonical = Astro.props.canonical ?? '';

const ogImage = ogImageProp ?? '/og-image.svg';
// r116: fallback to the canonical R2 deploy host (ownlocalml.com).
// Matches astro.config.mjs so og:url never ships a placeholder
// ('pulse.local' / 'pulse.tld') even if Astro.site is undefined
// (e.g. build with PULSE_SITE= overriding the config at runtime).
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://ownlocalml.com';

// R256: animated 6-layer background renders only on the three marketing
// pages (/, /pricing, /download). Legal and login stay clean for readability.
// Astro.url.pathname always starts with a slash, e.g. '/', '/pricing/'.
const showBackground = ['/', '/pricing', '/pricing/', '/download', '/download/'].includes(Astro.url.pathname);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1a1b26" />

    <title>{title}</title>
    <meta name="description" content={description} />

    {canonical && <link rel="canonical" href={canonical} />}

    {/*
      R257: surface the changelog RSS feed in <head> when the page
      is a /changelog* surface, so feed readers can auto-discover
      it from any page in the family.
    */}
    {Astro.url.pathname.startsWith('/changelog') && (
      <link rel="alternate" type="application/rss+xml" title="Pulse Changelog" href="/changelog/rss.xml" />
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- noscript fallback: show reveal content immediately -->
    <noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${description}`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/*
      R256: Astro View Transitions — cross-fade on every internal link
      click instead of a hard MPA navigation. Keeps the page feel
      reactive (per Roman: "не дёрганые а реактивные по ссылкам").
    */}
    <ViewTransitions transition:animate="fade" />
  </head>
  <body data-page-footer-license={footerLicense} data-page-footer-version={footerVersion}>
    {/*
      R256: animated background on the three marketing pages only.
      Layers are pointer-events:none, fixed-position, behind main content
      (main/.topnav/header/footer all z-index: 20). see Background.astro
      and the .bg-* rules in global.css.
    */}
    {showBackground && <Background />}

    {/*
      R252: shared TopNav on every page. Rendered above <slot/> so
      pages don't need to know about the nav. The component owns
      desktop links, mobile burger, drawer, scroll-morph, and the
      `aria-current="page"` active state. 404.astro and notes.astro
      opt out via `showNav={false}`.
    */}
    {showNav && <TopNav currentPath={Astro.url.pathname} showLogin={Astro.url.pathname !== '/login/'} />}

    <slot />

    {ctaVisible && (
      <!-- P0-1: Sticky mobile CTA (download) — appears after hero, hides at #download. R85: per-page text + href. -->
      <div class="sticky-cta" id="sticky-cta" hidden aria-label="Download Pulse">
        <a class="btn btn--primary" href={ctaHref} data-sticky-cta-link>
          {ctaText}
        </a>
        <button type="button" class="sticky-cta__close" id="sticky-cta-close" aria-label="Dismiss">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="6" y1="6" x2="18" y2="18"></line>
            <line x1="18" y1="6" x2="6" y2="18"></line>
          </svg>
        </button>
      </div>
    )}

    <!-- Scroll-reveal via IntersectionObserver. R263: re-run on every
         Astro ViewTransitions page swap, otherwise the new DOM's
         .reveal nodes stay at opacity: 0 and the page renders blank
         until the user hard-reloads. -->
    <script>
      const initReveal = () => {
        if (!('IntersectionObserver' in window)) {
          document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal:not(.is-visible)').forEach((el) => io.observe(el));
      };
      initReveal();
      document.addEventListener('astro:page-load', initReveal);
    </script>

    {ctaVisible && (
      <!-- P0-1: Sticky CTA logic — show after hero, hide at #download, dismissable -->
      <script is:inline>
        (() => {
          if (window.matchMedia('(min-width: 768px)').matches) return;  // desktop only

          const cta = document.getElementById('sticky-cta');
          const closeBtn = document.getElementById('sticky-cta-close');
          if (!cta || !closeBtn) return;

          const DISMISS_KEY = 'pulse_sticky_cta_dismissed';
          if (localStorage.getItem(DISMISS_KEY) === '1') {
            cta.hidden = true;
            return;
          }

          const hero = document.querySelector('.home-hero-ray, .hero, .notes-hero, .legal');
          const download = document.getElementById('download');
          if (!hero || !download) return;

          let heroOut = false;     // user has scrolled past hero
          let atDownload = false;  // user is at #download

          const showCta = () => {
            if (heroOut && !atDownload) {
              cta.hidden = false;
              requestAnimationFrame(() => cta.classList.add('is-visible'));
            }
          };
          const hideCta = () => {
            cta.classList.remove('is-visible');
            // After transition, fully hide
            setTimeout(() => {
              if (!cta.classList.contains('is-visible')) cta.hidden = true;
            }, 350);
          };

          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.target === hero) heroOut = !e.isIntersecting;
                if (e.target === download) atDownload = e.isIntersecting;
              }
              if (heroOut && !atDownload) showCta();
              else hideCta();
            },
            { threshold: 0, rootMargin: '0px' }
          );
          io.observe(hero);
          io.observe(download);

          closeBtn.addEventListener('click', () => {
            localStorage.setItem(DISMISS_KEY, '1');
            hideCta();
          });

          // Smooth-scroll handled by html { scroll-behavior: smooth } in global.css;
          // need to refresh visibility when hash changes.
          cta.querySelector('[data-sticky-cta-link]')?.addEventListener('click', () => {
            // give smooth-scroll a moment, then force-hide
            setTimeout(hideCta, 50);
          });
        })();
      </script>
    )}
  </body>
</html>

